    /* CTA */
    .info-cta {
      padding: 4rem 1rem;
      text-align: center;
    }
    .cta-inner {
      max-width: 520px;
      margin: 0 auto;
    }
    .cta-heading {
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 4vw, 2.6rem);
