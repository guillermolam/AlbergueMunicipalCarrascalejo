                        height="28"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="var(--green)"
                        stroke-width="2"
                        stroke-linecap="round"
                      >
                        <path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0" />
                        <circle cx="12" cy="20" r="1" fill="var(--green)" />
                      </svg>
                    )}
                    {f.icon === 'lock' && (
                      <svg
                        width="28"
