<div class="info-scene">
  <canvas id="info-scene-reviews-canvas" class="info-canvas" aria-label="Reseñas 3D"></canvas>
  <div class="info-overlay">
    <div class="info-title">Reseñas</div>
    <div class="info-subtitle">Subpuntuaciones en 3D · Booking.com</div>
  </div>
</div>

<script>
  import { attachSectionActive, createRafLoop } from '../../../lib/three/sectionActive';

  const canvas = document.getElementById('info-scene-reviews-canvas') as HTMLCanvasElement | null;
  if (!canvas) throw new Error('[SceneReviews] canvas missing');
  const section = canvas.closest('.ip-section') as HTMLElement | null;
  if (!section) throw new Error('[SceneReviews] section missing');
  const canvasEl = canvas as HTMLCanvasElement;
  const sectionEl = section as HTMLElement;

  function readInfoData() {
    const el = document.getElementById('info-scene-data');
    const raw = el?.textContent?.trim();
    if (!raw) return null;
    return JSON.parse(raw);
  }

  const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches ?? false;

  let runtime: any = null;
  let runtimePromise: Promise<any> | null = null;

  function makeScoreTex(THREE: any, score: unknown, label: unknown) {
    const c = document.createElement('canvas');
    c.width = 768;
    c.height = 512;
    const ctx = c.getContext('2d');
    if (!ctx) throw new Error('2d ctx missing');
    ctx.clearRect(0, 0, c.width, c.height);
    ctx.fillStyle = 'rgba(0,0,0,0.58)';
    roundRect(ctx, 36, 36, c.width - 72, c.height - 72, 44);
    ctx.fill();
    ctx.strokeStyle = 'rgba(255,255,255,0.14)';
    ctx.lineWidth = 3;
    roundRect(ctx, 36, 36, c.width - 72, c.height - 72, 44);
    ctx.stroke();
    ctx.fillStyle = '#00ab39';
    ctx.font = '900 150px system-ui, -apple-system, Segoe UI, Roboto, Arial';
    ctx.fillText(String(score), 76, 240);
    ctx.fillStyle = 'rgba(255,255,255,0.92)';
    ctx.font = '800 46px system-ui, -apple-system, Segoe UI, Roboto, Arial';
    ctx.fillText(String(label || ''), 76, 320);
    const tex = new THREE.CanvasTexture(c);
    tex.colorSpace = THREE.SRGBColorSpace;
    tex.anisotropy = 2;
    return tex;
  }

  function roundRect(
    ctx: CanvasRenderingContext2D,
    x: number,
    y: number,
    w: number,
    h: number,
    r: number
  ) {
    const rr = Math.min(r, w / 2, h / 2);
    ctx.beginPath();
    ctx.moveTo(x + rr, y);
    ctx.arcTo(x + w, y, x + w, y + h, rr);
    ctx.arcTo(x + w, y + h, x, y + h, rr);
    ctx.arcTo(x, y + h, x, y, rr);
    ctx.arcTo(x, y, x + w, y, rr);
    ctx.closePath();
  }

  async function init() {
    const THREE = await import('three');
    const data = readInfoData();
    const r = data?.reviewData ?? {};

    const metrics = [
      { k: 'staff', label: 'Staff' },
      { k: 'cleanliness', label: 'Limpieza' },
      { k: 'comfort', label: 'Confort' },
      { k: 'valueForMoney', label: 'Calidad/precio' },
      { k: 'facilities', label: 'Instalaciones' },
      { k: 'location', label: 'Ubicación' },
    ].map((m) => ({ ...m, v: Number(r[m.k] ?? 0) }));

    const renderer = new THREE.WebGLRenderer({
      canvas: canvasEl,
      antialias: true,
      alpha: false,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x05070b);
    scene.fog = new THREE.Fog(0x05070b, 12, 38);

    const camera = new THREE.PerspectiveCamera(55, 1, 0.1, 200);
    camera.position.set(0, 6.5, 16);
    camera.lookAt(0, 2.2, 0);

    scene.add(new THREE.AmbientLight(0xffffff, 0.85));
    const key = new THREE.DirectionalLight(0xffffff, 1.2);
    key.position.set(9, 12, 8);
    scene.add(key);

    const ground = new THREE.Mesh(
      new THREE.PlaneGeometry(28, 18),
      new THREE.MeshStandardMaterial({ color: 0x071018, roughness: 1, metalness: 0 })
    );
    ground.rotation.x = -Math.PI / 2;
    ground.position.y = 0;
    scene.add(ground);

    const barGeo = new THREE.BoxGeometry(1.2, 1, 1.2);
    const bars: any[] = [];
    const mats: any[] = [];
    for (let i = 0; i < metrics.length; i++) {
      const hue = 0.34 + i * 0.02;
      const col = new THREE.Color().setHSL(hue, 0.75, 0.5);
      const mat = new THREE.MeshStandardMaterial({ color: col, roughness: 0.55, metalness: 0.1 });
      mats.push(mat);
      const bar = new THREE.Mesh(barGeo, mat);
      bar.position.set((i - (metrics.length - 1) / 2) * 2.0, 0.5, 0);
      bar.scale.y = 0.001;
      bar.userData.target = clamp(metrics[i].v / 10, 0, 1) * 8.5;
      scene.add(bar);
      bars.push(bar);
    }

    const scoreTex = makeScoreTex(THREE, r.overall ?? 9.1, r.label ?? 'Sobresaliente');
    const scorePlane = new THREE.Mesh(
      new THREE.PlaneGeometry(7.2, 4.8),
      new THREE.MeshStandardMaterial({ map: scoreTex, transparent: true, roughness: 0.8, metalness: 0.05 })
    );
    scorePlane.position.set(0, 6.6, -3.8);
    scene.add(scorePlane);

    let W = 1;
    let H = 1;
    const ro = new ResizeObserver(() => {
      const rr = sectionEl.getBoundingClientRect();
      W = Math.max(1, rr.width);
      H = Math.max(1, rr.height);
      renderer.setSize(W, H, false);
      camera.aspect = W / H;
      camera.updateProjectionMatrix();
      if (reducedMotion) renderFrame(0, performance.now());
    });
    ro.observe(sectionEl);

    const loop = createRafLoop(renderFrame);
    let enteredAt = performance.now();

    function renderFrame(dt: number, t: number) {
      const p = clamp((t - enteredAt) / 800, 0, 1);
      const ease = 1 - Math.pow(1 - p, 3);
      for (const b of bars) {
        const target = b.userData.target ?? 1;
        b.scale.y = reducedMotion ? target : Math.max(0.001, target * ease);
        b.position.y = b.scale.y / 2;
      }
      scorePlane.rotation.y = Math.sin(t * 0.001) * 0.08;
      renderer.render(scene, camera);
    }

    renderFrame(0, performance.now());

    return {
      start() {
        enteredAt = performance.now();
        if (reducedMotion) return;
        loop.start();
      },
      stop() {
        loop.stop();
      },
      destroy() {
        loop.stop();
        ro.disconnect();
        barGeo.dispose();
        for (const m of mats) m.dispose();
        ground.geometry.dispose();
        ground.material.dispose();
        scorePlane.geometry.dispose();
        scorePlane.material.dispose();
        scoreTex.dispose();
        renderer.dispose();
      },
    };
  }

  function clamp(v: number, lo: number, hi: number) {
    return Math.max(lo, Math.min(hi, v));
  }

  async function ensureRuntime() {
    if (runtime) return runtime;
    runtimePromise ??= init();
    runtime = await runtimePromise;
    return runtime;
  }

  attachSectionActive(sectionEl, {
    auto: false,
    onChange(active) {
      if (active) ensureRuntime().then((r) => r.start());
      else if (runtime) {
        runtime.destroy();
        runtime = null;
        runtimePromise = null;
      }
    },
  });
</script>

<style>
  .info-scene {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #05070b;
  }
  .info-canvas {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none;
  }
  .info-overlay {
    position: absolute;
    left: 22px;
    top: 22px;
    z-index: 10;
    pointer-events: none;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.45);
  }
  .info-title {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .info-subtitle {
    margin-top: 6px;
    font-size: 13px;
    opacity: 0.85;
  }
</style>
