---
// StepPayment.astro — Step 5: secure payment card form
---

<div class="step-panel hidden" id="step-5" data-step="5">
  <div class="step-header center">
    <div class="step-header-icon large">
      <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#00AB39" stroke-width="2" stroke-linecap="round">
        <rect width="20" height="14" x="2" y="5" rx="2"></rect>
        <line x1="2" x2="22" y1="10" y2="10"></line>
      </svg>
    </div>
    <h1 class="step-title">Secure Payment</h1>
    <p class="step-desc">Your payment is encrypted and secure 🔒</p>
  </div>

  <div class="payment-card">
    <svg class="info-card-border" preserveAspectRatio="none" aria-hidden="true">
      <rect x="4" y="6" width="calc(100% - 8px)" height="calc(100% - 10px)" rx="14" fill="rgba(0,0,0,0.05)" filter="blur(5px)"></rect>
      <rect x="0" y="0" width="100%" height="100%" rx="16" fill="white" stroke="#D4A574" stroke-width="2.5"></rect>
    </svg>
    <div class="payment-inner">
      <div class="price-summary-bar">
        <span class="psb-label">Total to pay</span>
        <span class="psb-val" id="pay-total">EUR 0</span>
      </div>

      <div class="fg">
        <label class="fl">Card Number</label>
        <div class="card-input-wrap">
          <input
            type="text"
            id="f-card"
            name="cardNumber"
            class="fi card-number"
            placeholder="1234 5678 9012 3456"
            maxlength="19"
            inputmode="numeric"
          />
          <div class="card-icons">
            <svg width="32" height="20" viewBox="0 0 32 20" fill="none">
              <rect width="32" height="20" rx="3" fill="#1A1A6E"></rect>
              <rect x="12" y="4" width="8" height="12" rx="1" fill="#FF5F00"></rect>
              <circle cx="10" cy="10" r="6" fill="#EB001B"></circle>
              <circle cx="22" cy="10" r="6" fill="#F79E1B"></circle>
            </svg>
          </div>
        </div>
      </div>

      <div class="form-row-2">
        <div class="fg">
          <label class="fl">Expiry Date</label>
          <input type="text" id="f-expiry" name="expiry" class="fi" placeholder="MM/YY" maxlength="5" />
        </div>
        <div class="fg">
          <label class="fl">CVV</label>
          <div class="cvv-wrap">
            <input type="text" id="f-cvv" name="cvv" class="fi" placeholder="123" maxlength="4" inputmode="numeric" />
            <button type="button" class="cvv-help" aria-label="What is CVV?">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 16v-4m0-4h.01"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div class="fg">
        <label class="fl">Name on Card</label>
        <input type="text" id="f-cardname" name="cardName" class="fi" placeholder="MARÍA GARCÍA" />
      </div>

      <div class="security-note">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00AB39" stroke-width="2.5">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>256-bit SSL encryption. Your card details are never stored.</span>
      </div>
    </div>
  </div>
</div>
