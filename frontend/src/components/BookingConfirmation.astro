---
import { t } from '@/i18n/t';

const {
  bookingReference,
  pilgrimName,
  arrivalDate,
  departureDate,
  nights,
  roomType,
  totalAmount,
  confirmationCode,
  status = 'confirmed',
} = Astro.props;

const locale = Astro.currentLocale ?? 'es';
const roomLabel =
  roomType === 'private' ? t('Habitación privada', locale) : t('Habitación compartida', locale);
const statusLabel = status === 'confirmed' ? t('Confirmado', locale) : t('Pendiente', locale);
---

<section class="max-w-2xl w-full bg-white rounded-2xl shadow-xl p-8">
  <header class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900">
      {t('Reserva {0}', locale)}{statusLabel}
    </h1>
    <p class="text-slate-600 mt-1">
      {t('Referencia: <0/>', locale)}<span class="font-mono">{bookingReference}</span>
    </p>
  </header>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <div class="text-sm text-slate-500">{t('Nombre', locale)}</div>
      <div class="font-semibold text-slate-900">{pilgrimName}</div>
    </div>
    <div>
      <div class="text-sm text-slate-500">{t('Código', locale)}</div>
      <div class="font-mono text-slate-900">{confirmationCode}</div>
    </div>
    <div>
      <div class="text-sm text-slate-500">{t('Llegada', locale)}</div>
      <div class="text-slate-900">{arrivalDate}</div>
    </div>
    <div>
      <div class="text-sm text-slate-500">{t('Salida', locale)}</div>
      <div class="text-slate-900">{departureDate}</div>
    </div>
    <div>
      <div class="text-sm text-slate-500">{t('Noches', locale)}</div>
      <div class="text-slate-900">{nights}</div>
    </div>
    <div>
      <div class="text-sm text-slate-500">{t('Tipo', locale)}</div>
      <div class="text-slate-900">{roomLabel}</div>
    </div>
  </div>

  <footer class="mt-8 flex items-center justify-between">
    <div class="text-slate-600">{t('Total', locale)}</div>
    <div class="text-2xl font-bold text-slate-900">{totalAmount} EUR</div>
  </footer>
</section>
