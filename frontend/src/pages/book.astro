    // ── CLOUDFLARE IMAGES CONSTRAINTS ─────────────────────────────────────────
    const CF_ALLOWED_TYPES = new Set([
      'image/jpeg',
      'image/jpg',
      'image/png',
      'image/gif',
      'image/webp',
      'image/svg+xml',
      'image/heic',
      'image/heif',
    ]);
    const CF_MAX_BYTES = 10 * 1024 * 1024; // 10 MB
    const CF_MAX_DIM = 12_000; // px per side
    const CF_MAX_AREA = 100_000_000; // 100 MP

    interface FileValidationResult {
      ok: boolean;
      error?: string;
      width?: number;
      height?: number;
    }

    async function validateImageFile(file: File): Promise<FileValidationResult> {
      // Normalise type: some browsers report '' for HEIC — fall back to extension
      let mimeType = file.type.toLowerCase();
      if (!mimeType) {
        const ext = file.name.split('.').pop()?.toLowerCase() ?? '';
        const extMap: Record<string, string> = {
          jpg: 'image/jpeg',
          jpeg: 'image/jpeg',
          png: 'image/png',
          gif: 'image/gif',
          webp: 'image/webp',
          svg: 'image/svg+xml',
          heic: 'image/heic',
          heif: 'image/heif',
        };
        mimeType = extMap[ext] ?? '';
      }

      if (!CF_ALLOWED_TYPES.has(mimeType)) {
        const ext = file.name.split('.').pop()?.toUpperCase() ?? 'this format';
        return {
          ok: false,
          error: `${ext} files are not supported. Please use JPG, PNG, WebP, HEIC or GIF.`,
        };
      }

      if (file.size > CF_MAX_BYTES) {
        const mb = (file.size / 1_048_576).toFixed(1);
        return { ok: false, error: `File too large (${mb} MB). Maximum allowed size is 10 MB.` };
      }

      // SVG / HEIC browsers cannot decode raster dimensions — skip
      if (mimeType === 'image/svg+xml' || mimeType === 'image/heic' || mimeType === 'image/heif') {
        return { ok: true };
      }

      // Decode dimensions via <img>
      try {
        const url = URL.createObjectURL(file);
        const dims = await new Promise<{ w: number; h: number }>((resolve, reject) => {
          const img = new Image();
          img.onload = () => {
            URL.revokeObjectURL(url);
            resolve({ w: img.naturalWidth, h: img.naturalHeight });
          };
          img.onerror = () => {
            URL.revokeObjectURL(url);
            reject(new Error('decode'));
          };
          img.src = url;
        });
        if (dims.w > CF_MAX_DIM || dims.h > CF_MAX_DIM) {
          return {
            ok: false,
            error: `Image too large (${dims.w}×${dims.h} px). Maximum is 12,000 px per side.`,
          };
        }
        if (dims.w * dims.h > CF_MAX_AREA) {
          const mp = ((dims.w * dims.h) / 1_000_000).toFixed(0);
          return {
            ok: false,
            error: `Image area too large (${mp} MP). Maximum is 100 megapixels.`,
          };
        }
        return { ok: true, width: dims.w, height: dims.h };
      } catch {
        return { ok: false, error: 'Cannot read image. Please try a different file.' };
      }
    }

    function showUploadError(side: 'front' | 'back', message: string) {
      const content = document.getElementById(`upload-${side}-content`)!;
      clearEl(content);
      const errDiv = document.createElement('div');
      errDiv.style.cssText =
        "padding:1rem;text-align:center;font-family:'Patrick Hand',cursive;font-size:0.87rem;color:#EF5350;display:flex;flex-direction:column;align-items:center;gap:0.4rem";
      const NS3 = 'http://www.w3.org/2000/svg';
      const errSvg = document.createElementNS(NS3, 'svg') as SVGSVGElement;
      errSvg.setAttribute('width', '28');
      errSvg.setAttribute('height', '28');
      errSvg.setAttribute('viewBox', '0 0 24 24');
      errSvg.setAttribute('fill', 'none');
      errSvg.setAttribute('stroke', '#EF5350');
      errSvg.setAttribute('stroke-width', '2');
      errSvg.setAttribute('stroke-linecap', 'round');
      const ci = document.createElementNS(NS3, 'circle');
      ci.setAttribute('cx', '12');
      ci.setAttribute('cy', '12');
      ci.setAttribute('r', '10');
      errSvg.appendChild(ci);
      const li = document.createElementNS(NS3, 'line');
      li.setAttribute('x1', '12');
      li.setAttribute('y1', '8');
      li.setAttribute('x2', '12');
      li.setAttribute('y2', '12');
      errSvg.appendChild(li);
      const li2 = document.createElementNS(NS3, 'line');
      li2.setAttribute('x1', '12');
      li2.setAttribute('y1', '16');
      li2.setAttribute('x2', '12.01');
      li2.setAttribute('y2', '16');
      errSvg.appendChild(li2);
      errDiv.appendChild(errSvg);
      const txt = document.createElement('span');
      txt.textContent = message;
      errDiv.appendChild(txt);
      const retry = document.createElement('button');
      retry.type = 'button';
      retry.style.cssText =
        "margin-top:0.25rem;font-family:'Patrick Hand',cursive;font-size:0.82rem;color:#5D4E37;background:none;border:1px solid #D4A574;border-radius:8px;padding:0.2rem 0.6rem;cursor:pointer";
      retry.textContent = 'Try another file';
      retry.onclick = () => {
        const input = document.getElementById(`upload-${side}-input`) as HTMLInputElement;
        if (input) {
          input.value = '';
          input.click();
        }
      };
      errDiv.appendChild(retry);
      content.appendChild(errDiv);
      // Reset file input so same file can be re-selected after fix
      const inp = document.getElementById(`upload-${side}-input`) as HTMLInputElement;
      if (inp) inp.value = '';
    }

    // ── Clerk avatar helpers ───────────────────────────────────────────────────

    /** Convert a base64 JPEG data URL to a File object for Clerk's setProfileImage(). */
    function dataUrlToFile(dataUrl: string, filename: string): File {
      const [header, b64] = dataUrl.split(',');
      const mimeMatch = header.match(/:(.*?);/);
      const mime = mimeMatch ? mimeMatch[1] : 'image/jpeg';
      const bytes = atob(b64);
      const arr = new Uint8Array(bytes.length);
      for (let i = 0; i < bytes.length; i++) arr[i] = bytes.charCodeAt(i);
      return new File([arr], filename, { type: mime });
    }

    /**
     * Upload a cropped face image to Clerk as the authenticated user's profile picture.
     * Fire-and-forget — does not block the booking flow.
     * Only applicable for pilgrim 0 (the booking account holder).
     */
    async function uploadAvatarToClerk(dataUrl: string): Promise<void> {
      try {
        const w = window as any;
        // Wait for Clerk to initialise (it may not be ready immediately)
        if (!w.Clerk?.user) {
          try {
            await w.Clerk?.load?.();
          } catch {
            /* Clerk not available — skip */
          }
        }
        const user = w.Clerk?.user;
        if (!user) return; // Not logged in — nothing to do
        const file = dataUrlToFile(dataUrl, 'pilgrim-avatar.jpg');
        await user.setProfileImage({ file });
        // Show a brief toast
        showBookingToast('Foto de perfil actualizada ✓', '#00AB39');
      } catch (err) {
        // Non-fatal — avatar upload failure must never interrupt booking
        console.warn('[clerk] Avatar upload failed:', err);
      }
    }

    /** Brief toast for non-critical booking-flow notifications. */
    function showBookingToast(message: string, color = '#5D4E37') {
      let toast = document.getElementById('booking-toast') as HTMLDivElement | null;
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'booking-toast';
        toast.style.cssText = [
          'position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%) translateY(2rem)',
          'background:#fff;border:1.5px solid #D4A574;border-radius:12px',
          "padding:0.55rem 1.2rem;font-family:'Patrick Hand',cursive;font-size:0.88rem",
          'box-shadow:0 4px 18px rgba(0,0,0,0.12);z-index:9999',
          'transition:opacity 300ms,transform 300ms;opacity:0;pointer-events:none',
        ].join(';');
        document.body.appendChild(toast);
      }
      toast.style.color = color;
      toast.textContent = message;
      // Animate in
      requestAnimationFrame(() => {
        toast!.style.opacity = '1';
        toast!.style.transform = 'translateX(-50%) translateY(0)';
      });
      // Animate out after 2.8 s
      setTimeout(() => {
        toast!.style.opacity = '0';
        toast!.style.transform = 'translateX(-50%) translateY(2rem)';
      }, 2800);
    }

    /**
     * Crop the face/photo region from a document image using Canvas API.
     * For EU ID card front: face is in the left ~32% of the landscape card.
     * For passport page:    face is in the left ~35% of the portrait page.
     * Returns a data URL (JPEG, 256×256) suitable for Clerk setProfileImage().
     */
    async function cropFaceForAvatar(file: File, docType: string): Promise<string | null> {
      return new Promise((resolve) => {
        const url = URL.createObjectURL(file);
        const img = new Image();
        img.onload = () => {
          URL.revokeObjectURL(url);
          const w = img.naturalWidth;
          const h = img.naturalHeight;
          const isLandscape = w > h;

          // Define crop region based on document type and orientation
          let sx: number, sy: number, sw: number, sh: number;
          if (isLandscape) {
            // ID card front: face occupies left ~32% of the card, vertically centred
            sw = Math.round(w * 0.32);
            sh = Math.round(h * 0.82);
            sx = Math.round(w * 0.03);
            sy = Math.round(h * 0.09);
          } else {
            // Passport portrait page: face top-left, roughly 38% wide × 42% tall
            sw = Math.round(w * 0.38);
            sh = Math.round(h * 0.42);
            sx = Math.round(w * 0.04);
            sy = Math.round(h * 0.06);
          }

          const OUT = 256;
          const canvas = document.createElement('canvas');
          canvas.width = OUT;
          canvas.height = OUT;
          const ctx = canvas.getContext('2d');
          if (!ctx) {
            resolve(null);
            return;
          }

          // Fit the cropped region into a square with white background
          const ratio = sw / sh;
          let dw: number, dh: number, dx: number, dy: number;
          if (ratio > 1) {
            dw = OUT;
            dh = Math.round(OUT / ratio);
            dx = 0;
            dy = Math.round((OUT - dh) / 2);
          } else {
            dh = OUT;
            dw = Math.round(OUT * ratio);
            dy = 0;
            dx = Math.round((OUT - dw) / 2);
          }

          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, OUT, OUT);
          ctx.drawImage(img, sx, sy, sw, sh, dx, dy, dw, dh);

          resolve(canvas.toDataURL('image/jpeg', 0.88));
        };
        img.onerror = () => {
          URL.revokeObjectURL(url);
          resolve(null);
        };
        img.src = url;
      });
    }

    // Upload file handlers
    async function handleUpload(side: 'front' | 'back', file: File) {
      // 1. Client-side format/size/dimension validation
      const validation = await validateImageFile(file);
      if (!validation.ok) {
        showUploadError(side, validation.error!);
        return;
      }

      // 2. Store File object immediately
      if (side === 'front') {
        uploadedFiles.frontFile = file;
        uploadedFiles.frontValid = null; // pending
      } else {
        uploadedFiles.backFile = file;
        uploadedFiles.backValid = null;
      }

      // 3. Render thumbnail preview in "validating" state
      const contentEl = document.getElementById(`upload-${side}-content`)!;
      renderUploadedFilePreview(contentEl, file, side, null);

      // 4. Check if both required files are now present → show summary bar
      const needBack = state.docType === 'dni';
      const hasFront = uploadedFiles.frontFile !== null;
      const hasBack = uploadedFiles.backFile !== null;
      if (hasFront && (!needBack || hasBack)) {
        renderStep2Nav();
        const nameEl = document.getElementById('uploaded-file-name')!;
        nameEl.textContent = needBack && hasBack ? 'Front + Back uploaded' : file.name;
        uploadComplete.style.display = '';
        ocrResult.style.display = '';
        const ocrFieldsEl = ocrResult.querySelector('.ocr-fields') as HTMLElement | null;
        if (ocrFieldsEl) {
          clearEl(ocrFieldsEl);
          const sd = document.createElement('div');
          sd.style.cssText =
            "text-align:center;padding:0.5rem 0;font-family:'Patrick Hand',cursive;color:#5D4E37";
          sd.textContent = 'Escaneando documento…';
          ocrFieldsEl.appendChild(sd);
        }

        // 5. Run OCR
        const lang = state.docType === 'passport' ? 'eng' : 'spa';
        try {
          const engine = await getOCREngine(lang);
          let rawText = '';
          if (uploadedFiles.frontFile) {
            engine.loadImage(await fileToImageData(uploadedFiles.frontFile));
            rawText += engine.getText() + '\n';
          }
          if (uploadedFiles.backFile) {
            engine.loadImage(await fileToImageData(uploadedFiles.backFile));
            rawText += engine.getText() + '\n';
          }
          const ext = state.docType === 'passport' ? parsePassport(rawText) : parseDni(rawText);
          const hasData = !!(ext.firstName || ext.lastName || ext.documentNumber || ext.birthDate);

          if (!hasData) {
            if (ocrFieldsEl) {
              clearEl(ocrFieldsEl);
              const ed = document.createElement('div');
              ed.style.cssText =
                "color:#EF5350;font-family:'Patrick Hand',cursive;font-size:0.9rem;padding:0.5rem 0";
              ed.textContent =
                'OCR no pudo extraer datos — por favor rellene los campos manualmente';
              ocrFieldsEl.appendChild(ed);
            }
          } else {
            if (ocrFieldsEl) {
              // Pre-fill Step 3 form fields
              const fFirst = document.getElementById('f-first') as HTMLInputElement;
              const fLast = document.getElementById('f-last') as HTMLInputElement;
              const fDob = document.getElementById('f-dob') as HTMLInputElement;
              const fNat = document.getElementById('f-nat') as HTMLInputElement;
              if (fFirst && ext.firstName) fFirst.value = ext.firstName;
              if (fLast && ext.lastName) fLast.value = ext.lastName;
              if (fDob && ext.birthDate) fDob.value = ext.birthDate;
              if (fNat && ext.nationality) fNat.value = ext.nationality;
              // Save OCR data into the current person's Step 3 slot
              const ocr = personFormData[activePersonStep2] ?? {};
              if (ext.firstName) ocr['f-first'] = ext.firstName;
              if (ext.lastName) ocr['f-last'] = ext.lastName;
              if (ext.birthDate) ocr['f-dob'] = ext.birthDate;
              if (ext.nationality) ocr['f-nat'] = ext.nationality;
              personFormData[activePersonStep2] = ocr;
              // Update OCR display panel
              const name =
                [ext.firstName, ext.lastName].filter(Boolean).join(' ').toUpperCase() || '—';
              const docNum = ext.documentNumber || '—';
              clearEl(ocrFieldsEl);
              [
                ['Nombre', name],
                ['Documento #', docNum],
                ['Fecha nacimiento', ext.birthDate || '—'],
                ['Nacionalidad', (ext.nationality || '—').toUpperCase()],
              ].forEach(([lbl, val]) => {
                const f = document.createElement('div');
                f.className = 'ocr-field';
                const ls = document.createElement('span');
                ls.className = 'ocr-label';
                ls.textContent = lbl;
                const vs = document.createElement('span');
                vs.className = 'ocr-value';
                vs.textContent = val;
                f.appendChild(ls);
                f.appendChild(vs);
                ocrFieldsEl.appendChild(f);
              });
            }
          }
        } catch (err) {
          console.error('[tesseract-wasm] OCR error:', err);
          if (ocrFieldsEl) {
            clearEl(ocrFieldsEl);
            const errD = document.createElement('div');
            errD.style.cssText =
              "color:#EF5350;font-family:'Patrick Hand',cursive;font-size:0.9rem";
            errD.textContent = 'Error al escanear — por favor rellene manualmente.';
            ocrFieldsEl.appendChild(errD);
          }
        }
      }

      enableNext(canProceed());

      // 6. Backend CV validation (async, updates validation badge after result)
      (async () => {
        try {
          const b64 = await new Promise<string>((res, rej) => {
            const reader = new FileReader();
            reader.onload = () => res((reader.result as string).split(',')[1] ?? '');
            reader.onerror = rej;
            reader.readAsDataURL(file);
          });
          const resp = await fetch('/api/validate/image-upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              image_data: b64,
              mime_type: file.type || 'image/jpeg',
              declared_type: state.docType ?? 'unknown',
            }),
          });
          if (!resp.ok) {
            if (side === 'front') uploadedFiles.frontValid = null;
            else uploadedFiles.backValid = null;
            return;
          }
          const data = (await resp.json()) as {
            format_valid?: boolean;
            size_valid?: boolean;
            dimensions_valid?: boolean;
            errors?: string[];
            type_mismatch?: boolean;
            side_warning?: string | null;
            classification?: {
              side: string;
              doc_type: string;
              confidence: number;
              has_photo_region?: boolean;
              has_eu_flag?: boolean;
            } | null;
          };

          const allValid =
            data.format_valid !== false &&
            data.size_valid !== false &&
            data.dimensions_valid !== false &&
            !data.type_mismatch;
          const errMsg = data.errors?.join('; ') ?? null;

          if (side === 'front') {
            uploadedFiles.frontValid = allValid;
            uploadedFiles.validationError = allValid ? null : errMsg;
          } else {
            uploadedFiles.backValid = allValid;
          }

          // Re-render the thumbnail with new validation state
          const freshContent = document.getElementById(`upload-${side}-content`)!;
          const currentFile = side === 'front' ? uploadedFiles.frontFile : uploadedFiles.backFile;
          if (currentFile === file) {
            // still the same file
            renderUploadedFilePreview(freshContent, file, side, allValid);
          }

          // Also update stored state so switching pilgrims retains result
          saveStep2State();
          enableNext(canProceed());

          // Type-mismatch or side warning banner
          const wrapEl = document.getElementById('upload-phase');
          if (!wrapEl) return;
          let banner = document.getElementById('cv-warning-banner');
          if (data.type_mismatch || data.side_warning) {
            if (!banner) {
              banner = document.createElement('div');
              banner.id = 'cv-warning-banner';
              banner.style.cssText =
                "margin:0.5rem 0;padding:0.6rem 1rem;background:#FFF8E1;border:1.5px solid #FFB300;border-radius:10px;font-family:'Patrick Hand',cursive;font-size:0.87rem;color:#5D4E37;display:flex;align-items:center;gap:0.5rem";
              wrapEl.prepend(banner);
            }
            const msg = data.type_mismatch
              ? 'This image may not match the selected document type. Please verify you chose the correct option.'
              : (data.side_warning ?? '');
            banner.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFB300" stroke-width="2.5" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>${msg}`;
          } else if (banner) {
            banner.remove();
          }

          // 7. Face crop for avatar — only for front side of ID card or passport
          if (
            side === 'front' &&
            allValid &&
            data.classification &&
            (data.classification.side === 'front' || data.classification.doc_type === 'passport') &&
            (data.classification.has_photo_region || data.classification.has_eu_flag)
          ) {
            cropFaceForAvatar(file, data.classification.doc_type).then((dataUrl) => {
              if (dataUrl) {
                uploadedFiles.avatarDataUrl = dataUrl;
                saveStep2State();
                // Show small avatar preview in the upload-complete bar
                const bar = document.getElementById('upload-complete');
                if (bar && !bar.querySelector('.avatar-preview')) {
                  const av = document.createElement('img');
                  av.className = 'avatar-preview';
                  av.style.cssText =
                    'width:36px;height:36px;border-radius:50%;object-fit:cover;border:2px solid #00AB39;flex-shrink:0';
                  av.src = dataUrl;
                  av.title = 'Face crop for profile picture';
                  bar.querySelector('.uploaded-file-row')?.prepend(av);
                }
              }
            });
          }
        } catch {
          // Swallow — backend validation is advisory only
        }
      })();
    }

    [uploadFrontInput, uploadBackInput].forEach((input) => {
      if (!input) return;
      const side = input.id.includes('front') ? 'front' : 'back';
      input.addEventListener('change', () => {
        if (input.files && input.files[0]) handleUpload(side as 'front' | 'back', input.files[0]);
      });
      // Click the upload face to trigger file input
      const face = input.closest('.upload-face');
      if (face) {
        face.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).tagName !== 'INPUT') input.click();
        });
        face.addEventListener('keydown', (e) => {
          if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ')
            input.click();
        });
      }
    });

    // Remove uploaded file
    uploadedFileRemove.addEventListener('click', () => {
      uploadComplete.style.display = 'none';
      ocrResult.style.display = 'none';
      uploadedFiles = {
        frontFile: null,
        backFile: null,
        frontValid: null,
        backValid: null,
        validationError: null,
        avatarDataUrl: null,
      };
      function buildUploadPlaceholder(
        strokeColor: string,
        labelText: string,
        labelSpanId?: string
      ): DocumentFragment {
        const NS3 = 'http://www.w3.org/2000/svg';
        const frag = document.createDocumentFragment();
        const camSvg = document.createElementNS(NS3, 'svg') as SVGSVGElement;
        camSvg.setAttribute('width', '48');
        camSvg.setAttribute('height', '48');
        camSvg.setAttribute('viewBox', '0 0 24 24');
        camSvg.setAttribute('fill', 'none');
        camSvg.setAttribute('stroke', strokeColor);
        camSvg.setAttribute('stroke-width', '1.5');
        camSvg.setAttribute('stroke-linecap', 'round');
        camSvg.setAttribute('class', 'upload-cam-icon');
        const camRect = document.createElementNS(NS3, 'rect');
        camRect.setAttribute('x', '3');
        camRect.setAttribute('y', '5');
        camRect.setAttribute('width', '18');
        camRect.setAttribute('height', '14');
        camRect.setAttribute('rx', '2');
        camSvg.appendChild(camRect);
        const camCirc = document.createElementNS(NS3, 'circle');
        camCirc.setAttribute('cx', '12');
        camCirc.setAttribute('cy', '12');
        camCirc.setAttribute('r', '3.5');
        camSvg.appendChild(camCirc);
        const camPath = document.createElementNS(NS3, 'path');
        camPath.setAttribute('d', 'M3 5l2-2h4l2 2');
        camSvg.appendChild(camPath);
        frag.appendChild(camSvg);
        const labelP = document.createElement('p');
        labelP.className = 'upload-label';
        if (labelSpanId) {
          labelP.textContent = labelText;
          const idSpan = document.createElement('span');
          idSpan.id = labelSpanId;
          idSpan.textContent = 'ID';
          labelP.appendChild(idSpan);
        } else {
          labelP.textContent = labelText;
        }
        frag.appendChild(labelP);
        const hintP = document.createElement('p');
        hintP.className = 'upload-hint';
        hintP.textContent = 'Click or drag image to upload';
        frag.appendChild(hintP);
        const fmtP = document.createElement('p');
        fmtP.className = 'upload-formats';
        fmtP.textContent = 'JPG, PNG or PDF (max 10MB)';
        frag.appendChild(fmtP);
        return frag;
      }
      const frontContent = document.getElementById('upload-front-content')!;
      clearEl(frontContent);
      frontContent.appendChild(buildUploadPlaceholder('#00AB39', 'Front of ', 'upload-face-label'));
      const backContent = document.getElementById('upload-back-content');
      if (backContent) {
        clearEl(backContent);
        backContent.appendChild(buildUploadPlaceholder('#D4A574', 'Back of ID'));
      }
      (uploadFrontInput as HTMLInputElement).value = '';
      (uploadBackInput as HTMLInputElement).value = '';
    });

    // ── BED SELECTION (per-night availability, multi-bed schedule, Chart.js-style tooltip) ──
    const FRAME = { dark: '#5D4E37', mid: '#8D6E4E', light: '#A08060' };
    type BedSt = 'available' | 'occupied' | 'selected' | 'partial';

    // Fallback bed availability map derived from per-day cached data
    function getAvailabilityMapFallback(): Record<number, boolean[]> {
      const n = state.nights || 1;
      const seed = state.checkin
        ? state.checkin
            .split('-')
            .map(Number)
            .reduce((a, b) => a + b, 0)
        : 42;
      const map: Record<number, boolean[]> = {};
      for (let bed = 1; bed <= 24; bed++) {
        const nights: boolean[] = [];
        for (let ni = 0; ni < n; ni++) {
          const hash = (bed * 7 + ni * 13 + seed * 3) % 37;
          if ([5, 9, 15, 23].includes(bed)) {
            nights.push(false);
          } else if ([3, 7, 18, 21].includes(bed) && ni >= Math.floor(n / 2)) {
            nights.push(false);
          } else if (bed === 11 && ni === 0) {
            nights.push(false);
          } else {
            nights.push(hash > 5);
          }
        }
        map[bed] = nights;
      }
      return map;
    }

    // Build bed availability from per-day cached API data.
    // A bed is "available" on a night if that night still has free beds
    // in the pool (approximation until the backend exposes per-bed slots).
    function buildAvailMapFromCache(): Record<number, boolean[]> {
      const n = state.nights || 1;
      if (!state.checkin) return getAvailabilityMapFallback();
      const map: Record<number, boolean[]> = {};
      for (let bed = 1; bed <= 24; bed++) {
        const nights: boolean[] = [];
        for (let ni = 0; ni < n; ni++) {
          const d = new Date(state.checkin + 'T00:00:00');
          d.setDate(d.getDate() + ni);
          const ds = d.toISOString().split('T')[0];
          const info = getDayInfo(ds);
          // If no data yet, assume bed is available (conservative — refined by loadBedAvailability)
          nights.push(bed <= (info?.beds ?? 24));
        }
        map[bed] = nights;
      }
      return map;
    }

    async function loadBedAvailability() {
      // Show fallback instantly, then silently refine with API data
      availMap =
        Object.keys(dayInfoCache).length > 0
          ? buildAvailMapFromCache()
          : getAvailabilityMapFallback();
      renderBedGrid();
      renderSchedule();
      updateBedState();

      if (!state.checkin || !state.checkout) return;
      // Fetch the date range into cache if not already present
      const startDs = state.checkin;
      const endDs = state.checkout;
      const needsFetch = !dayInfoCache[startDs] || !dayInfoCache[endDs];
      if (needsFetch) {
        try {
          const res = await fetch(`/api/availability?from=${startDs}&to=${endDs}`);
          if (res.ok) {
            const data = (await res.json()) as {
              days: Record<string, { beds: number; price: number }>;
            };
            Object.assign(dayInfoCache, data.days);
            availMap = buildAvailMapFromCache();
            renderBedGrid();
            renderSchedule();
            updateBedState();
          }
        } catch {
          // keep fallback
        }
      }
    }

    // Per-person bed schedules: personBedSchedules[person][night] = bed number | null
    let personBedSchedules: (number | null)[][] = [[]];
    let activePerson = 0; // which person's schedule is currently being edited
    // bedSchedule always points to personBedSchedules[activePerson] for convenience
    let bedSchedule: (number | null)[] = personBedSchedules[0];
    let activeNight = 0; // which night tab is active
    let availMap: Record<number, boolean[]> = {};
    const tooltipEl = document.getElementById('bed-tooltip')!;
    const ttTitle = document.getElementById('tt-title')!;
    const ttStatus = document.getElementById('tt-status')!;
    const ttNights = document.getElementById('tt-nights')!;

    function bedLabel(bed: number) {
      const isTop = bed % 2 !== 0;
      const bunk = Math.ceil(bed / 2);
      return `Bed ${bed} — ${isTop ? 'Top' : 'Bottom'} Bunk #${bunk}`;
    }

    function bedOverallStatus(bed: number): BedSt {
      const avail = availMap[bed];
      if (!avail) return 'occupied';
      // Selected = current person's schedule has this bed
      const assignedNights = bedSchedule.map((b, i) => (b === bed ? i : -1)).filter((i) => i >= 0);
      if (assignedNights.length > 0) return 'selected';
      const availCount = avail.filter(Boolean).length;
      if (availCount === 0) return 'occupied';
      if (availCount === avail.length) return 'available';
      return 'partial';
    }

    function bedColors(st: BedSt) {
      if (st === 'selected')
        return {
          m: '#90CAF9',
          ms: '#64B5F6',
          mf: '#42A5F5',
          p: '#E3F2FD',
          ps: '#BBDEFB',
          sh: '#BBDEFB',
          sk: '#1565C0',
        };
      if (st === 'occupied')
        return {
          m: '#EF9A9A',
          ms: '#E57373',
          mf: '#F44336',
          p: '#FFCDD2',
          ps: '#EF9A9A',
          sh: '#FFCDD2',
          sk: '#C62828',
        };
      if (st === 'partial')
        return {
          m: '#FFF3CD',
          ms: '#FFE082',
          mf: '#FFD54F',
          p: '#FFFDE7',
          ps: '#FFF9C4',
          sh: '#FFF9C4',
          sk: '#D4A017',
        };
      return {
        m: '#A5D6A7',
        ms: '#66BB6A',
        mf: '#4CAF50',
        p: '#E8F5E9',
        ps: '#C8E6C9',
        sh: '#C8E6C9',
        sk: '#2E7D32',
      };
    }

    function mattressSVG(y: number, c: ReturnType<typeof bedColors>, bedNum: number, st: BedSt) {
      const badge =
        st === 'occupied'
          ? `<circle cx="48" cy="${y + 2}" r="6" fill="white" stroke="${c.sk}" stroke-width="1"/><path d="M45,${y - 1} L51,${y + 5} M45,${y + 5} L51,${y - 1}" stroke="${c.sk}" stroke-width="1.5" stroke-linecap="round"/>`
          : st === 'selected'
            ? `<circle cx="48" cy="${y + 2}" r="6" fill="${c.sk}"/><path d="M45,${y + 2} L47,${y + 4} L51,${y}" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`
            : st === 'partial'
              ? `<circle cx="48" cy="${y + 2}" r="6" fill="${c.sk}"/><text x="48" y="${y + 5}" text-anchor="middle" font-size="7" fill="white" font-weight="bold">½</text>`
              : '';
      return `
        <path d="M8,${y} L38,${y - 3} L56,${y - 3} L26,${y} Z" fill="${c.m}" stroke="${c.sk}" stroke-width="0.8"/>
        <path d="M8,${y} L26,${y} L26,${y + 7} L8,${y + 7} Z" fill="${c.mf}" stroke="${c.sk}" stroke-width="0.8"/>
        <path d="M26,${y} L56,${y - 3} L56,${y + 4} L26,${y + 7} Z" fill="${c.ms}" stroke="${c.sk}" stroke-width="0.6"/>
        <rect x="9" y="${y}" width="12" height="5" rx="2" fill="${c.p}" stroke="${c.sk}" stroke-width="0.5"/>
        <path d="M9,${y} L17,${y - 2} Q19,${y - 2} 21,${y} Z" fill="${c.ps}" stroke="${c.sk}" stroke-width="0.3" opacity="0.7"/>
        <text x="17" y="${y + 6}" text-anchor="middle" font-family="Cabin Sketch,cursive" font-size="5.5" font-weight="bold" fill="${c.sk}">${bedNum}</text>
        ${badge}`;
    }

