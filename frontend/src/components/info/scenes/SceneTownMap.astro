---
import Map3DTown from '../Map3DTown.astro';
---

<div class="info-scene">
  <Map3DTown autoActive={false} enablePilgrims={true} />
  <div class="info-hud">
    <div class="info-hud-pill">Arrastra para rotar · Hover para ver pueblos</div>
  </div>
  <div class="info-gmaps" aria-hidden="true">
    <iframe
      title="Google Street View"
      src="https://www.google.com/maps/embed?pb=!4v1776132626168!6m8!1m7!1sXfIuEjt1gcb_6t5BbncyUg!2m2!1d39.02360854529584!2d-6.337591378819762!3f33.74876442920598!4f-9.827810844357984!5f0.764310698987728"
      width="380"
      height="240"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    />
  </div>
</div>

<style>
  .info-scene {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #0b0f14;
  }
  .info-hud {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 10;
    pointer-events: none;
  }
  .info-hud-pill {
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.9);
    font-size: 12px;
    font-weight: 600;
    backdrop-filter: blur(10px);
  }

  :global(.map3d-town-wrap) {
    border-radius: 0 !important;
  }
  :global(.map3d-town-wrap canvas) {
    border-radius: 0 !important;
    pointer-events: auto !important;
  }
  :global(.map3d-legend),
  :global(.map3d-label) {
    pointer-events: none !important;
  }

  .info-gmaps {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 12;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.5);
    pointer-events: auto;
  }
  .info-gmaps iframe {
    display: block;
  }
</style>
