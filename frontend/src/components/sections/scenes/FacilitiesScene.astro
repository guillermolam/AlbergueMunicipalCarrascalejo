---
// FacilitiesScene.astro — Minimal amenity "orbit" scene (hover shows label).
---

<div id="scene-facilities" class="section-scene" data-active="false">
  <canvas id="scene-facilities-canvas" aria-hidden="true"></canvas>
  <div id="scene-facilities-label" class="scene-label" aria-live="polite"></div>
</div>

<script type="module">
  import { attachSectionActive, createRafLoop } from '../../../lib/three/sectionActive';
  import { cssVarColorInt } from '../../../lib/three/cssColor';

  const root = document.getElementById('scene-facilities');
  const canvas = document.getElementById('scene-facilities-canvas');
  const labelEl = document.getElementById('scene-facilities-label');
  if (!root || !canvas) throw new Error('[FacilitiesScene] root/canvas missing');

  const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches ?? false;

  let runtime = null;
  let runtimePromise = null;

  async function init() {
    const THREE = await import('three');

    const cWhite = cssVarColorInt('--white', 0xffffff);
    const cBlack = cssVarColorInt('--black', 0x1a1a1a);
    const cGreen = cssVarColorInt('--green', 0x00ab39);
    const cBlue = cssVarColorInt('--blue', 0x0071bc);
    const cRed = cssVarColorInt('--red', 0xed1c24);
    const cGold = cssVarColorInt('--gold', 0xeac102);

    let W = root.clientWidth;
    let H = root.clientHeight;

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(W, H);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, W / H, 0.1, 50);
    camera.position.set(0, 3.5, 9.5);
    camera.lookAt(0, 1.4, 0);

    scene.add(new THREE.AmbientLight(cWhite, 0.9));
    const sun = new THREE.DirectionalLight(cWhite, 1.0);
    sun.position.set(8, 9, 4);
    scene.add(sun);

    // Simple "ground".
    const ground = new THREE.Mesh(
      new THREE.CylinderGeometry(3.8, 4.6, 0.25, 28),
      new THREE.MeshStandardMaterial({ color: cGreen, roughness: 0.95, transparent: true, opacity: 0.18 })
    );
    ground.position.y = 0.15;
    scene.add(ground);

    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2(-9, -9);
    let hoveredName = '';

    const items = [];
    const defs = [
      { name: 'Beds', color: cGold, geo: () => new THREE.BoxGeometry(1.1, 0.35, 0.7) },
      { name: 'Showers', color: cBlue, geo: () => new THREE.CylinderGeometry(0.35, 0.35, 0.9, 10) },
      { name: 'Wi‑Fi', color: cGreen, geo: () => new THREE.TorusGeometry(0.55, 0.12, 10, 28, Math.PI * 1.35) },
      { name: 'Laundry', color: cRed, geo: () => new THREE.BoxGeometry(0.75, 0.75, 0.75) },
    ];

    for (let i = 0; i < defs.length; i++) {
      const d = defs[i];
      const g = new THREE.Group();
      const m = new THREE.Mesh(d.geo(), new THREE.MeshStandardMaterial({ color: d.color, roughness: 0.6 }));
      m.castShadow = false;
      g.add(m);

      // Outline (hand-drawn-ish) via second mesh.
      const outline = new THREE.Mesh(d.geo(), new THREE.MeshBasicMaterial({ color: cBlack, transparent: true, opacity: 0.10, wireframe: true }));
      outline.scale.setScalar(1.03);
      g.add(outline);

      g.userData.name = d.name;
      scene.add(g);
      items.push(g);
    }

    function positionItems(t) {
      const r = 3.0;
      for (let i = 0; i < items.length; i++) {
        const a = t * 0.45 + (i / items.length) * Math.PI * 2;
        const x = Math.cos(a) * r;
        const z = Math.sin(a) * r;
        const y = 1.3 + Math.sin(t * 0.8 + i) * 0.15;
        items[i].position.set(x, y, z);
        items[i].rotation.y = a + Math.PI * 0.5;
      }
    }

    const onMove = (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / Math.max(1, rect.width)) * 2 - 1;
      mouse.y = -(((e.clientY - rect.top) / Math.max(1, rect.height)) * 2 - 1);
      if (reducedMotion) renderFrame(0, performance.now());
    };
    canvas.addEventListener('mousemove', onMove);
    canvas.addEventListener('mouseleave', () => {
      mouse.set(-9, -9);
      hoveredName = '';
      if (labelEl) labelEl.textContent = '';
      canvas.style.cursor = 'default';
      if (reducedMotion) renderFrame(0, performance.now());
    });

    const clock = new THREE.Timer();

    function renderFrame(_dt, _t) {
      clock.update();
      const time = clock.getElapsed();
      positionItems(time);

      raycaster.setFromCamera(mouse, camera);
      const hits = raycaster.intersectObjects(items, true);
      const hit = hits.length ? hits[0].object.parent : null;
      const name = hit?.userData?.name ?? '';

      if (name !== hoveredName) {
        hoveredName = name;
        if (labelEl) labelEl.textContent = hoveredName ? hoveredName : '';
      }
      canvas.style.cursor = hoveredName ? 'pointer' : 'grab';

      for (const g of items) {
        const on = g.userData.name === hoveredName;
        g.scale.setScalar(on ? 1.12 : 1.0);
      }

      renderer.render(scene, camera);
    }

    const loop = createRafLoop(renderFrame);
    const ro = new ResizeObserver(() => {
      W = root.clientWidth;
      H = root.clientHeight;
      renderer.setSize(W, H);
      camera.aspect = Math.max(1e-6, W / Math.max(1, H));
      camera.updateProjectionMatrix();
      if (reducedMotion) renderFrame(0, performance.now());
    });
    ro.observe(root);

    renderFrame(0, performance.now());

    return {
      start() {
        if (reducedMotion) return;
        loop.start();
      },
      stop() {
        loop.stop();
      },
      destroy() {
        loop.stop();
        ro.disconnect();
        canvas.removeEventListener('mousemove', onMove);
        renderer.dispose();
      },
    };
  }

  async function ensureRuntime() {
    if (runtime) return runtime;
    runtimePromise ??= init();
    runtime = await runtimePromise;
    return runtime;
  }

  attachSectionActive(root, {
    auto: true,
    onChange(active) {
      if (active) ensureRuntime().then((r) => r.start());
      else runtime?.stop();
    },
  });
</script>

<style>
  .section-scene {
    position: relative;
    width: 100%;
    height: 18rem;
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(232, 245, 233, 1), rgba(255, 255, 255, 0.6));
  }
  .section-scene canvas {
    width: 100% !important;
    height: 100% !important;
  }
  .scene-label {
    position: absolute;
    left: 12px;
    bottom: 12px;
    background: rgba(26, 26, 26, 0.72);
    color: #fff;
    font-size: 0.75rem;
    padding: 6px 10px;
    border-radius: 10px;
    pointer-events: none;
    min-height: 1.2rem;
  }
  @media (min-width: 768px) {
    .section-scene { height: 22rem; }
  }
</style>

