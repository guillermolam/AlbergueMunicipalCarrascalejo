
FROM node:18-alpine

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

WORKDIR /app

# Install system dependencies, Rust, and wasm-pack in a single RUN statement
RUN apk add --no-cache \
    curl \
    git \
    postgresql-client && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
    . ~/.cargo/env && rustup target add wasm32-unknown-unknown && \
    curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh

# Copy package files
COPY package*.json ./
RUN npm ci

# Copy specific directories instead of everything
COPY --chown=nextjs:nodejs src/ ./src/
COPY --chown=nextjs:nodejs public/ ./public/
COPY --chown=nextjs:nodejs build-bff.sh ./

# Switch to non-root user
USER nextjs

# Build WASM modules
RUN . ~/.cargo/env && ./build-bff.sh

EXPOSE 5000

CMD ["npm", "run", "dev"]
