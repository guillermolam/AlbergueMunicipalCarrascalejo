---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Reservar Cama — Albergue Municipal de El Carrascalejo"
  showHeader={false}
  showFooter={false}
>
  <div class="wiz-wrap">

    <!-- ═══ DESKTOP SIDEBAR ═══ -->
    <aside class="wiz-sidebar" aria-label="Booking steps">
      <div class="sidebar-logo">
        <img src="/logos/logo.png" alt="Albergue Carrascalejo" class="s-logo"/>
        <h2 class="s-title">Albergue Carrascalejo</h2>
        <p class="s-sub">Camino de Santiago</p>
      </div>

      <!-- Dashed connector line -->
      <div class="step-track">
        <svg class="track-line" aria-hidden="true">
          <line x1="30" y1="40" x2="30" y2="100%" stroke="#D4A574" stroke-width="2.5" stroke-dasharray="6,6" opacity="0.4"/>
        </svg>

        <!-- Step buttons -->
        <button class="step-btn active" data-step="1" disabled>
          <div class="step-circle active" aria-hidden="true">
            <svg width="60" height="60" viewBox="0 0 60 60"><circle cx="30" cy="30" r="26" fill="#00AB39" stroke="#005a1e" stroke-width="3.5"/><circle cx="30" cy="30" r="22" fill="none" stroke="#005a1e" stroke-width="2" stroke-dasharray="4,4" opacity="0.3"/></svg>
            <span class="step-icon">📅</span>
          </div>
          <div class="step-info">
            <span class="step-num">Step 1</span>
            <p class="step-label active">Dates</p>
            <p class="step-sub">Check-in &amp; out</p>
          </div>
          <div class="step-dot active"></div>
        </button>

        <button class="step-btn" data-step="2" disabled>
          <div class="step-circle" aria-hidden="true">
            <svg width="60" height="60" viewBox="0 0 60 60"><circle cx="30" cy="30" r="26" fill="#FFF9F0" stroke="#D4A574" stroke-width="2.5"/></svg>
            <span class="step-icon inactive">⬆️</span>
          </div>
          <div class="step-info">
            <span class="step-num inactive">Step 2</span>
            <p class="step-label">ID Upload</p>
            <p class="step-sub">OCR scan</p>
          </div>
        </button>

        <button class="step-btn" data-step="3" disabled>
          <div class="step-circle" aria-hidden="true">
            <svg width="60" height="60" viewBox="0 0 60 60"><circle cx="30" cy="30" r="26" fill="#FFF9F0" stroke="#D4A574" stroke-width="2.5"/></svg>
            <span class="step-icon inactive">🧑</span>
          </div>
          <div class="step-info">
            <span class="step-num inactive">Step 3</span>
            <p class="step-label">Your Info</p>
            <p class="step-sub">Pilgrim details</p>
          </div>
        </button>

        <button class="step-btn" data-step="4" disabled>
          <div class="step-circle" aria-hidden="true">
            <svg width="60" height="60" viewBox="0 0 60 60"><circle cx="30" cy="30" r="26" fill="#FFF9F0" stroke="#D4A574" stroke-width="2.5"/></svg>
            <span class="step-icon inactive">🛏️</span>
          </div>
          <div class="step-info">
            <span class="step-num inactive">Step 4</span>
            <p class="step-label">Select Bed</p>
            <p class="step-sub">Dorm view</p>
          </div>
        </button>

        <button class="step-btn" data-step="5" disabled>
          <div class="step-circle" aria-hidden="true">
            <svg width="60" height="60" viewBox="0 0 60 60"><circle cx="30" cy="30" r="26" fill="#FFF9F0" stroke="#D4A574" stroke-width="2.5"/></svg>
            <span class="step-icon inactive">💳</span>
          </div>
          <div class="step-info">
            <span class="step-num inactive">Step 5</span>
            <p class="step-label">Payment</p>
            <p class="step-sub">Secure checkout</p>
          </div>
        </button>

        <button class="step-btn" data-step="6" disabled>
          <div class="step-circle" aria-hidden="true">
            <svg width="60" height="60" viewBox="0 0 60 60"><circle cx="30" cy="30" r="26" fill="#FFF9F0" stroke="#D4A574" stroke-width="2.5"/></svg>
            <span class="step-icon inactive">📋</span>
          </div>
          <div class="step-info">
            <span class="step-num inactive">Step 6</span>
            <p class="step-label">Summary</p>
            <p class="step-sub">Review booking</p>
          </div>
        </button>

        <button class="step-btn" data-step="7" disabled>
          <div class="step-circle" aria-hidden="true">
            <svg width="60" height="60" viewBox="0 0 60 60"><circle cx="30" cy="30" r="26" fill="#FFF9F0" stroke="#D4A574" stroke-width="2.5"/></svg>
            <span class="step-icon inactive">🏠</span>
          </div>
          <div class="step-info">
            <span class="step-num inactive">Step 7</span>
            <p class="step-label">Dashboard</p>
            <p class="step-sub">Your portal</p>
          </div>
        </button>
      </div>
    </aside>

    <!-- ═══ MAIN CONTENT ═══ -->
    <main class="wiz-main">

      <!-- Mobile top bar -->
      <div class="mobile-bar">
        <img src="/logos/logo.png" alt="logo" class="mb-logo"/>
        <div>
          <h2 class="mb-title">Albergue Carrascalejo</h2>
          <p class="mb-step" id="mobile-step-label">Step 1 of 7</p>
        </div>
      </div>

      <!-- Progress bar -->
      <div class="prog-wrap">
        <div class="prog-bar">
          <div class="prog-fill" id="prog-fill" style="width:14%"></div>
        </div>
        <div class="prog-labels">
          <span class="prog-text" id="prog-text">Step 1 of 7</span>
          <span class="prog-pct" id="prog-pct">14% Complete</span>
        </div>
      </div>

      <!-- ── STEP 1: DATES ── -->
      <div class="step-panel" id="step-1" data-step="1">
        <div class="step-header">
          <div class="step-header-icon">
            <svg width="48" height="48" viewBox="0 0 100 100" fill="none">
              <path d="M15,30 L15,85 C15,88 17,90 20,90 L80,90 C83,90 85,88 85,85 L85,30 Z" fill="#FFF9F0" stroke="#00AB39" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M15,18 C15,15 17,13 20,13 L80,13 C83,13 85,15 85,18 L85,30 L15,30 Z" fill="#00AB39" stroke="#00AB39" stroke-width="3"/>
              <circle cx="30" cy="18" r="4" fill="white" stroke="#006b24" stroke-width="2.5"/><circle cx="30" cy="18" r="2" fill="#006b24"/>
              <circle cx="70" cy="18" r="4" fill="white" stroke="#006b24" stroke-width="2.5"/><circle cx="70" cy="18" r="2" fill="#006b24"/>
            </svg>
          </div>
          <div>
            <h1 class="step-title">When are you visiting?</h1>
            <p class="step-desc">Select your check-in and check-out dates</p>
          </div>
          <div class="step-hint" aria-hidden="true">Select your stay dates</div>
        </div>

        <!-- Date summary bar -->
        <div class="date-summary" id="date-summary">
          <div class="date-chip" id="checkin-chip">
            <span class="chip-label">Check-in</span>
            <span class="chip-val" id="checkin-display">—</span>
          </div>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00AB39" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <div class="date-chip" id="checkout-chip">
            <span class="chip-label">Check-out</span>
            <span class="chip-val" id="checkout-display">—</span>
          </div>
          <div class="nights-chip" id="nights-chip" style="display:none">
            <span class="nights-icon">🌙</span>
            <span class="nights-val" id="nights-val">0</span>
          </div>
          <div class="price-chip" id="price-chip" style="display:none">
            <span class="price-chip-label">Total</span>
            <span class="price-chip-val" id="price-total">€0</span>
          </div>
          <div class="date-actions" id="date-actions" style="display:none">
            <span class="time-hint">✨ Check-in: 2:00 PM | Check-out: 10:00 AM</span>
            <button class="clear-btn" id="clear-dates">Clear</button>
          </div>
          <div class="price-breakdown" id="price-breakdown" style="display:none">
            <div class="price-breakdown-rows" id="price-rows"></div>
            <div class="price-breakdown-total" id="price-total-row"></div>
          </div>
        </div>

        <!-- Calendar container -->
        <div class="cal-wrap">
          <svg class="cal-border" aria-hidden="true" preserveAspectRatio="none">
            <rect x="4" y="4" width="calc(100% - 8px)" height="calc(100% - 8px)" fill="white" fill-opacity="0.95" stroke="#00AB39" stroke-width="3.5" rx="20"/>
            <rect x="8" y="8" width="calc(100% - 16px)" height="calc(100% - 16px)" fill="none" stroke="#00AB39" stroke-width="2" rx="18" opacity="0.3" stroke-dasharray="6,6"/>
          </svg>
          <div class="cal-inner">
            <div class="cal-nav">
              <button class="cal-nav-btn" id="prev-month" aria-label="Previous month">
                <svg class="nav-circle" viewBox="0 0 100 100"><circle cx="50" cy="50" r="45" fill="none" stroke="#00AB39" stroke-width="3" stroke-dasharray="2,3" opacity="0.3"/></svg>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>
              </button>
              <h3 class="cal-month-title" id="cal-month-title">April 2026</h3>
              <button class="cal-today-btn" id="today-btn" aria-label="Go to today">Today</button>
              <button class="cal-nav-btn" id="next-month" aria-label="Next month">
                <svg class="nav-circle" viewBox="0 0 100 100"><circle cx="50" cy="50" r="45" fill="none" stroke="#00AB39" stroke-width="3" stroke-dasharray="2,3" opacity="0.3"/></svg>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m9 18 6-6-6-6"/></svg>
              </button>
            </div>
            <div class="cal-dow-row">
              <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
            </div>
            <div class="cal-grid" id="cal-grid"></div>
          </div>
        </div>
      </div>

      <!-- ── STEP 2: ID UPLOAD ── -->
      <div class="step-panel hidden" id="step-2" data-step="2">
        <div class="step-header center">
          <div class="step-header-icon large">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#00AB39" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
          </div>
          <h1 class="step-title">Upload Your ID</h1>
          <p class="step-desc">We'll automatically extract your information</p>
          <svg class="squiggle-line" viewBox="0 0 200 12" preserveAspectRatio="none"><path d="M0,6 Q25,0 50,6 T100,6 T150,6 T200,6" fill="none" stroke="#00AB39" stroke-width="2.5" stroke-linecap="round"/></svg>
        </div>

        <!-- Phase 1: Doc type selection cards -->
        <div class="doc-cards" id="doc-cards-phase">
          <!-- DNI Card -->
          <button class="doc-card" id="doc-dni" data-doc="dni" type="button" aria-label="Select DNI / ID Card">
            <svg class="doc-card-bg" preserveAspectRatio="none" aria-hidden="true">
              <rect x="4" y="4" width="calc(100% - 8px)" height="calc(100% - 8px)" fill="white" stroke="#D4A574" stroke-width="3" rx="20"/>
            </svg>
            <div class="doc-card-inner">
              <div class="doc-illustration dni-illus">
                <svg viewBox="0 0 280 180" fill="none">
                  <rect x="10" y="10" width="260" height="160" rx="12" fill="#E8F5E9" stroke="#00AB39" stroke-width="3"/>
                  <rect x="10" y="10" width="260" height="160" rx="12" fill="none" stroke="#006b24" stroke-width="1.5" stroke-dasharray="4,4" opacity="0.4"/>
                  <text x="140" y="45" text-anchor="middle" font-family="Cabin Sketch,cursive" font-size="20" fill="#006b24">DNI</text>
                  <rect x="30" y="60" width="80" height="14" rx="3" fill="#ED1C24" opacity="0.7"/>
                  <rect x="30" y="82" width="60" height="10" rx="3" fill="#1A1A1A" opacity="0.2"/>
                  <rect x="30" y="100" width="70" height="10" rx="3" fill="#1A1A1A" opacity="0.2"/>
                  <rect x="28" y="130" width="40" height="34" rx="4" fill="#EAC102" opacity="0.8" stroke="#D4A574" stroke-width="1.5"/>
                  <rect x="165" y="55" width="85" height="100" rx="8" fill="#C8E6C9" stroke="#00AB39" stroke-width="2"/>
                  <circle cx="207" cy="90" r="22" fill="#A5D6A7"/>
                  <path d="M190,148 Q207,130 224,148" fill="#81C784"/>
                  <rect x="28" y="146" width="100" height="6" rx="2" fill="#1A1A1A" opacity="0.15"/>
                </svg>
              </div>
              <h3 class="doc-name">DNI / ID Card</h3>
              <p class="doc-desc">Spanish National ID Card</p>
              <p class="doc-req"><span class="req-dot green"></span> Requires front + back photos</p>
            </div>
          </button>

          <!-- Passport Card -->
          <button class="doc-card" id="doc-passport" data-doc="passport" type="button" aria-label="Select Passport">
            <svg class="doc-card-bg" preserveAspectRatio="none" aria-hidden="true">
              <rect x="4" y="4" width="calc(100% - 8px)" height="calc(100% - 8px)" fill="white" stroke="#D4A574" stroke-width="3" rx="20"/>
            </svg>
            <div class="doc-card-inner">
              <div class="doc-illustration pass-illus">
                <svg viewBox="0 0 280 180" fill="none">
                  <rect x="40" y="8" width="200" height="164" rx="10" fill="#DBEAFE" stroke="#3B82F6" stroke-width="2.5"/>
                  <rect x="40" y="8" width="200" height="164" rx="10" fill="none" stroke="#1D4ED8" stroke-width="1" stroke-dasharray="5,5" opacity="0.3"/>
                  <text x="140" y="40" text-anchor="middle" font-family="Cabin Sketch,cursive" font-size="14" fill="#1D4ED8" letter-spacing="3">PASSPORT</text>
                  <circle cx="140" cy="100" r="50" fill="none" stroke="#3B82F6" stroke-width="1.5" opacity="0.5"/>
                  <circle cx="140" cy="100" r="35" fill="none" stroke="#3B82F6" stroke-width="1.5" opacity="0.5"/>
                  <line x1="90" y1="100" x2="190" y2="100" stroke="#3B82F6" stroke-width="1.5" opacity="0.5"/>
                  <path d="M140,50 Q165,75 165,100 Q165,125 140,150 Q115,125 115,100 Q115,75 140,50Z" fill="none" stroke="#3B82F6" stroke-width="1.5" opacity="0.5"/>
                  <text x="140" y="170" text-anchor="middle" font-family="Patrick Hand,cursive" font-size="10" fill="#1D4ED8" opacity="0.6">ESPAÑA</text>
                </svg>
              </div>
              <h3 class="doc-name">Passport</h3>
              <p class="doc-desc">International Passport</p>
              <p class="doc-req"><span class="req-dot blue"></span> Requires photo page only</p>
            </div>
          </button>
        </div>

        <!-- Phase 2: Upload zone (replaces doc cards after selection) -->
        <div class="upload-phase" id="upload-phase" style="display:none">
          <!-- Selected doc type indicator -->
          <div class="selected-doc-bar" id="selected-doc-bar">
            <div class="selected-doc-info">
              <span class="selected-doc-icon" id="selected-doc-icon">🪪</span>
              <span class="selected-doc-label" id="selected-doc-label">DNI / ID Card</span>
            </div>
            <button type="button" class="change-doc-btn" id="change-doc-btn">Change ↺</button>
          </div>

          <!-- Upload drop zones -->
          <div class="upload-zone-inner" id="upload-zone-inner">
            <div class="upload-face" id="upload-front" role="button" tabindex="0">
              <svg class="upload-border" aria-hidden="true" preserveAspectRatio="none">
                <rect x="3" y="3" width="calc(100% - 6px)" height="calc(100% - 6px)" fill="white" stroke="#00AB39" stroke-width="2.5" rx="16" stroke-dasharray="8,5"/>
              </svg>
              <div class="upload-content" id="upload-front-content">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#00AB39" stroke-width="1.5" stroke-linecap="round" class="upload-cam-icon"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="12" cy="12" r="3.5"/><path d="M3 5l2-2h4l2 2"/></svg>
                <p class="upload-label">Front of <span id="upload-face-label">ID</span></p>
                <p class="upload-hint">Click or drag image to upload</p>
                <p class="upload-formats">JPG, PNG or PDF (max 10MB)</p>
              </div>
              <input type="file" accept="image/*,.pdf" class="upload-input" id="upload-front-input"/>
            </div>
            <div class="upload-face" id="upload-back" role="button" tabindex="0">
              <svg class="upload-border" aria-hidden="true" preserveAspectRatio="none">
                <rect x="3" y="3" width="calc(100% - 6px)" height="calc(100% - 6px)" fill="white" stroke="#D4A574" stroke-width="2.5" rx="16" stroke-dasharray="8,5"/>
              </svg>
              <div class="upload-content" id="upload-back-content">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#D4A574" stroke-width="1.5" stroke-linecap="round" class="upload-cam-icon"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="12" cy="12" r="3.5"/><path d="M3 5l2-2h4l2 2"/></svg>
                <p class="upload-label">Back of ID</p>
                <p class="upload-hint">Click or drag image to upload</p>
                <p class="upload-formats">JPG, PNG or PDF (max 10MB)</p>
              </div>
              <input type="file" accept="image/*,.pdf" class="upload-input" id="upload-back-input"/>
            </div>
          </div>

          <!-- Uploaded file state (replaces drop zone content after upload) -->
          <div class="upload-complete" id="upload-complete" style="display:none">
            <div class="uploaded-file-row">
              <div class="uploaded-file-check">
                <svg viewBox="0 0 24 24" width="24" height="24"><path d="M 5 13 Q 7 15 9 16 Q 11 14 18 6" stroke="#00AB39" stroke-width="2.5" stroke-linecap="round" fill="none" class="check-draw"/></svg>
              </div>
              <span class="uploaded-file-name" id="uploaded-file-name">document.jpg</span>
              <button type="button" class="uploaded-file-remove" id="uploaded-file-remove" aria-label="Remove file">×</button>
            </div>
          </div>

          <!-- OCR extraction simulation -->
          <div class="ocr-result" id="ocr-result" style="display:none">
            <div class="ocr-header">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00AB39" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
              <span>OCR Data Extracted</span>
            </div>
            <div class="ocr-fields">
              <div class="ocr-field"><span class="ocr-label">Name</span><span class="ocr-value">MARÍA GARCÍA</span></div>
              <div class="ocr-field"><span class="ocr-label">Document #</span><span class="ocr-value">51503381X</span></div>
              <div class="ocr-field"><span class="ocr-label">Birth Date</span><span class="ocr-value">1990-05-15</span></div>
              <div class="ocr-field"><span class="ocr-label">Nationality</span><span class="ocr-value">ESP</span></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ── STEP 3: PILGRIM INFO ── -->
      <div class="step-panel hidden" id="step-3" data-step="3">
        <div class="step-header center">
          <div class="step-header-icon large">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#00AB39" stroke-width="2" stroke-linecap="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h1 class="step-title">Pilgrim Information</h1>
          <p class="step-desc">Complete your details below</p>
          <div class="wave-line" aria-hidden="true">
            <svg viewBox="0 0 200 12" preserveAspectRatio="none"><path d="M0,6 Q25,0 50,6 T100,6 T150,6 T200,6" fill="none" stroke="#00AB39" stroke-width="2.5" stroke-linecap="round"/></svg>
          </div>
        </div>

        <div class="info-card">
          <svg class="info-card-border" preserveAspectRatio="none" aria-hidden="true">
            <rect x="4" y="6" width="calc(100% - 8px)" height="calc(100% - 10px)" rx="14" fill="rgba(0,0,0,0.05)" filter="blur(5px)"/>
            <rect x="0" y="0" width="100%" height="100%" rx="16" fill="white" stroke="#D4A574" stroke-width="2.5"/>
            <rect x="5" y="5" width="calc(100% - 10px)" height="calc(100% - 10px)" rx="14" fill="none" stroke="#D4A574" stroke-width="1" opacity="0.3"/>
          </svg>
          <div class="info-card-inner">

            <!-- Personal Details -->
            <div class="info-section">
              <h3 class="info-section-title"><span>🧍</span> Personal Details</h3>
              <div class="form-row-3">
                <div class="fg">
                  <label class="fl">First Name <span class="req">*</span></label>
                  <input type="text" id="f-first" name="firstName" class="fi" placeholder="María" required/>
                  <span class="ferr">Required</span>
                </div>
                <div class="fg">
                  <label class="fl">Last Name <span class="req">*</span></label>
                  <input type="text" id="f-last" name="lastName" class="fi" placeholder="García" required/>
                  <span class="ferr">Required</span>
                </div>
                <div class="fg">
                  <label class="fl">Second Last Name</label>
                  <input type="text" id="f-last2" name="lastName2" class="fi" placeholder="López"/>
                </div>
              </div>
              <div class="form-row-2">
                <div class="fg">
                  <label class="fl">Date of Birth <span class="req">*</span></label>
                  <input type="date" id="f-dob" name="dob" class="fi" required/>
                  <span class="ferr">Required</span>
                </div>
                <div class="fg" style="position:relative">
                  <label class="fl">Nationality <span class="req">*</span></label>
                  <div class="country-pick-wrap" id="nat-pick-wrap">
                    <span class="country-pick-flag" id="f-nat-flag">🌍</span>
                    <input type="text" id="f-nat" name="nationality" class="fi country-pick-input"
                      placeholder="Spain" autocomplete="off" role="combobox" aria-autocomplete="list"
                      aria-haspopup="listbox" aria-expanded="false" aria-controls="nat-drop" required/>
                  </div>
                  <input type="hidden" id="f-nat-code" name="nationalityCode"/>
                  <ul id="nat-drop" class="country-drop" role="listbox"></ul>
                  <span class="ferr">Required</span>
                </div>
              </div>
            </div>

            <div class="section-divider"></div>

