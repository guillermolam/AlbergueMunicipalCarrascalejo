{
  "name": "albergue-carrascalejo-frontend",
  "type": "module",
  "version": "1.0.0",
  "description": "Static Astro frontend for Albergue Municipal Carrascalejo - Camino de Santiago (plain CSS, RoughJS, IBM Plex)",
  "keywords": [
    "astro",
    "camino-santiago",
    "albergue",
    "static-site",
    "plain-css",
    "roughjs",
    "ibm-plex"
  ],
  "author": "Albergue Municipal Carrascalejo",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro build",
    "preview": "wrangler types && astro preview",
    "clean": "rimraf dist .astro node_modules/.cache",
    "astro-check": "astro check",
    "format": "prettier --write .",
    "lint": "tsc -p tsconfig.typecheck.json --noEmit",
    "type-check": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@nanostores/persistent": "^1.3.3",
    "@supabase/supabase-js": "^2.101.1",
    "alpinejs": "^3.15.11",
    "astro": "^6.1.3",
    "clsx": "^2.1.1",
    "jwt-decode": "^4.0.0",
    "nanostores": "^1.2.0",
    "redis": "^5.11.0",
    "roughjs": "^4.6.6",
    "solid-js": "^1.9.12",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/cloudflare": "^13.1.7",
    "@types/alpinejs": "^3.13.11",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "wrangler": "^4.80.0"
  },
  "packageManager": "pnpm@10.29.3"
}
