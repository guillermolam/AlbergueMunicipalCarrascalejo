---
// WizardNav.astro — bottom navigation buttons (Back / Continue) for the booking wizard
---

<div class="wiz-nav" id="wiz-nav">
  <button class="btn-back" id="btn-back" style="display:none">
    <svg style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none" aria-hidden="true">
      <rect x="0" y="0" width="100%" height="100%" rx="12" fill="white" stroke="#00AB39" stroke-width="2.5" filter="url(#sketchy-filter-book)"></rect>
    </svg>
    <span class="nav-btn-label back-label">← Back</span>
  </button>
  <button class="btn-next" id="btn-next" disabled>
    <svg style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none" aria-hidden="true">
      <rect x="0" y="0" width="100%" height="100%" rx="12" fill="#00AB39" stroke="#1A1A1A" stroke-width="2.5" filter="url(#sketchy-filter-book)"></rect>
    </svg>
    <span class="nav-btn-label">Continue →</span>
  </button>
</div>
