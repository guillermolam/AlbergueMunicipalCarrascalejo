    // ── Night Tabs ──
    // Shows stay dates. When some nights are unassigned (partial bed), tabs become interactive
    // so user can select which night to assign a different bed to.
    function renderNightTabs() {
      const wrap = document.getElementById('night-tabs-wrap')!;
      const tabs = document.getElementById('night-tabs')!;
      if (!state.nights || state.nights < 1) {
        wrap.style.display = 'none';
        return;
      }
      wrap.style.display = '';
      clearEl(tabs);
      const ciDate = state.checkin ? new Date(state.checkin + 'T12:00:00') : new Date();
      const allAssigned = bedSchedule.every((b) => b !== null && b !== undefined);
      const hasUnassigned = bedSchedule.some((b) => b === null || b === undefined);
      // Update label based on state
      const label = wrap.querySelector('.night-tabs-label') as HTMLElement;
      if (label) {
        label.textContent = allAssigned
          ? 'Your stay:'
          : hasUnassigned
            ? 'Select bed for highlighted night:'
            : 'Your stay:';
      }
      for (let i = 0; i < state.nights; i++) {
        const d = new Date(ciDate);
        d.setDate(d.getDate() + i);
        const dateLabel = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        const isAssigned = bedSchedule[i] !== null && bedSchedule[i] !== undefined;
        const isActive = i === activeNight && hasUnassigned;
        const tab = document.createElement(hasUnassigned ? 'button' : 'span');
        if (hasUnassigned) (tab as HTMLButtonElement).type = 'button';
        tab.className = `night-tab${isActive ? ' active' : ''}${isAssigned ? ' assigned' : ''}`;
        const dotColor = isAssigned ? '#0071BC' : '#bbb';
        tab.appendChild(document.createTextNode(`N${i + 1} `));
        const dateLabelSpan = document.createElement('span');
        dateLabelSpan.style.fontSize = '0.7rem';
        dateLabelSpan.style.opacity = '0.7';
        dateLabelSpan.textContent = dateLabel;
        tab.appendChild(dateLabelSpan);
        if (isAssigned) {
          const dot = document.createElement('span');
          dot.className = 'night-tab-dot';
          dot.style.background = isActive ? 'white' : dotColor;
          tab.appendChild(dot);
        }
        if (hasUnassigned) {
          tab.addEventListener('click', () => {
            activeNight = i;
            renderBedGrid();
            renderNightTabs();
            renderSchedule();
          });
        }
        tabs.appendChild(tab);
      }
    }

    // ── Schedule Summary ──
    function renderSchedule() {
      const wrap = document.getElementById('bed-schedule')!;
      const rows = document.getElementById('bed-schedule-rows')!;
      const anyAssigned = bedSchedule.some((b) => b !== null && b !== undefined);
      wrap.style.display = anyAssigned ? '' : 'none';
      if (!anyAssigned) return;
      clearEl(rows);

      const unique = [...new Set(bedSchedule.filter((b) => b !== null && b !== undefined))];
      const allAssigned = bedSchedule.every((b) => b !== null && b !== undefined);
      const ciDate = state.checkin ? new Date(state.checkin + 'T12:00:00') : new Date();

      if (allAssigned && unique.length === 1) {
        // Single bed for all nights — show compact summary
        const bed = unique[0]!;
        const isTop = bed % 2 !== 0;
        const bunk = Math.ceil(bed / 2);
        const row = document.createElement('div');
        row.className = 'sched-row';
        const n1 = document.createElement('span');
        n1.className = 'sched-night';
        n1.textContent = `All ${state.nights} nights`;
        row.appendChild(n1);
        const b1 = document.createElement('span');
        b1.className = 'sched-bed';
        b1.textContent = `Bed ${bed} · ${isTop ? 'Top' : 'Bottom'} · Bunk ${bunk}`;
        row.appendChild(b1);
        const rb1 = document.createElement('button');
        rb1.className = 'sched-remove';
        rb1.dataset.night = 'all';
        rb1.setAttribute('aria-label', 'Remove');
        rb1.textContent = '×';
        row.appendChild(rb1);
        rows.appendChild(row);
      } else {
        // Per-night breakdown (partial/multi-bed scenario)
        for (let i = 0; i < state.nights; i++) {
          const d = new Date(ciDate);
          d.setDate(d.getDate() + i);
          const label = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
          const bed = bedSchedule[i];
          const row = document.createElement('div');
          row.className = 'sched-row';
          if (bed !== null && bed !== undefined) {
            const isTop = bed % 2 !== 0;
            const bunk = Math.ceil(bed / 2);
            const n2 = document.createElement('span');
            n2.className = 'sched-night';
            n2.textContent = `N${i + 1} ${label}`;
            row.appendChild(n2);
            const b2 = document.createElement('span');
            b2.className = 'sched-bed';
            b2.textContent = `Bed ${bed} · ${isTop ? 'Top' : 'Bottom'} · Bunk ${bunk}`;
            row.appendChild(b2);
            const rb2 = document.createElement('button');
            rb2.className = 'sched-remove';
            rb2.dataset.night = String(i);
            rb2.setAttribute('aria-label', 'Remove');
            rb2.textContent = '×';
            row.appendChild(rb2);
          } else {
            const n3 = document.createElement('span');
            n3.className = 'sched-night unassigned';
            n3.textContent = `N${i + 1} ${label}`;
            row.appendChild(n3);
            const e3 = document.createElement('span');
            e3.className = 'sched-empty';
            e3.textContent = 'Tap a bed to assign';
            row.appendChild(e3);
          }
          rows.appendChild(row);
        }
      }
      // Wire remove buttons
      rows.querySelectorAll('.sched-remove').forEach((btn) => {
        btn.addEventListener('click', () => {
          const nightVal = (btn as HTMLElement).dataset.night!;
          if (nightVal === 'all') {
            // Clear entire selection
            for (let i = 0; i < bedSchedule.length; i++) bedSchedule[i] = null;
            activeNight = 0;
          } else {
            const ni = parseInt(nightVal);
            bedSchedule[ni] = null;
            activeNight = ni;
          }
          renderPersonTabs();
          renderBedGrid();
          renderNightTabs();
          renderSchedule();
          updateBedState();
        });
      });
    }

    // ── Tooltip ──
    function showTooltip(bed: number, e: MouseEvent) {
      const avail = availMap[bed] || [];
      const isTop = bed % 2 !== 0;
      const bunk = Math.ceil(bed / 2);
      const overall = bedOverallStatus(bed);

      ttTitle.textContent = `Bed ${bed} — ${isTop ? 'Top' : 'Bottom'} Bunk #${bunk}`;

      const statusColors: Record<string, string> = {
        available: '#A5D6A7',
        partial: '#FFD54F',
        occupied: '#EF9A9A',
        selected: '#90CAF9',
      };
      const statusLabels: Record<string, string> = {
        available: 'Fully Available',
        partial: 'Partially Available',
        occupied: 'Fully Occupied',
        selected: 'Selected',
      };
      clearEl(ttStatus);
      const ttDot = document.createElement('span');
      ttDot.className = 'tt-dot';
      ttDot.style.background = statusColors[overall];
      ttStatus.appendChild(ttDot);
      ttStatus.appendChild(document.createTextNode(statusLabels[overall]));

      const ciDate = state.checkin ? new Date(state.checkin + 'T12:00:00') : new Date();
      clearEl(ttNights);
      for (let i = 0; i < avail.length; i++) {
        const d = new Date(ciDate);
        d.setDate(d.getDate() + i);
        const label = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        const isAvail = avail[i];
        const isSelected = bedSchedule[i] === bed;
        const cls = isSelected ? 'selected' : isAvail ? 'avail' : 'unavail';
        const val = isSelected ? '✓ Assigned' : isAvail ? 'Available' : 'Occupied';
        const nr = document.createElement('div');
        nr.className = 'tt-night-row';
        const nl = document.createElement('span');
        nl.className = 'tt-night-label';
        nl.textContent = `N${i + 1} ${label}`;
        const nv = document.createElement('span');
        nv.className = `tt-night-val ${cls}`;
        nv.textContent = val;
        nr.appendChild(nl);
        nr.appendChild(nv);
        ttNights.appendChild(nr);
      }

      tooltipEl.style.display = '';
      const rect = (e.target as Element).closest('.bunk-zone')?.getBoundingClientRect();
      if (rect) {
        const x = rect.left + rect.width / 2;
        const y = rect.top - 10;
        tooltipEl.style.left = Math.max(10, Math.min(x - 90, window.innerWidth - 200)) + 'px';
        tooltipEl.style.top = y - tooltipEl.offsetHeight + 'px';
      }
    }

    function hideTooltip() {
      tooltipEl.style.display = 'none';
    }

    // ── Render Grid ──
    function renderBedGrid() {
      // availMap is set before renderBedGrid() is called (by initBedSelection / loadBedAvailability)
      const grid1 = document.getElementById('dorm1-grid')!;
      const grid2 = document.getElementById('dorm2-grid')!;
      clearEl(grid1);
      clearEl(grid2);

      for (let bunk = 1; bunk <= 12; bunk++) {
        const topBed = (bunk - 1) * 2 + 1;
        const bottomBed = (bunk - 1) * 2 + 2;
        const topSt = bedOverallStatus(topBed);
        const botSt = bedOverallStatus(bottomBed);

        const cell = document.createElement('div');
        cell.className = 'bunk-cell';
        cell.appendChild(parseSVG(createBunkSVG(bunk, topBed, bottomBed, topSt, botSt)));
        const bunkLbl = document.createElement('div');
        bunkLbl.className = 'bunk-label';
        bunkLbl.textContent = `Bunk ${bunk}`;
        cell.appendChild(bunkLbl);

        if (bunk <= 6) grid1.appendChild(cell);
        else grid2.appendChild(cell);
      }

      // Wire click + hover on bunk zones
      // 1 person per reservation:
      // - Fully available bed → autofill ALL nights
      // - Partially available bed → autofill available nights, leave unavailable nights for per-night selection
      // - Occupied bed → not clickable
      document.querySelectorAll('.bunk-zone').forEach((zone) => {
        const bedNum = parseInt(zone.getAttribute('data-bed') ?? '');
        const avail = availMap[bedNum] || [];
        const isOccupiedAll = avail.every((a) => !a);
        const isSelected = bedSchedule.some((b) => b === bedNum);
        const hasAnyAvail = avail.some(Boolean);

        if (hasAnyAvail || isSelected) {
          zone.setAttribute('style', 'cursor:pointer');
          zone.addEventListener('click', (e) => {
            e.stopPropagation();
            if (isSelected) {
              // Deselect: clear nights assigned to this bed
              for (let i = 0; i < bedSchedule.length; i++) {
                if (bedSchedule[i] === bedNum) bedSchedule[i] = null;
              }
              // Set active night to the first now-unassigned night
              const firstEmpty = bedSchedule.findIndex((b) => b === null || b === undefined);
              if (firstEmpty >= 0) activeNight = firstEmpty;
            } else {
              // Assign this bed to all available nights it covers
              // First, clear any previous full selection (so user can switch beds)
              const prevBed = bedSchedule[0];
              const allSameBed = bedSchedule.every((b) => b === prevBed);
              if (allSameBed && prevBed !== null) {
                // User is switching beds — clear all first
                for (let i = 0; i < bedSchedule.length; i++) bedSchedule[i] = null;
              }
              // Autofill this bed for all its available nights
              for (let i = 0; i < bedSchedule.length; i++) {
                if (avail[i] && (bedSchedule[i] === null || bedSchedule[i] === undefined)) {
                  bedSchedule[i] = bedNum;
                }
              }
              // Set active night to first remaining unassigned night (if any)
              const firstEmpty = bedSchedule.findIndex((b) => b === null || b === undefined);
              if (firstEmpty >= 0) activeNight = firstEmpty;
            }
            renderPersonTabs();
            renderBedGrid();
            renderNightTabs();
            renderSchedule();
            updateBedState();
          });
        } else if (isOccupiedAll) {
          zone.setAttribute('style', 'cursor:not-allowed');
        }

        // Tooltip hover
        zone.addEventListener('mouseenter', (e) => showTooltip(bedNum, e as MouseEvent));
        zone.addEventListener('mousemove', (e) => showTooltip(bedNum, e as MouseEvent));
        zone.addEventListener('mouseleave', hideTooltip);
      });
    }

    function updateBedState() {
      // All persons must have all nights assigned
      const allPersonsDone =
        personBedSchedules.length > 0 &&
        personBedSchedules.every(
          (sched) => sched.length > 0 && sched.every((b) => b !== null && b !== undefined)
        );
      const allAssigned =
        bedSchedule.length > 0 && bedSchedule.every((b) => b !== null && b !== undefined);
      const unique = [...new Set(bedSchedule.filter((b) => b !== null && b !== undefined))];
      // Set state.bed for the booking (comma-separated per-person summaries)
      if (allPersonsDone) {
        const parts = personBedSchedules.map((sched, pi) => {
          const u = [...new Set(sched.filter((b) => b !== null && b !== undefined))];
          return u.length === 1
            ? `P${pi + 1}:${u[0]}`
            : sched.map((b, i) => `P${pi + 1}N${i + 1}:${b}`).join(',');
        });
        state.bed = parts.join('|');
      } else {
        state.bed = null;
      }
      enableNext(allPersonsDone);

      // Update info card & ready
      const infoCard = document.getElementById('bed-info-card')!;
      const bedReady = document.getElementById('bed-ready')!;
      const hint = document.getElementById('bed-hint')!;
      const assigned = bedSchedule.filter((b) => b !== null && b !== undefined).length;

      const personLabel = state.persons > 1 ? ` (Pilgrim ${activePerson + 1})` : '';
      if (allPersonsDone) {
        infoCard.style.display = '';
        bedReady.style.display = '';
        if (state.persons > 1) {
          const bedNums = personBedSchedules
            .map((s, i) => {
              const u = [...new Set(s.filter((b) => b !== null && b !== undefined))];
              return `P${i + 1}: Bed${u.length > 1 ? 's' : ''} ${u.join('/')}`;
            })
            .join(' · ');
          hint.textContent = `✨ All ${state.persons} pilgrims assigned! ${bedNums}`;
          (document.getElementById('bed-info-num') as HTMLElement).textContent =
            `${state.persons} pilgrims`;
          (document.getElementById('bed-info-pos') as HTMLElement).textContent = 'All assigned';
          (document.getElementById('bed-info-bunk') as HTMLElement).textContent =
            `${state.nights} night${state.nights > 1 ? 's' : ''}`;
          (document.getElementById('bed-info-dorm') as HTMLElement).textContent = '📋 All dorms';
        } else if (unique.length === 1) {
          const bed = unique[0]!;
          const isTop = bed % 2 !== 0;
          const bunk = Math.ceil(bed / 2);
          (document.getElementById('bed-info-num') as HTMLElement).textContent = `Bed #${bed}`;
          (document.getElementById('bed-info-pos') as HTMLElement).textContent = isTop
            ? 'Top Bunk'
            : 'Bottom Bunk';
          (document.getElementById('bed-info-bunk') as HTMLElement).textContent = `Bunk #${bunk}`;
          (document.getElementById('bed-info-dorm') as HTMLElement).textContent =
            `🏠 Dormitory ${bed <= 12 ? 1 : 2}`;
          hint.textContent = `✨ Bed ${bed} assigned for all ${state.nights} nights!`;
        } else {
          (document.getElementById('bed-info-num') as HTMLElement).textContent =
            `${unique.length} beds`;
          (document.getElementById('bed-info-pos') as HTMLElement).textContent =
            'Split across nights';
          (document.getElementById('bed-info-bunk') as HTMLElement).textContent =
            `${state.nights} nights covered`;
          (document.getElementById('bed-info-dorm') as HTMLElement).textContent =
            '📋 See schedule above';
          hint.textContent = `✨ All ${state.nights} nights assigned!`;
        }
        hint.style.color = '#00AB39';
      } else if (assigned > 0) {
        const remaining = state.nights - assigned;
        hint.textContent = `${personLabel} ${assigned}/${state.nights} nights assigned — select a bed for ${remaining} more night${remaining > 1 ? 's' : ''}`;
        hint.style.color = '#D4A017';
        bedReady.style.display = 'none';
        infoCard.style.display = 'none';
      } else {
        hint.textContent =
          state.persons > 1
            ? `Select a bed for Pilgrim ${activePerson + 1}`
            : 'Select a bed for your stay';
        hint.style.color = '#D4A017';
        bedReady.style.display = 'none';
        infoCard.style.display = 'none';
      }
    }

    // Render person tabs (shown when persons > 1)
    function renderPersonTabs() {
      const wrap = document.getElementById('person-tabs-wrap')!;
      const tabs = document.getElementById('person-tabs')!;
      if (state.persons <= 1) {
        wrap.style.display = 'none';
        return;
      }
      wrap.style.display = '';
      clearEl(tabs);
      for (let p = 0; p < state.persons; p++) {
        const sched = personBedSchedules[p] ?? [];
        const done = sched.length > 0 && sched.every((b) => b !== null && b !== undefined);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `person-tab${p === activePerson ? ' active' : ''}${done ? ' done' : ''}`;
        btn.textContent = `Pilgrim ${p + 1}`;
        btn.addEventListener('click', () => {
          activePerson = p;
          bedSchedule = personBedSchedules[activePerson];
          activeNight = bedSchedule.findIndex((b) => b === null || b === undefined);
          if (activeNight < 0) activeNight = 0;
          renderPersonTabs();
          renderNightTabs();
          renderBedGrid();
          renderSchedule();
          updateBedState();
        });
        tabs.appendChild(btn);
      }
    }

    // Initialize bed system when entering step 4
    function initBedSelection() {
      const n = state.nights || 1;
      const p = state.persons || 1;
      // Re-init per-person schedules
      personBedSchedules = Array.from({ length: p }, () => new Array(n).fill(null));
      activePerson = 0;
      bedSchedule = personBedSchedules[0];
      activeNight = 0;
      availMap = getAvailabilityMapFallback(); // render immediately with fallback
      renderPersonTabs();
      renderNightTabs();
      renderBedGrid();
      renderSchedule();
      updateBedState();
      loadBedAvailability(); // async: refines with real data when ready
    }

    initBedSelection();

    // ── CARD NUMBER FORMATTER ──
    document.getElementById('f-card')?.addEventListener('input', function () {
      const el = this as HTMLInputElement;
      let v = el.value.replace(/\D/g, '');
      el.value = v
        .replace(/(.{4})/g, '$1 ')
        .trim()
        .substring(0, 19);
    });
    document.getElementById('f-expiry')?.addEventListener('input', function () {
      const el = this as HTMLInputElement;
      let v = el.value.replace(/\D/g, '');
      if (v.length >= 3) el.value = v.substring(0, 2) + '/' + v.substring(2, 4);
      else el.value = v;
    });

    // ── STEP 3 VALIDATION ──
    function validateStep3(): boolean {
      // Save the current person's state first
      saveStep3State();

      const required = ['f-first', 'f-last', 'f-email', 'f-zip', 'f-city'];

      // Validate current person's DOM fields (show inline errors)
      let currentOk = true;
      required.forEach((id) => {
        const el = document.getElementById(id) as HTMLInputElement;
        if (!el) return;
        const fg = el.closest('.fg')!;
        if (!el.value.trim()) {
          fg.classList.add('has-error');
          el.classList.add('invalid');
          currentOk = false;
          el.addEventListener(
            'input',
            () => {
              fg.classList.remove('has-error');
              el.classList.remove('invalid');
            },
            { once: true }
          );
        }
      });
      const email = document.getElementById('f-email') as HTMLInputElement;
      if (email?.value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
        const fg = email.closest('.fg')!;
        fg.classList.add('has-error');
        email.classList.add('invalid');
        currentOk = false;
      }
      if (!currentOk) return false;

      // Check all other persons' saved data
      if (state.persons > 1) {
        const firstIncomplete = personFormData.findIndex((data, i) => {
          if (i === activePersonStep3) return false; // already validated above
          return !required.every((id) => data[id]?.trim());
        });
        if (firstIncomplete !== -1) {
          // Switch to the first incomplete person so the user can fill it in
          activePersonStep3 = firstIncomplete;
          loadStep3State();
          renderStep3Nav();
          // Show errors for that person
          required.forEach((id) => {
            const el = document.getElementById(id) as HTMLInputElement;
            if (!el) return;
            const fg = el.closest('.fg')!;
            if (!el.value.trim()) {
              fg.classList.add('has-error');
              el.classList.add('invalid');
              el.addEventListener(
                'input',
                () => {
                  fg.classList.remove('has-error');
                  el.classList.remove('invalid');
                },
                { once: true }
              );
            }
          });
          return false;
        }
      }

      return true;
    }

    // ── SUMMARY POPULATE ──
    function populateSummary() {
      const fmt = (d: string) =>
        new Date(d + 'T12:00:00').toLocaleDateString('en-US', {
          month: 'short',
          day: 'numeric',
          year: 'numeric',
        });
      const ciStr = state.checkin ? fmt(state.checkin) : '—';
      const coStr = state.checkout ? fmt(state.checkout) : '—';
      (document.getElementById('sum-dates') as HTMLElement).textContent = `${ciStr} → ${coStr}`;
      (document.getElementById('sum-nights') as HTMLElement).textContent = String(state.nights);
      (document.getElementById('sum-persons') as HTMLElement).textContent = String(state.persons);
      (document.getElementById('sum-bed') as HTMLElement).textContent = state.bed ?? '—';
      // Use saved personFormData for P1 (user may have navigated away from step 3)
      const p0 = personFormData[0] ?? {};
      const firstName =
        p0['f-first'] || (document.getElementById('f-first') as HTMLInputElement)?.value || '—';
      const lastName =
        p0['f-last'] || (document.getElementById('f-last') as HTMLInputElement)?.value || '';
      const pilgrimLabel =
        state.persons > 1
          ? `${firstName} ${lastName}`.trim() + ` + ${state.persons - 1} more`
          : `${firstName} ${lastName}`.trim();
      (document.getElementById('sum-pilgrim') as HTMLElement).textContent = pilgrimLabel;
      (document.getElementById('sum-doc') as HTMLElement).textContent =
        state.docType === 'dni'
          ? 'DNI / NIE / EU ID Card'
          : state.docType === 'passport'
            ? 'Passport'
            : '—';
      const total = state.totalPrice > 0 ? state.totalPrice : state.nights * state.pricePerNight;
      (document.getElementById('sum-total') as HTMLElement).textContent = `EUR ${total}`;
      (document.getElementById('pay-total') as HTMLElement).textContent = `EUR ${total}`;
    }

    // ── NAVIGATION ──
    btnNext.addEventListener('click', function () {
      if (state.step === 3 && !validateStep3()) return;
      if (state.step === 6) {
        submitBooking();
        return;
      }
      rippleEffect(this as HTMLElement);
      if (state.step === 5) populateSummary();
      goToStep(state.step + 1, 'forward');
    });

    btnBack.addEventListener('click', function () {
      rippleEffect(this as HTMLElement);
      goToStep(state.step - 1, 'back');
    });

    function rippleEffect(el: HTMLElement) {
      const rect = el.getBoundingClientRect();
      const r = document.createElement('span');
      r.className = 'ripple-wave';
      const size = Math.max(rect.width, rect.height);
      r.style.cssText = `width:${size}px;height:${size}px;left:${rect.width / 2 - size / 2}px;top:${rect.height / 2 - size / 2}px`;
      el.appendChild(r);
      setTimeout(() => r.remove(), 650);
    }

    // ── SUBMIT ──
    async function submitBooking() {
      populateSummary();
      btnNext.disabled = true;
      const originalLabel = btnNext.textContent;
      btnNext.textContent = 'Confirmando…';

      const p0data = personFormData[0] ?? {};
      const firstName =
        p0data['f-first']?.trim() ||
        (document.getElementById('f-first') as HTMLInputElement)?.value.trim() ||
        '';
      const lastName =
        p0data['f-last']?.trim() ||
        (document.getElementById('f-last') as HTMLInputElement)?.value.trim() ||
        '';
      const email =
        p0data['f-email']?.trim() ||
        (document.getElementById('f-email') as HTMLInputElement)?.value.trim() ||
        '';
      const total = state.totalPrice > 0 ? state.totalPrice : state.nights * state.pricePerNight;

      function buildRedirectParams(confCode: string, bookingRef: string) {
        return new URLSearchParams({
          conf: confCode,
          ref: bookingRef,
          name: `${firstName} ${lastName}`.trim() || 'Peregrino',
          checkin: state.checkin ?? '',
          checkout: state.checkout ?? '',
          nights: String(state.nights),
          total: String(total),
          bed: state.bed ?? '',
          persons: String(state.persons),
          email,
        });
      }

      try {
        const pilgrimsNote = personFormData
          .map((data, i) => {
            const first = (data['f-first'] || '').trim();
            const last = (data['f-last'] || '').trim();
            return first ? `P${i + 1}: ${first} ${last}`.trim() : `P${i + 1}: —`;
          })
          .join(', ');

        const result = await callAction<{ booking: unknown; confirmationCode: string }>(
          'booking.create',
          {
            checkIn: state.checkin!,
            checkOut: state.checkout!,
            persons: state.persons,
            notes: [
              state.bed ? `Cama: ${state.bed}` : '',
              state.docType ? `Doc: ${state.docType.toUpperCase()}` : '',
              pilgrimsNote ? `Peregrinos: ${pilgrimsNote}` : '',
            ]
              .filter(Boolean)
              .join('. '),
          }
        );

        const data = result.data ?? (result as any);
        const confCode =
          (data as any).confirmationCode ??
          'CONF-' + Math.random().toString(36).substring(2, 8).toUpperCase();
        const rawBooking = (data as any).booking;
        const bookingRef = rawBooking?.id
          ? 'BK-' + String(rawBooking.id).substring(0, 6).toUpperCase()
          : 'BK-' + Date.now().toString(36).toUpperCase().slice(-6);

        window.location.href = `/booking-confirmed?${buildRedirectParams(confCode, bookingRef)}`;
      } catch (err) {
        console.warn('[booking] API call failed, using offline confirmation', err);
        // Graceful degradation — pilgrim still gets a local confirmation
        const confCode = 'CONF-' + Math.random().toString(36).substring(2, 8).toUpperCase();
        const bookingRef = 'BK-' + Date.now().toString(36).toUpperCase().slice(-6);
        const params = buildRedirectParams(confCode, bookingRef);
        params.set('offline', '1');
        window.location.href = `/booking-confirmed?${params}`;
      } finally {
        btnNext.disabled = false;
        btnNext.textContent = originalLabel;
      }
    }

    // ── CONFETTI ──
    function launchConfetti() {
      const c = document.getElementById('confetti-book')!;
      c.style.display = 'block';
      const colors = ['#00AB39', '#EAC102', '#006b24', '#ffffff', '#ED1C24'];
      for (let i = 0; i < 80; i++) {
        const dot = document.createElement('div');
        const size = 5 + Math.random() * 9;
        const angle = Math.random() * Math.PI * 2;
        const dist = 100 + Math.random() * 200;
        dot.style.cssText = `
          position:absolute;
          width:${size}px;height:${size}px;
