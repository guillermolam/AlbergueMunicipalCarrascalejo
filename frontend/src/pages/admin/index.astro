---
export const prerender = true;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Admin Dashboard" activeSection="dashboard">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
    <div class="card-brut p-3" data-rough-frame>
      <div class="text-sm opacity-70">Peregrinos activos</div>
      <div class="text-2xl font-900">24</div>
    </div>
    <div class="card-brut p-3" data-rough-frame>
      <div class="text-sm opacity-70">Reservas hoy</div>
      <div class="text-2xl font-900">12</div>
    </div>
    <div class="card-brut p-3" data-rough-frame>
      <div class="text-sm opacity-70">Salud de servicios</div>
      <div class="text-2xl font-900">87.5%</div>
    </div>
    <div class="card-brut p-3" data-rough-frame>
      <div class="text-sm opacity-70">Latencia media</div>
      <div class="text-2xl font-900">68ms</div>
    </div>
  </div>

  <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-3">
    <a href="/admin/services" class="card-brut no-underline text-black" data-rough-frame>
      <div class="font-900 mb-1">Servicios</div>
      <div class="text-sm opacity-75">Monitoreo y estado en tiempo real.</div>
    </a>
    <a href="/admin/bookings" class="card-brut no-underline text-black" data-rough-frame>
      <div class="font-900 mb-1">Reservas</div>
      <div class="text-sm opacity-75">Gestión de check-in y asignaciones.</div>
    </a>
    <a href="/admin/pilgrims" class="card-brut no-underline text-black" data-rough-frame>
      <div class="font-900 mb-1">Peregrinos</div>
      <div class="text-sm opacity-75">Perfiles y seguimiento de ruta.</div>
    </a>
  </div>
</AdminLayout>
