      align-items: center;
      gap: 0.3rem;
      transition: transform 250ms ease;
    }
    .pricing-stat:hover {
      transform: translateY(-3px);
    }
    .pricing-val {
      position: relative;
      z-index: 2;
      font-family: var(--font-display);
      font-size: 1.8rem;
