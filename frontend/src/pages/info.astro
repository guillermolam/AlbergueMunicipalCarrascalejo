    }
    .loc-row strong {
      font-family: var(--font-sketch);
      font-weight: 700;
      font-size: 0.9rem;
      color: var(--black);
      display: block;
    }
    .loc-row p {
      font-family: var(--font-hand);
      font-size: 0.85rem;
      color: #555;
      margin: 0.1rem 0 0;
    }

    /* Accordion */
    .accordion {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .acc-item {
      border-radius: var(--r-md);
      border: 2px solid rgba(0, 171, 57, 0.25);
