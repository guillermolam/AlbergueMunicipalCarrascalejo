    /** Swap the document illustration icon in the upload zones. */
    function setDocIcons(docType: string) {
      const frontWrap = document.getElementById('upload-front-doc-icon');
      const backWrap = document.getElementById('upload-back-doc-icon');
      if (!frontWrap) return;
      clearEl(frontWrap);
      frontWrap.appendChild(parseSVG(docType === 'passport' ? SVG_PASSPORT_PAGE : SVG_DNI_FRONT));
      if (backWrap) {
        clearEl(backWrap);
        if (docType !== 'passport') {
          backWrap.appendChild(parseSVG(SVG_DNI_BACK));
        }
      }
