    /* Responsive */
    @media (max-width: 768px) {
      .about-grid,
      .location-grid {
        grid-template-columns: 1fr;
      }
      .pricing-stats {
        grid-template-columns: repeat(2, 1fr);
      }
      .rules-ul {
        grid-template-columns: 1fr;
      }
      .reviews-overall {
        grid-template-columns: 1fr;
      }
      .subscore-row {
        grid-template-columns: 140px 1fr 36px;
      }
      .nearby-grid {
