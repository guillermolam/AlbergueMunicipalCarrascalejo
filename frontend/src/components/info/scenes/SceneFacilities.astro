---
import FacilitiesPopover from '../FacilitiesPopover.astro';
---

<div class="info-scene">
  <canvas id="info-scene-facilities-canvas" class="info-canvas" aria-label="Instalaciones 3D"></canvas>
  <div class="info-ui">
    <FacilitiesPopover />
    <div id="info-facilities-hint" class="info-hint" aria-hidden="true">Click en una tarjeta para abrir</div>
  </div>
</div>

<script>
  import { attachSectionActive, createRafLoop } from '../../../lib/three/sectionActive';

  const canvas = document.getElementById('info-scene-facilities-canvas');
  if (!(canvas instanceof HTMLCanvasElement)) throw new Error('[SceneFacilities] canvas missing');
  const section = canvas.closest('.ip-section');
  if (!(section instanceof HTMLElement)) throw new Error('[SceneFacilities] section missing');
  const canvasEl = canvas;
  const sectionEl = section;

  const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches ?? false;

  let runtime: any = null;
  let runtimePromise: Promise<any> | null = null;

  async function init() {
    const THREE = await import('three');

    const renderer = new THREE.WebGLRenderer({
      canvas: canvasEl,
      antialias: true,
      alpha: false,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0b1f13);
    scene.fog = new THREE.Fog(0x0b1f13, 10, 26);

    const camera = new THREE.PerspectiveCamera(55, 1, 0.1, 200);
    camera.position.set(0, 0.2, 9.5);

    scene.add(new THREE.AmbientLight(0xffffff, 0.85));
    scene.add(new THREE.HemisphereLight(0xeaf4ff, 0x172319, 0.55));
    const key = new THREE.DirectionalLight(0xffffff, 1.05);
    key.position.set(7, 10, 6);
    scene.add(key);

    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    key.castShadow = true;
    key.shadow.mapSize.set(1024, 1024);
    key.shadow.camera.near = 1;
    key.shadow.camera.far = 60;
    key.shadow.camera.left = -18;
    key.shadow.camera.right = 18;
    key.shadow.camera.top = 18;
    key.shadow.camera.bottom = -18;

    const ground = new THREE.Mesh(
      new THREE.PlaneGeometry(50, 50),
      new THREE.MeshStandardMaterial({ color: 0x07140c, roughness: 1, metalness: 0 })
    );
    ground.rotation.x = -Math.PI / 2;
    ground.position.y = -4.6;
    ground.receiveShadow = true;
    scene.add(ground);

    const payloadEl = document.getElementById('info-scene-data');
    let payload: any = null;
    try {
      payload = payloadEl ? JSON.parse(payloadEl.textContent || '{}') : null;
    } catch {
      payload = null;
    }
    const facilities = Array.isArray(payload?.facilities) ? payload.facilities.slice(0, 12) : [];

    const drawIcon = (ctx: CanvasRenderingContext2D, name: string) => {
      ctx.clearRect(0, 0, 256, 256);
      ctx.fillStyle = '#0b1f13';
      ctx.fillRect(0, 0, 256, 256);

      ctx.fillStyle = '#00ab39';
      ctx.beginPath();
      ctx.roundRect(18, 18, 220, 220, 44);
      ctx.fill();

      ctx.strokeStyle = 'rgba(255,255,255,0.92)';
      ctx.lineWidth = 12;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      const c = name || '';
      if (c === 'wifi') {
        ctx.beginPath();
        ctx.arc(128, 160, 16, 0, Math.PI * 2);
        ctx.stroke();
        for (const r of [36, 60, 84]) {
          ctx.beginPath();
          ctx.arc(128, 160, r, Math.PI * 1.05, Math.PI * 1.95);
          ctx.stroke();
        }
        return;
      }

      if (c === 'bed') {
        ctx.beginPath();
        ctx.moveTo(52, 150);
        ctx.lineTo(52, 118);
        ctx.lineTo(92, 118);
        ctx.lineTo(110, 136);
        ctx.lineTo(204, 136);
        ctx.lineTo(204, 150);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(52, 150);
        ctx.lineTo(204, 150);
        ctx.stroke();
        return;
      }

      if (c === 'shower') {
        ctx.beginPath();
        ctx.moveTo(78, 92);
        ctx.lineTo(176, 92);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(152, 92);
        ctx.lineTo(152, 122);
        ctx.stroke();
        for (let i = 0; i < 5; i++) {
          ctx.beginPath();
          ctx.moveTo(116 + i * 12, 132);
          ctx.lineTo(116 + i * 12, 160);
          ctx.stroke();
        }
        return;
      }

      if (c === 'kitchen') {
        ctx.beginPath();
        ctx.roundRect(78, 86, 100, 122, 18);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(96, 116);
        ctx.lineTo(160, 116);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(112, 164, 10, 0, Math.PI * 2);
        ctx.stroke();
        return;
      }

      if (c === 'lock') {
        ctx.beginPath();
        ctx.roundRect(86, 130, 84, 74, 18);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(128, 128, 28, Math.PI, 0);
        ctx.stroke();
        return;
      }

      if (c === 'laundry') {
        ctx.beginPath();
        ctx.roundRect(78, 86, 100, 128, 18);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(128, 154, 26, 0, Math.PI * 2);
        ctx.stroke();
        return;
      }

      if (c === 'garden') {
        ctx.beginPath();
        ctx.moveTo(128, 182);
        ctx.lineTo(128, 118);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(116, 126, 18, Math.PI * 0.2, Math.PI * 1.2);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(144, 134, 18, Math.PI * 1.9, Math.PI * 0.9);
        ctx.stroke();
        return;
      }

      ctx.font = '800 110px system-ui, -apple-system, Segoe UI, Roboto, sans-serif';
      ctx.fillStyle = 'rgba(255,255,255,0.92)';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText((c || 'i').slice(0, 1).toUpperCase(), 128, 140);
    };

    const makeIconTexture = (iconName: string) => {
      const iconCanvas = document.createElement('canvas');
      iconCanvas.width = 256;
      iconCanvas.height = 256;
      const ctx = iconCanvas.getContext('2d');
      if (!ctx) throw new Error('[SceneFacilities] 2d ctx missing');
      drawIcon(ctx, iconName);
      const tex = new THREE.CanvasTexture(iconCanvas);
      tex.colorSpace = THREE.SRGBColorSpace;
      tex.anisotropy = 2;
      return tex;
    };

    const cardGeo = new THREE.BoxGeometry(1.55, 1.18, 0.18, 1, 1, 1);
    const edgeGeo = new THREE.EdgesGeometry(cardGeo, 28);
    const edgeMat = new THREE.LineBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.16 });

    const cards: Array<{ mesh: any; edges: any; phase: number; base: any; iconTex: any }> = [];

    const ringR = 4.2;
    const baseY = 0.0;
    const count = facilities.length || 10;
    for (let i = 0; i < count; i++) {
      const f = facilities[i] || { icon: 'i', label: 'Instalación' };
      const tex = makeIconTexture(String(f.icon || 'i'));
      const front = new THREE.MeshStandardMaterial({
        color: 0x00ab39,
        roughness: 0.42,
        metalness: 0.14,
        map: tex,
        emissive: 0x00160b,
        emissiveIntensity: 0.18,
      });
      const side = new THREE.MeshStandardMaterial({ color: 0x0a361f, roughness: 0.6, metalness: 0.08 });
      const mats = [side, side, side, side, front, side];
      const m = new THREE.Mesh(cardGeo, mats);
      m.castShadow = true;
      m.receiveShadow = false;
      m.userData = { index: i, label: String(f.label || '') };

      const a = (i / count) * Math.PI * 2;
      const x = Math.cos(a) * ringR;
      const z = Math.sin(a) * ringR;
      m.position.set(x, baseY + (i % 3) * 0.35 - 0.35, z);
      m.lookAt(0, baseY, 0);
      m.rotateY(Math.PI);

      const edges = new THREE.LineSegments(edgeGeo, edgeMat);
      edges.position.z = 0.1;
      m.add(edges);

      scene.add(m);
      cards.push({ mesh: m, edges, phase: Math.random() * Math.PI * 2, base: m.position.clone(), iconTex: tex });
    }

    let W = 1;
    let H = 1;
    const ro = new ResizeObserver(() => {
      const r = sectionEl.getBoundingClientRect();
      W = Math.max(1, r.width);
      H = Math.max(1, r.height);
      renderer.setSize(W, H, false);
      camera.aspect = W / H;
      camera.updateProjectionMatrix();
      if (reducedMotion) renderFrame(0, performance.now());
    });
    ro.observe(sectionEl);

    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2(-9, -9);
    let hoverId = -1;
    const hintEl = document.getElementById('info-facilities-hint');

    const onMove = (e: PointerEvent) => {
      const r = canvasEl.getBoundingClientRect();
      mouse.x = ((e.clientX - r.left) / Math.max(1, r.width)) * 2 - 1;
      mouse.y = -((e.clientY - r.top) / Math.max(1, r.height)) * 2 + 1;
      if (reducedMotion) renderFrame(0, performance.now());
    };
    const onLeave = () => {
      mouse.set(-9, -9);
      hoverId = -1;
      if (hintEl) hintEl.textContent = 'Click en una tarjeta para abrir';
      canvasEl.style.cursor = 'default';
      if (reducedMotion) renderFrame(0, performance.now());
    };

    const openPopover = () => {
      const trigger = sectionEl.querySelector('.fp-trigger');
      if (trigger instanceof HTMLButtonElement) trigger.click();
    };

    const onClick = () => {
      if (hoverId >= 0) openPopover();
    };

    canvasEl.addEventListener('pointermove', onMove);
    canvasEl.addEventListener('pointerleave', onLeave);
    canvasEl.addEventListener('click', onClick);

    const loop = createRafLoop(renderFrame);

    function renderFrame(dt: number, t: number) {
      const tt = t * 0.001;
      for (let i = 0; i < cards.length; i++) {
        const c = cards[i];
        const bob = Math.sin(tt * 1.15 + c.phase) * 0.08;
        c.mesh.position.y = c.base.y + bob;
        c.mesh.rotation.z = Math.sin(tt * 0.9 + c.phase) * 0.06;
      }

      raycaster.setFromCamera(mouse, camera);
      const hits = raycaster.intersectObjects(cards.map((c) => c.mesh), false);
      const hit = hits.length ? hits[0].object : null;
      const idx = typeof hit?.userData?.index === 'number' ? hit.userData.index : -1;
      hoverId = idx;
      if (hoverId >= 0) {
        const lbl = String(hit?.userData?.label || '');
        if (hintEl) hintEl.textContent = lbl ? lbl : 'Instalación';
        canvasEl.style.cursor = 'pointer';
      } else {
        if (hintEl) hintEl.textContent = 'Arrastra para rotar';
        canvasEl.style.cursor = 'grab';
      }

      for (let i = 0; i < cards.length; i++) {
        const m = cards[i].mesh;
        const s = i === hoverId ? 1.12 : 1.0;
        const cur = m.scale.x;
        const next = cur + (s - cur) * (reducedMotion ? 1 : Math.min(1, dt * 10));
        m.scale.setScalar(next);
      }

      renderer.render(scene, camera);
    }

    renderFrame(0, performance.now());

    return {
      start() {
        if (reducedMotion) return;
        loop.start();
      },
      stop() {
        loop.stop();
      },
      destroy() {
        loop.stop();
        ro.disconnect();
        canvasEl.removeEventListener('pointermove', onMove);
        canvasEl.removeEventListener('pointerleave', onLeave);
        canvasEl.removeEventListener('click', onClick);
        cardGeo.dispose();
        edgeGeo.dispose();
        edgeMat.dispose();
        for (const c of cards) {
          const mats = Array.isArray(c.mesh.material) ? c.mesh.material : [c.mesh.material];
          for (const m of mats) m.dispose();
          c.iconTex.dispose();
        }
        ground.geometry.dispose();
        (ground.material as any).dispose?.();
        renderer.dispose();
      },
    };
  }

  async function ensureRuntime() {
    if (runtime) return runtime;
    runtimePromise ??= init();
    runtime = await runtimePromise;
    return runtime;
  }

  function ensurePopover() {
    const fp = sectionEl.querySelector('.fp-root');
    const A = window.Alpine;
    if (!(fp instanceof HTMLElement) || !A?.initTree) return;
    if (fp.dataset.fpAlpineInit === '1') return;
    fp.dataset.fpAlpineInit = '1';
    fp.removeAttribute('x-ignore');
    A.initTree(fp);
  }

  attachSectionActive(sectionEl, {
    auto: false,
    onChange(active) {
      if (active) {
        ensurePopover();
        ensureRuntime().then((r: any) => r.start());
      }
      else if (runtime) {
        runtime.destroy();
        runtime = null;
        runtimePromise = null;
      }
    },
  });
</script>

<style>
  .info-scene {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #0b1f13;
  }
  .info-canvas {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    pointer-events: auto;
    touch-action: none;
  }
  .info-ui {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 18px;
    gap: 12px;
  }
  :global(.fp-root) {
    pointer-events: auto;
  }
  .info-hint {
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.9);
    font-size: 12px;
    font-weight: 600;
    backdrop-filter: blur(10px);
  }
</style>
