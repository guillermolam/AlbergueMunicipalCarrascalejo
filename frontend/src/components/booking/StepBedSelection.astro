---
// StepBedSelection.astro — Step 4: isometric bunk bed selection grid
---

<div class="step-panel hidden" id="step-4" data-step="4">
  <div class="step-header center">
    <div class="step-header-icon large">
      <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#00AB39" stroke-width="2" stroke-linecap="round">
        <path d="M2 4v16"></path>
        <path d="M2 8h18a2 2 0 0 1 2 2v10"></path>
        <path d="M2 17h20"></path>
        <path d="M6 8v9"></path>
      </svg>
    </div>
    <h1 class="step-title">Select Your Bed</h1>
    <p class="step-desc">Choose from our comfortable dormitories</p>
    <svg class="squiggle-line" viewBox="0 0 200 12" preserveAspectRatio="none">
      <path d="M0,6 Q25,0 50,6 T100,6 T150,6 T200,6" fill="none" stroke="#00AB39" stroke-width="2.5" stroke-linecap="round"></path>
    </svg>
  </div>

  <!-- Bed legend -->
  <div class="bed-legend">
    <span class="legend-item"><span class="legend-swatch" style="background:#A5D6A7;border-color:#2E7D32"></span>Full</span>
    <span class="legend-item"><span class="legend-swatch" style="background:#FFF3CD;border-color:#D4A017"></span>Partial</span>
    <span class="legend-item"><span class="legend-swatch" style="background:#90CAF9;border-color:#1565C0"></span>Selected</span>
    <span class="legend-item"><span class="legend-swatch" style="background:#EF9A9A;border-color:#C62828"></span>Occupied</span>
  </div>

  <!-- Person tabs (shown when persons > 1) -->
  <div class="person-tabs-wrap" id="person-tabs-wrap" style="display:none">
    <div class="person-tabs-label">Select bed for:</div>
    <div class="person-tabs" id="person-tabs"></div>
  </div>

  <!-- Night selector tabs -->
  <div class="night-tabs-wrap" id="night-tabs-wrap">
    <div class="night-tabs-label">Your stay:</div>
    <div class="night-tabs" id="night-tabs">
      <!-- Generated by JS -->
    </div>
  </div>

  <!-- Bed schedule summary -->
  <div class="bed-schedule" id="bed-schedule" style="display:none">
    <div class="bed-schedule-header">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00AB39" stroke-width="2" stroke-linecap="round">
        <path d="M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"></path>
      </svg>
      <span>Your Bed Schedule</span>
    </div>
    <div class="bed-schedule-rows" id="bed-schedule-rows"></div>
  </div>

  <!-- Dormitory 1 -->
  <div class="dorm-wrap">
    <svg class="dorm-border" preserveAspectRatio="none" aria-hidden="true">
      <rect x="4" y="4" width="calc(100% - 8px)" height="calc(100% - 8px)" fill="white" stroke="#00AB39" stroke-width="3" rx="20"></rect>
      <rect x="8" y="8" width="calc(100% - 16px)" height="calc(100% - 16px)" fill="none" stroke="#00AB39" stroke-width="1.5" rx="18" opacity="0.25" stroke-dasharray="6,6"></rect>
    </svg>
    <div class="dorm-inner">
      <h3 class="dorm-title">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        Dormitory 1 <span class="dorm-range">(Beds 1-12)</span>
      </h3>
      <div class="iso-bed-grid" id="dorm1-grid">
        <!-- Beds 1-12 generated by JS -->
      </div>
    </div>
  </div>

  <!-- Dormitory 2 -->
  <div class="dorm-wrap" style="margin-top:1.5rem">
    <svg class="dorm-border" preserveAspectRatio="none" aria-hidden="true">
      <rect x="4" y="4" width="calc(100% - 8px)" height="calc(100% - 8px)" fill="white" stroke="#00AB39" stroke-width="3" rx="20"></rect>
      <rect x="8" y="8" width="calc(100% - 16px)" height="calc(100% - 16px)" fill="none" stroke="#00AB39" stroke-width="1.5" rx="18" opacity="0.25" stroke-dasharray="6,6"></rect>
    </svg>
    <div class="dorm-inner">
      <h3 class="dorm-title">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        Dormitory 2 <span class="dorm-range">(Beds 13-24)</span>
      </h3>
      <div class="iso-bed-grid" id="dorm2-grid">
        <!-- Beds 13-24 generated by JS -->
      </div>
    </div>
  </div>

  <!-- Bed selection info card (hidden until selected) -->
  <div class="bed-info-card" id="bed-info-card" style="display:none">
    <div class="bed-info-inner">
      <div class="bed-info-badge">✓</div>
      <div class="bed-info-header">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0071BC" stroke-width="2" stroke-linecap="round">
          <path d="M2 4v16"></path>
          <path d="M2 8h18a2 2 0 0 1 2 2v10"></path>
          <path d="M2 17h20"></path>
          <path d="M6 8v9"></path>
        </svg>
        <span class="bed-info-num" id="bed-info-num">Bed #1</span>
      </div>
      <div class="bed-info-detail">
        <div class="bunk-illus" id="bunk-illus">
          <!-- JS fills bunk illustration -->
        </div>
        <div>
          <p class="bed-info-position" id="bed-info-pos">Bottom Bunk</p>
          <p class="bed-info-bunk" id="bed-info-bunk">Bunk #1</p>
        </div>
      </div>
      <div class="bed-info-divider"></div>
      <p class="bed-info-dorm" id="bed-info-dorm">Dormitory 1</p>
    </div>
  </div>

  <!-- Ready confirmation -->
  <div class="bed-ready" id="bed-ready" style="display:none">
    <p class="bed-ready-title">Ready!</p>
    <p class="bed-ready-sub">Your bed is reserved</p>
  </div>

  <p class="bed-selection-hint" id="bed-hint">
    Hover over a bed to see availability, tap to assign
  </p>
</div>

<!-- Bed tooltip (floating, outside panels) -->
<div class="bed-tooltip" id="bed-tooltip" style="display:none">
  <div class="bed-tooltip-arrow"></div>
  <div class="bed-tooltip-title" id="tt-title">Bed #1 — Top Bunk</div>
  <div class="bed-tooltip-status" id="tt-status"></div>
  <div class="bed-tooltip-nights" id="tt-nights"></div>
</div>
