---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Reservar Cama — Albergue Municipal de El Carrascalejo"
  showHeader={false}
  showFooter={false}
>
  <div class="wiz-wrap">
    <!-- ═══ DESKTOP SIDEBAR ═══ -->
    <aside class="wiz-sidebar" aria-label="Booking steps">
      <div class="sidebar-logo">
        <button class="sidebar-logo-btn" id="sidebar-home-btn" aria-label="Return to home page">
          <img src="/logos/logo.png" alt="Albergue Carrascalejo" class="s-logo" />
        </button>
        <h2 class="s-title">Albergue Carrascalejo</h2>
        <p class="s-sub">Camino de Santiago</p>
      </div>

      <!-- Dashed connector line -->
      <div class="step-track">
        <svg class="track-line" aria-hidden="true">
          <line
            x1="30"
            y1="40"
            x2="30"
            y2="100%"
            stroke="#D4A574"
            stroke-width="2.5"
            stroke-dasharray="6,6"
            opacity="0.4"></line>
        </svg>

        <!-- Step buttons — single SVG per circle (bg + icon in one coordinate space) -->
        <!-- Icon paths live in 24×24 space, centered via translate(18,18) in 60×60 SVG -->

        <!-- Step 1: Dates — active (green) -->
        <button class="step-btn active" data-step="1" disabled>
          <div class="step-circle active" aria-hidden="true">
            <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
              <!-- bg -->
              <circle cx="30" cy="30" r="27" fill="#00AB39" stroke="#005a1e" stroke-width="2.5"
              ></circle>
              <circle
                cx="30"
                cy="30"
                r="21"
                fill="none"
                stroke="rgba(255,255,255,0.2)"
                stroke-width="1.5"
                stroke-dasharray="3,4"></circle>
              <!-- calendar: outer g positions, inner g is animation target -->
              <g transform="translate(20,21)">
                <g
                  class="step-svg-icon"
                  stroke="white"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                >
                  <rect x="0" y="2" width="20" height="16" rx="2.5"></rect>
                  <path d="M0 7.5h20"></path>
                  <path d="M5.5 0v4.5M14.5 0v4.5"></path>
                  <circle cx="5.5" cy="12" r="1.5" fill="white" stroke="none"></circle>
                  <circle cx="10" cy="12" r="1.5" fill="white" stroke="none"></circle>
                  <circle cx="14.5" cy="12" r="1.5" fill="white" stroke="none"></circle>
                </g>
              </g>
            </svg>
          </div>
          <div class="step-info">
            <span class="step-num">Step 1</span>
            <p class="step-label active">Dates</p>
            <p class="step-sub">Check-in &amp; out</p>
          </div>
          <div class="step-dot active"></div>
        </button>

        <!-- Step 2: ID Upload — inactive (tan) -->
        <button class="step-btn" data-step="2" disabled>
          <div class="step-circle" aria-hidden="true">
            <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
              <circle cx="30" cy="30" r="27" fill="#FFF9F0" stroke="#D4A574" stroke-width="2"
              ></circle>
              <g transform="translate(18,17)">
                <g
                  class="step-svg-icon"
                  stroke="#D4A574"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                >
                  <!-- id card body -->
                  <rect x="1" y="5" width="22" height="16" rx="2.5"></rect>
                  <path d="M5 11h6M5 14.5h3.5"></path>
                  <circle cx="17.5" cy="13" r="3"></circle>
                  <!-- upload arrow above card -->
                  <path d="M12 0v5"></path>
                  <path d="M9.5 2.5L12 0l2.5 2.5"></path>
                </g>
              </g>
            </svg>
          </div>
          <div class="step-info">
            <span class="step-num inactive">Step 2</span>
            <p class="step-label">ID Upload</p>
            <p class="step-sub">OCR scan</p>
          </div>
        </button>

        <!-- Step 3: Your Info — pilgrim with staff (tan) -->
        <button class="step-btn" data-step="3" disabled>
          <div class="step-circle" aria-hidden="true">
            <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
              <circle cx="30" cy="30" r="27" fill="#FFF9F0" stroke="#D4A574" stroke-width="2"
              ></circle>
              <g transform="translate(18,18)">
                <g
                  class="step-svg-icon"
                  stroke="#D4A574"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                >
                  <circle cx="12" cy="5.5" r="3.5"></circle>
                  <path d="M5 22v-2.5a7 7 0 0 1 14 0V22"></path>
                  <!-- walking staff -->
                  <path d="M18.5 9l1.5 13" stroke-width="2"></path>
                </g>
              </g>
            </svg>
          </div>
          <div class="step-info">
            <span class="step-num inactive">Step 3</span>
            <p class="step-label">Your Info</p>
            <p class="step-sub">Pilgrim details</p>
          </div>
        </button>

        <!-- Step 4: Select Bed — bunk bed (tan) -->
        <button class="step-btn" data-step="4" disabled>
          <div class="step-circle" aria-hidden="true">
            <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
              <circle cx="30" cy="30" r="27" fill="#FFF9F0" stroke="#D4A574" stroke-width="2"
              ></circle>
              <g transform="translate(18,18)">
                <g
                  class="step-svg-icon"
                  stroke="#D4A574"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                >
                  <!-- posts -->
                  <path d="M3 3v18M21 3v18"></path>
                  <!-- two bunks -->
                  <rect x="3" y="5" width="18" height="6" rx="1.5"></rect>
                  <rect x="3" y="13" width="18" height="6" rx="1.5"></rect>
                </g>
              </g>
            </svg>
          </div>
          <div class="step-info">
            <span class="step-num inactive">Step 4</span>
            <p class="step-label">Select Bed</p>
            <p class="step-sub">Dorm view</p>
          </div>
        </button>

        <!-- Step 5: Payment — card with coin (tan) -->
        <button class="step-btn" data-step="5" disabled>
          <div class="step-circle" aria-hidden="true">
            <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
              <circle cx="30" cy="30" r="27" fill="#FFF9F0" stroke="#D4A574" stroke-width="2"
              ></circle>
              <g transform="translate(18,18)">
                <g
                  class="step-svg-icon"
                  stroke="#D4A574"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                >
                  <rect x="1" y="5" width="22" height="15" rx="2.5"></rect>
                  <path d="M1 10h22"></path>
                  <path d="M5 15.5h5"></path>
                  <!-- euro coin -->
                  <circle cx="17.5" cy="15.5" r="3"></circle>
                  <path
                    d="M16 14.5c.3-.4.9-.7 1.5-.7.8 0 1.5.5 1.5 1.7s-.7 1.7-1.5 1.7c-.6 0-1.2-.3-1.5-.7"
                  ></path>
                </g>
              </g>
            </svg>
          </div>
          <div class="step-info">
            <span class="step-num inactive">Step 5</span>
            <p class="step-label">Payment</p>
            <p class="step-sub">Secure checkout</p>
          </div>
        </button>

        <!-- Step 6: Summary — clipboard with tick (tan) -->
        <button class="step-btn" data-step="6" disabled>
          <div class="step-circle" aria-hidden="true">
            <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
              <circle cx="30" cy="30" r="27" fill="#FFF9F0" stroke="#D4A574" stroke-width="2"
              ></circle>
              <g transform="translate(18,18)">
                <g
                  class="step-svg-icon"
                  stroke="#D4A574"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                >
                  <path
                    d="M9 3H7a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-2"
                  ></path>
                  <rect x="9" y="1" width="6" height="4" rx="1.5"></rect>
                  <path d="M8.5 12l2.5 2.5 5-5"></path>
                  <path d="M8.5 18h7"></path>
                </g>
              </g>
            </svg>
          </div>
          <div class="step-info">
            <span class="step-num inactive">Step 6</span>
            <p class="step-label">Summary</p>
            <p class="step-sub">Review booking</p>
          </div>
        </button>

        <!-- Step 7: Dashboard — albergue house (tan) -->
        <button class="step-btn" data-step="7" disabled>
          <div class="step-circle" aria-hidden="true">
            <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
              <circle cx="30" cy="30" r="27" fill="#FFF9F0" stroke="#D4A574" stroke-width="2"
              ></circle>
              <g transform="translate(18,18)">
                <g
                  class="step-svg-icon"
                  stroke="#D4A574"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                >
                  <!-- roof -->
                  <path d="M2 11L12 3l10 8"></path>
                  <!-- walls -->
                  <path d="M4 10v12h16V10"></path>
                  <!-- door -->
                  <rect x="9" y="14" width="6" height="8" rx="1"></rect>
                </g>
              </g>
            </svg>
          </div>
          <div class="step-info">
            <span class="step-num inactive">Step 7</span>
            <p class="step-label">Dashboard</p>
            <p class="step-sub">Your portal</p>
          </div>
        </button>
      </div>
    </aside>

    <!-- ═══ MAIN CONTENT ═══ -->
    <main class="wiz-main">
      <!-- Mobile top bar -->
      <div class="mobile-bar">
        <img src="/logos/logo.png" alt="logo" class="mb-logo" />
        <div>
          <h2 class="mb-title">Albergue Carrascalejo</h2>
          <p class="mb-step" id="mobile-step-label">Step 1 of 7</p>
        </div>
      </div>

      <!-- Progress bar -->
      <div class="prog-wrap">
        <div class="prog-bar">
          <div class="prog-fill" id="prog-fill" style="width:14%"></div>
        </div>
        <div class="prog-labels">
          <span class="prog-text" id="prog-text">Step 1 of 7</span>
          <span class="prog-pct" id="prog-pct">14% Complete</span>
        </div>
      </div>

      <!-- ── STEP 1: DATES ── -->
      <div class="step-panel" id="step-1" data-step="1">
        <div class="step-header">
          <div class="step-header-icon">
            <svg width="48" height="48" viewBox="0 0 100 100" fill="none">
              <path
                d="M15,30 L15,85 C15,88 17,90 20,90 L80,90 C83,90 85,88 85,85 L85,30 Z"
                fill="#FFF9F0"
                stroke="#00AB39"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M15,18 C15,15 17,13 20,13 L80,13 C83,13 85,15 85,18 L85,30 L15,30 Z"
                fill="#00AB39"
                stroke="#00AB39"
                stroke-width="3"></path>
              <circle cx="30" cy="18" r="4" fill="white" stroke="#006b24" stroke-width="2.5"
              ></circle><circle cx="30" cy="18" r="2" fill="#006b24"></circle>
              <circle cx="70" cy="18" r="4" fill="white" stroke="#006b24" stroke-width="2.5"
              ></circle><circle cx="70" cy="18" r="2" fill="#006b24"></circle>
            </svg>
          </div>
          <div>
            <h1 class="step-title">When are you visiting?</h1>
            <p class="step-desc">Select your check-in and check-out dates</p>
          </div>
          <div class="step-hint" aria-hidden="true">Select your stay dates</div>
        </div>

        <!-- Step 1 top row: date summary + pilgrim picker side by side -->
        <div class="step1-top-row">
          <!-- Date summary bar -->
          <div class="date-summary" id="date-summary">
            <div class="date-chip" id="checkin-chip">
              <span class="chip-label">Check-in</span>
              <span class="chip-val" id="checkin-display">—</span>
            </div>
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#00AB39"
              stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
            >
            <div class="date-chip" id="checkout-chip">
              <span class="chip-label">Check-out</span>
              <span class="chip-val" id="checkout-display">—</span>
            </div>
            <div class="nights-chip" id="nights-chip" style="display:none">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
              >
              <span class="nights-val" id="nights-val">0</span>
            </div>
            <div class="price-chip" id="price-chip" style="display:none">
              <span class="price-chip-label">Total</span>
              <span class="price-chip-val" id="price-total">€0</span>
            </div>
            <div class="date-actions" id="date-actions" style="display:none">
              <span class="time-hint">Check-in 14:00 · Check-out 10:00</span>
              <button class="clear-btn" id="clear-dates">Clear</button>
            </div>
            <div class="price-breakdown" id="price-breakdown" style="display:none">
              <div class="price-breakdown-rows" id="price-rows"></div>
              <div class="price-breakdown-total" id="price-total-row"></div>
            </div>
          </div>

          <!-- Person count picker -->
          <div class="persons-picker" id="persons-picker">
            <div class="persons-label">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#00AB39"
                stroke-width="2.5"
                stroke-linecap="round"
                ><circle cx="12" cy="7" r="4"></circle><path d="M4 21v-2a8 8 0 0 1 16 0v2"
                ></path></svg
              >
              <span>Pilgrims</span>
            </div>
            <div class="persons-control">
              <button
                class="persons-btn"
                id="persons-minus"
                type="button"
                aria-label="Remove pilgrim">−</button
              >
              <input
                id="persons-input"
                class="persons-input"
                type="number"
                min="1"
                max="10"
                value="1"
                inputmode="numeric"
                aria-label="Number of pilgrims"
              />
              <button class="persons-btn" id="persons-plus" type="button" aria-label="Add pilgrim"
                >+</button
              >
            </div>
            <span class="persons-hint" id="persons-hint">1 pilgrim</span>
          </div>
        </div><!-- /.step1-top-row -->

        <!-- Calendar container -->
        <div class="cal-wrap">
          <svg class="cal-border" aria-hidden="true" preserveAspectRatio="none">
            <rect
              x="4"
              y="4"
              width="calc(100% - 8px)"
              height="calc(100% - 8px)"
              fill="white"
              fill-opacity="0.95"
              stroke="#00AB39"
              stroke-width="3.5"
              rx="20"></rect>
            <rect
              x="8"
              y="8"
              width="calc(100% - 16px)"
              height="calc(100% - 16px)"
              fill="none"
              stroke="#00AB39"
              stroke-width="2"
              rx="18"
              opacity="0.3"
              stroke-dasharray="6,6"></rect>
          </svg>
          <div class="cal-inner">
            <div class="cal-nav">
              <button class="cal-nav-btn" id="prev-month" aria-label="Previous month">
                <svg class="nav-circle" viewBox="0 0 100 100"
                  ><circle
                    cx="50"
                    cy="50"
                    r="45"
                    fill="none"
                    stroke="#00AB39"
                    stroke-width="3"
                    stroke-dasharray="2,3"
                    opacity="0.3"></circle></svg
                >
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"><path d="m15 18-6-6 6-6"></path></svg
                >
              </button>
              <h3 class="cal-month-title" id="cal-month-title">April 2026</h3>
              <button class="cal-today-btn" id="today-btn" aria-label="Go to today">Today</button>
              <button class="cal-nav-btn" id="next-month" aria-label="Next month">
                <svg class="nav-circle" viewBox="0 0 100 100"
                  ><circle
                    cx="50"
                    cy="50"
                    r="45"
                    fill="none"
                    stroke="#00AB39"
                    stroke-width="3"
                    stroke-dasharray="2,3"
                    opacity="0.3"></circle></svg
                >
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"><path d="m9 18 6-6-6-6"></path></svg
                >
              </button>
            </div>
            <div class="cal-dow-row">
              <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span
                >Fri</span
              ><span>Sat</span>
            </div>
            <div class="cal-grid" id="cal-grid"></div>
          </div>
          <!-- Validation error shown when selected range exceeds max nights -->
          <p
            id="date-range-error"
            style="display:none;color:#c0392b;font-size:0.85rem;margin:0.5rem 1rem 0;font-weight:600;"
          >
          </p>
        </div>
      </div>

      <!-- ── STEP 2: ID UPLOAD ── -->
      <div class="step-panel hidden" id="step-2" data-step="2">
        <div class="step-header center">
          <div class="step-header-icon large">
            <svg
              width="80"
              height="80"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#00AB39"
              stroke-width="2"
              stroke-linecap="round"
              ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline
                points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg
            >
          </div>
          <h1 class="step-title">Upload IDs</h1>
          <p class="step-desc" id="step2-desc">We'll automatically extract your information</p>
          <svg class="squiggle-line" viewBox="0 0 200 12" preserveAspectRatio="none"
            ><path
              d="M0,6 Q25,0 50,6 T100,6 T150,6 T200,6"
              fill="none"
              stroke="#00AB39"
              stroke-width="2.5"
              stroke-linecap="round"></path></svg
          >
        </div>

        <!-- Per-pilgrim navigation (shown when persons > 1) -->
        <div class="pilgrim-step-nav" id="step2-person-nav" style="display:none">
          <div class="pilgrim-step-nav-label">Upload ID for:</div>
          <div class="pilgrim-step-tabs" id="step2-pilgrim-tabs"></div>
        </div>

        <!-- Phase 1: Doc type selection cards -->
        <div class="doc-cards" id="doc-cards-phase">
          <!-- DNI Card -->
          <button
            class="doc-card"
            id="doc-dni"
            data-doc="dni"
            type="button"
            aria-label="Select DNI, NIE or EU ID Card"
          >
            <svg class="doc-card-bg" preserveAspectRatio="none" aria-hidden="true">
              <rect
                x="4"
                y="4"
                width="calc(100% - 8px)"
                height="calc(100% - 8px)"
                fill="white"
                stroke="#D4A574"
                stroke-width="3"
                rx="20"></rect>
            </svg>
            <div class="doc-card-inner">
              <div class="doc-illustration dni-illus">
                <svg viewBox="0 0 280 180" fill="none">
                  <rect
                    x="10"
                    y="10"
                    width="260"
                    height="160"
                    rx="12"
                    fill="#E8F5E9"
                    stroke="#00AB39"
                    stroke-width="3"></rect>
                  <rect
                    x="10"
                    y="10"
                    width="260"
                    height="160"
                    rx="12"
                    fill="none"
                    stroke="#006b24"
                    stroke-width="1.5"
                    stroke-dasharray="4,4"
                    opacity="0.4"></rect>
                  <text
                    x="140"
                    y="45"
                    text-anchor="middle"
                    font-family="Cabin Sketch,cursive"
                    font-size="20"
                    fill="#006b24">DNI</text
                  >
                  <rect x="30" y="60" width="80" height="14" rx="3" fill="#ED1C24" opacity="0.7"
                  ></rect>
                  <rect x="30" y="82" width="60" height="10" rx="3" fill="#1A1A1A" opacity="0.2"
                  ></rect>
                  <rect x="30" y="100" width="70" height="10" rx="3" fill="#1A1A1A" opacity="0.2"
                  ></rect>
                  <rect
                    x="28"
                    y="130"
                    width="40"
                    height="34"
                    rx="4"
                    fill="#EAC102"
                    opacity="0.8"
                    stroke="#D4A574"
                    stroke-width="1.5"></rect>
                  <rect
                    x="165"
                    y="55"
                    width="85"
                    height="100"
                    rx="8"
                    fill="#C8E6C9"
                    stroke="#00AB39"
                    stroke-width="2"></rect>
                  <circle cx="207" cy="90" r="22" fill="#A5D6A7"></circle>
                  <path d="M190,148 Q207,130 224,148" fill="#81C784"></path>
                  <rect x="28" y="146" width="100" height="6" rx="2" fill="#1A1A1A" opacity="0.15"
                  ></rect>
                </svg>
              </div>
              <h3 class="doc-name">DNI / NIE / EU ID Cards</h3>
              <p class="doc-desc">Spanish DNI, NIE or any EU/EEA national ID card</p>
              <p class="doc-req">
                <span class="req-dot green"></span> Requires front + back photos
              </p>
            </div>
          </button>

          <!-- Passport Card -->
          <button
            class="doc-card"
            id="doc-passport"
            data-doc="passport"
            type="button"
            aria-label="Select Passport"
          >
            <svg class="doc-card-bg" preserveAspectRatio="none" aria-hidden="true">
              <rect
                x="4"
                y="4"
                width="calc(100% - 8px)"
                height="calc(100% - 8px)"
                fill="white"
                stroke="#D4A574"
                stroke-width="3"
                rx="20"></rect>
            </svg>
            <div class="doc-card-inner">
              <div class="doc-illustration pass-illus">
                <svg viewBox="0 0 280 180" fill="none">
                  <rect
                    x="40"
                    y="8"
                    width="200"
                    height="164"
                    rx="10"
                    fill="#DBEAFE"
                    stroke="#3B82F6"
                    stroke-width="2.5"></rect>
                  <rect
                    x="40"
                    y="8"
                    width="200"
                    height="164"
                    rx="10"
                    fill="none"
                    stroke="#1D4ED8"
                    stroke-width="1"
                    stroke-dasharray="5,5"
                    opacity="0.3"></rect>
                  <text
                    x="140"
                    y="40"
                    text-anchor="middle"
                    font-family="Cabin Sketch,cursive"
                    font-size="14"
                    fill="#1D4ED8"
