---
export interface Props {
  title?: string;
  activeSection?: string;
}

const { title = 'Admin', activeSection = 'services' } = Astro.props;

const menuItems = [
  { id: 'services', label: 'Services', icon: 'server', path: '/admin/services' },
  { id: 'bookings', label: 'Bookings', icon: 'calendar', path: '/admin/bookings' },
  { id: 'pilgrims', label: 'Pilgrims', icon: 'users', path: '/admin/pilgrims' },
  { id: 'analytics', label: 'Analytics', icon: 'chart-bar', path: '/admin/analytics' },
  { id: 'settings', label: 'Settings', icon: 'cog', path: '/admin/settings' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="module" src="/src/scripts/runtime.ts"></script>
  </head>
  <body class="bg-white text-black min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-4 grid grid-cols-1 lg:grid-cols-[250px_1fr] gap-4">
      <aside class="card-brut h-fit" data-rough-frame>
        <div class="font-900 text-lg mb-3">Admin Panel</div>
        <nav class="flex flex-col gap-2">
          {
            menuItems.map((item) => (
              <a
                href={item.path}
                class:list={[
                  'badge-doodle no-underline text-black justify-between',
                  activeSection === item.id ? 'bg-primary text-white' : '',
                ]}
              >
                <span>{item.label}</span>
                <span class="font-800">{activeSection === item.id ? 'ON' : ''}</span>
              </a>
            ))
          }
        </nav>
      </aside>
      <div class="card-brut" data-rough-frame>
        <header class="mb-4 pb-2 border-b-2 border-black flex items-center justify-between">
          <h1 class="m-0 text-lg font-900">{title}</h1>
          <a href="/" class="btn-primary no-underline">Volver</a>
        </header>
        <main class="p-0">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
