---
// On-demand rendering: auth-gated via Clerk middleware
import Layout from '../layouts/Layout.astro';
import { UserButton } from '@clerk/astro/components';

// Auth guard — middleware already redirects guests, but double-check here
const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect('/auth?from=/dashboard', 302);

// Fetch full Clerk user for profile picture, name, email
const clerkUser = await Astro.locals.currentUser();
const firstName = clerkUser?.firstName ?? Astro.locals.user?.name?.split(' ')[0] ?? 'Peregrino';
const fullName =
  [clerkUser?.firstName, clerkUser?.lastName].filter(Boolean).join(' ') || 'Peregrino';
const email = clerkUser?.emailAddresses?.[0]?.emailAddress ?? Astro.locals.user?.email ?? '';
const avatarUrl = clerkUser?.imageUrl ?? null;

// Fetch user's bookings from the backend api-service
// Guest email is used to correlate bookings (Clerk userId stored separately in future)
let bookings: Array<{
  id: string;
  ref: string;
  checkin: string;
  checkout: string;
  nights: number;
  status: string;
  total: number;
  room_type: string;
}> = [];

try {
  const resp = await fetch('http://localhost:8787/api/bookings', {
    signal: AbortSignal.timeout(3000),
  });
  if (resp.ok) {
    const raw = (await resp.json()) as Array<Record<string, unknown>>;
    // Show bookings that belong to this user's email
    bookings = raw
      .filter((b) => !email || b.guest_email === email)
      .map((b) => {
        const ci = String(b.check_in ?? '');
        const co = String(b.check_out ?? '');
        const nights =
          ci && co
            ? Math.max(
                1,
                Math.round((new Date(co).getTime() - new Date(ci).getTime()) / 86_400_000)
              )
            : 1;
        const fmtDate = (d: string) =>
          d
            ? new Date(d + 'T12:00:00').toLocaleDateString('es-ES', {
                day: 'numeric',
                month: 'short',
                year: 'numeric',
              })
            : '—';
        const statusMap: Record<string, string> = {
          pending: 'Pendiente',
          confirmed: 'Confirmada',
          checked_in: 'Hospedado',
          checked_out: 'Completada',
          cancelled: 'Cancelada',
        };
        return {
          id: String(b.id ?? ''),
          ref: String(b.id ?? '')
            .toUpperCase()
            .slice(0, 8),
          checkin: fmtDate(ci),
          checkout: fmtDate(co),
          nights,
          status: statusMap[String(b.status ?? 'pending')] ?? 'Pendiente',
          total: Math.round(Number(b.total_price ?? 0) / 100),
          room_type: String(b.room_type ?? 'dormitory'),
        };
      });
  }
} catch {
  /* backend unavailable — show empty state */
}

const totalNights = bookings.reduce((s, b) => s + b.nights, 0);
const totalSpent = bookings.reduce((s, b) => s + b.total, 0);
---

