  </style>

  <script>
    // --- Photo Gallery Carousel ---
    (function () {
      const track = document.getElementById('gallery-track') as HTMLElement | null;
      const dotsContainer = document.getElementById('gallery-dots');
      const slides = track ? Array.from(track.querySelectorAll('.gallery-slide')) : [];
      const total = slides.length;
      if (!track || total === 0) return;

      let current = 0;
      let autoTimer: ReturnType<typeof setInterval>;

      function goTo(idx: number) {
        current = ((idx % total) + total) % total;
        if (track) track.style.transform = `translateX(-${current * 100}%)`;
        dotsContainer?.querySelectorAll('.gallery-dot').forEach((d, i) => {
          d.classList.toggle('active', i === current);
          d.setAttribute('aria-selected', i === current ? 'true' : 'false');
        });
      }

      document.getElementById('gallery-prev')?.addEventListener('click', () => {
        goTo(current - 1);
        clearInterval(autoTimer);
        autoTimer = setInterval(() => goTo(current + 1), 4500);
      });
      document.getElementById('gallery-next')?.addEventListener('click', () => {
        goTo(current + 1);
        clearInterval(autoTimer);
        autoTimer = setInterval(() => goTo(current + 1), 4500);
      });

      dotsContainer?.querySelectorAll('.gallery-dot').forEach((dot, i) => {
        dot.addEventListener('click', () => {
          goTo(i);
          clearInterval(autoTimer);
          autoTimer = setInterval(() => goTo(current + 1), 4500);
        });
      });

      autoTimer = setInterval(() => goTo(current + 1), 4500);

      // Pause on hover
      const outer = document.getElementById('gallery-outer');
      outer?.addEventListener('mouseenter', () => clearInterval(autoTimer));
      outer?.addEventListener('mouseleave', () => {
        autoTimer = setInterval(() => goTo(current + 1), 4500);
      });
    })();

    // --- Facility Modal ---
    (function () {
      interface PhotoEntry {
        id: string;
        hash: string;
        alt: string;
      }
      interface FacEntry {
        label: string;
        photos: number[];
        details: string;
      }

      const photosRaw = document.getElementById('photos-data')?.textContent ?? '[]';
      const facRaw = document.getElementById('facilities-data')?.textContent ?? '[]';
      let PHOTOS: PhotoEntry[] = [];
      let facData: FacEntry[] = [];
      try {
        PHOTOS = JSON.parse(photosRaw);
      } catch (e) {
        console.warn('[info] photos-data parse error', e);
      }
      try {
        facData = JSON.parse(facRaw);
      } catch (e) {
        console.warn('[info] facilities-data parse error', e);
      }

      const modal = document.getElementById('facility-modal');
      const modalTitle = document.getElementById('fac-modal-title');
      const modalTrack = document.getElementById('fac-modal-track') as HTMLElement | null;
      const modalDesc = document.getElementById('fac-modal-desc');
      const modalDots = document.getElementById('fac-dots');
      let facIdx = 0;
      let facPhotos: number[] = [];

      function facGoTo(i: number) {
        facIdx = ((i % facPhotos.length) + facPhotos.length) % facPhotos.length;
        if (modalTrack) modalTrack.style.transform = `translateX(-${facIdx * 100}%)`;
        modalDots?.querySelectorAll('.gallery-dot').forEach((d, j) => {
          d.classList.toggle('active', j === facIdx);
          d.setAttribute('aria-selected', j === facIdx ? 'true' : 'false');
        });
      }

      function openModal(facilityIndex: number) {
        const fac = facData[facilityIndex];
        if (!fac || !modal) return;
        facPhotos = fac.photos;
        facIdx = 0;
        if (modalTitle) modalTitle.textContent = fac.label;
        if (modalDesc) modalDesc.textContent = fac.details;

        if (modalTrack) {
          while (modalTrack.firstChild) modalTrack.removeChild(modalTrack.firstChild);
          modalTrack.style.transform = 'translateX(0)';
          facPhotos.forEach((pi, i) => {
            const p = PHOTOS[pi];
            if (!p) return;
            const fig = document.createElement('figure');
            fig.className = 'fac-slide';
            const img = document.createElement('img');
            img.src = `https://cf.bstatic.com/xdata/images/hotel/max1280x900/${p.id}.jpg?k=${p.hash}&o=`;
            img.alt = p.alt;
            img.loading = i === 0 ? 'eager' : 'lazy';
            const cap = document.createElement('figcaption');
            cap.textContent = p.alt;
            fig.appendChild(img);
            fig.appendChild(cap);
            modalTrack.appendChild(fig);
          });
        }

        if (modalDots) {
          while (modalDots.firstChild) modalDots.removeChild(modalDots.firstChild);
          facPhotos.forEach((_, i) => {
            const btn = document.createElement('button');
            btn.className = `gallery-dot${i === 0 ? ' active' : ''}`;
            btn.setAttribute('aria-label', `Foto ${i + 1}`);
            btn.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
            btn.addEventListener('click', () => facGoTo(i));
            modalDots.appendChild(btn);
          });
        }

        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        if (!modal) return;
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      document.getElementById('fac-modal-close')?.addEventListener('click', closeModal);
      document.getElementById('fac-modal-backdrop')?.addEventListener('click', closeModal);
      document.getElementById('fac-prev')?.addEventListener('click', () => facGoTo(facIdx - 1));
      document.getElementById('fac-next')?.addEventListener('click', () => facGoTo(facIdx + 1));

      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (modal?.getAttribute('aria-hidden') !== 'false') return;
        if (e.key === 'Escape') closeModal();
        if (e.key === 'ArrowLeft') facGoTo(facIdx - 1);
        if (e.key === 'ArrowRight') facGoTo(facIdx + 1);
      });

      document
        .querySelectorAll<HTMLElement>('.facility-card[data-facility-idx]')
        .forEach((card) => {
          card.addEventListener('click', () => {
            const i = parseInt(card.dataset.facilityIdx ?? '0', 10);
            openModal(i);
          });
        });
    })();

    // Scroll reveal
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('revealed');
            observer.unobserve(e.target);
          }
        });
      },
      { threshold: 0.08 }
    );
    document.querySelectorAll('.reveal-section').forEach((el) => observer.observe(el));

    // Accordion
    document.querySelectorAll('.acc-trigger').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest('.acc-item') as HTMLElement;
        const isOpen = item.classList.contains('open');
        // Close all
        document.querySelectorAll('.acc-item').forEach((i) => {
          i.classList.remove('open');
          (i.querySelector('.acc-trigger') as HTMLButtonElement).setAttribute(
            'aria-expanded',
            'false'
          );
        });
        // Open clicked (if was closed)
        if (!isOpen) {
          item.classList.add('open');
          (trigger as HTMLButtonElement).setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Wave underline draw-on-scroll for hero wave
    const heroWavePath = document.querySelector('.hero-wave path') as SVGPathElement | null;
    if (heroWavePath) {
      const len = heroWavePath.getTotalLength?.() || 340;
      heroWavePath.style.strokeDasharray = String(len);
      heroWavePath.style.strokeDashoffset = String(len);
      heroWavePath.style.transition = 'stroke-dashoffset 800ms ease 300ms';
      const waveObs = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) {
            heroWavePath.style.strokeDashoffset = '0';
            waveObs.disconnect();
          }
        },
        { threshold: 0.2 }
      );
      waveObs.observe(heroWavePath.closest('.hero-wave') as Element);
    }
  </script>

  <!-- Fetch live price from /api/pricing and update displayed values -->
  <script>
    (async () => {
      try {
        const res = await fetch('/api/pricing');
        if (!res.ok) return;
        const data = (await res.json()) as { price_eur?: number; price_cents?: number };
        const priceEur = data.price_eur ?? (data.price_cents ? data.price_cents / 100 : 15);
        const label = `${priceEur} EUR`;

        const locRow = document.getElementById('info-price-locrow');
        if (locRow) locRow.textContent = `${label} / noche por persona`;

        const statEl = document.getElementById('info-price-stat');
        if (statEl) statEl.textContent = label;
      } catch {
        /* keep default 15 EUR */
      }
    })();
  </script>
</Layout>
