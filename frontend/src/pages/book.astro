  <style is:global>
    /* ─── BASE ─── */
    .wiz-wrap {
      min-height: 100vh;
      background: #fff9f0;
      display: flex;
      overflow-x: hidden;
    }

    /* ─── SIDEBAR ─── */
    .wiz-sidebar {
      display: none;
      width: 320px;
      flex-shrink: 0;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(8px);
      border-right: 3px solid rgba(212, 165, 116, 0.25);
      padding: 2rem;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
    }
    @media (min-width: 1024px) {
      .wiz-sidebar {
        display: flex;
        flex-direction: column;
      }
    }

    .sidebar-logo {
      text-align: center;
      margin-bottom: 2.5rem;
    }
    .sidebar-logo-btn {
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      display: block;
      margin: 0 auto 0.75rem;
      border-radius: 50%;
      transition:
        transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1),
        box-shadow 300ms;
    }
    .sidebar-logo-btn:hover {
      transform: scale(1.08) rotate(-3deg);
      box-shadow: 0 6px 20px rgba(0, 171, 57, 0.25);
    }
    .sidebar-logo-btn:active {
      transform: scale(0.95);
    }
    .s-logo {
      width: 64px;
      height: 64px;
      display: block;
      animation: logo-wobble-s 4s ease-in-out infinite;
    }
    @keyframes logo-wobble-s {
      0%,
      100% {
        transform: rotate(0deg) translateY(0);
      }
      25% {
        transform: rotate(-4deg) translateY(-2px);
      }
      75% {
        transform: rotate(4deg) translateY(-1px);
      }
    }
    .s-title {
      font-family: 'Cabin Sketch', cursive;
      font-size: 1.3rem;
      color: #00ab39;
      margin: 0;
    }
    .s-sub {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.85rem;
      color: #888;
      margin: 0.25rem 0 0;
    }

    .step-track {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .track-line {
      position: absolute;
      left: 29px;
      top: 40px;
      width: 2px;
      height: calc(100% - 40px);
      pointer-events: none;
    }

    .step-btn {
      display: flex;
      align-items: center;
      gap: 1rem;
      background: none;
      border: none;
      cursor: default;
      padding: 0;
      text-align: left;
      transition: opacity 200ms;
    }
    .step-btn.active {
      cursor: default;
    }

    /* ─── STEP CIRCLE: single-SVG approach — bg circle + icon in one SVG ─── */
    .step-circle {
      width: 60px;
      height: 60px;
      flex-shrink: 0;
      transition: transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .step-circle svg {
      display: block;
      overflow: visible;
    }
    .step-btn:hover:not([disabled]) .step-circle {
      transform: scale(1.1);
    }

    /* Active icon: gentle float animation on the <g> inside the SVG */
    .step-circle.active .step-svg-icon {
      animation: icon-float 2.8s ease-in-out infinite;
      transform-box: fill-box;
      transform-origin: center;
    }
    @keyframes icon-float {
      0%,
      100% {
        transform: translateY(0px);
      }
      48% {
        transform: translateY(-4px);
      }
    }

    /* Hover on inactive: icon group brightens toward brown */
    .step-btn:hover:not([disabled]) .step-circle:not(.active) .step-svg-icon {
      stroke: #5d4e37;
      transition: stroke 200ms;
    }

    /* Active state: JS adds class 'active' — bg circle turns green, icon turns white.
       Use > svg > circle to target ONLY the SVG's direct-child background circles,
       not icon circles nested inside the positioning <g>. */
    .step-circle.active > svg > circle:first-child {
      fill: #00ab39 !important;
      stroke: #005a1e !important;
      stroke-width: 2.5px !important;
    }
    .step-circle.active > svg > circle:nth-child(2) {
      stroke: rgba(255, 255, 255, 0.2) !important;
    }
    .step-circle.active .step-svg-icon {
      stroke: white !important;
    }
    /* fill="white" dots inside calendar icon must stay white when active */
    .step-circle.active .step-svg-icon circle[fill='white'] {
      fill: white !important;
      stroke: none !important;
    }

    /* Done state: JS adds class 'done' — circle turns mint, icon turns green */
    .step-circle.done > svg > circle:first-child {
      fill: #e8f5e9 !important;
      stroke: #00ab39 !important;
      stroke-width: 2px !important;
    }
    .step-circle.done > svg > circle:nth-child(2) {
      stroke: rgba(0, 171, 57, 0.15) !important;
    }
    .step-circle.done .step-svg-icon {
      stroke: #00ab39 !important;
      animation: icon-pop 400ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    /* filled dots inside icon stay visible in done state */
    .step-circle.done .step-svg-icon circle[fill='white'] {
      fill: #00ab39 !important;
      stroke: none !important;
    }
    @keyframes icon-pop {
      from {
        transform: scale(0.5) rotate(-8deg);
        opacity: 0;
      }
      80% {
        transform: scale(1.08) rotate(2deg);
        opacity: 1;
      }
      to {
        transform: scale(1) rotate(0deg);
        opacity: 1;
      }
    }

    .step-info {
      flex: 1;
      min-width: 0;
    }
    .step-num {
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #888;
    }
    .step-num.inactive {
      color: #aaa;
    }
    .step-label {
      font-family: 'Shadows Into Light', cursive;
      font-size: 1.1rem;
      color: #999;
      margin: 0;
      transition: color 300ms;
    }
    .step-label.active {
      color: #5d4e37;
    }
    .step-sub {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.8rem;
      color: #bbb;
      margin: 0;
    }
    .step-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .step-dot.active {
      background: #00ab39;
      animation: dot-pulse 2s ease-in-out infinite;
    }
    @keyframes dot-pulse {
      0%,
      100% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.4);
      }
    }

    /* ─── MAIN ─── */
    .wiz-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Mobile bar */
    .mobile-bar {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 249, 240, 0.95);
      backdrop-filter: blur(8px);
      border-bottom: 2px solid rgba(0, 171, 57, 0.15);
      padding: 0.75rem 1rem;
    }
    @media (min-width: 1024px) {
      .mobile-bar {
        display: none;
      }
    }
    .mb-logo {
      width: 44px;
      height: 44px;
      animation: logo-wobble-s 4s ease-in-out infinite;
    }
    .mb-title {
      font-family: 'Cabin Sketch', cursive;
      font-size: 1.1rem;
      color: #00ab39;
      margin: 0;
    }
    .mb-step {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.8rem;
      color: #888;
      margin: 0;
    }

    /* Progress bar */
    .prog-wrap {
      padding: 1rem 1.5rem 0;
    }
    .prog-bar {
      width: 100%;
      height: 8px;
      background: #e5e7eb;
      border-radius: 99px;
      overflow: hidden;
      margin-bottom: 0.4rem;
    }
    .prog-fill {
      height: 100%;
      background: linear-gradient(90deg, #006b24, #00ab39);
      border-radius: 99px;
      transition: width 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .prog-labels {
      display: flex;
      justify-content: space-between;
    }
    .prog-text {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.8rem;
      color: #888;
    }
    .prog-pct {
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.85rem;
      color: #00ab39;
      font-weight: 700;
    }

    /* Step panels */
    .step-panel {
      flex: 1;
      padding: 1.25rem 1.25rem 1.5rem;
      animation: step-enter 400ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    .step-panel.hidden {
      display: none !important;
    }
    @keyframes step-enter {
      from {
        opacity: 0;
        transform: translateX(30px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }
    .step-panel.exiting {
      animation: step-exit 300ms ease forwards;
    }
    @keyframes step-exit {
      from {
        opacity: 1;
        transform: translateX(0);
      }
      to {
        opacity: 0;
        transform: translateX(-30px);
      }
    }

    /* ─── STEP HEADER ─── */
    .step-header {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .step-header.center {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.5rem;
    }
    .step-header-icon {
      flex-shrink: 0;
    }
    .step-header-icon.large {
      margin-bottom: 0.25rem;
    }
    .step-title {
      font-family: 'Cabin Sketch', cursive;
      font-size: clamp(1.8rem, 5vw, 3rem);
      color: #5d4e37;
      margin: 0 0 0.25rem;
      line-height: 1.1;
    }
    .step-desc {
      font-family: 'Patrick Hand', cursive;
      font-size: 1.1rem;
      color: #888;
      margin: 0;
    }
    .step-hint {
      font-family: 'Shadows Into Light', cursive;
      font-size: 1.4rem;
      color: #00ab39;
      white-space: nowrap;
      margin-left: auto;
    }
    @media (max-width: 600px) {
      .step-hint {
        display: none;
      }
    }

    /* ─── STEP 1 TWO-COLUMN TOP ROW ─── */
    .step1-top-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.75rem;
      align-items: start;
      margin-bottom: 1.25rem;
    }
    @media (max-width: 600px) {
      .step1-top-row {
        grid-template-columns: 1fr;
      }
    }

    /* ─── DATE SUMMARY BAR ─── */
    .date-summary {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem;
      background: white;
      border: 2px solid #d4a574;
      border-radius: 14px;
      padding: 0.75rem 1rem;
      margin-bottom: 0;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      transition: box-shadow 200ms;
    }
    .date-chip {
      display: flex;
      flex-direction: column;
      padding: 0.4rem 0.8rem;
      background: #f5f5f5;
      border-radius: 8px;
      transition:
        background 200ms,
        transform 200ms;
    }
    .date-chip.filled {
      background: #e8f5e9;
      transform: translateY(-1px);
    }
    .chip-label {
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #888;
    }
    .chip-val {
      font-family: 'Shadows Into Light', cursive;
      font-size: 1.1rem;
      color: #00ab39;
    }
    .nights-chip {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      background: #00ab39;
      color: white;
      border-radius: 10px;
      padding: 0.5rem 1rem;
      font-family: 'Cabin Sketch', cursive;
      font-size: 1rem;
      animation: bounce-in-chip 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @keyframes bounce-in-chip {
      from {
        transform: scale(0);
        opacity: 0;
      }
      to {
        transform: scale(1);
        opacity: 1;
      }
    }
    .date-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-left: auto;
    }
    .time-hint {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.82rem;
      color: #888;
    }
    .clear-btn {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.85rem;
      color: #00ab39;
      background: none;
      border: none;
      cursor: pointer;
      text-decoration: underline;
      transition: color 150ms;
    }
    .clear-btn:hover {
      color: #006b24;
    }

    /* ─── PRICE CHIP & BREAKDOWN ─── */
    .price-chip {
      display: flex;
      flex-direction: column;
      align-items: center;
      background: linear-gradient(135deg, #006b24, #00ab39);
      color: white;
      border-radius: 10px;
      padding: 0.4rem 1rem;
      animation: bounce-in-chip 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .price-chip-label {
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.62rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      opacity: 0.85;
    }
    .price-chip-val {
      font-family: 'Shadows Into Light', cursive;
      font-size: 1.2rem;
      font-weight: 700;
    }
    .price-breakdown {
      width: 100%;
      margin-top: 0.5rem;
      padding-top: 0.5rem;
      border-top: 1.5px dashed #d4a574;
      animation: fade-in-up-uc 300ms ease;
    }
    .price-breakdown-rows {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }
    .price-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: 'Patrick Hand', cursive;
      font-size: 0.82rem;
      color: #5d4e37;
      padding: 0.15rem 0.25rem;
      border-radius: 6px;
      transition: background 150ms;
    }
    .price-row:hover {
      background: rgba(0, 171, 57, 0.06);
    }
    .price-row-night {
      opacity: 0.7;
    }
    .price-row-amt {
      font-weight: 700;
      color: #00ab39;
    }

    /* ─── PERSON PICKER ─── */
    .persons-picker {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.55rem;
      background: #f0fbf4;
      border: 2px solid #a5d6a7;
      border-radius: 12px;
      padding: 0.75rem 1rem;
      margin-bottom: 0;
      min-width: 140px;
    }
    .persons-label {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.95rem;
      color: #006b24;
      font-weight: 700;
    }
    .persons-control {
      display: flex;
      align-items: center;
      gap: 0.45rem;
    }
    .persons-btn {
      width: 30px;
      height: 30px;
      border-radius: 7px;
      border: 2px solid #00ab39;
      background: white;
      color: #00ab39;
      font-size: 1.2rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition:
        background 150ms,
        color 150ms,
        transform 100ms;
      line-height: 1;
    }
    .persons-btn:hover {
      background: #00ab39;
      color: white;
    }
    .persons-btn:active {
      transform: scale(0.92);
    }
    .persons-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      background: white;
      color: #00ab39;
    }
    .persons-input {
      width: 48px;
      text-align: center;
      font-family: 'Shadows Into Light', cursive;
      font-size: 1.3rem;
      color: #006b24;
      font-weight: 700;
      border: 2px solid #00ab39;
      border-radius: 8px;
      padding: 0.15rem 0.3rem;
      background: white;
      -moz-appearance: textfield;
    }
    .persons-input::-webkit-outer-spin-button,
    .persons-input::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    .persons-hint {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.8rem;
      color: #5d4e37;
    }

    /* ─── PILGRIM STEP NAVIGATOR (steps 2 & 3) ─── */
    .pilgrim-step-nav {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      background: #f0fbf4;
      border: 2px solid #a5d6a7;
      border-radius: 12px;
      padding: 0.65rem 1rem;
      margin-bottom: 1.25rem;
    }
    .pilgrim-step-nav-label {
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.82rem;
      color: #006b24;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      white-space: nowrap;
    }
    .pilgrim-step-tabs {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
    }

    /* ─── PERSON TABS (step 4) ─── */
    .person-tabs-wrap {
      margin-bottom: 0.75rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
    }
    .person-tabs-label {
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.8rem;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .person-tabs {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
    }
    .person-tab {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.85rem;
      padding: 0.35rem 0.8rem;
      border-radius: 20px;
      border: 2px solid #00ab39;
      background: white;
      color: #00ab39;
      cursor: pointer;
      transition:
        background 150ms,
        color 150ms;
    }
    .person-tab.active {
      background: #00ab39;
      color: white;
    }
    .person-tab.done {
      background: #e8f5e9;
      border-color: #a5d6a7;
      color: #006b24;
    }
    .person-tab.done::after {
      content: ' ✓';
    }

    .price-breakdown-total {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 0.35rem;
      padding-top: 0.35rem;
      border-top: 2px solid #d4a574;
      font-family: 'Cabin Sketch', cursive;
      font-size: 1rem;
      color: #5d4e37;
    }
    .price-total-label {
      font-weight: 700;
    }
    .price-total-amt {
      font-weight: 700;
      color: #00ab39;
      font-size: 1.15rem;
    }

    /* ─── CALENDAR ─── */
    .cal-wrap {
      position: relative;
      border-radius: 20px;
      padding: 1rem 1.5rem 1.5rem;
      min-height: 400px;
    }
    .cal-border {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      filter: drop-shadow(3px 4px 6px rgba(0, 0, 0, 0.08));
    }
    .cal-inner {
      position: relative;
      z-index: 2;
    }
    .cal-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.25rem;
      padding: 0 0.5rem;
    }
    .cal-month-title {
      font-family: 'Cabin Sketch', cursive;
      font-size: 1.8rem;
      color: #00ab39;
      margin: 0;
      transition:
        opacity 200ms,
        transform 200ms;
    }
    .cal-nav-btn {
      position: relative;
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: white;
      border: 3px solid #00ab39;
      color: #00ab39;
      cursor: pointer;
      transition:
        background 150ms,
        transform 150ms;
      border-radius: 50% 45% 48% 52% / 52% 48% 50% 50%;
    }
    .cal-nav-btn:hover {
      background: #e8f5e9;
      transform: scale(1.1);
    }
    .cal-nav-btn:active {
      transform: scale(0.92);
    }
    .nav-circle {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .cal-today-btn {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.82rem;
      color: #00ab39;
      background: #e8f5e9;
      border: 2px solid #00ab39;
      border-radius: 8px;
      padding: 0.3rem 0.75rem;
      cursor: pointer;
      transition: all 150ms;
      white-space: nowrap;
    }
    .cal-today-btn:hover {
      background: #00ab39;
      color: white;
      transform: scale(1.05);
    }
    .cal-today-btn:active {
      transform: scale(0.95);
    }
    .cal-dow-row {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 0.25rem;
      margin-bottom: 0.6rem;
      opacity: 0.9;
    }
    .cal-dow-row span {
      text-align: center;
      font-family: 'Cabin Sketch', cursive;
      font-size: clamp(0.75rem, 1.5vw, 1rem);
      color: #5d4e37;
      padding: 0.25rem 0;
    }
    .cal-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: clamp(3px, 0.6vw, 8px);
    }
    .cal-day {
      position: relative;
      aspect-ratio: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition:
        transform 150ms,
        box-shadow 150ms;
      border: none;
      background: none;
      padding: 0;
      gap: 0;
    }
    .cal-day:not(.disabled):hover {
      transform: scale(1.08);
      box-shadow: 0 3px 12px rgba(0, 171, 57, 0.15);
      z-index: 5;
    }
    .cal-day:not(.disabled):active {
      transform: scale(0.94);
    }
    .cal-day.disabled {
      cursor: not-allowed;
      opacity: 0.5;
    }
    .cal-day-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    .cal-day-num {
      position: relative;
      z-index: 2;
      font-family: 'Patrick Hand', cursive;
      font-size: clamp(0.78rem, 1.8vw, 1rem);
      color: #5d4e37;
      line-height: 1.1;
    }
    .cal-day-beds {
      position: relative;
      z-index: 2;
      font-family: 'Cabin Sketch', cursive;
      font-size: clamp(0.6rem, 1.4vw, 0.75rem);
      color: #00ab39;
      line-height: 1;
      opacity: 0.9;
      white-space: nowrap;
    }
    .cal-day-beds.low {
      color: #ed1c24;
      font-weight: 700;
    }
    .cal-day-beds.none {
      color: #999;
    }
    .cal-day-price {
      position: relative;
      z-index: 2;
      font-family: 'Patrick Hand', cursive;
      font-size: clamp(0.58rem, 1.2vw, 0.72rem);
      color: #5d4e37;
      opacity: 0.7;
      line-height: 1;
    }
    .cal-day.today .cal-day-num {
      color: white;
      font-family: 'Cabin Sketch', cursive;
    }
    .cal-day.today .cal-day-beds {
      color: white;
      opacity: 0.9;
    }
    .cal-day.today .cal-day-price {
      color: white;
      opacity: 0.7;
    }
    .cal-day.disabled .cal-day-num {
      color: #ccc;
    }
    .cal-day.disabled .cal-day-beds,
    .cal-day.disabled .cal-day-price {
      display: none;
    }
    .cal-day.in-range {
      background: rgba(0, 171, 57, 0.1);
      border-radius: 4px;
    }
    .cal-day.selected .cal-day-num,
    .cal-day.checkin .cal-day-num,
    .cal-day.checkout .cal-day-num {
      color: white;
      font-family: 'Cabin Sketch', cursive;
    }
    .cal-day.checkin .cal-day-beds,
    .cal-day.checkout .cal-day-beds {
      color: white;
      opacity: 0.9;
    }
    .cal-day.checkin .cal-day-price,
    .cal-day.checkout .cal-day-price {
      color: white;
      opacity: 0.7;
    }
    .cal-day.in-range .cal-day-beds {
      color: #006b24;
    }
    .cal-day.in-range .cal-day-price {
      color: #006b24;
      opacity: 0.7;
    }
    .today-dot {
      position: absolute;
      bottom: 4%;
      left: 50%;
      transform: translateX(-50%);
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: white;
      z-index: 3;
    }

    /* ─── DOC CARDS ─── */
    .doc-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      margin-bottom: 1.5rem;
    }
    @media (max-width: 560px) {
      .doc-cards {
        grid-template-columns: 1fr;
      }
    }
    .doc-card {
      position: relative;
      border-radius: 20px;
      background: white;
      border: 2.5px solid #d4a574;
      cursor: pointer;
      padding: 1.5rem;
      transition:
        transform 200ms,
        box-shadow 200ms,
        border-color 200ms;
      overflow: hidden;
    }
    .doc-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px rgba(212, 165, 116, 0.25);
    }
    .doc-card.selected {
      border-color: #00ab39;
      box-shadow: 0 0 0 3px rgba(0, 171, 57, 0.2);
    }
    .doc-card.selected .doc-selected-ring {
      display: block;
      animation: ring-grow 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .doc-selected-ring {
      display: none;
      position: absolute;
      top: 10px;
      right: 10px;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: #00ab39;
      background-image: url("data:image/svg+xml,%3Csvg width='14' height='10' viewBox='0 0 14 10' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 5L5 9L13 1' stroke='white' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-position: center;
    }
    @keyframes ring-grow {
      from {
        transform: scale(0);
      }
      to {
        transform: scale(1);
      }
    }
    .doc-card-inner {
      position: relative;
      z-index: 2;
    }
    .doc-illustration {
      margin-bottom: 1rem;
    }
    .doc-illustration svg {
      width: 100%;
      height: auto;
      max-height: 140px;
    }
    .doc-name {
      font-family: 'Cabin Sketch', cursive;
      font-size: 1.2rem;
      color: #5d4e37;
      margin: 0 0 0.25rem;
    }
    .doc-desc {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.9rem;
      color: #888;
      margin: 0 0 0.5rem;
    }
    .doc-req {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.82rem;
      color: #555;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .req-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .req-dot.green {
      background: #00ab39;
    }
    .req-dot.blue {
      background: #3b82f6;
    }

    /* ─── UPLOAD ZONE ─── */
    .upload-zone {
      margin-top: 1rem;
    }
    .upload-zone-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    @media (max-width: 560px) {
      .upload-zone-inner {
        grid-template-columns: 1fr;
      }
    }
    .upload-face {
      position: relative;
      border-radius: 16px;
      min-height: 140px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform 200ms;
    }
    .upload-face:hover {
      transform: scale(1.02);
    }
    .upload-border {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    .upload-content {
      position: relative;
      z-index: 2;
      text-align: center;
      padding: 1.5rem;
    }
    .upload-icon {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }
    .upload-label {
      font-family: 'Cabin Sketch', cursive;
      font-size: 1rem;
      color: #5d4e37;
      margin: 0 0 0.25rem;
    }
    .upload-hint {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.82rem;
      color: #aaa;
      margin: 0;
    }
    .upload-input {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
      width: 100%;
      height: 100%;
    }

    /* ─── INFO CARD (Step 3) ─── */
    .info-card {
      position: relative;
      border-radius: 16px;
      margin-bottom: 1rem;
    }
    .info-card-border {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    .info-card-inner {
      position: relative;
      z-index: 2;
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .info-section {
      padding: 0.85rem 0;
    }
    .info-section:first-child {
      padding-top: 0;
    }
    .info-section-title {
      font-family: 'Cabin Sketch', cursive;
      font-size: 1rem;
      color: #5d4e37;
      font-weight: 700;
      margin: 0 0 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.45rem;
    }
    .section-divider {
      height: 1px;
      background: rgba(212, 165, 116, 0.4);
      border: none;
      margin: 0;
      border-top: 1.5px dashed rgba(212, 165, 116, 0.5);
    }

    /* Form fields */
    .fg {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }
    .fl {
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #5d4e37;
    }
    .req {
      color: #ed1c24;
    }
    .fi {
      width: 100%;
      padding: 0.7rem 0.9rem;
      font-family: 'Patrick Hand', cursive;
      font-size: 1rem;
      color: #5d4e37;
      background: #fff9f0;
      border: 1.5px solid #e8e0d5;
      border-radius: 10px;
      outline: none;
      transition:
        border-color 200ms,
        box-shadow 200ms,
        transform 150ms;
    }
    .fi:focus {
      border-color: #00ab39;
      box-shadow:
        0 0 0 3px rgba(0, 171, 57, 0.12),
        0 2px 6px rgba(0, 171, 57, 0.08);
      transform: translateY(-1px);
    }
    .fi.invalid {
      border-color: #ed1c24;
      animation: shake-field 0.4s ease;
    }
    @keyframes shake-field {
      0%,
      100% {
        transform: translateX(0);
      }
      20% {
        transform: translateX(-5px);
      }
      40% {
        transform: translateX(5px);
      }
      60% {
        transform: translateX(-3px);
      }
      80% {
        transform: translateX(3px);
      }
    }
    .ferr {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.76rem;
      color: #ed1c24;
      display: none;
    }
    .fg.has-error .ferr {
      display: block;
      animation: fade-in-err 200ms ease;
    }
    @keyframes fade-in-err {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    .fg.has-error .fi {
      border-color: #ed1c24;
    }

    .form-row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      margin-top: 0.6rem;
    }
    .form-row-3 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 0.75rem;
    }
    @media (max-width: 660px) {
      .form-row-2 {
        grid-template-columns: 1fr;
      }
      .form-row-3 {
        grid-template-columns: 1fr;
      }
    }

    /* Phone input */
    .phone-wrap {
      display: flex;
      border: 1.5px solid #e8e0d5;
      border-radius: 10px;
      overflow: hidden;
      background: #fff9f0;
      transition:
        border-color 200ms,
        box-shadow 200ms;
    }
    .phone-wrap:focus-within {
      border-color: #00ab39;
      box-shadow: 0 0 0 3px rgba(0, 171, 57, 0.12);
    }
    .phone-wrap.invalid {
      border-color: #ed1c24;
    }
    .fg.has-error .phone-wrap {
      border-color: #ed1c24;
    }
    .phone-prefix {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.7rem 0.75rem;
      border-right: 1.5px solid #e8e0d5;
      background: #f5efe8;
      cursor: pointer;
      flex-shrink: 0;
      transition: background 150ms;
    }
    .phone-prefix:hover {
      background: #ede4d8;
    }
    .flag {
      font-size: 1.2rem;
    }
    .prefix-code {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.9rem;
      color: #5d4e37;
    }
    .phone-input {
      border: none !important;
      box-shadow: none !important;
      background: transparent !important;
      flex: 1;
      transform: none !important;
    }

    /* Phone prefix searchable dropdown */
    .phone-outer {
      position: relative;
    }
    .phone-prefix-drop {
      display: none;
      position: absolute;
      top: calc(100% + 2px);
      left: 0;
      z-index: 300;
      width: 280px;
      background: #fff;
      border: 1.5px solid #d4a574;
      border-radius: 10px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.14);
      overflow: hidden;
    }
    .phone-prefix-drop.open {
      display: block;
    }
    .phone-drop-search {
      width: 100%;
      box-sizing: border-box;
      padding: 0.6rem 0.75rem;
      border: none;
      border-bottom: 1.5px solid #e8e0d5;
      font-family: 'Patrick Hand', cursive;
      font-size: 0.9rem;
      color: #3d2b1f;
      background: #fff9f0;
      outline: none;
    }
    .phone-drop-search::placeholder {
      color: #b8a89a;
    }
    .phone-drop-list {
      max-height: 220px;
      overflow-y: auto;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .phone-drop-list li {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.5rem 0.75rem;
      cursor: pointer;
      font-family: 'Patrick Hand', cursive;
      font-size: 0.88rem;
      color: #3d2b1f;
      border-bottom: 1px solid #f3eae0;
    }
    .phone-drop-list li:last-child {
      border-bottom: none;
    }
    .phone-drop-list li:hover,
    .phone-drop-list li.active {
      background: #f0fff4;
    }
    .phone-drop-list .pdl-dial {
      margin-left: auto;
      color: #888;
      font-size: 0.82rem;
    }

    /* Country picker (nationality + address country) */
    .country-pick-wrap {
      display: flex;
      align-items: center;
      border: 1.5px solid #e8e0d5;
      border-radius: 10px;
      background: #fff9f0;
      padding-left: 0.7rem;
      transition:
        border-color 200ms,
        box-shadow 200ms;
      gap: 0.4rem;
    }
    .country-pick-wrap:focus-within {
      border-color: #00ab39;
      box-shadow: 0 0 0 3px rgba(0, 171, 57, 0.12);
    }
    .country-pick-flag {
      font-size: 1.2rem;
      flex-shrink: 0;
    }
    .country-pick-input {
      border: none !important;
      box-shadow: none !important;
      background: transparent !important;
      transform: none !important;
      padding-left: 0 !important;
      flex: 1;
    }
    .country-drop {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 200;
      margin: 2px 0 0;
      padding: 0;
      list-style: none;
      background: #fff;
      border: 1.5px solid #d4a574;
      border-radius: 8px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
      max-height: 220px;
      overflow-y: auto;
      display: none;
    }
    .country-drop li {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.55rem 0.9rem;
      cursor: pointer;
      font-family: 'Patrick Hand', cursive;
      font-size: 0.9rem;
      color: #3d2b1f;
      border-bottom: 1px solid #f3eae0;
      list-style: none;
    }
    .country-drop li:last-child {
      border-bottom: none;
    }
    .country-drop li:hover,
    .country-drop li.active {
      background: #f0fff4;
    }
    .country-drop .cdl-code {
      margin-left: auto;
      color: #aaa;
      font-size: 0.78rem;
    }

    /* Address */
    .addr-wrap {
      display: flex;
      align-items: center;
      border: 1.5px solid #e8e0d5;
      border-radius: 10px;
      background: #fff9f0;
      padding-left: 0.7rem;
      transition:
        border-color 200ms,
        box-shadow 200ms;
    }
    .addr-wrap:focus-within {
      border-color: #00ab39;
      box-shadow: 0 0 0 3px rgba(0, 171, 57, 0.12);
    }
    .addr-input {
      border: none !important;
      box-shadow: none !important;
      background: transparent !important;
      transform: none !important;
      padding-left: 0.4rem !important;
    }

    /* ─── BED SELECTION ─── */
    .bed-legend {
      display: flex;
      gap: 1.5rem;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
    }
    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-family: 'Patrick Hand', cursive;
      font-size: 0.9rem;
      color: #5d4e37;
    }
    .legend-dot {
      width: 14px;
      height: 14px;
      border-radius: 4px;
    }
    .legend-dot.available {
      background: #fff9f0;
      border: 2px solid #d4a574;
    }
    .legend-dot.occupied {
      background: #f5f5f5;
      border: 2px solid #e0e0e0;
    }
    .legend-dot.selected {
      background: #00ab39;
      border: 2px solid #006b24;
    }

    .dorm-wrap {
      position: relative;
      border-radius: 20px;
      margin-bottom: 1rem;
    }
    .dorm-border {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      filter: drop-shadow(2px 3px 8px rgba(0, 0, 0, 0.07));
    }
    .dorm-inner {
      position: relative;
      z-index: 2;
      padding: 1.5rem;
    }
    .bunk-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    @media (max-width: 560px) {
      .bunk-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .bunk {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .bunk-label {
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.85rem;
      color: #5d4e37;
      font-weight: 700;
      text-align: center;
    }

    .bed-btn {
      position: relative;
      width: 100%;
      aspect-ratio: 5/3;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      cursor: pointer;
      padding: 0;
      transition:
        transform 200ms,
        filter 200ms;
    }
    .bed-btn:not([data-state='occupied']):hover {
      transform: scale(1.06);
      filter: brightness(1.03);
    }
    .bed-btn:not([data-state='occupied']):active {
      transform: scale(0.94);
    }
    .bed-btn[data-state='occupied'] {
      cursor: not-allowed;
      opacity: 0.7;
    }
    .bed-btn[data-state='selected'] .bed-bg rect {
      fill: #e8f5e9 !important;
      stroke: #00ab39 !important;
      stroke-width: 3 !important;
    }
    .bed-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    .bed-pos {
      position: relative;
      z-index: 2;
      font-family: 'Patrick Hand', cursive;
      font-size: 0.85rem;
      color: #5d4e37;
    }
    .occupied-text {
      color: #aaa;
      text-decoration: line-through;
    }
    .bed-selection-hint {
      text-align: center;
      font-family: 'Patrick Hand', cursive;
      font-size: 0.9rem;
      color: #aaa;
    }

    /* ─── UPLOAD PHASE (Step 2 transition) ─── */
    .squiggle-line {
      width: 140px;
      height: 12px;
      margin: 0.5rem auto 0;
      display: block;
    }
    .doc-card-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    .upload-formats {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.72rem;
      color: #bbb;
      margin: 0.4rem 0 0;
    }
    .upload-cam-icon {
      margin-bottom: 0.5rem;
    }
    .upload-doc-icon {
      display: block;
      margin-bottom: 0.75rem;
    }
    .upload-doc-icon svg {
      display: block;
      margin: 0 auto;
      filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.1));
    }
    .upload-doc-icon .upload-cam-icon {
      margin-bottom: 0;
    }

    .doc-cards.phase-out {
      animation: cards-slide-up 400ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    @keyframes cards-slide-up {
      0% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      100% {
        opacity: 0;
        transform: translateY(-30px) scale(0.95);
      }
    }

    .upload-phase {
      animation: upload-slide-in 450ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    @keyframes upload-slide-in {
      0% {
        opacity: 0;
        transform: translateY(20px) scale(0.96);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    .upload-phase.phase-out {
      animation: upload-slide-out 350ms ease forwards;
    }
    @keyframes upload-slide-out {
      0% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      100% {
        opacity: 0;
        transform: translateY(20px) scale(0.96);
      }
    }
    .doc-cards.phase-in {
      animation: cards-slide-down 400ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    @keyframes cards-slide-down {
      0% {
        opacity: 0;
        transform: translateY(-20px) scale(0.95);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .selected-doc-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #e8f5e9;
      border: 2px solid #00ab39;
      border-radius: 14px;
      padding: 0.75rem 1.25rem;
      margin-bottom: 1.25rem;
      animation: bar-pop 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @keyframes bar-pop {
      from {
        transform: scale(0.9);
        opacity: 0;
      }
      to {
        transform: scale(1);
        opacity: 1;
      }
    }
    .selected-doc-info {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .selected-doc-icon {
      font-size: 1.5rem;
    }
    .selected-doc-label {
      font-family: 'Cabin Sketch', cursive;
      font-size: 1.05rem;
      color: #006b24;
      font-weight: 700;
    }
    .change-doc-btn {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.9rem;
      color: #00ab39;
      background: white;
      border: 1.5px solid #00ab39;
      border-radius: 10px;
      padding: 0.4rem 0.9rem;
      cursor: pointer;
      transition:
        background 150ms,
        transform 150ms;
    }
    .change-doc-btn:hover {
      background: #e8f5e9;
      transform: scale(1.05);
    }

    .upload-complete {
      margin-top: 1rem;
      animation: fade-in-up-uc 300ms ease;
    }
    @keyframes fade-in-up-uc {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    .uploaded-file-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: #e8f5e9;
      border: 1.5px solid #a5d6a7;
      border-radius: 12px;
      padding: 0.75rem 1rem;
    }
    .uploaded-file-check {
      width: 28px;
      height: 28px;
      flex-shrink: 0;
      background: #00ab39;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .uploaded-file-check svg {
      display: block;
    }
    .check-draw {
      stroke-dasharray: 30;
      stroke-dashoffset: 30;
      animation: draw-check 500ms ease 150ms forwards;
    }
    @keyframes draw-check {
      to {
        stroke-dashoffset: 0;
      }
    }
    .uploaded-file-name {
      flex: 1;
      font-family: 'Patrick Hand', cursive;
      font-size: 0.95rem;
      color: #006b24;
    }
    .uploaded-file-remove {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 1.3rem;
      color: #888;
      line-height: 1;
      transition:
        color 150ms,
        transform 150ms;
    }
    .uploaded-file-remove:hover {
      color: #ed1c24;
      transform: scale(1.2);
    }

    .ocr-result {
      margin-top: 1rem;
      background: #fafafa;
      border: 1.5px solid #e0e0e0;
      border-radius: 12px;
      padding: 1rem 1.25rem;
      animation: fade-in-up-uc 400ms ease;
    }
    .ocr-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.9rem;
      color: #00ab39;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }
    .ocr-fields {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem 1.5rem;
    }
    @media (max-width: 500px) {
      .ocr-fields {
        grid-template-columns: 1fr;
      }
    }
    .ocr-field {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .ocr-label {
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #888;
    }
    .ocr-value {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.95rem;
      color: #5d4e37;
    }

    /* ─── ISO BED GRID (Step 4) ─── */
    .legend-swatch {
      width: 18px;
      height: 18px;
      border-radius: 5px;
      border: 2px solid;
      display: inline-block;
    }
    .dorm-title {
      font-family: 'Cabin Sketch', cursive;
      font-size: 1.05rem;
      color: #5d4e37;
      font-weight: 700;
      margin: 0 0 1rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .dorm-range {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.9rem;
      color: #888;
      font-weight: 400;
    }
    .iso-bed-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem 0.6rem;
    }
    @media (max-width: 400px) {
      .iso-bed-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .bunk-cell {
      position: relative;
      width: 100%;
      transition: transform 200ms;
    }
    .bunk-cell:hover {
      transform: translateY(-3px);
    }
    .bunk-cell svg {
      width: 100%;
      height: auto;
      display: block;
    }
    .bunk-cell .bunk-label {
      text-align: center;
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.72rem;
      color: #5d4e37;
      margin-top: 0.15rem;
      font-weight: 700;
    }
    /* Clickable zones within each bunk SVG */
    .bunk-zone {
      cursor: pointer;
      transition:
        opacity 150ms,
        transform 150ms;
    }
    .bunk-zone:hover:not(.occupied) {
      opacity: 0.8;
      transform: scale(1.03);
    }
    .bunk-zone.occupied {
      cursor: not-allowed;
    }
    .bunk-zone.occupied:hover {
      opacity: 1;
    }
    .bunk-zone.selected {
      filter: brightness(1.05);
    }

    /* Bed info card */
    .bed-info-card {
      margin-top: 1.25rem;
      background: white;
      border: 2.5px solid #0071bc;
      border-radius: 16px;
      padding: 1rem 1.25rem;
      animation: bed-card-pop 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @keyframes bed-card-pop {
      from {
        transform: scale(0.85);
        opacity: 0;
      }
      to {
        transform: scale(1);
        opacity: 1;
      }
    }
    .bed-info-inner {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .bed-info-badge {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #0071bc;
      color: white;
      font-size: 0.9rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      align-self: flex-end;
    }
    .bed-info-header {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .bed-info-num {
      font-family: 'Cabin Sketch', cursive;
      font-size: 1.2rem;
      color: #0071bc;
      font-weight: 700;
    }
    .bed-info-detail {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .bed-info-position {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.95rem;
      color: #5d4e37;
      margin: 0;
    }
    .bed-info-bunk {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.85rem;
      color: #888;
      margin: 0.1rem 0 0;
    }
    .bed-info-divider {
      height: 1.5px;
      background: rgba(0, 113, 188, 0.2);
      border-top: 1px dashed rgba(0, 113, 188, 0.3);
    }
    .bed-info-dorm {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.9rem;
      color: #5d4e37;
      margin: 0;
    }

    .bed-ready {
      text-align: center;
      margin-top: 1rem;
      animation: fade-in-up-uc 400ms ease;
    }
    .bed-ready-title {
      font-family: 'Shadows Into Light', cursive;
      font-size: 1.4rem;
      color: #00ab39;
      margin: 0;
    }
    .bed-ready-sub {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.9rem;
      color: #888;
      margin: 0.2rem 0 0;
    }

    /* Bunk illustration in info card */
    .bunk-illus {
      width: 48px;
      height: 48px;
      flex-shrink: 0;
    }
    .bunk-illus svg {
      width: 100%;
      height: 100%;
    }

    /* ─── NIGHT TABS ─── */
    .night-tabs-wrap {
      margin-bottom: 1rem;
      padding: 0.75rem 1rem;
      background: white;
      border: 2px solid #d4a574;
      border-radius: 14px;
    }
    .night-tabs-label {
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #5d4e37;
      margin-bottom: 0.5rem;
    }
    .night-tabs {
      display: flex;
      gap: 0.35rem;
      flex-wrap: wrap;
    }
    .night-tab {
      position: relative;
      padding: 0.35rem 0.7rem;
      font-family: 'Patrick Hand', cursive;
      font-size: 0.85rem;
      border: 2px solid #d4a574;
      border-radius: 10px;
      background: #fff9f0;
      color: #5d4e37;
      cursor: pointer;
      transition: all 200ms;
    }
    .night-tab:hover {
      border-color: #00ab39;
      background: #e8f5e9;
    }
    .night-tab.active {
      border-color: #00ab39;
      background: #00ab39;
      color: white;
      font-weight: 700;
      box-shadow: 0 2px 8px rgba(0, 171, 57, 0.2);
    }
    .night-tab.assigned {
      border-color: #0071bc;
      background: #e3f2fd;
    }
    .night-tab.assigned.active {
      background: #0071bc;
      color: white;
      border-color: #0071bc;
    }
    .night-tab-dot {
      display: inline-block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      margin-left: 0.3rem;
      vertical-align: middle;
    }

    /* ─── BED SCHEDULE ─── */
    .bed-schedule {
      margin-top: 1rem;
      background: white;
      border: 2px solid #d4a574;
      border-radius: 14px;
      padding: 0.75rem 1rem;
      animation: fade-in-up-uc 350ms ease;
    }
    .bed-schedule-header {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.85rem;
      font-weight: 700;
      color: #00ab39;
      margin-bottom: 0.5rem;
    }
    .bed-schedule-rows {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }
    .sched-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.3rem 0.6rem;
      border-radius: 8px;
      font-family: 'Patrick Hand', cursive;
      font-size: 0.85rem;
      color: #5d4e37;
      background: #f9f9f6;
      border: 1px solid #e8e0d5;
    }
    .sched-night {
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.72rem;
      font-weight: 700;
      color: white;
      background: #00ab39;
      border-radius: 6px;
      padding: 0.15rem 0.4rem;
      min-width: 52px;
      text-align: center;
    }
    .sched-bed {
      flex: 1;
    }
    .sched-remove {
      background: none;
      border: none;
      cursor: pointer;
      color: #aaa;
      font-size: 1rem;
      transition: color 150ms;
    }
    .sched-remove:hover {
      color: #ed1c24;
    }
    .sched-empty {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.82rem;
      color: #bbb;
      font-style: italic;
      padding: 0.2rem 0;
    }

    /* ─── BED TOOLTIP (Chart.js style) ─── */
    .bed-tooltip {
      position: fixed;
      z-index: 999;
      pointer-events: none;
      background: rgba(30, 30, 30, 0.92);
      backdrop-filter: blur(6px);
      border-radius: 10px;
      padding: 0.65rem 0.85rem;
      min-width: 180px;
      max-width: 260px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
      transition:
        opacity 150ms,
        transform 100ms;
    }
    .bed-tooltip-arrow {
      position: absolute;
      bottom: -6px;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 0;
      border-left: 7px solid transparent;
      border-right: 7px solid transparent;
      border-top: 7px solid rgba(30, 30, 30, 0.92);
    }
    .bed-tooltip-title {
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.9rem;
      font-weight: 700;
      color: white;
      margin-bottom: 0.35rem;
    }
    .bed-tooltip-status {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-family: 'Patrick Hand', cursive;
      font-size: 0.82rem;
      color: #ccc;
      margin-bottom: 0.3rem;
    }
    .tt-dot {
      width: 8px;
      height: 8px;
      border-radius: 3px;
      flex-shrink: 0;
    }
    .bed-tooltip-nights {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }
    .tt-night-row {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-family: 'Patrick Hand', cursive;
      font-size: 0.78rem;
    }
    .tt-night-label {
      color: #aaa;
      min-width: 48px;
    }
    .tt-night-val {
      color: white;
    }
    .tt-night-val.avail {
      color: #a5d6a7;
    }
    .tt-night-val.unavail {
      color: #ef9a9a;
    }
    .tt-night-val.selected {
      color: #90caf9;
    }

    /* ─── BUNK ANIMATIONS ─── */
    .bunk-cell {
      animation: bunk-float 4s ease-in-out infinite;
    }
    .bunk-cell:nth-child(2) {
      animation-delay: -0.7s;
    }
    .bunk-cell:nth-child(3) {
      animation-delay: -1.4s;
    }
    .bunk-cell:nth-child(4) {
      animation-delay: -2.1s;
    }
    .bunk-cell:nth-child(5) {
      animation-delay: -2.8s;
    }
    .bunk-cell:nth-child(6) {
      animation-delay: -3.5s;
    }
    @keyframes bunk-float {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-3px);
      }
    }
    .bunk-cell:hover {
      animation: none;
      transform: translateY(-4px) scale(1.03);
    }

    /* ─── PAYMENT ─── */
    .payment-card {
      position: relative;
      border-radius: 16px;
      margin-bottom: 1rem;
    }
    .payment-inner {
      position: relative;
      z-index: 2;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .price-summary-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #e8f5e9;
      border-radius: 12px;
      padding: 0.9rem 1.25rem;
      margin-bottom: 0.5rem;
    }
    .psb-label {
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.9rem;
      color: #006b24;
      font-weight: 700;
      text-transform: uppercase;
    }
    .psb-val {
      font-family: 'Shadows Into Light', cursive;
      font-size: 2rem;
      color: #00ab39;
    }
    .card-input-wrap {
      position: relative;
    }
    .card-number {
      padding-right: 3.5rem !important;
      letter-spacing: 0.1em;
    }
    .card-icons {
      position: absolute;
      right: 0.75rem;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
    }
    .cvv-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }
    .cvv-help {
      position: absolute;
      right: 0.75rem;
      background: none;
      border: none;
      cursor: pointer;
      color: #888;
      display: flex;
      transition: color 150ms;
    }
    .cvv-help:hover {
      color: #00ab39;
    }
    .security-note {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-family: 'Patrick Hand', cursive;
      font-size: 0.82rem;
      color: #888;
      background: #f0fff4;
      border-radius: 8px;
      padding: 0.6rem 0.9rem;
    }

    /* ─── SUMMARY ─── */
    .summary-card {
      position: relative;
      border-radius: 16px;
      margin-bottom: 1.5rem;
    }
    .summary-inner {
      position: relative;
      z-index: 2;
      padding: 1.75rem;
    }
    .summary-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 0;
      border-bottom: 1px dashed rgba(212, 165, 116, 0.3);
    }
    .summary-row:last-child {
      border-bottom: none;
    }
    .sum-label {
      font-family: 'Patrick Hand', cursive;
      font-size: 0.95rem;
      color: #888;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .sum-val {
      font-family: 'Cabin Sketch', cursive;
      font-size: 1rem;
      color: #5d4e37;
      text-align: right;
    }
    .summary-divider {
      height: 2px;
      background: rgba(212, 165, 116, 0.4);
      margin: 0.5rem 0;
    }
    .total-row {
      padding-top: 1rem;
    }
    .total-label {
      font-family: 'Cabin Sketch', cursive;
      font-size: 1.1rem;
      color: #1a1a1a;
      font-weight: 700;
    }
    .total-val {
      font-family: 'Shadows Into Light', cursive;
      font-size: 2.2rem;
      color: #00ab39;
    }

    .btn-confirm {
      position: relative;
      width: 100%;
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      cursor: pointer;
      border-radius: 14px;
      transition: transform 200ms;
      overflow: hidden;
      animation: cta-rock 3.5s ease-in-out infinite;
    }
    .btn-confirm:hover {
      animation: none;
      transform: scale(1.06) rotateZ(-3deg) translateY(-3px);
    }
    .btn-confirm:active {
      transform: scale(0.95);
      animation: none;
    }
    @keyframes cta-rock {
      0%,
      100% {
        transform: rotate(0deg) translateY(0);
      }
      25% {
        transform: rotate(-2deg) translateY(-2px);
      }
      75% {
        transform: rotate(2deg) translateY(-1px);
      }
    }
    .confirm-label {
      position: relative;
      z-index: 2;
      font-family: 'Cabin Sketch', cursive;
      font-size: 1.1rem;
      font-weight: 700;
      color: white;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    /* Wave underline */
    .wave-line {
      width: 120px;
      height: 12px;
    }
    .wave-line svg {
      width: 100%;
      height: 100%;
    }

    /* ─── CONFIRMED ─── */
    .confirmed-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 2rem 1rem;
      gap: 1rem;
    }
    .confirmed-circle {
      width: 90px;
      height: 90px;
    }
    .confirmed-circle svg {
      width: 100%;
      height: 100%;
    }
    .conf-ring {
      stroke-dasharray: 151;
      stroke-dashoffset: 151;
      transition: stroke-dashoffset 700ms ease 200ms;
    }
    .conf-check {
      stroke-dasharray: 50;
      stroke-dashoffset: 50;
      transition: stroke-dashoffset 600ms ease 900ms;
    }
    .confirmed-wrap.show .conf-ring {
      stroke-dashoffset: 0;
    }
    .confirmed-wrap.show .conf-check {
      stroke-dashoffset: 0;
    }
    .confirmed-title {
      font-family: 'Shadows Into Light', cursive;
      font-size: 2.5rem;
      color: #00ab39;
      margin: 0;
      animation: bounce-in 500ms cubic-bezier(0.34, 1.56, 0.64, 1) 1.2s both;
    }
    .confirmed-sub {
      font-family: 'Patrick Hand', cursive;
      font-size: 1.1rem;
      color: #555;
      margin: 0;
      animation: fade-in-up-c 400ms ease 1.4s both;
    }
    @keyframes bounce-in {
      from {
        transform: scale(0.5);
        opacity: 0;
      }
      to {
        transform: scale(1);
        opacity: 1;
      }
    }
    @keyframes fade-in-up-c {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    .confirmed-ref {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.2rem;
      padding: 0.75rem 1.5rem;
      background: #e8f5e9;
      border-radius: 12px;
      animation: fade-in-up-c 400ms ease 1.6s both;
    }
    .ref-label {
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.75rem;
      color: #006b24;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .ref-val {
      font-family: 'Shadows Into Light', cursive;
      font-size: 1.5rem;
      color: #00ab39;
    }
    .confirmed-btns {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 1rem;
      animation: fade-in-up-c 400ms ease 1.8s both;
    }
    .btn-conf-primary,
    .btn-conf-secondary {
      position: relative;
      padding: 0.8rem 1.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 160px;
      border-radius: 12px;
      text-decoration: none;
      cursor: pointer;
      transition: transform 200ms;
    }
    .btn-conf-primary:hover,
    .btn-conf-secondary:hover {
      transform: translateY(-3px) scale(1.04);
    }
    .conf-btn-label {
      position: relative;
      z-index: 2;
      font-family: 'Cabin Sketch', cursive;
      font-size: 0.95rem;
      font-weight: 700;
      color: white;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .conf-btn-label.sec {
      color: #00ab39;
    }

    /* ─── BOTTOM NAV ─── */
    .wiz-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 40;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 1.5rem;
      background: rgba(255, 249, 240, 0.95);
      backdrop-filter: blur(8px);
      border-top: 2px solid rgba(212, 165, 116, 0.2);
    }
    /* On desktop, sidebar is 320px wide — offset fixed nav accordingly */
    @media (min-width: 1024px) {
      .wiz-nav {
        left: 320px;
      }
    }
    /* Add bottom padding so content isn't hidden behind the fixed nav (~88px tall) */
    .wiz-main {
      padding-bottom: 100px;
    }
    .btn-back,
    .btn-next {
      position: relative;
      padding: 0.9rem 2rem;
      border: none;
      cursor: pointer;
      border-radius: 12px;
      transition:
        transform 200ms,
        opacity 200ms;
      min-width: 140px;
    }
    .btn-back:hover {
      transform: translateX(-3px) scale(1.04);
    }
    .btn-next:hover:not(:disabled) {
      transform: translateX(3px) scale(1.04);
    }
    .btn-back:active,
    .btn-next:active {
      transform: scale(0.95);
    }
    .btn-next:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }
    .nav-btn-label {
      position: relative;
      z-index: 2;
      font-family: 'Cabin Sketch', cursive;
      font-size: 1rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: white;
    }
    .back-label {
      color: #00ab39;
    }

    /* Ripple */
    .ripple-wave {
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.35);
      transform: scale(0);
      pointer-events: none;
      animation: ripple-go 600ms linear;
    }
    @keyframes ripple-go {
      to {
        transform: scale(4);
        opacity: 0;
      }
    }

    @media (max-width: 480px) {
      .btn-back,
      .btn-next {
        min-width: 110px;
        padding: 0.8rem 1.25rem;
      }
      .step-panel {
        padding: 1rem;
      }
    }

    /* ─── HOME CONFIRMATION MODAL ─── */
    .home-modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 10000;
      background: rgba(93, 78, 55, 0.45);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 220ms ease;
    }
    .home-modal-overlay.open {
      opacity: 1;
      pointer-events: auto;
    }

    .home-modal {
      position: relative;
      background: #fff9f0;
      border-radius: 20px;
      padding: 2.25rem 2rem 1.75rem;
      max-width: 360px;
      width: calc(100% - 2rem);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
      transform: scale(0.85) translateY(20px);
      transition:
        transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
        opacity 220ms ease;
      opacity: 0;
      text-align: center;
    }
    .home-modal-overlay.open .home-modal {
      transform: scale(1) translateY(0);
      opacity: 1;
    }

    /* Doodle border ring */
    .home-modal::before {
      content: '';
      position: absolute;
      inset: -3px;
      border-radius: 22px;
      border: 2.5px dashed rgba(212, 165, 116, 0.55);
      pointer-events: none;
    }

    .home-modal-icon {
      width: 56px;
      height: 56px;
      margin: 0 auto 1rem;
      background: #fff0e0;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #d4a574;
    }
    .home-modal-title {
      font-family: 'Cabin Sketch', cursive;
      font-size: 1.4rem;
      color: #5d4e37;
      margin: 0 0 0.5rem;
    }
    .home-modal-body {
      font-family: 'Patrick Hand', cursive;
      font-size: 1rem;
      color: #888;
      margin: 0 0 1.75rem;
      line-height: 1.5;
    }
    .home-modal-body strong {
      color: #5d4e37;
    }
    .home-modal-actions {
      display: flex;
      gap: 0.75rem;
      justify-content: center;
    }
    .hm-btn {
      font-family: 'Patrick Hand', cursive;
      font-size: 1rem;
      font-weight: 700;
      padding: 0.7rem 1.5rem;
      border-radius: 10px;
      cursor: pointer;
      border: 2.5px solid transparent;
      transition:
        background 160ms,
