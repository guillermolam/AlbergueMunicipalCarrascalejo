---
export const prerender = false;

const embed = Astro.url.searchParams.get('embed') === '1';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Albergue Carrascalejo – Modelo 3D</title>
    <style>
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #2a3a50;
        font-family: system-ui, sans-serif;
      }
      body[data-embed='1'] {
        background: transparent;
      }
      body[data-embed='1'] #ld {
        background: transparent;
      }
      #c {
        width: 100vw;
        height: 100vh;
      }
      #info {
        position: fixed;
        top: 1rem;
        left: 1rem;
        z-index: 9;
        color: #fff;
        background: rgba(10, 18, 35, 0.72);
        backdrop-filter: blur(8px);
        padding: 0.75rem 1rem;
        border-radius: 10px;
        font-size: 0.8rem;
        border: 1px solid rgba(255, 255, 255, 0.13);
        max-width: 205px;
        pointer-events: none;
      }
      #info h2 {
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 0.2rem;
      }
      #info p {
        opacity: 0.76;
        font-size: 0.73rem;
        line-height: 1.45;
      }
      #legend {
        position: fixed;
        bottom: 3.8rem;
        left: 1rem;
        z-index: 9;
        color: #fff;
        background: rgba(10, 18, 35, 0.65);
        backdrop-filter: blur(6px);
        padding: 0.55rem 0.8rem;
        border-radius: 8px;
        font-size: 0.71rem;
        border: 1px solid rgba(255, 255, 255, 0.12);
        pointer-events: none;
      }
      #legend .r {
        display: flex;
        align-items: center;
        gap: 0.38rem;
        margin: 0.14rem 0;
      }
      #legend .s {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        flex-shrink: 0;
      }
      #hint {
        position: fixed;
        bottom: 1rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9;
        color: rgba(255, 255, 255, 0.7);
        background: rgba(0, 0, 0, 0.42);
        padding: 0.38rem 1rem;
        border-radius: 20px;
        font-size: 0.72rem;
        white-space: nowrap;
        pointer-events: none;
      }
      #ld {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #2a3a50;
        color: #fff;
        font-size: 1rem;
        z-index: 20;
        transition: opacity 0.6s;
      }
    </style>
  </head>
  <body data-embed={embed ? '1' : '0'}>
    <div id="ld">Cargando modelo 3D…</div>
    <div id="c"></div>
    <div id="info" style={embed ? 'display:none' : undefined}>
      <h2>Albergue Municipal</h2>
      <p>El Carrascalejo, Cáceres<br />Extremadura · Vía de la Plata</p>
      <p style="margin-top:.3rem;opacity:.5;font-size:.68rem">
        Ref. 0830102QD3203S<br />24 plazas · €15/noche · ★ 4.6
      </p>
    </div>
    <div id="legend" style={embed ? 'display:none' : undefined}>
      <div class="r"><span class="s" style="background:#f0ead8"></span>Albergue (Alas A y B)</div>
      <div class="r">
        <span class="s" style="background:#c96c2a"></span>Cubierta árabe terracota
      </div>
      <div class="r"><span class="s" style="background:#d4a820"></span>Zócalo ochre</div>
      <div class="r">
        <span class="s" style="background:#f0ead8;border:1px solid #ccc"></span>Nave / polideportivo
      </div>
      <div class="r"><span class="s" style="background:#a89e78"></span>Parcela (27.290 m²)</div>
    </div>
    <div id="hint" style={embed ? 'display:none' : undefined}>
      Arrastrar: rotar · Rueda: zoom · Clic derecho: desplazar
    </div>

    <script>
      import * as THREE from 'three';
      import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

      const EMBED = document.body.dataset.embed === '1';

      // ── Geo helpers (parcel KML reference point) ─────────────────────────────────
      const C_LON = -6.33643424,
        C_LAT = 39.0237316;
      const LON_M = 111320 * Math.cos((C_LAT * Math.PI) / 180); // ≈86 511 m/°
      const LAT_M = 111320;
      function sv(lon: number, lat: number) {
        return new THREE.Vector2((lon - C_LON) * LON_M, -(lat - C_LAT) * LAT_M);
      }

      // ── KML parcel outer boundary ────────────────────────────────────────────────
      const PARCEL = [
        [-6.33683342224783, 39.0239355547523],
        [-6.33698461893749, 39.0239382886597],
        [-6.33711270189528, 39.0239598645919],
        [-6.33759893378039, 39.0241903570446],
        [-6.33760463600712, 39.0241922892074],
        [-6.33774067263712, 39.0241343139493],
        [-6.337905510814, 39.0240997949808],
        [-6.33808417875299, 39.0241706367513],
        [-6.33818883506123, 39.0242223092704],
        [-6.33825689974765, 39.0242305313978],
        [-6.33825888515365, 39.0242299461059],
        [-6.33821982095171, 39.0241906736224],
        [-6.33818395882724, 39.0241614747028],
        [-6.33814808126133, 39.0241266896211],
        [-6.33810992962716, 39.0240846450841],
        [-6.33807640784608, 39.0240454091443],
        [-6.33804633152809, 39.0240097655833],
        [-6.33786465599791, 39.0238718479061],
        [-6.33754684574956, 39.023634126659],
        [-6.33740691814011, 39.023503536999],
        [-6.33725335044535, 39.0233086691552],
        [-6.33722847533949, 39.0233081368273],
        [-6.33700413298683, 39.0232805505239],
        [-6.33689833655571, 39.0232675426925],
        [-6.33680331239796, 39.0232558576139],
        [-6.33673720182603, 39.0232477296872],
        [-6.33661879964328, 39.0232331680135],
        [-6.3364342868886, 39.0232104784132],
        [-6.33624972729918, 39.0231878057614],
        [-6.33606520860565, 39.0231651205301],
        [-6.33590128683075, 39.0231449420303],
        [-6.33588074268571, 39.0231424139811],
        [-6.33568267553717, 39.0231180587695],
        [-6.33577372015411, 39.0229469203798],
        [-6.33533589540283, 39.0231970621766],
        [-6.33536181615248, 39.0232218806287],
        [-6.33504167964385, 39.0234260923926],
        [-6.33475577374852, 39.023606837565],
        [-6.3346596931458, 39.0236697259289],
        [-6.33464608146261, 39.023793838819],
        [-6.33464057453927, 39.0239987662468],
        [-6.3345942601072, 39.0241556377655],
        [-6.33458359211148, 39.0243226935055],
        [-6.33456403766845, 39.0244466661062],
        [-6.33457750434695, 39.0244417483687],
        [-6.33473541134361, 39.0244624741503],
        [-6.33491902949468, 39.024463160448],
        [-6.33526189358185, 39.0243995546706],
        [-6.33552066829085, 39.0243240271547],
        [-6.33593832877769, 39.0242554634487],
        [-6.336293132451, 39.0241939278452],
        [-6.33643141175623, 39.0241163679082],
        [-6.33654596664503, 39.0240737583096],
        [-6.33672885058153, 39.0240537062811],
        [-6.33683342224783, 39.0239355547523],
      ];

      // KML exact almacén footprint, h=3 m
      const ALMACEN = [
        [-6.3372527185697, 39.0239313823508],
        [-6.33719902007271, 39.0239188936946],
        [-6.33706411764078, 39.0238913058556],
        [-6.33704897768603, 39.0239407817408],
        [-6.33718042159802, 39.0239682004632],
        [-6.33718571738123, 39.0239532758179],
        [-6.3372388490359, 39.0239654812414],
      ];

      // ── Scene ─────────────────────────────────────────────────────────────────────
      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x91c5e0);
      scene.fog = new THREE.Fog(0xb0cfe0, 320, 650);

      const W = window.innerWidth,
        H = window.innerHeight;
      // Camera from the SW (road side) to see the west / front face of the hostel
      const camera = new THREE.PerspectiveCamera(50, W / H, 0.5, 800);
      camera.position.set(-200, 85, -40);
      camera.lookAt(-95, 5, 20);

      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: EMBED });
      renderer.setSize(W, H);
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.0;
      if (EMBED) renderer.setClearColor(0x000000, 0);
      const container = document.getElementById('c');
      if (!container) throw new Error('hostel-3d container missing');
      container.appendChild(renderer.domElement);

      const controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.06;
      controls.maxPolarAngle = Math.PI * 0.47;
      controls.minDistance = 15;
      controls.maxDistance = 550;
      controls.target.set(-95, 3, 20);
      controls.update();
      if (EMBED) {
        controls.enabled = false;
        controls.autoRotate = true;
        controls.autoRotateSpeed = 0.18;
      }
      if (!EMBED) {
        controls.autoRotate = true;
        controls.autoRotateSpeed = 0.45;
        let autoResumeAt = 0;
        const pauseAuto = () => {
          controls.autoRotate = false;
          autoResumeAt = performance.now() + 1400;
        };
        const resumeAuto = () => {
          if (performance.now() > autoResumeAt) controls.autoRotate = true;
        };
        window.addEventListener('pointerdown', pauseAuto, { passive: true });
        window.addEventListener('wheel', pauseAuto, { passive: true });
        controls.addEventListener('change', resumeAuto);
      }

      // ── Lights ───────────────────────────────────────────────────────────────────
      scene.add(new THREE.HemisphereLight(0xcce8ff, 0xc0a860, 0.72));
      const sun = new THREE.DirectionalLight(0xfff8e8, 1.65);
      sun.position.set(120, 160, -80);
      sun.castShadow = true;
      sun.shadow.mapSize.set(2048, 2048);
      sun.shadow.camera.near = 5;
      sun.shadow.camera.far = 600;
      sun.shadow.camera.left = -220;
      sun.shadow.camera.right = 220;
      sun.shadow.camera.top = 220;
      sun.shadow.camera.bottom = -220;
      sun.shadow.bias = -0.001;
      scene.add(sun);

      // ── Materials ─────────────────────────────────────────────────────────────────
      const M = {
        gnd: new THREE.MeshLambertMaterial({ color: 0xa89e78, side: THREE.DoubleSide }), // dry Extremaduran earth
        far: new THREE.MeshLambertMaterial({ color: 0x9a9268 }),
        road: new THREE.MeshLambertMaterial({ color: 0x786a52 }),
        pave: new THREE.MeshLambertMaterial({ color: 0xc8c0a0 }),
        grv: new THREE.MeshLambertMaterial({ color: 0xbcb090 }), // gravel/packed earth
        wh: new THREE.MeshLambertMaterial({ color: 0xf0ead8 }), // white render
        dado: new THREE.MeshLambertMaterial({ color: 0xd4a820 }), // ochre zócalo
        roof: new THREE.MeshLambertMaterial({ color: 0xc96c2a, side: THREE.DoubleSide }), // terracotta
        rdk: new THREE.MeshLambertMaterial({ color: 0x8c4a1e }), // ridge / shadow
        bush: new THREE.MeshLambertMaterial({ color: 0x2a6020 }), // ornamental bushes
        lawn: new THREE.MeshLambertMaterial({ color: 0x4a8830 }), // grass patches
        stne: new THREE.MeshLambertMaterial({ color: 0x8a9070 }), // almacén stone
        iron: new THREE.MeshLambertMaterial({ color: 0x3c3c3c }),
        wood: new THREE.MeshLambertMaterial({ color: 0x5c3a18 }),
        gl: new THREE.MeshLambertMaterial({ color: 0x88b4c8, transparent: true, opacity: 0.5 }),
        trk: new THREE.MeshLambertMaterial({ color: 0x4a3010 }),
        cyp: new THREE.MeshLambertMaterial({ color: 0x234a1a }), // dark cypress
        palm: new THREE.MeshLambertMaterial({ color: 0x3a8830 }),
      };

      // ── Helpers ──────────────────────────────────────────────────────────────────
      const sh = (m: any, c: boolean = true, r: boolean = true) => {
        m.castShadow = c;
        m.receiveShadow = r;
        return m;
      };
      function bx(
        w: number,
        h: number,
        d: number,
        mat: any,
        x: number,
        y: number,
        z: number,
        ry: number = 0
      ) {
        const m = sh(new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat));
        m.position.set(x, y, z);
        m.rotation.y = ry;
        return m;
      }

      /** Extrude a WGS84 polygon footprint vertically. */
      function extrudeWGS(coords: any, h: number, mat: any) {
        const shape = new THREE.Shape(coords.map((pair: any) => sv(pair[0], pair[1])));
        const geo = new THREE.ExtrudeGeometry(shape, { depth: h, bevelEnabled: false });
        const mesh = sh(new THREE.Mesh(geo, mat));
        mesh.rotation.x = -Math.PI / 2;
        return mesh;
      }

      /**
       * Gabled roof where ridge runs N-S (along Z axis).
       * Slopes go down to E and W. Gable end fills on N and S.
       * bx,bz = building world centre; HW=E-W width; HD=N-S depth.
       */
      function gabledRoofNS(
        bxc: number,
        bzc: number,
        HW: number,
        HD: number,
        wallH: number,
        ridgeH: number,
        roofMat: any,
        fillMat: any,
        ov: number = 0.55
      ) {
        const sL = Math.sqrt((HW / 2 + ov) ** 2 + ridgeH ** 2);
        const ang = Math.atan2(ridgeH, HW / 2 + ov);
        // West slope (tilts down to the west)
        const wP = sh(new THREE.Mesh(new THREE.BoxGeometry(sL, 0.32, HD + 2 * ov), roofMat));
        wP.rotation.z = +ang;
        wP.position.set(bxc - (HW / 4 + ov / 2), wallH + ridgeH / 2, bzc);
        scene.add(wP);
        // East slope
        const eP = sh(new THREE.Mesh(new THREE.BoxGeometry(sL, 0.32, HD + 2 * ov), roofMat));
        eP.rotation.z = -ang;
        eP.position.set(bxc + (HW / 4 + ov / 2), wallH + ridgeH / 2, bzc);
        scene.add(eP);
        // Ridge cap
        scene.add(bx(0.38, 0.4, HD + 2 * ov + 0.1, M.rdk, bxc, wallH + ridgeH, bzc));
        // Gable end fills (N and S faces, white triangle above wall-top)
        for (const gz of [bzc - HD / 2, bzc + HD / 2]) {
          const v = new Float32Array([
            bxc - HW / 2,
            wallH,
            gz,
            bxc + HW / 2,
            wallH,
            gz,
            bxc,
            wallH + ridgeH,
            gz,
          ]);
          const g = new THREE.BufferGeometry();
          g.setAttribute('position', new THREE.Float32BufferAttribute(v, 3));
          g.computeVertexNormals();
          scene.add(
            new THREE.Mesh(
              g,
              new THREE.MeshLambertMaterial({ color: 0xf0ead8, side: THREE.DoubleSide })
            )
          );
        }
      }

      /** Barred window on west face (x=wx, height centre wy, depth wz). */
      function winW(group: any, wz: number, wy: number, wx: number, fw: number = 1.1, fh: number = 1.3) {
        const depth = 0.12;
        // frame
        const fr = new THREE.Mesh(new THREE.BoxGeometry(depth, fh + 0.16, fw + 0.16), M.dado);
        fr.position.set(wx, wy, wz);
        group.add(fr);
        // glass
        const gl = new THREE.Mesh(new THREE.BoxGeometry(depth * 0.6, fh, fw), M.gl);
        gl.position.set(wx - 0.02, wy, wz);
        group.add(gl);
        // 3 iron bars
        for (const b of [-1, 0, 1]) {
          const bar = new THREE.Mesh(new THREE.BoxGeometry(depth * 0.8, fh * 0.9, 0.04), M.iron);
          bar.position.set(wx - 0.03, wy, wz + b * (fw / 3));
          group.add(bar);
        }
      }

      const windy: any[] = [];
      function cypress(x: number, z: number, h: number = 9) {
        const g = new THREE.Group();
        const trunk = sh(new THREE.Mesh(new THREE.CylinderGeometry(0.18, 0.28, h * 0.28, 7), M.trk));
        trunk.position.set(0, h * 0.14, 0);
        const cr = sh(new THREE.Mesh(new THREE.ConeGeometry(h * 0.09, h * 0.8, 7), M.cyp));
        cr.position.set(0, h * 0.28 + h * 0.4, 0);
        g.add(trunk, cr);
        g.position.set(x, 0, z);
        g.userData.wind = { phase: Math.random() * Math.PI * 2, s: 0.55 + Math.random() * 0.65 };
        scene.add(g);
        windy.push(g);
      }

      function oak(x: number, z: number, h: number = 7, r: number = 3) {
        const g = new THREE.Group();
        const trunk = sh(new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.28, h * 0.32, 7), M.trk));
        trunk.position.set(0, h * 0.16, 0);
        const cr = sh(new THREE.Mesh(new THREE.SphereGeometry(r, 7, 5), M.cyp));
        cr.scale.y = 0.65;
        cr.position.set(0, h * 0.32 + r * 0.65, 0);
        g.add(trunk, cr);
        g.position.set(x, 0, z);
        g.userData.wind = { phase: Math.random() * Math.PI * 2, s: 0.3 + Math.random() * 0.55 };
        scene.add(g);
        windy.push(g);
      }

      // ── Far ground (countryside / road) with terrain undulation ──────────────────
      const farGnd = sh(
        new THREE.Mesh(new THREE.PlaneGeometry(900, 900, 56, 56), M.far),
        false,
        true
      );
      farGnd.rotation.x = -Math.PI / 2;
      farGnd.position.y = -0.06;
      scene.add(farGnd);
      {
        // Displace vertices for rolling Extremaduran terrain.
        // PlaneGeometry local: x→world X, y→world -Z, z→world Y (height).
        const pos = farGnd.geometry.attributes.position;
        for (let i = 0; i < pos.count; i++) {
          const gx = pos.getX(i),
            gy = pos.getY(i); // local XY
          // Flat zone: inside the compound/road corridor (world x≈-125…-20, z≈-55…+50)
          const inFlat = gx > -130 && gx < -15 && gy > -55 && gy < 55;
          if (inFlat) {
            pos.setZ(i, 0.05);
            continue;
          }
          // Gentle hills elsewhere
          const h =
            Math.sin(gx * 0.0082 + 0.5) * 2.4 +
            Math.sin(gy * 0.0068 + 0.9) * 1.8 +
            Math.cos((gx - gy) * 0.0042) * 1.2 +
            Math.sin(gx * 0.022) * 0.5 +
            Math.cos(gy * 0.028) * 0.4 +
            gy * 0.007;
          pos.setZ(i, Math.max(h, -0.5));
        }
        pos.needsUpdate = true;
        farGnd.geometry.computeVertexNormals();
      }

      // ── Parcel ground shape ───────────────────────────────────────────────────────
      const pShape = new THREE.Shape(PARCEL.map((pair: number[]) => sv(pair[0], pair[1])));
      const gMesh = sh(new THREE.Mesh(new THREE.ShapeGeometry(pShape, 3), M.gnd), false, true);
      gMesh.rotation.x = -Math.PI / 2;
      gMesh.position.y = -0.02;
      scene.add(gMesh);

      // ── ROAD (diagonal ~NNW-SSE, runs west of hostel) ────────────────────────────
      // From Street View GPS: road angle ≈40° west of north (heading ~318° going north)
      // road group rotated so its length (Z) runs along 318° compass
      const roadAngle = Math.PI * (-42 / 180); // -42° = NNW direction
      const rdGrp = new THREE.Group();
      rdGrp.rotation.y = roadAngle;
      // asphalt
      rdGrp.add(sh(new THREE.Mesh(new THREE.BoxGeometry(7, 0.07, 520), M.road), false, true));
      // centre dashes (thin)
      rdGrp.add(
        new THREE.Mesh(
          new THREE.BoxGeometry(0.18, 0.08, 520),
          new THREE.MeshLambertMaterial({ color: 0xe8e0c0 })
        )
      );
      // Wide stone-slab sidewalk alongside hostel (photo shows ~4m wide, large tiles)
      const pave = sh(new THREE.Mesh(new THREE.BoxGeometry(4.5, 0.11, 90), M.pave), false, true);
      pave.position.x = 5.75;
      rdGrp.add(pave);
      // Tile grout lines on sidewalk (subtle)
      for (let ti = -42; ti <= 42; ti += 2.4) {
        const tl = new THREE.Mesh(
          new THREE.BoxGeometry(4.3, 0.115, 0.04),
          new THREE.MeshLambertMaterial({ color: 0xb0a888 })
        );
        tl.position.set(5.75, 0, ti);
        rdGrp.add(tl);
      }
      // Kerb/curb between road and sidewalk
      const kerb = sh(new THREE.Mesh(new THREE.BoxGeometry(0.22, 0.22, 90), M.pave), false, true);
      kerb.position.x = 3.4;
      rdGrp.add(kerb);
      rdGrp.position.set(-128, 0, 8);
      scene.add(rdGrp);

      const cars = [];
      const carBodyMat = new THREE.MeshLambertMaterial({ color: 0x1c2430 });
      const carTopMat = new THREE.MeshLambertMaterial({ color: 0x344256 });
      const carGlassMat = new THREE.MeshLambertMaterial({ color: 0x2aa7c9, transparent: true, opacity: 0.35 });

      const makeCar = (z, dir, seed) => {
        const g = new THREE.Group();
        const body = new THREE.Mesh(new THREE.BoxGeometry(1.7, 0.55, 3.6), carBodyMat);
        body.position.y = 0.35;
        body.castShadow = true;
        body.receiveShadow = true;
        g.add(body);

        const top = new THREE.Mesh(new THREE.BoxGeometry(1.4, 0.5, 1.7), carTopMat);
        top.position.set(0, 0.78, -0.2);
        top.castShadow = true;
        g.add(top);

        const glass = new THREE.Mesh(new THREE.BoxGeometry(1.35, 0.4, 1.05), carGlassMat);
        glass.position.set(0, 0.82, -0.2);
        g.add(glass);

        g.position.set(-0.9 + (seed % 3) * 0.25, 0.04, z);
        g.rotation.y = dir > 0 ? 0 : Math.PI;
        g.userData.dir = dir;
        g.userData.speed = 22 + (seed % 5) * 6;
        rdGrp.add(g);
        cars.push(g);
      };
      for (let i = 0; i < 7; i++) {
        makeCar(-240 + i * 80, 1, i);
      }
      for (let i = 0; i < 6; i++) {
        makeCar(220 - i * 88, -1, 100 + i);
      }

      const trailPts = [
        new THREE.Vector3(-128, 0.06, 6),
        new THREE.Vector3(-128, 0.06, 44),
