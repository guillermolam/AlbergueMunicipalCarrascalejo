---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import '../styles/booking/wizard-layout.css';
import '../styles/booking/calendar.css';
import '../styles/booking/forms.css';
import '../styles/booking/beds.css';
import '../styles/booking/payment.css';
import WizardSidebar from '../components/booking/WizardSidebar.astro';
import StepDatePicker from '../components/booking/StepDatePicker.astro';
import StepPilgrims from '../components/booking/StepPilgrims.astro';
import StepPersonalInfo from '../components/booking/StepPersonalInfo.astro';
import StepBedSelection from '../components/booking/StepBedSelection.astro';
import StepPayment from '../components/booking/StepPayment.astro';
import StepSummary from '../components/booking/StepSummary.astro';
import StepConfirmed from '../components/booking/StepConfirmed.astro';
import WizardNav from '../components/booking/WizardNav.astro';
---

<Layout
  title="Reservar Cama — Albergue Municipal de El Carrascalejo"
  showHeader={false}
  showFooter={false}
>
  <div class="wiz-wrap">
    <WizardSidebar />
    <main class="wiz-main">
      <!-- Mobile top bar -->
      <div class="mobile-bar">
        <img src="/logos/logo.png" alt="logo" class="mb-logo" />
        <div>
          <h2 class="mb-title">Albergue Carrascalejo</h2>
          <p class="mb-step" id="mobile-step-label">Step 1 of 6</p>
        </div>
      </div>
      <!-- Progress bar -->
      <div class="prog-wrap">
        <div class="prog-bar">
          <div class="prog-fill" id="prog-fill" style="width:14%"></div>
        </div>
        <div class="prog-labels">
          <span class="prog-text" id="prog-text">Step 1 of 6</span>
          <span class="prog-pct" id="prog-pct">14% Complete</span>
        </div>
      </div>
      <StepDatePicker />
      <StepPilgrims />
      <StepPersonalInfo />
      <StepBedSelection />
      <StepPayment />
      <StepSummary />
      <StepConfirmed />
    </main>
  </div>
  <WizardNav />

  <!-- Shared sketchy SVG filter (referenced by WizardNav buttons and step panels) -->
  <svg style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true">
    <defs>
      <filter id="sketchy-filter-book">
        <feTurbulence
          type="turbulence"
          baseFrequency="0.025"
          numOctaves="3"
          result="noise"
        ></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.5"></feDisplacementMap>
      </filter>
    </defs>
  </svg>

  <!-- Confetti container (populated by launchConfetti()) -->
  <div
    id="confetti-book"
    style="position:fixed;inset:0;pointer-events:none;z-index:9999;display:none"
    aria-hidden="true"
  ></div>

  <!-- Home-navigation confirmation modal -->
  <div
    class="home-modal-overlay"
    id="home-modal-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="home-modal-title"
  >
    <div class="home-modal">
      <div class="home-modal-icon">
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#D4A574"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
      </div>
      <h2 class="home-modal-title" id="home-modal-title">Leave booking?</h2>
      <p class="home-modal-body">
        Your <strong>progress will be lost</strong> if you leave now.<br />
        Are you sure you want to go back home?
      </p>
      <div class="home-modal-actions">
        <button class="hm-btn hm-btn-stay" id="hm-stay">Stay &amp; continue</button>
        <button class="hm-btn hm-btn-leave" id="hm-leave">Leave</button>
      </div>
    </div>
  </div>

  <script>
    // ── Relative imports guarantee TS language-server resolution regardless of
    //    path-alias caching (book.astro lives in src/pages/).
    import type { PilgrimCompleteData } from '../islands/booking/PilgrimCardIsland';
    import { initCalendarIsland } from '../islands/booking/CalendarIsland';
    import { initPersonsPickerIsland } from '../islands/booking/PersonsPickerIsland';
    import { initWizardNavigatorIsland } from '../islands/booking/WizardNavigatorIsland';
    import { initBedSelectionIsland } from '../islands/booking/BedSelectionIsland';
    import {
      initPaymentIsland,
      populateSummary,
      submitBooking,
      launchConfetti,
    } from '../islands/booking/PaymentIsland';
    import { resetPilgrims } from '../stores/bookingPilgrims';
    import { bookingDatesStore } from '../stores/bookingDatesStore';

    // ── Calendar ──────────────────────────────────────────────────────────────
    initCalendarIsland({
      gridId: 'cal-grid',
      titleId: 'cal-month-title',
      prevBtnId: 'prev-month',
      nextBtnId: 'next-month',
      todayBtnId: 'today-btn',
      dateErrorId: 'date-range-error',
      clearBtnId: 'clear-dates',
      // Wire date selection → wizard Next button reactivity
      onCanProceed: (can: boolean) => { window.__wizEnableNext?.(can); },
    });

    // ── Persons picker ────────────────────────────────────────────────────────
    initPersonsPickerIsland();

    // ── Bed selection ─────────────────────────────────────────────────────────
    initBedSelectionIsland({
      enableNext: (yes: boolean) => { window.__wizEnableNext?.(yes); },
    });

    // ── Payment + summary ─────────────────────────────────────────────────────
    initPaymentIsland();

    // ── Wire #btn-confirm → validate, show loading, submit ────────────────────
    // submitBooking() always redirects to /booking-confirmed (success or offline),
    // so step 7 panel + confetti are unused — the redirect IS the confirmation.
    const btnConfirm = document.getElementById('btn-confirm') as HTMLButtonElement | null;
    btnConfirm?.addEventListener('click', async () => {
      if (!btnConfirm || btnConfirm.disabled) return;

      // Guard: ensure essential booking data exists
      const s = bookingDatesStore.get();
      if (!s.checkin || !s.checkout || !s.persons) return;

      // Show loading state on the confirm button
      btnConfirm.disabled = true;
      const confirmLabel = btnConfirm.querySelector('.confirm-label');
      const originalHTML = confirmLabel?.innerHTML ?? '';
      if (confirmLabel) confirmLabel.textContent = 'Confirmando…';

      try {
        await submitBooking(); // redirects the page on success or offline fallback
      } catch {
        // submitBooking only throws if something truly unexpected happens
        // (both success & API failure redirect). Re-enable so user can retry.
        btnConfirm.disabled = false;
        if (confirmLabel) confirmLabel.innerHTML = originalHTML;
      }
    });

    // ── PilgrimCard dynamic mount ─────────────────────────────────────────────
    let _pilgrimCardCleanups: Array<() => void> = [];
    let _pilgrimCardCompletions: boolean[] = [];

    async function mountPilgrimCards(): Promise<void> {
      for (const cleanup of _pilgrimCardCleanups) cleanup();
      _pilgrimCardCleanups = [];

      const persons = Number(bookingDatesStore.get().persons) || 1;
      resetPilgrims(persons);
      _pilgrimCardCompletions = Array.from({ length: persons }, () => false);

      const { mount: mountPilgrimCard } = await import('../islands/booking/PilgrimCardIsland');
      const slotsContainer = document.getElementById('pilgrim-card-slots');
      if (!slotsContainer) return;
      slotsContainer.textContent = '';

      const labels = [
        'Peregrino 1', 'Peregrino 2', 'Peregrino 3', 'Peregrino 4', 'Peregrino 5',
        'Peregrino 6', 'Peregrino 7', 'Peregrino 8', 'Peregrino 9', 'Peregrino 10',
      ];

      for (let i = 0; i < persons; i++) {
        const slotEl = document.createElement('div');
        slotEl.id = `pilgrim-card-slot-${String(i)}`;
        slotsContainer.appendChild(slotEl);
        const cleanup = mountPilgrimCard(slotEl, {
          pilgrimIndex: i,
          pilgrimLabel: labels[i] ?? `Peregrino ${String(i + 1)}`,
          loggedInEmail: i === 0
            ? window.Clerk?.user?.primaryEmailAddress?.emailAddress
            : undefined,
          loggedInUserId: i === 0 ? window.Clerk?.user?.id : undefined,
          onAvatarChange: () => {},
          onComplete: (_data: PilgrimCompleteData) => {
            _pilgrimCardCompletions[i] = true;
            if (_pilgrimCardCompletions.every(Boolean)) window.__wizEnableNext?.(true);
          },
        });
        _pilgrimCardCleanups.push(cleanup);
      }
      window.__wizEnableNext?.(false);
    }

    // ── Home modal ────────────────────────────────────────────────────────────
    const homeOverlay = document.getElementById('home-modal-overlay');
    document
      .getElementById('sidebar-home-btn')
      ?.addEventListener('click', () => homeOverlay?.classList.add('open'));
    document
      .getElementById('hm-stay')
      ?.addEventListener('click', () => homeOverlay?.classList.remove('open'));
    document
      .getElementById('hm-leave')
      ?.addEventListener('click', () => { window.location.href = '/'; });

    // ── Wizard Navigator (init last — calls onEnter[1] on mount) ─────────────
    initWizardNavigatorIsland({
      onEnter: {
        2: (_dir: 'forward' | 'back') => { void mountPilgrimCards(); },
        3: (_dir: 'forward' | 'back') => {
          // Fire-and-forget: upload pilgrim 0 avatar to Clerk when entering personal info
          void import('../stores/bookingStep2Store').then(({ getPilgrimDocState }) => {
            const avatar = getPilgrimDocState(0)?.avatarDataUrl ?? null;
            if (avatar) {
              void import('../lib/imageCrop').then(({ uploadAvatarToClerk }) =>
                uploadAvatarToClerk(avatar),
              );
            }
          });
        },
        6: (_dir: 'forward' | 'back') => { populateSummary(); },
        7: (_dir: 'forward' | 'back') => { launchConfetti(); },
      },
      // canProceed logic is in WizardNavigatorIsland.defaultCanProceed()
      // — no per-step overrides needed here.
    });
  </script>
</Layout>
