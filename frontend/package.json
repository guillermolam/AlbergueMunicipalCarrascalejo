{
  "name": "albergue-carrascalejo-frontend",
  "type": "module",
  "version": "1.0.0",
  "description": "Static Astro frontend for Albergue Municipal Carrascalejo - Camino de Santiago (plain CSS, RoughJS, IBM Plex)",
  "keywords": [
    "astro",
    "camino-santiago",
    "albergue",
    "static-site",
    "plain-css",
    "roughjs",
    "ibm-plex"
  ],
  "author": "Albergue Municipal Carrascalejo",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro build",
    "preview": "wrangler types && astro preview",
    "clean": "rimraf dist .astro node_modules/.cache",
    "astro-check": "astro check",
    "format": "prettier --write .",
    "lint": "tsc -p tsconfig.typecheck.json --noEmit",
    "type-check": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:workers": "vitest run --config vitest.config.workers.ts",
    "test:workers:watch": "vitest --config vitest.config.workers.ts",
    "test:all": "vitest run --config vitest.config.ts && vitest run --config vitest.config.workers.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "deploy": "wrangler deploy --config dist/server/wrangler.json --env=\"\"",
    "deploy:preview": "wrangler deploy --config dist/server/wrangler.json --env=preview",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:introspect": "drizzle-kit introspect --config drizzle.config.ts"
  },
  "dependencies": {
    "@clerk/astro": "^3.0.12",
    "@fontsource/cabin-sketch": "^5.2.8",
    "@fontsource/londrina-sketch": "^5.2.8",
    "@nanostores/persistent": "^1.3.3",
    "@supabase/supabase-js": "^2.103.0",
    "@types/three": "^0.183.1",
    "@wuchale/astro": "^0.3.1",
    "alpinejs": "^3.15.11",
    "astro": "^6.1.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jwt-decode": "^4.0.0",
    "libphonenumber-js": "^1.12.41",
    "maplibre-gl": "^5.22.0",
    "nanostores": "^1.2.0",
    "redis": "^5.11.0",
    "roughjs": "^4.6.6",
    "solid-js": "^1.9.12",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "wuchale": "^0.22.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/cloudflare": "^13.1.7",
    "@astrojs/node": "^10.0.4",
    "@cloudflare/vitest-pool-workers": "^0.14.3",
    "@types/alpinejs": "^3.13.11",
    "@vitest/coverage-v8": "^4.1.4",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.8.9",
    "msw": "^2.7.5",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4",
    "wrangler": "^4.81.1"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "msw", "sharp", "workerd"]
  }
}
