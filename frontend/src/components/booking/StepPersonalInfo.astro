---
// StepPersonalInfo.astro — Step 3: pilgrim info form (personal, contact, address, emergency)
// Note: this step is hidden and auto-skipped by WizardNavigatorIsland when going forward.
// It exists in the DOM for form validation purposes only.
---

<div class="step-panel hidden" id="step-3" data-step="3" aria-hidden="true" style="display:none!important">
  <div class="step-header center">
    <div class="step-header-icon large">
      <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#00AB39" stroke-width="2" stroke-linecap="round">
        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
    </div>
    <h1 class="step-title">Pilgrim Information</h1>
    <p class="step-desc" id="step3-desc">Complete your details below</p>
    <div class="wave-line" aria-hidden="true">
      <svg viewBox="0 0 200 12" preserveAspectRatio="none">
        <path d="M0,6 Q25,0 50,6 T100,6 T150,6 T200,6" fill="none" stroke="#00AB39" stroke-width="2.5" stroke-linecap="round"></path>
      </svg>
    </div>
  </div>

  <!-- Per-pilgrim navigation (shown when persons > 1) -->
  <div class="pilgrim-step-nav" id="step3-person-nav" style="display:none">
    <div class="pilgrim-step-nav-label">Info for:</div>
    <div class="pilgrim-step-tabs" id="step3-pilgrim-tabs"></div>
  </div>

  <div class="info-card">
    <svg class="info-card-border" preserveAspectRatio="none" aria-hidden="true">
      <rect x="4" y="6" width="calc(100% - 8px)" height="calc(100% - 10px)" rx="14" fill="rgba(0,0,0,0.05)" filter="blur(5px)"></rect>
      <rect x="0" y="0" width="100%" height="100%" rx="16" fill="white" stroke="#D4A574" stroke-width="2.5"></rect>
      <rect x="5" y="5" width="calc(100% - 10px)" height="calc(100% - 10px)" rx="14" fill="none" stroke="#D4A574" stroke-width="1" opacity="0.3"></rect>
    </svg>
    <div class="info-card-inner">

      <!-- Personal Details -->
      <div class="info-section">
        <h3 class="info-section-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="7" r="4"></circle>
            <path d="M4 21v-2a8 8 0 0 1 16 0v2"></path>
          </svg>
          Personal Details
        </h3>
        <div class="form-row-3">
          <div class="fg">
            <label class="fl">First Name <span class="req">*</span></label>
            <input type="text" id="f-first" name="firstName" class="fi" placeholder="María" required />
            <span class="ferr">Required</span>
          </div>
          <div class="fg">
            <label class="fl">Last Name <span class="req">*</span></label>
            <input type="text" id="f-last" name="lastName" class="fi" placeholder="García" required />
            <span class="ferr">Required</span>
          </div>
          <div class="fg">
            <label class="fl">Second Last Name</label>
            <input type="text" id="f-last2" name="lastName2" class="fi" placeholder="López" />
          </div>
        </div>
        <div class="form-row-2">
          <div class="fg">
            <label class="fl">Date of Birth <span class="req">*</span></label>
            <input type="date" id="f-dob" name="dob" class="fi" required />
            <span class="ferr">Required</span>
          </div>
          <div class="fg" style="position:relative">
            <label class="fl">Nationality <span class="req">*</span></label>
            <div class="country-pick-wrap" id="nat-pick-wrap">
              <span class="country-pick-flag" id="f-nat-flag">🌍</span>
              <input
                type="text"
                id="f-nat"
                name="nationality"
                class="fi country-pick-input"
                placeholder="Spain"
                autocomplete="off"
                role="combobox"
                aria-autocomplete="list"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="nat-drop"
                required
              />
            </div>
            <input type="hidden" id="f-nat-code" name="nationalityCode" />
            <ul id="nat-drop" class="country-drop" role="listbox"></ul>
            <span class="ferr">Required</span>
          </div>
        </div>
      </div>

      <div class="section-divider"></div>

      <!-- Contact Information -->
      <div class="info-section">
        <h3 class="info-section-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.16h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.76a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.46 16z"></path>
          </svg>
          Contact Information
        </h3>
        <div class="form-row-2">
          <div class="fg">
            <label class="fl">Email <span class="req">*</span></label>
            <input type="email" id="f-email" name="email" class="fi" placeholder="maria@email.com" required />
            <span class="ferr">Invalid email</span>
          </div>
          <div class="fg">
            <label class="fl">Phone</label>
            <div class="phone-outer">
              <div class="phone-wrap">
                <button type="button" class="phone-prefix" id="phone-prefix" aria-haspopup="listbox" aria-expanded="false">
                  <span class="flag" id="phone-flag">🇪🇸</span>
                  <span class="prefix-code" id="phone-dial">+34</span>
                  <svg width="12" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <input type="tel" id="f-phone" name="phone" class="fi phone-input" placeholder="612 345 678" inputmode="numeric" autocomplete="tel" />
                <input type="hidden" id="f-phone-cc" name="phoneCountryCode" value="ES" />
              </div>
              <div id="phone-drop" class="phone-prefix-drop" role="listbox">
                <input type="text" class="phone-drop-search" placeholder="Search country or +code…" autocomplete="off" />
                <ul class="phone-drop-list"></ul>
              </div>
            </div>
            <span class="ferr" id="phone-err">Please enter a valid phone number (digits only)</span>
          </div>
        </div>
      </div>

      <div class="section-divider"></div>

      <!-- Address -->
      <div class="info-section">
        <h3 class="info-section-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          Address
        </h3>
        <div class="fg" style="position:relative">
          <label class="fl">Street Address</label>
          <div class="addr-wrap">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00AB39" stroke-width="2" stroke-linecap="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <input
              type="text"
              id="f-addr"
              name="address"
              class="fi addr-input"
              placeholder="Start typing your street address..."
              autocomplete="off"
              role="combobox"
              aria-autocomplete="list"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="addr-suggestions"
            />
          </div>
          <!-- Geoapify autocomplete dropdown -->
          <ul
            id="addr-suggestions"
            role="listbox"
            style="display:none;position:absolute;top:100%;left:0;right:0;z-index:200;
                   margin:2px 0 0;padding:0;list-style:none;
                   background:#fff;border:1.5px solid #D4A574;border-radius:8px;
                   box-shadow:0 4px 16px rgba(0,0,0,0.12);max-height:260px;overflow-y:auto"
          ></ul>
        </div>
        <div class="fg">
          <label class="fl">Address Line 2 (Optional)</label>
          <input type="text" id="f-addr2" name="address2" class="fi" placeholder="Apartment, suite, etc." />
        </div>
        <div class="form-row-2">
          <div class="fg">
            <label class="fl">Postal / ZIP Code <span class="req">*</span></label>
            <input type="text" id="f-zip" name="zip" class="fi" placeholder="28001" required />
            <span class="ferr">Required</span>
          </div>
          <div class="fg">
            <label class="fl">City <span class="req">*</span></label>
            <input type="text" id="f-city" name="city" class="fi" placeholder="Madrid" required />
            <span class="ferr">Required</span>
          </div>
        </div>
        <div class="fg" style="position:relative;margin-top:0.75rem">
          <label class="fl">Country</label>
          <div class="country-pick-wrap" id="addr-country-wrap">
            <span class="country-pick-flag" id="f-country-flag">🌍</span>
            <input
              type="text"
              id="f-country"
              name="country"
              class="fi country-pick-input"
              placeholder="Spain"
              autocomplete="off"
              role="combobox"
              aria-autocomplete="list"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="country-drop"
            />
          </div>
          <input type="hidden" id="f-country-code" name="countryCode" />
          <ul id="country-drop" class="country-drop" role="listbox"></ul>
        </div>
      </div>

      <div class="section-divider"></div>

      <!-- Emergency Contact -->
      <div class="info-section">
        <h3 class="info-section-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          Emergency Contact
        </h3>
        <div class="form-row-2">
          <div class="fg">
            <label class="fl">Contact Name</label>
            <input type="text" id="f-ec-name" name="ecName" class="fi" placeholder="John Doe" />
          </div>
          <div class="fg">
            <label class="fl">Emergency Phone</label>
            <div class="phone-outer">
              <div class="phone-wrap">
                <button type="button" class="phone-prefix" id="ec-phone-prefix" aria-haspopup="listbox" aria-expanded="false">
                  <span class="flag" id="ec-phone-flag">🇪🇸</span>
                  <span class="prefix-code" id="ec-phone-dial">+34</span>
                  <svg width="12" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <input type="tel" id="f-ec-phone" name="ecPhone" class="fi phone-input" placeholder="123 456 789" inputmode="numeric" autocomplete="tel" />
                <input type="hidden" id="f-ec-phone-cc" name="ecPhoneCountryCode" value="ES" />
              </div>
              <div id="ec-phone-drop" class="phone-prefix-drop" role="listbox">
                <input type="text" class="phone-drop-search" placeholder="Search country or +code…" autocomplete="off" />
                <ul class="phone-drop-list"></ul>
              </div>
            </div>
            <span class="ferr" id="ec-phone-err">Please enter a valid phone number (digits only)</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
