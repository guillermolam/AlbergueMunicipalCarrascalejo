---

<Layout title="Informacion — Albergue Municipal de El Carrascalejo">
  <svg style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true">
    <defs>
      <filter id="sketchy-filter">
        <feTurbulence type="turbulence" baseFrequency="0.03" numOctaves="4" result="noise"
        ></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="2"></feDisplacementMap>
      </filter>
    </defs>
  </svg>

  <!-- HERO -->
  <section class="info-hero reveal-section">
    <div class="info-hero-inner">
      <h1 class="info-title">Informacion</h1>
      <div class="hero-wave" aria-hidden="true">
        <svg viewBox="0 0 340 16" preserveAspectRatio="none">
          <path
            d="M0,8 Q28,0 56,8 T112,8 T168,8 T224,8 T280,8 T340,8"
            fill="none"
            stroke="var(--green)"
            stroke-width="3"
            stroke-linecap="round"></path>
        </svg>
      </div>
      <p class="info-hero-sub">Todo lo que necesitas saber para tu estancia en el Camino</p>
    </div>
  </section>

  <div class="info-content">
    <!-- 1. ABOUT -->
    <section class="info-section reveal-section" style="--delay:0.05s">
      <div class="info-section-inner">
        <div class="section-label">El Albergue</div>
        <div class="about-grid">
          <div class="about-text">
            <h2 class="section-heading">Un hogar en el Camino</h2>
            <p class="body-text">
              El Albergue Municipal de El Carrascalejo lleva mas de dos decadas acogiendo peregrinos
              que recorren la Via de la Plata. Con capacidad para 24 personas en dos dormitorios,
              ofrecemos un ambiente calido y tranquilo donde recuperar fuerzas para la siguiente
              etapa.
            </p>
            <p class="body-text">
              Gestionado por el Ayuntamiento de El Carrascalejo, nuestro albergue combina la
              tradicion hospitalaria del Camino con los servicios modernos que necesita el peregrino
              de hoy.
            </p>
            <div class="about-stats">
              <div class="about-stat">
                <span class="about-stat-val">+5.000</span>
                <span class="about-stat-lbl">Peregrinos al ano</span>
              </div>
              <div class="about-stat">
                <span class="about-stat-val">+20</span>
                <span class="about-stat-lbl">Anos de historia</span>
              </div>
              <div class="about-stat">
                <span class="about-stat-val">24</span>
                <span class="about-stat-lbl">Camas disponibles</span>
              </div>
            </div>
          </div>
          <div class="about-photo">
            <img
              src={`https://cf.bstatic.com/xdata/images/hotel/max1280x900/${PHOTOS[0].id}.jpg?k=${PHOTOS[0].hash}&o=`}
              alt={PHOTOS[0].alt}
              class="about-real-photo"
              loading="eager"
            />
            <div class="about-photo-badge">📸 Booking.com · 9.1 ★</div>
          </div>
        </div>
      </div>
    </section>

    <!-- PHOTO GALLERY CAROUSEL -->
    <section
      class="info-gallery reveal-section"
      style="--delay:0.07s"
      aria-label="Galeria de fotos"
    >
      <div class="gallery-header">
        <div class="section-label">Galeria</div>
        <h2 class="section-heading">Fotos del Albergue</h2>
      </div>
      <div class="gallery-track-outer" id="gallery-outer">
        <div class="gallery-track" id="gallery-track">
          {
            PHOTOS.map((p, i) => (
              <figure class="gallery-slide" data-index={i}>
                <img
                  src={`https://cf.bstatic.com/xdata/images/hotel/max1280x900/${p.id}.jpg?k=${p.hash}&o=`}
                  alt={p.alt}
                  class="gallery-img"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
                <figcaption class="gallery-caption">{p.alt}</figcaption>
              </figure>
            ))
          }
        </div>
        <button class="gallery-btn gallery-prev" id="gallery-prev" aria-label="Foto anterior"
          >&#8249;</button
        >
        <button class="gallery-btn gallery-next" id="gallery-next" aria-label="Foto siguiente"
          >&#8250;</button
        >
        <div class="gallery-dots" id="gallery-dots" role="tablist">
          {
            PHOTOS.map((_, i) => (
              <button
                class={`gallery-dot${i === 0 ? ' active' : ''}`}
                data-idx={i}
                role="tab"
                aria-label={`Foto ${i + 1}`}
                aria-selected={i === 0 ? 'true' : 'false'}
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- 2. FACILITIES -->
    <section class="info-section info-section-alt reveal-section" style="--delay:0.08s">
      <div class="info-section-inner">
        <div class="section-label">Instalaciones</div>
        <h2 class="section-heading text-center">Servicios y comodidades</h2>
        <div class="facilities-grid">
          {
            facilities.map((f, i) => (
              <button
                class="facility-card reveal-section"
                style={`--delay:${0.05 + i * 0.04}s`}
                data-facility-idx={i}
                aria-label={`Ver detalles: ${f.label}`}
              >
                <svg
                  style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none"
                  aria-hidden="true"
                >
                  <rect
                    x="0"
                    y="0"
                    width="100%"
                    height="100%"
                    rx="14"
                    fill="white"
                    stroke="var(--black)"
                    stroke-width="2"
                    filter="url(#sketchy-filter)"
                  />
                </svg>
                <div class="facility-inner">
                  <div class="facility-icon" aria-hidden="true">
                    {f.icon === 'bed' && (
                      <svg
                        width="28"
                        height="28"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="var(--green)"
                        stroke-width="2"
                        stroke-linecap="round"
                      >
                        <path d="M2 4v16M2 8h20M2 16h20M22 4v16" />
                      </svg>
                    )}
                    {f.icon === 'shower' && (
                      <svg
                        width="28"
                        height="28"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="var(--green)"
                        stroke-width="2"
                        stroke-linecap="round"
                      >
                        <path d="M4 12l1.41-1.41a2 2 0 0 1 2.83 0L10 12" />
                        <path d="M9 7V3a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v1" />
                        <path d="M4 20h16" />
                      </svg>
                    )}
                    {f.icon === 'kitchen' && (
                      <svg
                        width="28"
                        height="28"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="var(--green)"
                        stroke-width="2"
                        stroke-linecap="round"
                      >
                        <rect x="2" y="3" width="20" height="14" rx="2" />
                        <path d="M8 21h8M12 17v4" />
                      </svg>
                    )}
                    {f.icon === 'wifi' && (
                      <svg
