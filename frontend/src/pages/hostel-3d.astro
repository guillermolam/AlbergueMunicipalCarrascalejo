          db.position.set(2.75, 1.25, panelZ);
          g.add(db);
        }
        // A-frame support legs (2 diagonal props from top-corner to ground)
        for (const fx of [0.5, 5]) {
          const legLen = Math.sqrt(1.5 ** 2 + 2.5 ** 2);
          const legAng = Math.atan2(1.5, 2.5);
          const leg = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.06, legLen), M.iron);
          leg.rotation.x = legAng * (dir > 0 ? 1 : -1);
          leg.position.set(fx, 1.25, panelZ + dir * 1.2);
          g.add(leg);
        }
        g.position.set(-116, 0, 0);
        scene.add(g);
