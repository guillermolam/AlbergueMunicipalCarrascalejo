---
// ReviewsScene.astro — Minimal "stars" scene (non-interactive, ultra-light).
---

<div id="scene-reviews" class="section-scene" data-active="false">
  <canvas id="scene-reviews-canvas" aria-hidden="true"></canvas>
</div>

<script type="module">
  import { attachSectionActive, createRafLoop } from '../../../lib/three/sectionActive';
  import { cssVarColorInt } from '../../../lib/three/cssColor';

  const root = document.getElementById('scene-reviews');
  const canvas = document.getElementById('scene-reviews-canvas');
  if (!root || !canvas) throw new Error('[ReviewsScene] root/canvas missing');

  const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches ?? false;
  let runtime = null;
  let runtimePromise = null;

  async function init() {
    const THREE = await import('three');

    const cWhite = cssVarColorInt('--white', 0xffffff);
    const cGold = cssVarColorInt('--gold', 0xeac102);

    let W = root.clientWidth;
    let H = root.clientHeight;

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(W, H);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(55, W / H, 0.1, 80);
    camera.position.set(0, 0, 14);

    const count = 700;
    const positions = new Float32Array(count * 3);
    const speeds = new Float32Array(count);
    for (let i = 0; i < count; i++) {
      positions[i * 3 + 0] = (Math.random() - 0.5) * 26;
      positions[i * 3 + 1] = (Math.random() - 0.5) * 14;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 18;
      speeds[i] = 0.35 + Math.random() * 0.85;
    }

    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    const mat = new THREE.PointsMaterial({
      size: 0.05,
      color: cWhite,
      transparent: true,
      opacity: 0.8,
      depthWrite: false,
    });

    const stars = new THREE.Points(geo, mat);
    scene.add(stars);

    // 5 gold "rating" stars as brighter points.
    const goldGeo = new THREE.BufferGeometry();
    goldGeo.setAttribute(
      'position',
      new THREE.BufferAttribute(
        new Float32Array([
          -1.8, 2.2, 0,
          -0.9, 2.2, 0,
           0.0, 2.2, 0,
           0.9, 2.2, 0,
           1.8, 2.2, 0,
        ]),
        3
      )
    );
    const gold = new THREE.Points(
      goldGeo,
      new THREE.PointsMaterial({ size: 0.16, color: cGold, transparent: true, opacity: 0.95, depthWrite: false })
    );
    gold.position.z = 6;
    scene.add(gold);

    function renderFrame(dt) {
      // Gentle drift.
      const p = geo.attributes.position;
      for (let i = 0; i < count; i++) {
        const idx = i * 3 + 2;
        p.array[idx] += speeds[i] * dt * 0.65;
        if (p.array[idx] > 9) p.array[idx] = -9;
      }
      p.needsUpdate = true;

      const pulse = 0.75 + Math.sin(performance.now() * 0.004) * 0.2;
      gold.material.opacity = pulse;

      renderer.render(scene, camera);
    }

    const loop = createRafLoop((dt) => renderFrame(dt));
    const ro = new ResizeObserver(() => {
      W = root.clientWidth;
      H = root.clientHeight;
      renderer.setSize(W, H);
      camera.aspect = Math.max(1e-6, W / Math.max(1, H));
      camera.updateProjectionMatrix();
      if (reducedMotion) renderFrame(0);
    });
    ro.observe(root);

    renderFrame(0);

    return {
      start() {
        if (reducedMotion) return;
        loop.start();
      },
      stop() {
        loop.stop();
      },
      destroy() {
        loop.stop();
        ro.disconnect();
        renderer.dispose();
      },
    };
  }

  async function ensureRuntime() {
    if (runtime) return runtime;
    runtimePromise ??= init();
    runtime = await runtimePromise;
    return runtime;
  }

  attachSectionActive(root, {
    auto: true,
    onChange(active) {
      if (active) ensureRuntime().then((r) => r.start());
      else runtime?.stop();
    },
  });
</script>

<style>
  .section-scene {
    position: relative;
    width: 100%;
    height: 14rem;
    border-radius: 12px;
    overflow: hidden;
    background: radial-gradient(120% 90% at 30% 10%, rgba(0, 113, 188, 0.18), rgba(26, 26, 26, 0.04));
  }
  .section-scene canvas {
    width: 100% !important;
    height: 100% !important;
  }
  @media (min-width: 768px) {
    .section-scene { height: 18rem; }
  }
</style>

