      line-height: 1;
      cursor: pointer;
      backdrop-filter: blur(4px);
      transition: background 200ms;
    }
    .fac-modal-close:hover {
      background: rgba(0, 0, 0, 0.8);
    }
    .fac-modal-title {
      font-family: var(--font-sketch);
      font-weight: 700;
      font-size: 1.3rem;
      color: var(--black);
      padding: 1.1rem 1.5rem 0.75rem;
      border-bottom: 1px solid #f0f0f0;
      margin: 0;
    }
    .fac-modal-carousel {
      position: relative;
      aspect-ratio: 16/10;
      overflow: hidden;
      background: #000;
    }
    .fac-modal-track {
      display: flex;
      width: 100%;
      height: 100%;
      transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
      will-change: transform;
    }
    /* :global needed — .fac-slide elements are created via JS and lack the Astro scope hash */
    :global(.fac-slide) {
      flex: 0 0 100%;
      min-width: 100%;
      width: 100%;
      height: 100%;
      position: relative;
      overflow: hidden;
      margin: 0;
    }
    :global(.fac-slide img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    :global(.fac-slide figcaption) {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 0.5rem 0.9rem;
      background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
      color: #fff;
      font-family: var(--font-hand);
      font-size: 0.85rem;
    }
    .fac-prev {
      left: 0.65rem;
    }
    .fac-next {
      right: 0.65rem;
    }
    #fac-dots {
      position: absolute;
      bottom: 0.6rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 0.4rem;
      z-index: 4;
    }
    .fac-modal-desc {
      padding: 1rem 1.5rem 1.25rem;
      font-family: var(--font-hand);
      font-size: 0.9rem;
      color: #444;
      line-height: 1.65;
      margin: 0;
    }
    @media (max-width: 680px) {
      .gallery-track-outer {
        aspect-ratio: 4/3;
      }
      .fac-modal-box {
        max-height: 92vh;
        overflow-y: auto;
      }
    }

    /* Location */
    .location-grid {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 2rem;
      align-items: start;
    }

    /* Map card — contains the MapLibre component + overlays */
    .map-card-big {
      position: relative;
      border-radius: 16px;
      min-height: 320px;
      height: 320px;
      overflow: hidden;
    }

    /* SVG sketch border — sits on top of everything, pointer-events:none */
    .map-sketch-border {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 10;
    }

    /* The MapLibre host element fills the card */
    .info-map-inner {
      position: absolute !important;
      inset: 0 !important;
      border-radius: 16px;
      overflow: hidden;
      z-index: 1;
    }

    /* Bottom gradient overlay with address + OSM link */
    .map-bottom-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 5;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0) 100%);
      padding: 2rem 1.25rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      border-radius: 0 0 16px 16px;
      pointer-events: none;
    }
    .map-bottom-overlay a {
      pointer-events: auto;
    }
    .map-overlay-addr {
      font-family: var(--font-hand);
      font-size: 0.82rem;
      color: rgba(255, 255, 255, 0.88);
    }
    .map-overlay-link {
      font-family: var(--font-sketch);
      font-size: 0.78rem;
      font-weight: 700;
      color: #6ee7a0;
      text-decoration: none;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      width: fit-content;
    }
    .map-overlay-link:hover {
      color: white;
      text-decoration: underline;
    }

    .via-badge {
      background: var(--green);
      color: white;
      font-family: var(--font-sketch);
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.4rem 1rem;
      border-radius: 50px;
      display: inline-block;
      margin-bottom: 1rem;
    }
    .location-rows {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .loc-row {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.75rem;
      background: white;
      border-radius: var(--r-md);
      border: 1.5px solid rgba(0, 171, 57, 0.15);
    }
    .loc-row-icon {
      width: 38px;
      height: 38px;
      flex-shrink: 0;
      background: var(--green);
      border-radius: 50%;
      display: flex;
      align-items: center;
