      docType: string | null;
      phase: 'cards' | 'upload';
      frontFile: File | null;
      backFile: File | null;
      frontValid: boolean | null; // null=pending, true=ok, false=invalid
      backValid: boolean | null;
      validationError: string | null;
      avatarDataUrl: string | null; // cropped face from front side
    };
    let personDocStates: PersonDocState[] = [
      {
        docType: null,
        phase: 'cards',
        frontFile: null,
        backFile: null,
        frontValid: null,
        backValid: null,
        validationError: null,
        avatarDataUrl: null,
      },
    ];
    let activePersonStep2 = 0;

    const STEP3_FIELDS = [
      'f-first',
      'f-last',
      'f-last2',
      'f-dob',
      'f-nat',
      'f-nat-code',
      'f-email',
      'f-phone',
      'f-phone-cc',
      'f-addr',
      'f-addr2',
      'f-zip',
      'f-city',
      'f-country',
      'f-country-code',
      'f-ec-name',
      'f-ec-phone',
      'f-ec-phone-cc',
    ];
    let personFormData: Record<string, string>[] = [{}];
    let activePersonStep3 = 0;

    function initPersonSteps() {
      const p = state.persons || 1;
      personDocStates = Array.from({ length: p }, () => ({
        docType: null,
