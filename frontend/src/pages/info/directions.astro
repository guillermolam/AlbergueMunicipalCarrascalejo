---
export const prerender = true;
import '../../styles/directions.css';
import Layout from '../../layouts/Layout.astro';
import MapLibre from '../../components/MapLibre.astro';
import MapLibreBeacon from '../../components/MapLibreBeacon.astro';
import directionsData from '../../content/local-guide/directions.json';
import stagesData from '../../content/camino-guide/stages.json';
import {
  buildDirectionCards,
  buildNearbyStages,
  LAT,
  LNG,
  ELEVATION,
  osmUrl,
  osmDirections,
} from '../../lib/directions';

const directionCards = buildDirectionCards(directionsData as import('../../lib/directions').DirectionEntry[]);
const nearbyStages = buildNearbyStages(stagesData as import('../../lib/directions').StageEntry[]);
---

<Layout title="Como Llegar — Albergue Municipal de El Carrascalejo">
  <svg style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true">
    <defs>
      <filter id="sketchy-filter">
        <feTurbulence type="turbulence" baseFrequency="0.03" numOctaves="4" result="noise"
        ></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="2"></feDisplacementMap>
      </filter>
    </defs>
  </svg>

  <!-- HERO -->
  <section class="page-hero reveal-section">
    <div class="page-hero-inner">
      <a href="/dashboard" class="back-link">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"><path d="M19 12H5M12 5l-7 7 7 7"></path></svg
        >
        Volver al Panel
      </a>
      <div class="hero-emoji" aria-hidden="true">🧭</div>
      <h1 class="page-title">Como Llegar</h1>
      <p class="page-subtitle">Rutas, transporte y mapas para El Carrascalejo</p>
    </div>
  </section>

  <div class="page-content">
    <!-- HOW TO ARRIVE CARDS -->
    <section class="cards-section reveal-section" style="--delay:0.05s">
      <h2 class="section-title">Formas de Llegar</h2>
      <div class="arrival-grid">
        {
          directionCards.map((card) => (
            <div class="arrival-card">
              <svg
                style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none"
                aria-hidden="true"
              >
                <rect
                  x="0"
                  y="0"
                  width="100%"
                  height="100%"
                  rx="14"
                  fill="white"
                  stroke={card.color}
                  stroke-width="1.5"
                  filter="url(#sketchy-filter)"
                  stroke-opacity="0.4"
                />
              </svg>
              <div class="arrival-inner">
                <div class="arrival-header">
                  <span class="arrival-emoji" aria-hidden="true">
                    {card.icon}
                  </span>
                  <h3 class="arrival-title" style={`color:${card.color}`}>
                    {card.title}
                  </h3>
                </div>
                <ul class="arrival-list">
                  {card.lines.map((l) => (
                    <li>{l}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- MAPLIBRE GL MAP — OpenStreetMap tiles via OpenFreeMap (no API key) -->
    <section class="map-section reveal-section" style="--delay:0.1s">
      <h2 class="section-title">Ubicación</h2>
      <div class="map-card">
        <!-- Reusable MapLibre component (Astro 6 Web Component pattern) -->
        <MapLibre
          latitude={LAT}
          longitude={LNG}
          zoom={15}
          height="380px"
          markerTitle="Albergue Municipal"
          markerSubtitle={`El Carrascalejo · Km 482 · ${ELEVATION}m`}
          scrollZoom={true}
          data-elevation={ELEVATION}
          class="directions-map"
        />
        <MapLibreBeacon mapHostSelector=".directions-map" mapSectionSelector=".map-section" />
        <div class="map-meta">
          <div class="map-coords">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--green)"
              stroke-width="2.5"
              stroke-linecap="round"
              aria-hidden="true"
              ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle
                cx="12"
                cy="10"
                r="3"></circle></svg
            >
            {LAT.toFixed(6)}°N, {Math.abs(LNG).toFixed(6)}°O · {ELEVATION} m · Extremadura, España
          </div>
          <div class="map-actions">
            <a
              href={osmUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="map-btn map-btn-primary"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="white"
                stroke-width="2.5"
                stroke-linecap="round"
                aria-hidden="true"
                ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle
                  cx="12"
                  cy="10"
                  r="3"></circle></svg
              >
              Ver en OpenStreetMap
            </a>
            <a
              href={osmDirections}
              target="_blank"
              rel="noopener noreferrer"
              class="map-btn map-btn-secondary"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--green-dark)"
                stroke-width="2.5"
                stroke-linecap="round"
                aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg
              >
              Cómo llegar
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- TRAIL STAGES -->
    <section class="stages-section reveal-section" style="--delay:0.15s">
      <h2 class="section-title">Etapas Proximas</h2>
      <div class="stages-list">
        {
          nearbyStages.map((stage, i) => (
            <div class="stage-row reveal-section" style={`--delay:${0.17 + i * 0.06}s`}>
              <svg
                style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none"
                aria-hidden="true"
              >
                <rect
                  x="0"
                  y="0"
                  width="100%"
                  height="100%"
                  rx="12"
                  fill="white"
                  stroke="#e0e0e0"
                  stroke-width="1.5"
                  filter="url(#sketchy-filter)"
                />
              </svg>
              <div class="stage-inner">
                <div class="stage-route">
                  <span class="stage-city">{stage.from}</span>
                  <svg width="24" height="14" viewBox="0 0 24 14" fill="none" aria-hidden="true">
                    <path
                      d="M0 7h20M14 2l6 5-6 5"
                      stroke="var(--green)"
                      stroke-width="2"
                      stroke-linecap="round"
                    />
                  </svg>
                  <span class="stage-city">{stage.to}</span>
                  {stage.days === 0 && <span class="stage-badge">Aqui</span>}
                </div>
                <div class="stage-meta">
                  <span class="stage-km">{stage.km} km</span>
                  <span class={`stage-diff diff-${stage.diff.toLowerCase()}`}>{stage.diff}</span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>

</Layout>
