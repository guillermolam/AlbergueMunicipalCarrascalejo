{
  "name": "retto-ocr-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker using Retto WASM for OCR",
  "main": "src/index.ts",
  "scripts": {
    "build": "node build.mjs",
    "deploy": "node build.mjs && wrangler deploy .worker/index.js --no-bundle",
    "dev": "node build.mjs && wrangler dev .worker/index.js --no-bundle"
  },
  "dependencies": {
    "@nekoimageland/retto-wasm": "^0.1.5"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "wrangler": "^4.81.1",
    "typescript": "^5.7.0"
  }
}