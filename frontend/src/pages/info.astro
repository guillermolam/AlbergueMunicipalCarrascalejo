                        stroke-width="2"
                        stroke-linecap="round"
                      >
                        <path d="M12 22V12M12 12C12 12 8 8 4 9s-1 8 4 7M12 12c0 0 4-4 8-3s1 8-4 7" />
                      </svg>
                    )}
                    {f.icon === 'bike' && (
                      <svg
                        width="28"
