    function loadStep3State() {
      // Prefer in-memory cache; fall back to nanostore (e.g. after page refresh)
      let data = personFormData[activePersonStep3];
      if (!data || Object.values(data).every((v) => !v)) {
        const stored = pilgrimStores[activePersonStep3].get();
        data = Object.fromEntries(STEP3_FIELD_KEYS.map((k) => [k, stored[k] ?? '']));
        personFormData[activePersonStep3] = data;
      }
      for (const id of STEP3_FIELDS) {
        const el = document.getElementById(id) as HTMLInputElement | null;
        if (el) el.value = data[id] ?? '';
