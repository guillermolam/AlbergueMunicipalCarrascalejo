            viewBox="0 0 24 24"
            fill="none"
            stroke="white"
            stroke-width="2"
            stroke-linecap="round"
            ><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"
            ></circle></svg
          >
        </div>
        <div class="pmodal-identity-text">
          <div class="pmodal-name" id="pmodalName">Peregrino</div>
          <div class="pmodal-meta-line" id="pmodalEmail">peregrino@camino.es</div>
          <div class="pmodal-meta-line" id="pmodalCountry" style="display:none"></div>
        </div>
      </div>

      <!-- Contact chips -->
      <div class="pmodal-chips" id="pmodalChips" style="display:none"></div>

      <!-- Bio -->
      <p class="pmodal-bio" id="pmodalBio" style="display:none"></p>

      <!-- Camino progress -->
      <div class="pmodal-section">
        <div class="pmodal-section-label">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--green)"
            stroke-width="2.5"
            stroke-linecap="round"
            aria-hidden="true"><path d="M3 17l6-6 4 4 8-8"></path></svg
          >
          El Camino
        </div>
        <div class="pmodal-camino-stats" id="pmodalCaminoStats">0 etapas · 0 km</div>
        <div class="pmodal-progress-track">
          <div class="pmodal-progress-fill" id="pmodalProgressFill" style="width:0%"></div>
        </div>
        <div class="pmodal-progress-labels">
          <span>Inicio</span><span id="pmodalCaminoRoute">Via de la Plata</span><span>Santiago</span
          >
        </div>
      </div>

      <!-- Badges -->
      <div class="pmodal-section" id="pmodalBadgesSection" style="display:none">
        <div class="pmodal-section-label">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#f59e0b"
            stroke-width="2.5"
            stroke-linecap="round"
            aria-hidden="true"
            ><polygon
              points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
            ></polygon></svg
          >
          Medallas
        </div>
        <div class="pmodal-badges" id="pmodalBadges"></div>
      </div>

      <!-- Emergency contact -->
      <div class="pmodal-section" id="pmodalEmergencySection" style="display:none">
        <div class="pmodal-section-label">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#dc2626"
            stroke-width="2.5"
            stroke-linecap="round"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"
            ></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg
          >
          Contacto de Emergencia
        </div>
        <div class="pmodal-emergency-info" id="pmodalEmergencyInfo"></div>
      </div>

      <div class="pmodal-actions">
        <a href="/profile" class="pmodal-edit-btn">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="white"
            stroke-width="2.5"
            stroke-linecap="round"
            aria-hidden="true"
            ><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path
              d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg
          >
          Editar Perfil Completo
        </a>
      </div>
    </div>
  </div>
</div>
<!-- ============================================================ -->

<script>
  // Scroll reveal
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('revealed');
          observer.unobserve(e.target);
        }
      });
    },
    { threshold: 0.07 }
  );
  document.querySelectorAll('.reveal-section').forEach((el) => observer.observe(el));

  // Animate progress bar when in view
  const fillEl = document.getElementById('progress-fill');
  const fillObserver = new IntersectionObserver(
    (entries) => {
      if (entries[0].isIntersecting && fillEl) {
        setTimeout(() => {
          fillEl.style.width = '15%';
        }, 300);
        fillObserver.disconnect();
      }
    },
    { threshold: 0.3 }
  );
  if (fillEl) fillObserver.observe(fillEl);

  // ─── Hostel map modal ───
  type ZoneEntry = { emoji: string; name: string; desc: string; items: string[] };
  const ZONE_DATA: Record<string, ZoneEntry> = {
    dormitorios: {
      emoji: '🛏️',
      name: 'Dormitorios',
      desc: 'Dos salas con literas. Sabanas y mantas incluidas. Taquillas individuales.',
      items: [
        '24 camas (12 literas × 2 salas)',
        'Taquillas con candado',
        'Luz de lectura',
        'Ventanas con persiana',
      ],
    },
    banos_h: {
      emoji: '🚿',
      name: 'Baños Hombres',
      desc: 'Duchas individuales con agua caliente las 24 horas.',
      items: ['3 duchas de agua caliente', '2 WC', 'Ganchos y estanterias'],
    },
    banos_m: {
      emoji: '🚿',
      name: 'Baños Mujeres',
      desc: 'Duchas individuales con agua caliente. Espejo grande y enchufes.',
      items: ['3 duchas de agua caliente', '2 WC', 'Espejo grande', 'Enchufes y ganchos'],
    },
    cocina: {
      emoji: '🍳',
      name: 'Cocina + Zona Chill',
      desc: 'Zona comunitaria con electrodomesticos y mesa compartida para peregrinos.',
      items: [
        'Lavadora — 1 € / uso',
        'Secadora — 2 € / uso',
        'Nevera comunitaria',
        'Fogones y microondas',
        'Mesa y sillas comunes',
      ],
    },
    restaurante: {
      emoji: '🍽️',
      name: 'Restaurante / Cafeteria',
      desc: 'Bar Alqantara. Desayunos, tapas, menu del dia y bocadillos para llevar.',
      items: [
        'Desayunos desde 7:30h',
        'Bocadillos para llevar',
        'Menu del dia ~9 €',
        'Bar y tapas',
        'Terraza exterior',
      ],
    },
    aseo: {
      emoji: '🚻',
      name: 'Aseo',
      desc: 'WC publico del restaurante en horario de apertura del bar.',
      items: ['Acceso desde el restaurante', 'Disponible en horario del bar'],
    },
    patio: {
      emoji: '🌿',
      name: 'Patio Exterior',
      desc: 'Espacio al aire libre con mesas, sillas y altos. Tendedero y acceso libre 24h.',
      items: [
        'Mesas redondas con sillas',
        'High tops (mesas altas)',
        'Tendedero de ropa',
        'Acceso libre las 24h',
      ],
    },
    eventos: {
      emoji: '🎉',
      name: 'Sala de Eventos',
      desc: 'Sala multiuso para charlas y actividades del Camino. No siempre abierta.',
      items: [
        'Capacidad ~60 personas',
        'Apertura bajo reserva',
        'Escenario y proyector',
        'Entrada por el patio',
      ],
    },
  };

  const mapModal = document.getElementById('albergueMapModal') as HTMLElement;
  const openMapBtn = document.getElementById('openMapBtn') as HTMLButtonElement;
  const closeMapBtn = document.getElementById('closeMapBtn') as HTMLButtonElement;
  const mapTooltip = document.getElementById('mapTooltip') as HTMLElement;
  const mapWrap = document.getElementById('mapInteractiveWrap') as HTMLElement;

  function openMap() {
    if (!mapModal) return;
    mapModal.classList.add('map-open');
    document.body.style.overflow = 'hidden';
    if (closeMapBtn) closeMapBtn.focus();
  }
  function closeMap() {
    if (!mapModal) return;
    mapModal.classList.remove('map-open');
    document.body.style.overflow = '';
    if (openMapBtn) openMapBtn.focus();
  }

  if (openMapBtn) openMapBtn.addEventListener('click', openMap);
  if (closeMapBtn) closeMapBtn.addEventListener('click', closeMap);
  if (mapModal) {
    mapModal.addEventListener('click', (e) => {
      if (e.target === mapModal) closeMap();
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mapModal?.classList.contains('map-open')) closeMap();
  });

  // Build tooltip using safe DOM methods (no innerHTML)
  function populateTooltip(zoneId: string) {
    const d = ZONE_DATA[zoneId];
    if (!d || !mapTooltip) return;
    while (mapTooltip.firstChild) mapTooltip.removeChild(mapTooltip.firstChild);

    const header = document.createElement('div');
    header.className = 'tt-header';
    const emojiEl = document.createElement('span');
    emojiEl.className = 'tt-emoji';
    emojiEl.textContent = d.emoji;
    const nameEl = document.createElement('span');
    nameEl.className = 'tt-name';
    nameEl.textContent = d.name;
    header.appendChild(emojiEl);
    header.appendChild(nameEl);

    const descEl = document.createElement('p');
    descEl.className = 'tt-desc';
    descEl.textContent = d.desc;

    const ul = document.createElement('ul');
    ul.className = 'tt-list';
    for (const item of d.items) {
      const li = document.createElement('li');
      li.textContent = item;
      ul.appendChild(li);
    }

    mapTooltip.appendChild(header);
    mapTooltip.appendChild(descEl);
    mapTooltip.appendChild(ul);
    mapTooltip.classList.add('tt-visible');
  }

  document.querySelectorAll<SVGGElement>('.map-zone').forEach((zone) => {
    zone.addEventListener('mouseenter', () => populateTooltip(zone.dataset.zone || ''));
    zone.addEventListener('mouseleave', () => mapTooltip?.classList.remove('tt-visible'));
    zone.addEventListener('mousemove', (e: MouseEvent) => {
      if (!mapWrap || !mapTooltip) return;
      const rect = mapWrap.getBoundingClientRect();
      let x = e.clientX - rect.left + 18;
      let y = e.clientY - rect.top + 18;
      if (x + 290 > rect.width - 8) x = e.clientX - rect.left - 300;
      if (y + 210 > rect.height - 8) y = e.clientY - rect.top - 220;
      if (x < 4) x = 4;
      if (y < 4) y = 4;
      mapTooltip.style.left = x + 'px';
      mapTooltip.style.top = y + 'px';
    });
    zone.addEventListener('click', () => {
      if (mapTooltip) {
        populateTooltip(zone.dataset.zone || '');
        mapTooltip.style.left = '12px';
        mapTooltip.style.top = '12px';
        setTimeout(() => mapTooltip.classList.remove('tt-visible'), 3500);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.legend-item').forEach((btn) => {
    const zoneId = btn.dataset.legendZone || '';
    const zoneEl = document.querySelector<SVGGElement>(`.map-zone[data-zone="${zoneId}"]`);
    const bgEl = zoneEl ? zoneEl.querySelector<SVGRectElement>('.zone-bg') : null;
    btn.addEventListener('mouseenter', () => {
      if (bgEl) bgEl.style.filter = 'brightness(0.87) saturate(1.3)';
    });
    btn.addEventListener('mouseleave', () => {
      if (bgEl) bgEl.style.filter = '';
    });
    btn.addEventListener('click', () => {
      if (!mapTooltip) return;
      populateTooltip(zoneId);
      mapTooltip.style.left = '12px';
      mapTooltip.style.top = '12px';
      setTimeout(() => mapTooltip.classList.remove('tt-visible'), 3500);
    });
  });

  // ─── WiFi widget ───
  // Password show/hide toggle
  const togglePassBtn = document.getElementById('togglePass') as HTMLButtonElement | null;
  const passDots = document.querySelector('.pass-dots') as HTMLElement | null;
  const passText = document.querySelector('.pass-text') as HTMLElement | null;
  const eyeOpen = togglePassBtn?.querySelector('.eye-open') as HTMLElement | null;
  const eyeClosed = togglePassBtn?.querySelector('.eye-closed') as HTMLElement | null;

  if (togglePassBtn) {
    togglePassBtn.addEventListener('click', () => {
      const hidden = passDots?.style.display !== 'none';
      if (passDots) passDots.style.display = hidden ? 'none' : '';
      if (passText) passText.style.display = hidden ? '' : 'none';
      if (eyeOpen) eyeOpen.style.display = hidden ? 'none' : '';
      if (eyeClosed) eyeClosed.style.display = hidden ? '' : 'none';
      togglePassBtn.setAttribute(
        'aria-label',
        hidden ? 'Ocultar contraseña' : 'Mostrar contraseña'
      );
    });
  }

  // Copy buttons
  // WiFi modal
  document.getElementById('openWifiModal')?.addEventListener('click', () => {
    const m = document.getElementById('wifiModal') as HTMLElement;
    if (m) m.hidden = false;
  });
  document.getElementById('wifiModalClose')?.addEventListener('click', () => {
    const m = document.getElementById('wifiModal') as HTMLElement;
    if (m) m.hidden = true;
  });
  document.getElementById('wifiModal')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) (e.currentTarget as HTMLElement).hidden = true;
  });

  document.querySelectorAll<HTMLButtonElement>('.wifi-copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // Fallback: select & execCommand
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.cssText = 'position:fixed;opacity:0;top:0;left:0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      btn.classList.add('copied');
      setTimeout(() => btn.classList.remove('copied'), 1800);
    });
  });

  // Stat box wobble on hover
  document.querySelectorAll('.dash-stat-box').forEach((box) => {
    box.addEventListener('mouseenter', function () {
      (this as HTMLElement).style.animation = 'wobble-anim 0.6s ease';
    });
    box.addEventListener('animationend', function () {
      (this as HTMLElement).style.animation = '';
    });
  });

  // Quick action ripple
  document.querySelectorAll('.quick-action-btn').forEach((btn) => {
    btn.addEventListener('click', function (e) {
      const me = e as MouseEvent;
      const el = this as HTMLElement;
      const rect = el.getBoundingClientRect();
      const r = document.createElement('span');
      r.style.cssText =
        'position:absolute;border-radius:50%;background:rgba(0,171,57,0.15);transform:scale(0);animation:ripple-anim 600ms linear;pointer-events:none;';
      const size = Math.max(rect.width, rect.height);
      r.style.width = size + 'px';
      r.style.height = size + 'px';
      r.style.left = me.clientX - rect.left - size / 2 + 'px';
      r.style.top = me.clientY - rect.top - size / 2 + 'px';
      el.style.position = 'relative';
      el.style.overflow = 'hidden';
      el.appendChild(r);
      setTimeout(() => r.remove(), 700);
    });
  });

  // ─── Profile summary modal ───
  interface PilgrimProfile {
    name?: string;
    email?: string;
    phone?: string;
    country?: string;
    bio?: string;
    avatar?: string | null;
    emergency?: { name?: string; relation?: string; phone?: string; email?: string };
    camino?: { route?: string; stages?: string[] };
    manualBadges?: string[];
  }

  const BADGE_DEFS = [
    { id: 'first_step', emoji: '👣', label: 'Primer Paso' },
    { id: 'five_stages', emoji: '🥇', label: '5 Etapas' },
    { id: 'ten_stages', emoji: '🏅', label: '10 Etapas' },
    { id: 'twenty_stages', emoji: '🎖️', label: '20 Etapas' },
    { id: 'carrascalejo', emoji: '⛺', label: 'El Carrascalejo' },
    { id: 'via_plata', emoji: '🏛️', label: 'Via de la Plata' },
  ];

  const ROUTE_NAMES: Record<string, string> = {
    vdlp: 'Via de la Plata',
    camino_frances: 'Camino Francés',
    camino_norte: 'Camino del Norte',
    via_de_la_plata: 'Via de la Plata',
  };

  const COUNTRY_NAMES: Record<string, string> = {
    ES: '🇪🇸 España',
    DE: '🇩🇪 Alemania',
    FR: '🇫🇷 Francia',
    IT: '🇮🇹 Italia',
    PT: '🇵🇹 Portugal',
    GB: '🇬🇧 Reino Unido',
    US: '🇺🇸 Estados Unidos',
    NL: '🇳🇱 Países Bajos',
  };

  const pmodalOverlay = document.getElementById('profileModal') as HTMLElement | null;
  const openPModalBtn = document.getElementById('openProfileModalBtn') as HTMLButtonElement | null;
  const closePModalBtn = document.getElementById(
    'closeProfileModalBtn'
  ) as HTMLButtonElement | null;

  function openProfileModal() {
    if (!pmodalOverlay) return;
    loadProfileIntoModal();
    pmodalOverlay.classList.add('pmodal-open');
    document.body.style.overflow = 'hidden';
    if (closePModalBtn) closePModalBtn.focus();
  }

  function closeProfileModal() {
    if (!pmodalOverlay) return;
    pmodalOverlay.classList.remove('pmodal-open');
    document.body.style.overflow = '';
    if (openPModalBtn) openPModalBtn.focus();
  }

  function loadProfileIntoModal() {
    let profile: PilgrimProfile = {};
    try {
      const raw = localStorage.getItem('pilgrim_profile');
      if (raw) profile = JSON.parse(raw) as PilgrimProfile;
    } catch {
      /* ignore */
    }

    // ── Avatar ──
    const pmodalAvatarEl = document.getElementById('pmodalAvatar');
    if (pmodalAvatarEl) {
      while (pmodalAvatarEl.firstChild) pmodalAvatarEl.removeChild(pmodalAvatarEl.firstChild);
      if (profile.avatar) {
        const img = document.createElement('img');
        img.src = profile.avatar;
        img.alt = 'Foto de perfil';
        pmodalAvatarEl.appendChild(img);
      } else {
        const initials = (profile.name || 'P')
          .trim()
          .split(' ')
          .map((w) => w[0])
          .slice(0, 2)
          .join('')
          .toUpperCase();
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('width', '40');
        svg.setAttribute('height', '40');
        svg.setAttribute('viewBox', '0 0 40 40');
        const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circle.setAttribute('cx', '20');
        circle.setAttribute('cy', '20');
        circle.setAttribute('r', '20');
        circle.setAttribute('fill', 'var(--green)');
        const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        text.setAttribute('x', '20');
        text.setAttribute('y', '25');
        text.setAttribute('text-anchor', 'middle');
        text.setAttribute('font-size', '16');
        text.setAttribute('fill', 'white');
        text.setAttribute('font-family', 'Patrick Hand, sans-serif');
        text.setAttribute('font-weight', '700');
        text.textContent = initials;
        svg.appendChild(circle);
        svg.appendChild(text);
        pmodalAvatarEl.appendChild(svg);
      }
    }

    // ── Name & dashboard card ──
    const nameStr = (profile.name || 'Peregrino').trim();
    const pmodalNameEl = document.getElementById('pmodalName');
    if (pmodalNameEl) pmodalNameEl.textContent = nameStr;
    const dashNameEl = document.getElementById('dashProfileName');
    if (dashNameEl) dashNameEl.textContent = nameStr;

    // ── Email ──
    const emailStr = profile.email || 'peregrino@camino.es';
    const pmodalEmailEl = document.getElementById('pmodalEmail');
    if (pmodalEmailEl) pmodalEmailEl.textContent = emailStr;
    const dashEmailEl = document.getElementById('dashProfileEmail');
    if (dashEmailEl) dashEmailEl.textContent = emailStr;

    // ── Country ──
    const countryEl = document.getElementById('pmodalCountry');
    if (countryEl) {
      if (profile.country && COUNTRY_NAMES[profile.country]) {
        countryEl.textContent = COUNTRY_NAMES[profile.country];
        countryEl.style.display = '';
      } else {
        countryEl.style.display = 'none';
      }
    }

    // ── Dashboard avatar ──
    const dashAvEl = document.getElementById('dashAvatarCircle');
    if (dashAvEl) {
      while (dashAvEl.firstChild) dashAvEl.removeChild(dashAvEl.firstChild);
      if (profile.avatar) {
        const img = document.createElement('img');
        img.src = profile.avatar;
        img.alt = '';
        dashAvEl.appendChild(img);
      } else {
        const initials = (profile.name || 'P')
          .trim()
          .split(' ')
          .map((w) => w[0])
          .slice(0, 2)
          .join('')
          .toUpperCase();
        const span = document.createElement('span');
        span.style.cssText =
          'font-family:var(--font-sketch);font-weight:700;font-size:1rem;color:white;';
        span.textContent = initials;
        dashAvEl.appendChild(span);
      }
    }

    // ── Chips (phone) ──
    const chipsEl = document.getElementById('pmodalChips');
    if (chipsEl) {
      while (chipsEl.firstChild) chipsEl.removeChild(chipsEl.firstChild);
      const chips: { icon: string; label: string }[] = [];
      if (profile.phone) chips.push({ icon: '📞', label: profile.phone });
      if (chips.length > 0) {
        for (const c of chips) {
          const span = document.createElement('span');
          span.className = 'pmodal-chip';
          const icon = document.createElement('span');
          icon.textContent = c.icon;
          const label = document.createElement('span');
          label.textContent = c.label;
          span.appendChild(icon);
          span.appendChild(label);
          chipsEl.appendChild(span);
        }
        chipsEl.style.display = '';
      } else {
        chipsEl.style.display = 'none';
      }
    }

    // ── Bio ──
    const bioEl = document.getElementById('pmodalBio') as HTMLParagraphElement | null;
    if (bioEl) {
      if (profile.bio && profile.bio.trim()) {
        bioEl.textContent = profile.bio.trim();
        bioEl.style.display = '';
      } else {
        bioEl.style.display = 'none';
      }
    }

    // ── Camino progress ──
    const stages = profile.camino?.stages ?? [];
    const routeKey = profile.camino?.route || 'vdlp';
    const TOTAL_STAGES = 39; // Via de la Plata stages
    const pct = Math.min(100, Math.round((stages.length / TOTAL_STAGES) * 100));
    const statsEl = document.getElementById('pmodalCaminoStats');
    if (statsEl)
      statsEl.textContent = stages.length + ' etapas · ' + stages.length * 22 + ' km aprox.';
    const routeEl = document.getElementById('pmodalCaminoRoute');
    if (routeEl) routeEl.textContent = ROUTE_NAMES[routeKey] || routeKey;
    const fillEl2 = document.getElementById('pmodalProgressFill');
    if (fillEl2)
      setTimeout(() => {
        fillEl2.style.width = pct + '%';
      }, 120);

    // ── Badges ──
    const earnedBadgeIds = new Set<string>([...(profile.manualBadges ?? [])]);
    if (stages.length >= 1) earnedBadgeIds.add('first_step');
    if (stages.length >= 5) earnedBadgeIds.add('five_stages');
    if (stages.length >= 10) earnedBadgeIds.add('ten_stages');
    if (stages.length >= 20) earnedBadgeIds.add('twenty_stages');
    const badgesEl = document.getElementById('pmodalBadges');
    const badgesSec = document.getElementById('pmodalBadgesSection');
    if (badgesEl && badgesSec) {
      while (badgesEl.firstChild) badgesEl.removeChild(badgesEl.firstChild);
      const earned = BADGE_DEFS.filter((b) => earnedBadgeIds.has(b.id));
      if (earned.length > 0) {
        badgesSec.style.display = '';
        for (const b of earned.slice(0, 6)) {
          const span = document.createElement('span');
          span.className = 'pmodal-badge';
          const em = document.createElement('span');
          em.textContent = b.emoji;
          const lbl = document.createElement('span');
          lbl.textContent = b.label;
          span.appendChild(em);
          span.appendChild(lbl);
          badgesEl.appendChild(span);
        }
      } else {
        badgesSec.style.display = 'none';
      }
    }

    // ── Emergency contact ──
    const emSec = document.getElementById('pmodalEmergencySection');
    const emInfo = document.getElementById('pmodalEmergencyInfo');
    const em = profile.emergency;
    if (emSec && emInfo && em && em.name) {
      while (emInfo.firstChild) emInfo.removeChild(emInfo.firstChild);
      const nameDiv = document.createElement('div');
      nameDiv.className = 'pmodal-emergency-name';
      nameDiv.textContent = em.name + (em.relation ? ' (' + em.relation + ')' : '');
      emInfo.appendChild(nameDiv);
      if (em.phone) {
        const detail = document.createElement('div');
        detail.className = 'pmodal-emergency-detail';
        detail.textContent = '📞 ' + em.phone;
        emInfo.appendChild(detail);
      }
      if (em.email) {
        const detail = document.createElement('div');
        detail.className = 'pmodal-emergency-detail';
        detail.textContent = '✉️ ' + em.email;
        emInfo.appendChild(detail);
      }
      emSec.style.display = '';
    } else if (emSec) {
      emSec.style.display = 'none';
    }
  }

  if (openPModalBtn) openPModalBtn.addEventListener('click', openProfileModal);
  if (closePModalBtn) closePModalBtn.addEventListener('click', closeProfileModal);
  if (pmodalOverlay) {
    pmodalOverlay.addEventListener('click', (e) => {
      if (e.target === pmodalOverlay) closeProfileModal();
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && pmodalOverlay?.classList.contains('pmodal-open')) closeProfileModal();
  });

  // Load profile data into dashboard card on page load
  (function initDashboardProfile() {
    let profile: PilgrimProfile = {};
    try {
      const raw = localStorage.getItem('pilgrim_profile');
      if (raw) profile = JSON.parse(raw) as PilgrimProfile;
    } catch {
      /* ignore */
    }
    if (!profile.name && !profile.email && !profile.avatar) return;

    const nameEl = document.getElementById('dashProfileName');
    if (nameEl && profile.name) nameEl.textContent = profile.name;

    const emailEl = document.getElementById('dashProfileEmail');
    if (emailEl && profile.email) emailEl.textContent = profile.email;

    const avEl = document.getElementById('dashAvatarCircle');
    if (avEl) {
      if (profile.avatar) {
        while (avEl.firstChild) avEl.removeChild(avEl.firstChild);
        const img = document.createElement('img');
        img.src = profile.avatar;
        img.alt = '';
        img.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius:50%;';
        avEl.appendChild(img);
      } else if (profile.name) {
        while (avEl.firstChild) avEl.removeChild(avEl.firstChild);
        const initials = profile.name
          .trim()
          .split(' ')
          .map((w: string) => w[0])
          .slice(0, 2)
          .join('')
          .toUpperCase();
        const span = document.createElement('span');
        span.style.cssText =
          'font-family:var(--font-sketch);font-weight:700;font-size:1rem;color:white;';
        span.textContent = initials;
        avEl.appendChild(span);
      }
    }
  })();
</script>
