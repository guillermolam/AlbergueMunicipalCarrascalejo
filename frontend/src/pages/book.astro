        const badge = document.createElement('span');
        badge.style.cssText =
          "font-family:'Patrick Hand',cursive;font-size:0.8rem;color:#888;display:flex;align-items:center;gap:0.25rem";
        badge.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg> Validating…`;
        row.appendChild(badge);
