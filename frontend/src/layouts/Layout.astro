---
import '../styles/global.css';
import '../styles/figma-design.css';
import '../styles/ribbon.css';
import { Font } from 'astro:assets';
import { getD1, db, hostelConfig } from '../db/helpers';
import { eq } from 'drizzle-orm';

export interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  lang?: string;
}

const {
  title = 'Albergue Municipal de El Carrascalejo',
  description = 'Tu refugio en el Camino de Santiago — Vía de la Plata. Alojamiento para peregrinos en Extremadura.',
  showHeader = true,
  showFooter = true,
  lang = 'es',
} = Astro.props;

// Auth state for header pill.
// Prerendered pages bypass the middleware so locals.auth may not be a function.
const authState = typeof Astro.locals.auth === 'function' ? Astro.locals.auth() : null;
const userId = authState?.userId ?? null;
const role = Astro.locals.role ?? 'guest';
const localUser = Astro.locals.user ?? null;
const dashboardHref = role === 'admin' ? '/admin' : '/dashboard';

// Fetch Clerk avatar + display name when signed in (non-prerendered pages only)
let avatarUrl: string | null = null;
let displayName = localUser?.name?.split(' ')[0] ?? 'Mi cuenta';
let userInitials = displayName.slice(0, 2).toUpperCase();
if (userId && typeof Astro.locals.currentUser === 'function') {
  try {
    const clerkUser = await Astro.locals.currentUser();
    avatarUrl = clerkUser?.imageUrl ?? null;
    const first = clerkUser?.firstName ?? '';
    const last  = clerkUser?.lastName  ?? '';
    displayName = first || last
      ? [first, last].filter(Boolean).join(' ')
      : (localUser?.name ?? 'Mi cuenta');
    userInitials = [first?.[0], last?.[0]].filter(Boolean).join('').toUpperCase() || 'U';
  } catch { /* non-critical */ }
}

// ── Hostel config from D1 — queried on every SSR request ─────────────────────
// Falls back to real known values so the footer is never empty in dev mode.
const d1 = await getD1();
let hostel: typeof hostelConfig.$inferSelect | null = null;
if (d1) {
  try {
    const rows = await db(d1).select().from(hostelConfig).where(eq(hostelConfig.id, 1)).limit(1);
    hostel = rows[0] ?? null;
  } catch { /* non-critical — use fallbacks */ }
}

// Fallbacks match the real data so local Vite dev without wrangler still shows correct info
const footerPhone          = hostel?.phone          ?? '+34 695 90 43 44';
const footerEmail          = hostel?.email          ?? 'elcarrascalejoalbergue@gmail.com';
const footerCif            = hostel?.cif            ?? null;
const footerTourismLicense = hostel?.tourismLicense ?? 'H-CC-0023';
const footerInsurance      = hostel?.insurancePolicy ?? null;
const footerAddressStreet  = hostel?.addressStreet   ?? 'Paraje Cuesta, s/n';
const footerAddressPost    = hostel?.addressPostcode ?? '06894';
const footerAddressTown    = hostel?.addressTown     ?? 'El Carrascalejo';
const footerAddressProv    = hostel?.addressProvince ?? 'Badajoz';
const footerLat            = hostel?.latitude        ?? 39.023831;
const footerLng            = hostel?.longitude       ?? -6.337627;

// WhatsApp deep-link — strip spaces and leading + for wa.me format
const footerPhoneDigits    = footerPhone.replace(/[\s\-()]/g, '').replace(/^\+/, '');
const footerWhatsApp       = `https://wa.me/${footerPhoneDigits}`;
const footerOsmUrl         = `https://www.openstreetmap.org/?mlat=${footerLat}&mlon=${footerLng}&zoom=16`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00AB39" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: local WOFF2 files via Astro fontProviders.local() — zero network requests -->
    <Font cssVariable="--font-patrick-hand" preload />
    <Font cssVariable="--font-cabin-sketch" preload />
    <Font cssVariable="--font-shadows-into-light" preload />
    <Font cssVariable="--font-gloria" />
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-jetbrains-mono" />

    <!-- Material Symbols (Google Fonts icon provider) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,300..700,0..1,-50..200&display=swap"
    />

    <script>
      import '../scripts/runtime.ts';
    </script>

    <style>
      /* Header pill buttons - SVG stroke based */
      .pill-btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 1.1rem;
        font-family: var(--font-patrick-hand);
        font-size: 0.95rem;
        color: #1A1A1A;
        background: transparent;
        border: none;
        cursor: pointer;
        text-decoration: none;
        /* Spec: whileHover: { scale: 1.05 }, whileTap: { scale: 0.95 } */
        transition: transform 200ms ease, filter 200ms ease;
      }
      .pill-btn:hover {
        transform: scale(1.05);
      }
      .pill-btn:active {
        transform: scale(0.95);
      }
      .pill-btn svg.pill-border {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
      }
      .pill-btn svg.pill-border rect {
        fill: #FFFFFF;
        rx: 20;
        stroke: #00AB39;
        stroke-width: 2.5;
        transition: all 200ms ease;
      }
      .pill-btn .pill-label {
        position: relative;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
      }

      /* Entrar pill fill: white → #00AB39 */
      .pill-entrar svg.pill-border rect {
        transition: fill 200ms ease, stroke 200ms ease;
      }
      .pill-entrar:hover svg.pill-border rect {
        fill: #00AB39 !important;
        stroke: #00AB39 !important;
      }
      /* Language pill same */
      .pill-lang:hover svg.pill-border rect {
        fill: #00AB39 !important;
        stroke: #00AB39 !important;
      }
      .pill-lang:hover .pill-label,
      .pill-entrar:hover .pill-label {
        color: #FFFFFF !important;
      }
      .pill-lang:hover .pill-label svg,
      .pill-entrar:hover .pill-label svg {
        stroke: #FFFFFF !important;
      }

      /* User dropdown pill */
      .user-pill-wrap {
        position: relative;
        display: inline-flex;
      }
      .user-pill-btn {
        cursor: pointer;
        background: none;
        border: none;
        padding: 0.45rem 0.9rem 0.45rem 0.5rem;
        font-family: var(--font-patrick-hand);
        font-size: 0.9rem;
        color: #1A1A1A;
      }
      .user-avatar-circle {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        overflow: hidden;
        background: #00AB39;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 0.7rem;
        font-weight: 700;
        color: #fff;
        font-family: var(--font-cabin-sketch);
      }
      .user-avatar-circle img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .user-dropdown {
        display: none;
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 180px;
        background: #fff;
        border: 1.5px solid #e0e0e0;
        border-radius: 14px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.12);
        z-index: 9999;
        overflow: hidden;
      }
      .user-dropdown.open {
        display: block;
      }
      .user-dropdown-name {
        padding: 10px 16px 6px;
        font-size: 0.78rem;
        color: #888;
        border-bottom: 1px solid #f0f0f0;
        font-family: var(--font-patrick-hand);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .user-dropdown a,
      .user-dropdown button.dd-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
        padding: 10px 16px;
        font-size: 0.9rem;
        color: #1A1A1A;
        text-decoration: none;
        background: none;
        border: none;
        cursor: pointer;
        font-family: var(--font-patrick-hand);
        transition: background 150ms;
        text-align: left;
      }
      .user-dropdown a:hover,
      .user-dropdown button.dd-item:hover {
        background: #f5fdf7;
        color: #00AB39;
      }
      .user-dropdown .dd-logout {
        color: #c0392b;
        border-top: 1px solid #f0f0f0;
      }
      .user-dropdown .dd-logout:hover {
        background: #fff5f5;
        color: #c0392b;
      }

      /* Pulsing green dot */
      @keyframes pulse-indicator {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.3); opacity: 0.7; }
      }
      .pulse-indicator {
        width: 8px;
        height: 8px;
        background: #00AB39;
        border-radius: 50%;
        position: absolute;
        top: 2px;
        right: 2px;
        z-index: 3;
        animation: pulse-indicator 2s ease-in-out infinite;
      }

      /* Wobble logo — Exact spec: rotate: [0, 4, -4, 0], y: [0, -2, 0], duration: 4s, repeat: Infinity */
      .wobble-logo {
        animation: logo-wobble 4s ease-in-out infinite;
        transform-origin: center;
        flex-shrink: 0;
      }
      @keyframes logo-wobble {
        0%, 100% { transform: rotate(0deg) translateY(0); }
        25%       { transform: rotate(4deg) translateY(-2px); }
        50%       { transform: rotate(0deg) translateY(0); }
        75%       { transform: rotate(-4deg) translateY(-1px); }
      }
      /* Logo group hover/tap */
      .header-left:hover .wobble-logo { transform: rotate(0deg) scale(1.03); animation-play-state: paused; }

      /* Header spring entrance — spec: initial: { y: -100, opacity: 0 }, transition: spring stiffness:100 */
      /* Header */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(255, 255, 255, 0.80);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        animation: header-enter 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        transition: box-shadow 200ms ease;
      }
      .site-header.scrolled {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      }
      @keyframes header-enter {
        from { transform: translateY(-100%); opacity: 0; }
        to   { transform: translateY(0);     opacity: 1; }
      }
      .header-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 68px;
      }
      .header-left {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
      }
      .header-title {
        font-family: var(--font-shadows-into-light);
        font-size: 1.15rem;
        color: #1A1A1A;
        line-height: 1.2;
        font-weight: 400;
      }
      .header-subtitle {
        font-family: var(--font-patrick-hand);
        font-size: 0.82rem;
        color: #6B7280;
        line-height: 1;
      }
      .header-right {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      /* Nav link underline animation */
      .nav-link {
        position: relative;
        color: #1A1A1A;
        font-family: var(--font-patrick-hand);
        font-size: 0.95rem;
        text-decoration: none;
        padding: 0.25rem 0.375rem;
        transition: color 200ms ease;
      }
      .nav-link::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 2px;
        background: #00AB39;
        transition: width 200ms ease;
        border-radius: 1px;
      }
      .nav-link:hover { color: #00AB39; }
      .nav-link:hover::after { width: 100%; }
      .nav-link.active { color: #00AB39; }
      .nav-link.active::after { width: 100%; }

      /* Mobile hamburger */
      .hamburger-btn {
        display: none;
        padding: 0.5rem;
        background: none;
        border: none;
        cursor: pointer;
        width: 40px;
        height: 40px;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 5px;
      }
      .ham-bar {
        display: block;
        width: 22px;
        height: 2px;
        background: #1A1A1A;
        border-radius: 2px;
        transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1),
                    opacity 200ms ease,
                    width 200ms ease;
        transform-origin: center;
      }
      /* When nav is open, morph to X */
      .hamburger-btn.active .ham-bar-1 {
        transform: translateY(7px) rotate(45deg);
      }
      .hamburger-btn.active .ham-bar-2 {
        opacity: 0;
        transform: scaleX(0);
      }
      .hamburger-btn.active .ham-bar-3 {
        transform: translateY(-7px) rotate(-45deg);
      }

      /* Mobile nav dropdown */
      .mobile-nav {
        display: block;
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        transform: translateY(-8px);
        transition: max-height 350ms cubic-bezier(0.4, 0, 0.2, 1),
                    opacity 250ms ease,
                    transform 250ms ease;
        padding: 0 1rem;
        border-top: 1px solid rgba(0, 0, 0, 0.06);
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(12px);
      }
      .mobile-nav.open {
        max-height: 400px;
        opacity: 1;
        transform: translateY(0);
        padding: 0.75rem 1rem 1rem;
      }
      .mobile-nav-link {
        display: block;
        padding: 0.6rem 1rem;
        font-family: var(--font-patrick-hand);
        font-size: 1.05rem;
        color: #1A1A1A;
        text-decoration: none;
        border-radius: 8px;
        opacity: 0;
        transform: translateX(-12px);
        transition: opacity 200ms ease, transform 200ms ease, background 200ms ease;
      }
      .mobile-nav.open .mobile-nav-link {
        opacity: 1;
        transform: translateX(0);
      }
      .mobile-nav.open .mobile-nav-link:nth-child(1) { transition-delay: 50ms; }
      .mobile-nav.open .mobile-nav-link:nth-child(2) { transition-delay: 100ms; }
      .mobile-nav.open .mobile-nav-link:nth-child(3) { transition-delay: 150ms; }
      .mobile-nav.open .mobile-nav-link:nth-child(4) { transition-delay: 200ms; }
      .mobile-nav.open .mobile-nav-link:nth-child(5) { transition-delay: 250ms; }
      .mobile-nav-link:hover {
        background: rgba(0, 171, 57, 0.08);
        text-decoration: none;
      }
      .mobile-nav-bottom {
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px solid rgba(0, 0, 0, 0.08);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        opacity: 0;
        transform: translateX(-12px);
        transition: opacity 200ms ease 300ms, transform 200ms ease 300ms;
      }
      .mobile-nav.open .mobile-nav-bottom {
        opacity: 1;
        transform: translateX(0);
      }
      .mobile-acceso-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.6rem;
        background: #00AB39;
        color: #FFFFFF;
        border-radius: 20px;
        font-family: var(--font-patrick-hand);
        font-size: 0.95rem;
        text-decoration: none;
        border: none;
        cursor: pointer;
      }
      .mobile-lang-toggle {
        display: flex;
        border: 2px solid #00AB39;
        border-radius: 20px;
        overflow: hidden;
      }
      .mobile-lang-toggle button {
        padding: 0.35rem 0.65rem;
        font-size: 0.8rem;
        font-family: var(--font-patrick-hand);
        border: none;
        cursor: pointer;
      }
      .mobile-lang-toggle .lang-active {
        background: #00AB39;
        color: #FFFFFF;
        font-weight: 600;
      }
      .mobile-lang-toggle .lang-inactive {
        background: transparent;
        color: #00AB39;
      }

      /* Desktop pills hidden on mobile */
      .desktop-pills {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      /* Background pattern */
      .bg-pattern-layer {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
      }
      .bg-pattern-layer svg {
        width: 100%;
        height: 100%;
      }

      /* Footer styles */
      .footer-main {
        background: #006b24;
        color: #FFFFFF;
        padding: 3rem 0 0;
        font-family: var(--font-patrick-hand);
      }
      .footer-container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      .footer-section-1 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
      }
      .footer-section-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        padding: 2.5rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
      }
      .footer-heading {
        font-family: var(--font-shadows-into-light);
        font-size: 1.2rem;
        color: #FFFFFF;
        margin-bottom: 1rem;
      }
      .footer-text {
        font-family: var(--font-patrick-hand);
        font-size: 0.95rem;
        line-height: 1.6;
        opacity: 0.85;
      }
      .footer-link {
        color: #A5D6A7;
        text-decoration: none;
        font-family: var(--font-patrick-hand);
        font-size: 0.95rem;
        transition: color 200ms ease;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
      }
      .footer-link:hover {
        color: #EAC102;
        text-decoration: none;
      }
      .footer-links-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .footer-links-list li {
        padding: 0.3rem 0;
      }

      /* Footer logo stamp */
      .footer-stamp {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        /* Subtle outer glow ring matching the footer tone */
        box-shadow: 0 0 0 2px rgba(255,255,255,0.15), 0 4px 20px rgba(0,0,0,0.35);
        overflow: hidden;
      }
      .footer-stamp-logo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        /* logo-dark.png is already white-on-dark — no filter needed */
        opacity: 0.95;
        transition: opacity 0.3s ease, transform 0.3s ease;
      }
      .footer-stamp:hover .footer-stamp-logo {
        opacity: 1;
        transform: scale(1.05);
      }

      /* Footer badges */
      .flag-badge {
        display: inline-block;
        width: 28px;
        height: 20px;
        border-radius: 3px;
        border: 1px solid rgba(255, 255, 255, 0.3);
      }
      .registro-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.25rem 0.75rem;
        background: rgba(0, 171, 57, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        font-family: var(--font-patrick-hand);
        font-size: 0.8rem;
        color: #A5D6A7;
        margin-top: 0.75rem;
      }

      /* Footer social icons */
      .social-icons {
        display: flex;
        gap: 0.6rem;
        margin-top: 0.75rem;
      }
      .social-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1.5px solid rgba(255, 255, 255, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #FFFFFF;
        background: transparent;
        transition: all 200ms ease;
        cursor: pointer;
        text-decoration: none;
      }
      .social-icon:hover {
        background: #FFFFFF;
        color: #006b24;
        border-color: #FFFFFF;
        text-decoration: none;
      }
      .social-icon svg {
        width: 16px;
        height: 16px;
      }

      /* Footer certification pills */
      .cert-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.3rem 0.75rem;
        background: rgba(0, 171, 57, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 20px;
        font-family: var(--font-patrick-hand);
        font-size: 0.82rem;
        color: #A5D6A7;
        margin: 0.2rem;
      }
      .compliance-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.2rem 0.6rem;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 20px;
        font-family: var(--font-patrick-hand);
        font-size: 0.78rem;
        color: #A5D6A7;
        margin: 0.2rem;
      }
      .legal-links {
        margin-top: 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
      }
      .legal-link {
        color: rgba(255, 255, 255, 0.6);
        font-family: var(--font-patrick-hand);
        font-size: 0.82rem;
        text-decoration: none;
        transition: color 200ms ease;
      }
      .legal-link:hover {
        color: #EAC102;
        text-decoration: none;
      }

      /* Footer bottom bar */
      .footer-bottom-stripe {
        height: 6px;
        background: linear-gradient(90deg, #00AB39, #66BB6A, #00AB39);
      }
      .footer-bottom {
        background: #004d1f;
        padding: 1.5rem 0 1rem;
      }
      .footer-bottom-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      .footer-bottom-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 2rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 1rem;
      }
      .footer-bottom-heading {
        font-family: var(--font-shadows-into-light);
        font-size: 0.95rem;
        color: #FFFFFF;
        margin-bottom: 0.6rem;
      }
      .footer-bottom-text {
        font-family: var(--font-patrick-hand);
        font-size: 0.82rem;
        color: rgba(255, 255, 255, 0.6);
        line-height: 1.5;
      }
      .footer-bottom-link {
        color: #A5D6A7;
        text-decoration: none;
        font-size: 0.82rem;
        transition: color 200ms ease;
      }
      .footer-bottom-link:hover {
        color: #EAC102;
        text-decoration: none;
      }
      .footer-copyright {
        font-family: var(--font-patrick-hand);
        font-size: 0.82rem;
        color: rgba(255, 255, 255, 0.5);
        text-align: center;
      }
      .footer-accessibility {
        font-family: var(--font-patrick-hand);
        font-size: 0.72rem;
        color: rgba(255, 255, 255, 0.35);
        text-align: center;
        margin-top: 0.75rem;
      }

      /* Contact info with icons */
      .contact-item {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        padding: 0.25rem 0;
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.85);
      }
      .contact-item svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        margin-top: 3px;
        opacity: 0.7;
      }
      .contact-item a {
        color: #A5D6A7;
        text-decoration: none;
      }
      .contact-item a:hover {
        color: #EAC102;
        text-decoration: none;
      }
      .whatsapp-link {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        color: #25D366 !important;
        font-size: 0.85rem;
      }
      .whatsapp-link:hover {
        color: #1ebe57 !important;
      }
      .whatsapp-link svg {
        width: 13px;
        height: 13px;
        margin-top: 0 !important;
        opacity: 1 !important;
        flex-shrink: 0;
      }

      /* Back to top */
      .back-to-top {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        width: 44px;
        height: 44px;
        background: #00AB39;
        color: #FFFFFF;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(0, 171, 57, 0.3);
        opacity: 0;
        pointer-events: none;
        transform: translateY(8px);
        transition: opacity 300ms ease, transform 300ms ease, background-color 200ms ease;
        z-index: 40;
      }
      .back-to-top.visible {
        opacity: 1 !important;
        pointer-events: auto !important;
        transform: translateY(0) !important;
      }
      .back-to-top:hover {
        background: #006b24;
        transform: translateY(-2px);
      }

      /* Responsive */
      @media (max-width: 767px) {
        .desktop-pills {
          display: none !important;
        }
        .hamburger-btn {
          display: flex !important;
        }
        .footer-section-1,
        .footer-section-2 {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
        .footer-bottom-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }
        .header-title {
          font-size: 1rem;
        }
        .header-subtitle {
          font-size: 0.75rem;
        }
      }

      @media (min-width: 768px) {
        .hamburger-btn {
          display: none !important;
        }
        .desktop-pills {
          display: flex !important;
        }
      }

      /* Footer logo wobble — spec: rotate: [0, 5, -5, 0], duration: 4s, repeat: Infinity */
      .footer-stamp {
        animation: logo-wobble 4s ease-in-out infinite;
      }

      /* Footer column scroll reveal */
      .footer-col-reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s ease, transform 0.6s ease;
      }
      .footer-col-reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }
      .footer-col-reveal:nth-child(2) { transition-delay: 0.1s; }
      .footer-col-reveal:nth-child(3) { transition-delay: 0.2s; }
      .footer-col-reveal:nth-child(4) { transition-delay: 0.3s; }
    </style>
  </head>

  <body style="margin: 0; min-height: 100vh; display: flex; flex-direction: column; background: linear-gradient(180deg, #FFFFFF 0%, #f5f5f5 50%, #E8F5E9 100%); color: #1A1A1A; font-family: var(--font-patrick-hand);">

