// SSR — data fetched from D1 at request time via internal API routes
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import MapLibre from '../components/MapLibre.astro';
import Map3DTown from '../components/info/Map3DTown.astro';
import Map3DAlbergue from '../components/info/Map3DAlbergue.astro';
import FacilitiesPopover from '../components/info/FacilitiesPopover.astro';
import Hostel3DBackground from '../components/info/Hostel3DBackground.astro';
import ScrollHijack from '../components/info/ScrollHijack.astro';
import SceneHero from '../components/info/scenes/SceneHero.astro';
import SceneTownMap from '../components/info/scenes/SceneTownMap.astro';
import SceneGallery from '../components/info/scenes/SceneGallery.astro';
import SceneFacilities from '../components/info/scenes/SceneFacilities.astro';
import SceneFloorPlan from '../components/info/scenes/SceneFloorPlan.astro';
import ScenePractical from '../components/info/scenes/ScenePractical.astro';
import SceneFAQ from '../components/info/scenes/SceneFAQ.astro';
import SceneReviews from '../components/info/scenes/SceneReviews.astro';
import SceneCTA from '../components/info/scenes/SceneCTA.astro';
import {
  getD1,
  db,
  hostelConfig,
  hostelServices,
  hostelRules,
  nearbyAttractions,
  reviewScores,
} from '../db/helpers';
import { eq, asc } from 'drizzle-orm';

// ── Defaults (mirror migration seed / fallback when D1 not available) ─────────
const DEFAULT_CONFIG = {
  name: 'Albergue Municipal de El Carrascalejo',
  tagline: 'Acogida en el Camino de Santiago — Vía de la Plata',
  addressStreet: 'Paraje la cuesta, s/n',
  addressPostcode: '06894',
  addressTown: 'El Carrascalejo',
  addressProvince: 'Badajoz',
  addressCountry: 'España',
  phone: '+34 695 90 43 44',
  email: 'elcarrascalejoalbergue@gmail.com',
  latitude: 39.0237972,
  longitude: -6.3373782,
  checkInOpen: '10:00',
  checkInClose: '21:00',
  checkOutOpen: '09:00',
  checkOutClose: '11:00',
  maxNights: 2,
  totalBeds: 24,
  tourismLicense: 'AL-BA-0034',
  languages: ['es', 'en'] as string[],
  accessibility: { wheelchair: true, ground_floor: true, adapted_bathroom: true, grab_rails: true },
  caminoKm: '482',
  caminoRoute: 'Via de la Plata',
};

const DEFAULT_RULES = [
  'Horario de silencio: 22:00 — 07:00',
  'Zona de fumadores habilitada en el exterior',
  'No se permiten fiestas ni eventos',
  'No se admiten ninos (albergue para adultos peregrinos)',
  'Mascotas permitidas — consultar sin cargo adicional',
  'Documento de identidad obligatorio al llegar',
  'Respeta a los demas peregrinos',
  'Cancelacion gratuita 24h antes',
  'Pago en efectivo en el albergue',
  'Llegadas tardias: avisar previamente al hospitalero',
];

const DEFAULT_ATTRACTIONS = [
  {
    name: 'Acueducto Romano de Los Milagros',
    distanceKm: 13,
    icon: '🏛️',
    description:
      'Impresionante acueducto romano del siglo I d.C., Patrimonio de la Humanidad UNESCO.',
  },
  {
    name: 'Basilica de Santa Eulalia',
    distanceKm: 14,
    icon: '⛪',
    description: 'Imponente basilica gotica del siglo XIV dedicada a la martir patrona de Merida.',
  },
  {
    name: 'Teatro Romano y Anfiteatro',
    distanceKm: 15,
    icon: '🎭',
    description: 'Teatro del siglo I a.C. perfectamente conservado y anfiteatro de gladiadores.',
  },
  {
    name: 'Aeropuerto de Badajoz',
    distanceKm: 57,
    icon: '✈️',
    description: 'Aeropuerto internacional con conexiones a Madrid, Barcelona y Canarias.',
  },
];

const DEFAULT_REVIEW_SCORES = {
  source: 'booking',
  overall: 9.1,
  staff: 9.6,
  cleanliness: 9.4,
  comfort: 9.3,
  valueForMoney: 9.6,
  facilities: 9.0,
  location: 9.0,
  totalCount: 71,
  label: 'Sobresaliente',
};

// ── Load from D1 ──────────────────────────────────────────────────────────────
let hostelData = DEFAULT_CONFIG;
let rules: string[] = DEFAULT_RULES;
let attractions = DEFAULT_ATTRACTIONS;
let reviewData = DEFAULT_REVIEW_SCORES;
let servicePriceCents: Record<string, number> = {};

try {
  const d1 = await getD1();
  if (d1) {
    const drizzle = db(d1);

    // Config row
    const [cfgRow] = await drizzle
      .select()
      .from(hostelConfig)
      .where(eq(hostelConfig.id, 1))
      .limit(1);
    const extRow = await d1
      .prepare(
        'SELECT check_in_open, check_in_close, check_out_open, check_out_close, max_nights, total_beds, languages, accessibility, camino_km, camino_route FROM hostel_config WHERE id = 1'
      )
      .first<{
        check_in_open: string;
        check_in_close: string;
        check_out_open: string;
        check_out_close: string;
        max_nights: number;
        total_beds: number;
        languages: string;
        accessibility: string;
        camino_km: string;
        camino_route: string;
      }>();

    if (cfgRow) {
      hostelData = {
        name: cfgRow.name,
        tagline: cfgRow.tagline ?? DEFAULT_CONFIG.tagline,
        addressStreet: cfgRow.addressStreet ?? DEFAULT_CONFIG.addressStreet,
        addressPostcode: cfgRow.addressPostcode ?? DEFAULT_CONFIG.addressPostcode,
        addressTown: cfgRow.addressTown ?? DEFAULT_CONFIG.addressTown,
        addressProvince: cfgRow.addressProvince ?? DEFAULT_CONFIG.addressProvince,
        addressCountry: cfgRow.addressCountry ?? DEFAULT_CONFIG.addressCountry,
        phone: cfgRow.phone ?? DEFAULT_CONFIG.phone,
        email: cfgRow.email ?? DEFAULT_CONFIG.email,
        latitude: cfgRow.latitude ?? DEFAULT_CONFIG.latitude,
        longitude: cfgRow.longitude ?? DEFAULT_CONFIG.longitude,
        checkInOpen: extRow?.check_in_open ?? DEFAULT_CONFIG.checkInOpen,
        checkInClose: extRow?.check_in_close ?? DEFAULT_CONFIG.checkInClose,
        checkOutOpen: extRow?.check_out_open ?? DEFAULT_CONFIG.checkOutOpen,
        checkOutClose: extRow?.check_out_close ?? DEFAULT_CONFIG.checkOutClose,
        maxNights: extRow?.max_nights ?? DEFAULT_CONFIG.maxNights,
        totalBeds: extRow?.total_beds ?? DEFAULT_CONFIG.totalBeds,
        tourismLicense: cfgRow.tourismLicense ?? DEFAULT_CONFIG.tourismLicense,
        languages: extRow?.languages ? JSON.parse(extRow.languages) : DEFAULT_CONFIG.languages,
        accessibility: extRow?.accessibility
          ? JSON.parse(extRow.accessibility)
          : DEFAULT_CONFIG.accessibility,
        caminoKm: extRow?.camino_km ?? DEFAULT_CONFIG.caminoKm,
        caminoRoute: extRow?.camino_route ?? DEFAULT_CONFIG.caminoRoute,
      };
    }

    // House rules
    const rulesRows = await drizzle
      .select()
      .from(hostelRules)
      .where(eq(hostelRules.active, 1))
      .orderBy(asc(hostelRules.sortOrder));
    if (rulesRows.length > 0) rules = rulesRows.map((r) => r.rule);

    // Nearby attractions
    const attrRows = await drizzle
      .select()
      .from(nearbyAttractions)
      .where(eq(nearbyAttractions.active, 1))
      .orderBy(asc(nearbyAttractions.sortOrder));
    if (attrRows.length > 0) attractions = attrRows.map((r) => ({ ...r, description: r.description ?? '' }));

    // Review scores
    const [scoreRow] = await drizzle
      .select()
      .from(reviewScores)
      .where(eq(reviewScores.source, 'all'))
      .limit(1);
    if (scoreRow?.overall) {
      reviewData = {
        source: scoreRow.source,
        overall: scoreRow.overall ?? DEFAULT_REVIEW_SCORES.overall,
        staff: scoreRow.staff ?? DEFAULT_REVIEW_SCORES.staff,
        cleanliness: scoreRow.cleanliness ?? DEFAULT_REVIEW_SCORES.cleanliness,
        comfort: scoreRow.comfort ?? DEFAULT_REVIEW_SCORES.comfort,
        valueForMoney: scoreRow.valueForMoney ?? DEFAULT_REVIEW_SCORES.valueForMoney,
        facilities: scoreRow.facilities ?? DEFAULT_REVIEW_SCORES.facilities,
        location: scoreRow.location ?? DEFAULT_REVIEW_SCORES.location,
        totalCount: scoreRow.totalCount,
        label: scoreRow.label ?? DEFAULT_REVIEW_SCORES.label,
      };
    }

    // Service prices (for display in facilities cards)
    const svcRows = await drizzle
      .select()
      .from(hostelServices)
      .where(eq(hostelServices.available, 1));
    for (const s of svcRows) servicePriceCents[s.name] = s.priceCents;
  }
} catch (e) {
  console.warn('[info.astro] D1 load failed, using defaults:', e);
}

// ── Derived display values ─────────────────────────────────────────────────────
const INFO_LAT = hostelData.latitude;
const INFO_LNG = hostelData.longitude;
const addressDisplay = `${hostelData.addressStreet} · ${hostelData.addressTown}, ${hostelData.addressPostcode}`;
const addressMapMarker = `${hostelData.addressStreet} · ${hostelData.addressPostcode} ${hostelData.addressTown}`;

// ── Static page data (presentation-only, not in DB) ───────────────────────────

// Booking.com real photos (hotel ID 12983893)
const PHOTOS = [
  {
    id: '606951419',
    hash: '1d218a9c07fd4868d8dfd33d8e4ad425dbcd86d5a4c6a5d014f323d988e21638',
    alt: 'Vista exterior del Albergue',
  },
  {
    id: '611459101',
    hash: '0c34fc9a8944869c2fc447af28a1bacb60abdb38c1712c2cde2774a9ef0eb3e6',
    alt: 'Taquillas individuales',
  },
  {
    id: '611459099',
    hash: '0aee37511510817d18a45e21508eb4c6678d8d443c0ede1f75a973953bdeedbb',
    alt: 'Dormitorio con literas',
  },
  {
    id: '611459100',
    hash: 'd365f2a54b22abfd0d76899a76e0a6cf9b3e16dc1873389bd32cad04a9e67481',
    alt: 'Salon y cocina equipada',
  },
  {
    id: '611461035',
    hash: '12cbd3f361015698323a4490aceed3c39228f62e6f4ff1cf9ceb902947310c01',
    alt: 'Sala de estar',
  },
  {
    id: '611462188',
    hash: '8faae85df4f7bef1dbf301a1c2b38115419ad1d588860eaf39ed243380b3ff57',
    alt: 'Zona exterior y patio',
  },
  {
    id: '606951412',
    hash: 'b0bf171cd75cd368cfc5dd88c41dc0bbb077db47ec0a518e6f4b2ed5855dd5a0',
    alt: 'Zona comun',
  },
  {
    id: '611452555',
    hash: 'da95432f70b5e8233f1e246111300c0d8e15356385c84a24834f40abaf8cd50b',
    alt: 'Banos con ducha',
  },
  {
    id: '650733575',
    hash: 'ccb98b1497e57555b350854d076097159adfaa64a8f475449ca0a6a1af9918fd',
    alt: 'Cafeteria del Albergue',
  },
  {
    id: '618323334',
    hash: 'a311ea255ba92d313cf11962fb550fef02c0a2aefce4569deff4d80c212dd537',
    alt: 'Zona de comedor',
  },
  {
    id: '611452569',
    hash: '8c90f1241d38641a250d5f969412df968cde73656393d9050d279e6d322fff2f',
    alt: 'Aseos y duchas',
  },
];

const facilities = [
  {
    icon: 'bed',
    label: 'Dormitorios',
    desc: '2 salas con 12 literas cada una. Sabanas y mantas incluidas.',
    photos: [2, 1, 0],
    details:
      '2 dormitorios mixtos con capacidad para 12 personas cada uno. Literas con colchon comodo, sabanas limpias y manta incluidas. Taquillas individuales en cada cama.',
  },
  {
    icon: 'shower',
    label: 'Duchas Calientes',
    desc: 'Agua caliente 24h. Aseos accesibles para todos.',
    photos: [7, 10, 6],
    details: 'Aseos y duchas con agua caliente las 24 horas. Completamente accesibles.',
  },
  {
    icon: 'kitchen',
    label: 'Cocina Equipada',
    desc: 'Microondas, nevera, fogones y utensilios basicos.',
    photos: [3, 4],
    details: 'Cocina completamente equipada para uso de los huespedes.',
  },
  {
    icon: 'wifi',
    label: 'WiFi Gratuito',
    desc: 'Conexion de alta velocidad en todas las zonas.',
    photos: [0, 5],
    details: 'Conexion WiFi gratuita en todo el albergue. Contrasena en recepcion.',
  },
  {
    icon: 'lock',
    label: 'Taquillas',
    desc: 'Casilleros individuales con candado en cada cama.',
    photos: [1, 2],
    details: 'Casilleros de metal por cama. Candado propio recomendado.',
  },
  {
    icon: 'laundry',
    label: 'Lavanderia',
    desc: 'Lavadora y tendedero disponibles todo el dia.',
    photos: [6, 3],
    details: `Lavadora y secadora a ${(servicePriceCents['Lavadora'] ?? 250) / 100}€/lavado.`,
  },
  {
    icon: 'garden',
    label: 'Jardin y Patio',
    desc: 'Espacio exterior para descansar y tender ropa.',
    photos: [5, 4, 0],
    details: 'Zona exterior con jardin y mesas de picnic.',
  },
  {
    icon: 'bike',
    label: 'Parking Bicicletas',
    desc: 'Aparcamiento cubierto y seguro para bicicletas.',
    photos: [0, 5],
    details: 'Parking cubierto con herramientas basicas para reparaciones.',
  },
  {
    icon: 'cafe',
    label: 'Cafeteria',
    desc: 'Desayunos, bocadillos y menu del peregrino disponibles.',
    photos: [8, 9],
    details: `Desayuno continental desde ${(servicePriceCents['Desayuno'] ?? 350) / 100}€. Cena peregrino desde ${(servicePriceCents['Cena peregrino'] ?? 1000) / 100}€.`,
  },
];

const accordion = [
  {
    q: 'Que es la Via de la Plata?',
    a: 'La Via de la Plata es la ruta jacobea mas larga de Espana, con 1.000 km desde Sevilla hasta Santiago de Compostela. Discurre por Extremadura, Castilla y Leon y Galicia, siguiendo la antigua calzada romana.',
  },
  {
    q: 'Como llegar a El Carrascalejo?',
    a: 'A pie: etapa desde Alquesos (12 km) o hasta Alcuescar (21 km). En coche: N-630 desde Merida hacia Caceres, desvio a El Carrascalejo (25 min). En autobus: linea Merida-Caceres con parada en el pueblo.',
  },
  {
    q: 'Que llevar en la mochila?',
    a: 'Saco de dormir ligero, documentacion (DNI/Pasaporte), credencial de peregrino, ropa de recambio, zapatillas de estar por casa, candado para taquilla, botiquin basico (ampollas, tiritas), esterilla de yoga opcional.',
  },
];

const INFO_SECTIONS = [
  { title: 'El Albergue' },
  { title: 'El Pueblo' },
  { title: 'Galería' },
  { title: 'Instalaciones' },
  { title: 'Plano' },
  { title: 'Práctico' },
  { title: 'FAQ' },
  { title: 'Reseñas' },
  { title: 'Reserva' },
];

const photoUrls = PHOTOS.map((p) => ({
  ...p,
  url: `https://cf.bstatic.com/xdata/images/hotel/max1024x768/${p.id}/${p.hash}.jpg?k=${p.hash}&o=`,
}));

const heroStats = [
  { label: 'camas', value: String(hostelData.totalBeds ?? DEFAULT_CONFIG.totalBeds) },
  { label: 'Booking ★', value: String(reviewData.overall ?? DEFAULT_REVIEW_SCORES.overall) },
  { label: 'máx noches', value: String(hostelData.maxNights ?? DEFAULT_CONFIG.maxNights) },
  { label: 'desde', value: '15€' },
];

const scenePayload = {
  hostelData,
  rules,
  attractions,
  reviewData,
  servicePriceCents,
  photos: photoUrls,
  faq: accordion,
  facilities,
};

const sceneJson = JSON.stringify(scenePayload, (_k, v) => (typeof v === 'bigint' ? v.toString() : v)).replace(
  /</g,
  '\\u003c'
);
---

<Layout
  title="Información — Albergue Municipal de El Carrascalejo"
  description="Experiencia 3D por secciones: ubicación, galería, instalaciones, plano, FAQ, reseñas y reserva."
  showHeader={false}
  showFooter={false}
>
  <ScrollHijack sections={INFO_SECTIONS} initial={1}>
    <div class="ip-section" data-section="1">
      <SceneHero title="El Albergue" subtitle={hostelData.tagline} stats={heroStats} />
    </div>
    <div class="ip-section" data-section="2">
      <SceneTownMap />
    </div>
    <div class="ip-section" data-section="3">
      <SceneGallery />
    </div>
    <div class="ip-section" data-section="4">
      <SceneFacilities />
    </div>
    <div class="ip-section" data-section="5">
      <SceneFloorPlan />
    </div>
    <div class="ip-section" data-section="6">
      <ScenePractical />
    </div>
    <div class="ip-section" data-section="7">
      <SceneFAQ />
    </div>
    <div class="ip-section" data-section="8">
      <SceneReviews />
    </div>
    <div class="ip-section" data-section="9">
      <SceneCTA />
    </div>
  </ScrollHijack>

  <script type="application/json" id="info-scene-data" set:html={sceneJson}></script>
</Layout>

{false && (
<Layout title="Informacion — Albergue Municipal de El Carrascalejo">

  <!-- ══════════════════════════════════════════════════════════
       HOSTEL 3D BACKGROUND — fixed parallax canvas (z=0)
       Scroll drives camera through 8 cinematic keyframes.
       ══════════════════════════════════════════════════════════ -->
  <Hostel3DBackground />

  <!-- Shared SVG filter (sketchy style) -->
  <svg style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true">
    <defs>
      <filter id="sketchy-filter">
        <feTurbulence type="turbulence" baseFrequency="0.03" numOctaves="4" result="noise"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="2"></feDisplacementMap>
      </filter>
    </defs>
  </svg>

  <!-- ══════════════════════════════════════════════════════════
       HERO — glass overlay on top of 3D background
       ══════════════════════════════════════════════════════════ -->
  <section class="ip-hero ps-section" data-ps="hero">
    <div class="ip-hero-content ps-reveal">
      <div class="ip-hero-badge">🐚 Vía de la Plata · Km 482</div>
      <h1 class="ip-hero-title">El Albergue</h1>
      <p class="ip-hero-sub">Todo lo que necesitas para tu estancia en el Camino</p>
      <div class="ip-hero-stats">
        <div class="ip-hero-stat"><span>24</span><small>camas</small></div>
        <div class="ip-hero-stat"><span>9.1</span><small>Booking ★</small></div>
        <div class="ip-hero-stat"><span>+20</span><small>años</small></div>
        <div class="ip-hero-stat"><span>15€</span><small>/ noche</small></div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       SECTION 1: 3D TOWN MAP — El Carrascalejo on Vía de la Plata
       ══════════════════════════════════════════════════════════ -->
  <section class="ip-section ip-section--dark ps-section" data-ps="town">
    <div class="ip-section-inner ip-split">
      <div class="ip-split-text ps-reveal">
        <div class="ip-label">📍 Ubicación</div>
        <h2 class="ip-heading">El Carrascalejo<br>en la Vía de la Plata</h2>
        <p class="ip-body">
          A 482 km de Sevilla y a 298 km de Santiago de Compostela.
          El Carrascalejo es una parada estratégica entre Mérida y Alcuéscar,
          en el corazón de Extremadura.
        </p>
        <div class="ip-info-pills">
          <span class="ip-pill">⛰️ 482 km desde Sevilla</span>
          <span class="ip-pill">🏁 298 km hasta Santiago</span>
          <span class="ip-pill">🏛️ Mérida a 25 min</span>
          <span class="ip-pill">🌡️ Extremadura</span>
        </div>
        <div class="ip-map-cta">
          <MapLibre
            latitude={INFO_LAT}
            longitude={INFO_LNG}
            zoom={13}
            height="180px"
            markerTitle="Albergue Municipal El Carrascalejo"
            markerSubtitle={addressMapMarker}
            class="ip-mini-map"
          />
          <a
            href={`https://www.openstreetmap.org/?mlat=${INFO_LAT}&mlon=${INFO_LNG}&zoom=15`}
            target="_blank"
            rel="noopener noreferrer"
            class="ip-osm-link"
          >Ver en OpenStreetMap ↗</a>
        </div>
      </div>
      <div class="ip-split-3d ip-3d-tall ps-reveal" style="--ps-delay:0.1s">
        <Map3DTown />
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       SECTION 2: PHOTO GALLERY
       ══════════════════════════════════════════════════════════ -->
  <section class="ip-section ps-section" data-ps="gallery">
    <div class="ip-section-inner">
      <div class="ip-label ps-reveal">📸 Fotos reales · Booking.com</div>
      <div class="ip-gallery-track-outer" id="gallery-outer">
        <div class="ip-gallery-track" id="gallery-track">
          {PHOTOS.map((p, i) => (
            <figure class="ip-gallery-slide" data-index={i}>
              <img
                src={`https://cf.bstatic.com/xdata/images/hotel/max1280x900/${p.id}.jpg?k=${p.hash}&o=`}
                alt={p.alt}
                class="ip-gallery-img"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
              <figcaption class="ip-gallery-cap">{p.alt}</figcaption>
            </figure>
          ))}
        </div>
        <button class="ip-gallery-btn ip-gallery-prev" id="gallery-prev" aria-label="Anterior">&#8249;</button>
        <button class="ip-gallery-btn ip-gallery-next" id="gallery-next" aria-label="Siguiente">&#8250;</button>
        <div class="ip-gallery-dots" id="gallery-dots" role="tablist">
          {PHOTOS.map((_, i) => (
            <button
              class={`ip-gallery-dot${i === 0 ? ' active' : ''}`}
              data-idx={i}
              role="tab"
              aria-label={`Foto ${i + 1}`}
              aria-selected={i === 0 ? 'true' : 'false'}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       SECTION 3: FACILITIES — Popover + quick chips
       ══════════════════════════════════════════════════════════ -->
  <section class="ip-section ip-section--tinted ps-section" data-ps="facilities">
    <div class="ip-section-inner">
      <div class="ip-two-col">
        <div class="ps-reveal">
          <div class="ip-label">🏠 Instalaciones</div>
          <h2 class="ip-heading">Servicios incluidos</h2>
          <!-- Quick chips: top 9 facilities -->
          <div class="ip-chips">
            {[
              { emoji: '📶', text: 'WiFi gratis' },
              { emoji: '🛏️', text: '24 literas' },
              { emoji: '🚿', text: 'Duchas 24h' },
              { emoji: '🍳', text: 'Cocina' },
              { emoji: '🔒', text: 'Taquillas' },
              { emoji: '🌿', text: 'Jardín' },
              { emoji: '🚲', text: 'Bici parking' },
              { emoji: '☕', text: 'Cafetería' },
              { emoji: '♿', text: 'Accesible' },
            ].map(c => (
              <span class="ip-chip">{c.emoji} {c.text}</span>
            ))}
          </div>
