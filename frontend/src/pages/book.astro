    // ── HOME-NAVIGATION CONFIRMATION MODAL ──
    (function initHomeModal() {
      const overlay = document.getElementById('home-modal-overlay')!;
      const stayBtn = document.getElementById('hm-stay')!;
      const leaveBtn = document.getElementById('hm-leave')!;
      const logoBtn = document.getElementById('sidebar-home-btn')!;

      function openModal() {
        overlay.classList.add('open');
        stayBtn.focus();
      }
      function closeModal() {
        overlay.classList.remove('open');
        logoBtn.focus();
      }

      logoBtn.addEventListener('click', openModal);
      stayBtn.addEventListener('click', closeModal);
      leaveBtn.addEventListener('click', () => {
        window.location.href = '/';
      });
      // Dismiss on backdrop click
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeModal();
      });
      // Dismiss on Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
      });
    })();

    // ── STATE ──
    const state = {
      step: 1,
      checkin: null as string | null,
      checkout: null as string | null,
      nights: 0,
      persons: 1 as number, // how many pilgrims in this booking
      docType: null as string | null,
      bed: null as string | null,
      pricePerNight: 15 as number, // updated from API once dates are selected
      totalPrice: 0 as number,
    };

    // Booking rules — fetched from /api/info/hostel; fall back to schema defaults.
    let MAX_NIGHTS = 30;
    let MAX_ADVANCE_DAYS = 365;
    let MAX_PERSONS = 10;
    (async () => {
      try {
        const cfg = await fetch('/api/info/hostel').then((r) =>
          r.ok ? (r.json() as Promise<Record<string, unknown>>) : null
        );
        if (cfg) {
          if (typeof cfg['max_nights_per_booking'] === 'number')
            MAX_NIGHTS = cfg['max_nights_per_booking'];
          if (typeof cfg['max_booking_days_in_advance'] === 'number')
            MAX_ADVANCE_DAYS = cfg['max_booking_days_in_advance'];
          if (typeof cfg['max_people_per_booking'] === 'number')
            MAX_PERSONS = cfg['max_people_per_booking'];
        }
      } catch {
        /* keep defaults */
      }
      updatePersonPicker(); // refresh constraints after config loads
    })();

    let calYear = new Date().getFullYear();
    let calMonth = new Date().getMonth();

    // ── PERSON PICKER ──
    function updatePersonPicker() {
      const input = document.getElementById('persons-input') as HTMLInputElement;
      const minus = document.getElementById('persons-minus') as HTMLButtonElement;
      const plus = document.getElementById('persons-plus') as HTMLButtonElement;
      const hint = document.getElementById('persons-hint')!;
      if (!input) return;
      input.max = String(MAX_PERSONS);
      const v = state.persons;
      input.value = String(v);
      minus.disabled = v <= 1;
      plus.disabled = v >= MAX_PERSONS;
      hint.textContent = v === 1 ? '1 pilgrim' : `${v} pilgrims`;
      // Re-calculate price when persons changes
      updateDateSummary();
      if (state.checkin && state.checkout) fetchPriceForSelection();
    }

    document.getElementById('persons-minus')!.addEventListener('click', () => {
      if (state.persons > 1) {
        state.persons--;
        updatePersonPicker();
      }
    });
    document.getElementById('persons-plus')!.addEventListener('click', () => {
      if (state.persons < MAX_PERSONS) {
        state.persons++;
        updatePersonPicker();
      }
    });
    document.getElementById('persons-input')!.addEventListener('input', function () {
      const el = this as HTMLInputElement;
      let v = parseInt(el.value) || 1;
      v = Math.max(1, Math.min(MAX_PERSONS, v));
      state.persons = v;
      updatePersonPicker();
    });
    document.getElementById('persons-input')!.addEventListener('blur', function () {
      // Clamp on blur in case user typed something out of range
      const el = this as HTMLInputElement;
      let v = parseInt(el.value) || 1;
      v = Math.max(1, Math.min(MAX_PERSONS, v));
      state.persons = v;
      updatePersonPicker();
    });

    // ── STEP CONFIG ──
    const STEPS = [
      { pct: 14, label: 'Continue to ID Upload →', back: null },
      { pct: 29, label: 'Continue to Your Info →', back: '← Back to Dates' },
      { pct: 43, label: 'Continue to Bed Selection →', back: '← Back to ID Upload' },
      { pct: 57, label: 'Continue to Payment →', back: '← Back to Your Info' },
      { pct: 72, label: 'Continue to Summary →', back: '← Back to Bed Selection' },
      { pct: 86, label: 'Confirm Booking', back: '← Back to Payment' },
      { pct: 100, label: '', back: null },
    ];

    // ── ELEMENTS ──
    const progFill = document.getElementById('prog-fill')!;
    const progText = document.getElementById('prog-text')!;
    const progPct = document.getElementById('prog-pct')!;
    const mobileStepLabel = document.getElementById('mobile-step-label')!;
    const btnBack = document.getElementById('btn-back') as HTMLButtonElement;
    const btnNext = document.getElementById('btn-next') as HTMLButtonElement;
    const wizNav = document.getElementById('wiz-nav')!;

    // ── RENDER STEP ──
    function goToStep(next: number, dir: 'forward' | 'back' = 'forward') {
      const currentPanel = document.getElementById(`step-${state.step}`)!;
      const nextPanel = document.getElementById(`step-${next}`)!;

      currentPanel.style.animation =
        dir === 'forward' ? 'step-exit 280ms ease forwards' : 'step-exit-back 280ms ease forwards';

      setTimeout(() => {
        currentPanel.classList.add('hidden');
        currentPanel.style.animation = '';
        state.step = next;
        nextPanel.classList.remove('hidden');
        nextPanel.style.animation =
          dir === 'forward'
            ? 'step-enter 380ms cubic-bezier(0.34,1.56,0.64,1) forwards'
            : 'step-enter-back 380ms cubic-bezier(0.34,1.56,0.64,1) forwards';
        // Per-person step wiring
        if (next === 2 && dir === 'forward') initPersonSteps();
        if (next === 2) renderStep2Nav();
        if (next === 3 && dir === 'forward') {
          saveStep2State();
          // Upload cropped avatar for pilgrim 0 (the authenticated account holder) to Clerk.
          // This is fire-and-forget — the booking flow must not block on it.
          const p0Avatar = personDocStates[0]?.avatarDataUrl ?? uploadedFiles.avatarDataUrl;
          if (p0Avatar) uploadAvatarToClerk(p0Avatar);
        }
        if (next === 3) renderStep3Nav();
        if (next === 4 && dir === 'forward') saveStep3State();
        // Re-init bed selection when entering step 4 (needs current nights count)
        if (next === 4) initBedSelection();
        updateUI();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }, 260);
    }

    function updateUI() {
      const cfg = STEPS[state.step - 1];
      // Progress
      progFill.style.width = cfg.pct + '%';
      progText.textContent = `Step ${state.step} of 7`;
      progPct.textContent = `${cfg.pct}% Complete`;
      mobileStepLabel.textContent = `Step ${state.step} of 7`;

      // Nav buttons
      if (state.step === 7) {
        wizNav.style.display = 'none';
        return;
      } else {
        wizNav.style.display = '';
      }
      if (cfg.back) {
        btnBack.style.display = '';
        (btnBack.querySelector('.nav-btn-label') as HTMLElement).textContent = cfg.back;
      } else {
        btnBack.style.display = 'none';
      }
      (btnNext.querySelector('.nav-btn-label') as HTMLElement).textContent = cfg.label;

      // Sidebar
      document.querySelectorAll('.step-btn').forEach((btn, i) => {
        const s = i + 1;
        const circle = btn.querySelector('.step-circle')!;
        const num = btn.querySelector('.step-num')!;
        const lbl = btn.querySelector('.step-label')!;
        const dot = btn.querySelector('.step-dot');
        if (s < state.step) {
          circle.classList.remove('active');
          circle.classList.add('done');
          lbl.textContent = '✓ ' + lbl.textContent?.replace('✓ ', '');
          lbl.classList.add('active');
          num.classList.remove('inactive');
          if (dot) dot.classList.remove('active');
        } else if (s === state.step) {
          circle.classList.add('active');
          circle.classList.remove('done');
          lbl.classList.add('active');
          num.classList.remove('inactive');
          if (dot) {
            dot.classList.add('active');
            (dot as HTMLElement).style.display = '';
          }
        } else {
          circle.classList.remove('active');
          circle.classList.remove('done');
          lbl.classList.remove('active');
          num.classList.add('inactive');
          if (dot) dot.classList.remove('active');
        }
      });

      // Per-step enable/disable
      enableNext(canProceed());
    }

    function canProceed(): boolean {
      switch (state.step) {
        case 1:
          return !!(state.checkin && state.checkout);
        case 2: {
          return personDocStates.every((s, i) => {
            const docType = i === activePersonStep2 ? state.docType : s.docType;
            const front = i === activePersonStep2 ? uploadedFiles.frontFile : s.frontFile;
            const back = i === activePersonStep2 ? uploadedFiles.backFile : s.backFile;
            const fValid = i === activePersonStep2 ? uploadedFiles.frontValid : s.frontValid;
            const bValid = i === activePersonStep2 ? uploadedFiles.backValid : s.backValid;
            const needBack = docType === 'dni';
            return (
              docType !== null &&
              front !== null &&
              (!needBack || back !== null) &&
              fValid !== false && // false = invalid (null = still validating = ok to proceed)
              (!needBack || bValid !== false)
            );
          });
        }
        case 3:
          return true; // validated on click
        case 4:
          return !!state.bed;
        case 5:
          return true;
        case 6:
          return true;
        default:
          return false;
      }
    }

    function enableNext(yes: boolean) {
      btnNext.disabled = !yes;
    }

    // ── CALENDAR ──
    // Per-month availability cache populated from /api/availability.
    // null = data not yet loaded for this date (shows loading state in calendar).
    const dayInfoCache: Record<string, { beds: number; price: number }> = {};
    let calFetchController: AbortController | null = null;

    // Returns cached data or null while the fetch is in-flight.
    // No local formula — all data comes from /api/availability.
    function getDayInfo(dateStr: string): { beds: number; price: number } | null {
      return dayInfoCache[dateStr] ?? null;
    }

    // Fetch a full month from the API and repaint the calendar when done
    async function fetchMonthAvailability(year: number, month: number) {
      const mm = String(month + 1).padStart(2, '0');
      const lastDay = new Date(year, month + 1, 0).getDate();
      const from = `${year}-${mm}-01`;
      const to = `${year}-${mm}-${String(lastDay).padStart(2, '0')}`;
      calFetchController?.abort();
      calFetchController = new AbortController();
      try {
        const res = await fetch(`/api/availability?from=${from}&to=${to}`, {
          signal: calFetchController.signal,
        });
        if (res.ok) {
          const data = (await res.json()) as {
            days: Record<string, { beds: number; price: number }>;
          };
          Object.assign(dayInfoCache, data.days);
          renderCalendar(); // repaint with real data
        }
      } catch (e) {
        if ((e as Error).name !== 'AbortError') console.warn('[availability] fetch failed', e);
      }
    }

    // After dates are selected, fetch real per-night price from the action
    async function fetchPriceForSelection() {
      if (!state.checkin || !state.checkout) return;
      try {
        const result = await callAction<{ pricePerNight: number; totalPrice: number }>(
          'booking.checkAvailability',
          {
            checkIn: state.checkin,
            checkOut: state.checkout,
            persons: state.persons,
          }
        );
        if (result.data) {
          state.pricePerNight = result.data.pricePerNight ?? state.pricePerNight;
          state.totalPrice = result.data.totalPrice ?? state.nights * state.pricePerNight;
          // Update the price summary chips with real values
          updateDateSummary();
        }
      } catch {
        // keep default price — no UI disruption
      }
    }

    function renderCalendar() {
      const grid = document.getElementById('cal-grid')!;
      const titleEl = document.getElementById('cal-month-title')!;
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      titleEl.textContent = new Date(calYear, calMonth, 1).toLocaleDateString('en-US', {
        month: 'long',
        year: 'numeric',
      });

      // Show/hide today button depending on whether we're viewing the current month
      const todayBtn = document.getElementById('today-btn')!;
      const isCurrentMonth = calYear === today.getFullYear() && calMonth === today.getMonth();
      todayBtn.style.display = isCurrentMonth ? 'none' : '';

      clearEl(grid);

      const firstDay = new Date(calYear, calMonth, 1).getDay();
      const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();

      const checkinDate = state.checkin ? new Date(state.checkin + 'T00:00:00') : null;
      const checkoutDate = state.checkout ? new Date(state.checkout + 'T00:00:00') : null;

      // Empty cells
      for (let i = 0; i < firstDay; i++) {
        grid.appendChild(document.createElement('div'));
      }

      for (let d = 1; d <= daysInMonth; d++) {
        const date = new Date(calYear, calMonth, d);
        const isPast = date < today;
        const isToday = date.getTime() === today.getTime();
        const dateStr = `${calYear}-${String(calMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
        const isCheckin = state.checkin === dateStr;
        const isCheckout = state.checkout === dateStr;
        const inRange = checkinDate && checkoutDate && date > checkinDate && date < checkoutDate;

        // Get availability and price — null means still loading from /api/availability
        const info = getDayInfo(dateStr);
        const isLoading = !isPast && !isToday && info === null;
        const isSoldOut = !isLoading && info !== null && info.beds === 0;

        let fillColor = '#FFF9F0';
        let strokeColor = '#D4A574';
        let strokeWidth = '2.5';

        if (isPast && !isToday) {
          fillColor = '#f5f5f5';
          strokeColor = '#e0e0e0';
        }
        if (isLoading) {
          fillColor = '#f5f5f5';
          strokeColor = '#d0d0d0';
        }
        if (isToday) {
          fillColor = '#EAC102';
          strokeColor = '#D4A574';
        }
        if (isSoldOut) {
          fillColor = '#FFF0F0';
          strokeColor = '#EF9A9A';
        }
        if (isCheckin || isCheckout) {
          fillColor = '#00AB39';
          strokeColor = '#005a1e';
          strokeWidth = '3';
        }
        if (inRange) {
          fillColor = '#C8E6C9';
          strokeColor = '#81C784';
        }

        const isDisabled = (isPast && !isToday) || isSoldOut || isLoading;

        const classes = [
          'cal-day',
          isDisabled ? 'disabled' : '',
          isLoading ? 'loading' : '',
          isToday ? 'today' : '',
          isCheckin ? 'checkin' : '',
          isCheckout ? 'checkout' : '',
          inRange ? 'in-range' : '',
        ]
          .filter(Boolean)
          .join(' ');

        // Beds label — info may be null for any date (past, today, future) until the fetch resolves
        const bedsClass =
          info === null ? '' : info.beds === 0 ? 'none' : info.beds <= 3 ? 'low' : '';
        const bedsLabel = info === null ? '…' : info.beds === 0 ? 'Full' : `${info.beds} left`;
        const priceLabel = info === null ? '…' : `€${info.price}`;

        const btn = document.createElement('button');
        btn.className = classes;
        btn.dataset.date = dateStr;
        btn.dataset.price = info ? String(info.price) : '';
        btn.dataset.beds = info ? String(info.beds) : '';
        if (isDisabled) btn.disabled = true;
        btn.setAttribute(
          'aria-label',
          info === null
            ? `${dateStr} - loading`
            : `${dateStr} - €${info.price}/night - ${info.beds} beds left`
        );

        // SVG background
        const NS = 'http://www.w3.org/2000/svg';
        const svg = document.createElementNS(NS, 'svg') as SVGSVGElement;
        svg.setAttribute('class', 'cal-day-bg');
        svg.setAttribute('viewBox', '0 0 100 100');
        const rect = document.createElementNS(NS, 'rect');
        rect.setAttribute('x', '5');
        rect.setAttribute('y', '5');
        rect.setAttribute('width', '90');
        rect.setAttribute('height', '90');
        rect.setAttribute('rx', '15');
        rect.setAttribute('fill', fillColor);
        rect.setAttribute('stroke', strokeColor);
        rect.setAttribute('stroke-width', strokeWidth);
        svg.appendChild(rect);
        btn.appendChild(svg);

        const numSpan = document.createElement('span');
        numSpan.className = 'cal-day-num';
        numSpan.textContent = String(d);
        btn.appendChild(numSpan);

        const bedsSpan = document.createElement('span');
        bedsSpan.className = `cal-day-beds${bedsClass ? ' ' + bedsClass : ''}`;
        bedsSpan.textContent = bedsLabel;
        btn.appendChild(bedsSpan);

        const priceSpan = document.createElement('span');
        priceSpan.className = 'cal-day-price';
        priceSpan.textContent = priceLabel;
        btn.appendChild(priceSpan);

        if (isToday) {
          const dot = document.createElement('div');
          dot.className = 'today-dot';
          btn.appendChild(dot);
        }

        grid.appendChild(btn);
      }

      // Click handler
      const dateErrorEl = document.getElementById('date-range-error')!;
      function showDateError(msg: string) {
        dateErrorEl.textContent = msg;
        dateErrorEl.style.display = '';
      }
      function clearDateError() {
        dateErrorEl.textContent = '';
        dateErrorEl.style.display = 'none';
      }

      grid.querySelectorAll('.cal-day:not(.disabled)').forEach((btn) => {
        btn.addEventListener('click', () => {
          const d = (btn as HTMLElement).dataset.date!;
          if (!state.checkin || (state.checkin && state.checkout)) {
            // Starting a new selection
            state.checkin = d;
            state.checkout = null;
            state.nights = 0;
            clearDateError();
          } else {
            if (d <= state.checkin) {
              // Clicked before or on check-in — restart selection
              state.checkin = d;
              state.checkout = null;
              state.nights = 0;
              clearDateError();
            } else {
              const ms =
                new Date(d + 'T00:00:00').getTime() -
                new Date(state.checkin + 'T00:00:00').getTime();
              const nights = Math.round(ms / 86400000);
              if (nights > MAX_NIGHTS) {
                showDateError(
                  `Maximum stay is ${MAX_NIGHTS} nights. Please choose a check-out within ${MAX_NIGHTS} nights of your check-in.`
                );
                // Don't set checkout — keep checkin selected so user can pick another date
                return;
              }
              // Also validate not booking too far in advance
              const today = new Date();
              today.setHours(0, 0, 0, 0);
              const checkinDate = new Date(state.checkin + 'T00:00:00');
              const daysInAdvance = Math.round(
                (checkinDate.getTime() - today.getTime()) / 86400000
              );
              if (daysInAdvance > MAX_ADVANCE_DAYS) {
                showDateError(
                  `Bookings can only be made up to ${MAX_ADVANCE_DAYS} days in advance.`
                );
                return;
              }
              clearDateError();
              state.checkout = d;
              state.nights = nights;
              fetchPriceForSelection(); // async — updates state.pricePerNight when API responds
            }
          }
          updateDateSummary();
          renderCalendar();
          enableNext(canProceed());
        });
      });
    }

    function updateDateSummary() {
      const ci = document.getElementById('checkin-display')!;
      const co = document.getElementById('checkout-display')!;
      const cichip = document.getElementById('checkin-chip')!;
      const cochip = document.getElementById('checkout-chip')!;
      const nchip = document.getElementById('nights-chip')!;
      const nval = document.getElementById('nights-val')!;
      const acts = document.getElementById('date-actions')!;
      const priceChip = document.getElementById('price-chip')!;
      const priceTotal = document.getElementById('price-total')!;
      const priceBreakdown = document.getElementById('price-breakdown')!;
      const priceRows = document.getElementById('price-rows')!;
      const priceTotalRow = document.getElementById('price-total-row')!;

      if (state.checkin) {
        ci.textContent = new Date(state.checkin + 'T12:00:00').toLocaleDateString('en-US', {
          month: 'short',
          day: 'numeric',
        });
        cichip.classList.add('filled');
      } else {
        ci.textContent = '—';
        cichip.classList.remove('filled');
      }
      if (state.checkout) {
        co.textContent = new Date(state.checkout + 'T12:00:00').toLocaleDateString('en-US', {
          month: 'short',
          day: 'numeric',
        });
        cochip.classList.add('filled');
        nchip.style.display = '';
        nval.textContent = String(state.nights);
        acts.style.display = '';

        // Calculate price breakdown (price per night × persons)
        const ciDate = new Date(state.checkin + 'T12:00:00');
        const persons = state.persons || 1;
        let total = 0;
        clearEl(priceRows);
        for (let i = 0; i < state.nights; i++) {
          const d = new Date(ciDate);
          d.setDate(d.getDate() + i);
          const ds = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
          const info = getDayInfo(ds);
          const nightPrice = (info?.price ?? state.pricePerNight) * persons;
          total += nightPrice;
          const label = d.toLocaleDateString('en-US', {
            weekday: 'short',
            month: 'short',
            day: 'numeric',
          });
          const row = document.createElement('div');
          row.className = 'price-row';
