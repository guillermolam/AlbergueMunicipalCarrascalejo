---
const { initialServices = [] } = Astro.props;
---

<div class="bg-stone-100 rounded-xl p-6">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-xl font-semibold text-stone-900">Service status</h2>
    <div class="text-sm text-stone-500">Static snapshot</div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full border-collapse">
      <thead>
        <tr>
          <th>Service</th>
          <th>Status</th>
          <th>Response</th>
          <th>Message</th>
        </tr>
      </thead>
      <tbody>
        {
          initialServices.map((s) => (
            <tr>
              <td class="font-medium">{s.name}</td>
              <td>
                <span
                  class={`badge-doodle ${s.status === 'healthy' ? 'text-green-700' : s.status === 'warning' ? 'text-yellow-700' : 'text-red-700'}`}
                >
                  {s.status}
                </span>
              </td>
              <td class="font-mono">{s.responseTime}</td>
              <td class="text-stone-600">{s.message}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>
