---
export interface Props {
  autoActive?: boolean;
  enablePilgrims?: boolean;
}

const { autoActive = true, enablePilgrims = false } = Astro.props;
---

<div
  class="map3d-town-wrap"
  data-active="false"
  data-auto-active={autoActive ? 'true' : 'false'}
  data-enable-pilgrims={enablePilgrims ? 'true' : 'false'}
>
  <canvas id="map3d-town" aria-label="Mapa 3D de El Carrascalejo en la Vía de la Plata"></canvas>
  <div class="map3d-legend" aria-hidden="true">
    <span class="legend-dot legend-dot--route"></span><span>Vía de la Plata</span>
    <span class="legend-dot legend-dot--albergue"></span><span>Albergue</span>
    <span class="legend-dot legend-dot--town"></span><span>Pueblo</span>
  </div>
  <div class="map3d-label" id="map3d-town-label" aria-live="polite"></div>
</div>

<script>
import * as THREE from 'three';
import { attachSectionActive } from '../../lib/three/sectionActive';

const canvas = document.getElementById('map3d-town');
if (!(canvas instanceof HTMLCanvasElement)) throw new Error('map3d-town canvas missing');
const canvasEl: HTMLCanvasElement = canvas;

const root = canvasEl.closest('.map3d-town-wrap');
if (!(root instanceof HTMLElement)) throw new Error('map3d-town root missing');

const wrap = canvasEl.parentElement;
if (!(wrap instanceof HTMLElement)) throw new Error('map3d-town wrapper missing');
let W = wrap.clientWidth, H = wrap.clientHeight;

const autoActive = root.getAttribute('data-auto-active') !== 'false';
const enablePilgrims = root.getAttribute('data-enable-pilgrims') === 'true';

const renderer = new THREE.WebGLRenderer({ canvas: canvasEl, antialias: true, alpha: false });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(W, H);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;

const scene = new THREE.Scene();
scene.background = new THREE.Color(0xdde8f0);
scene.fog = new THREE.Fog(0xdde8f0, 60, 140);

const camera = new THREE.PerspectiveCamera(45, W / H, 0.1, 200);
camera.position.set(0, 45, 55);
camera.lookAt(0, 0, 0);

// Lights
const ambient = new THREE.AmbientLight(0xfff8e7, 0.7);
scene.add(ambient);
const sun = new THREE.DirectionalLight(0xfff4cc, 1.4);
sun.position.set(25, 60, 30);
sun.castShadow = true;
sun.shadow.mapSize.set(1024, 1024);
sun.shadow.camera.near = 1;
sun.shadow.camera.far = 150;
sun.shadow.camera.left = -60;
sun.shadow.camera.right = 60;
sun.shadow.camera.top = 60;
sun.shadow.camera.bottom = -60;
scene.add(sun);
const fill = new THREE.DirectionalLight(0xc8e0ff, 0.3);
fill.position.set(-20, 20, -10);
scene.add(fill);

// Terrain — gentle Extremaduran plain with slight undulations
const TERRAIN_W = 120, TERRAIN_D = 120, TERRAIN_SEG = 48;
const terrainGeo = new THREE.PlaneGeometry(TERRAIN_W, TERRAIN_D, TERRAIN_SEG, TERRAIN_SEG);
terrainGeo.rotateX(-Math.PI / 2);
const pos = terrainGeo.attributes.position;
for (let i = 0; i < pos.count; i++) {
  const x = pos.getX(i), z = pos.getZ(i);
  const h = Math.sin(x * 0.08) * 1.2 + Math.cos(z * 0.07) * 0.9
           + Math.sin(x * 0.03 + z * 0.04) * 2.5;
  pos.setY(i, h);
}
terrainGeo.computeVertexNormals();
const terrainMat = new THREE.MeshStandardMaterial({
  color: 0xb8c98a,
  roughness: 0.95,
  metalness: 0,
});
const terrain = new THREE.Mesh(terrainGeo, terrainMat);
terrain.receiveShadow = true;
scene.add(terrain);

// Helper: sample terrain Y at (x, z)
function terrainY(x: number, z: number) {
  return Math.sin(x * 0.08) * 1.2 + Math.cos(z * 0.07) * 0.9
       + Math.sin(x * 0.03 + z * 0.04) * 2.5;
}

// Vía de la Plata route path (S→N, roughly)
const routePoints = [
  [-5, 0, 50], [-4, 0, 35], [-3, 0, 20], [-2, 0, 5],
  [-1, 0, -10], [0, 0, -25], [1, 0, -40], [2, 0, -55],
].map(([x, , z]) => new THREE.Vector3(x, terrainY(x, z) + 0.4, z));

const routeCurve = new THREE.CatmullRomCurve3(routePoints);
const routePts = routeCurve.getPoints(120);
const routeGeo = new THREE.BufferGeometry().setFromPoints(routePts);
const routeLine = new THREE.Line(
  routeGeo,
  new THREE.LineBasicMaterial({ color: 0xf5a623, linewidth: 3 })
);
scene.add(routeLine);

// Road (tube for better visibility)
const routeTube = new THREE.TubeGeometry(routeCurve, 60, 0.18, 4, false);
const routeTubeMesh = new THREE.Mesh(
  routeTube,
  new THREE.MeshStandardMaterial({ color: 0xe8903a, roughness: 0.6 })
);
routeTubeMesh.receiveShadow = true;
scene.add(routeTubeMesh);

const pilgrims: THREE.Object3D[] = [];
if (enablePilgrims) {
  const bodyMat = new THREE.MeshStandardMaterial({ color: 0x2b2b2b, roughness: 0.9 });
  const headMat = new THREE.MeshStandardMaterial({ color: 0xf2d2b6, roughness: 0.95 });
  const packMat = new THREE.MeshStandardMaterial({ color: 0x00ab39, roughness: 0.75 });

  const hasCapsule = typeof THREE.CapsuleGeometry === 'function';
  const bodyGeo = hasCapsule
    ? new THREE.CapsuleGeometry(0.18, 0.4, 6, 10)
    : new THREE.CylinderGeometry(0.18, 0.18, 0.52, 10);
  const headGeo = new THREE.SphereGeometry(0.16, 10, 10);
  const packGeo = new THREE.BoxGeometry(0.22, 0.26, 0.14);

  for (let i = 0; i < 10; i++) {
    const g = new THREE.Group();
    const body = new THREE.Mesh(bodyGeo, bodyMat);
    body.castShadow = true;
    body.position.y = 0.32;
    g.add(body);
    const head = new THREE.Mesh(headGeo, headMat);
    head.castShadow = true;
    head.position.y = 0.72;
    g.add(head);
    const pack = new THREE.Mesh(packGeo, packMat);
    pack.castShadow = true;
    pack.position.set(0, 0.55, -0.22);
    g.add(pack);
    g.userData.offset = i / 10;
    scene.add(g);
    pilgrims.push(g);
  }
}

// Towns along the route
const towns = [
  { name: 'El Carrascalejo', x: -2, z: 5, primary: true, km: 482 },
  { name: 'Alcuéscar →', x: 3, z: -25, primary: false, km: 503 },
  { name: '← Alquéscar', x: -4, z: 35, primary: false, km: 468 },
  { name: 'Mérida ↓', x: -5, z: 50, primary: false, km: 455 },
];

const townObjects: Array<{ mesh: THREE.Object3D; name: string; km: number }> = [];

for (const town of towns) {
  const y = terrainY(town.x, town.z);

  if (town.primary) {
    const buildingGroup = new THREE.Group();
    buildingGroup.position.set(town.x, y, town.z);

    const wallMat = new THREE.MeshStandardMaterial({ color: 0xf3efe6, roughness: 0.95, metalness: 0.02 });
    const roofMat = new THREE.MeshStandardMaterial({ color: 0xcf6a2c, roughness: 0.85, metalness: 0.02 });
    const roadMat = new THREE.MeshStandardMaterial({ color: 0x6b6f74, roughness: 0.95, metalness: 0 });
    const dirtMat = new THREE.MeshStandardMaterial({ color: 0xc6b38e, roughness: 0.98, metalness: 0 });

    const road = new THREE.Mesh(new THREE.BoxGeometry(16, 0.12, 2.2), roadMat);
    road.position.set(0.5, 0.06, 0);
    road.rotation.y = -0.35;
    road.receiveShadow = true;
    buildingGroup.add(road);

    const road2 = new THREE.Mesh(new THREE.BoxGeometry(10, 0.12, 2.0), roadMat);
    road2.position.set(-1.8, 0.06, 1.6);
    road2.rotation.y = 0.9;
    road2.receiveShadow = true;
    buildingGroup.add(road2);

    const plaza = new THREE.Mesh(new THREE.CylinderGeometry(1.2, 1.2, 0.14, 18), dirtMat);
    plaza.position.set(-0.4, 0.07, 0.4);
    plaza.receiveShadow = true;
    buildingGroup.add(plaza);

    const makeHouse = (x: number, z: number, w: number, d: number, h: number, ry: number, isAlbergue = false) => {
      const g = new THREE.Group();
      g.position.set(x, 0, z);
      g.rotation.y = ry;

      const walls = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), wallMat);
      walls.position.y = h / 2;
      walls.castShadow = true;
      walls.receiveShadow = true;
      g.add(walls);

      const roof = new THREE.Mesh(new THREE.BoxGeometry(w * 1.02, h * 0.2, d * 1.04), roofMat);
      roof.position.y = h + h * 0.1;
      roof.castShadow = true;
      g.add(roof);

      if (isAlbergue) {
        const mark = new THREE.Mesh(
          new THREE.BoxGeometry(w * 0.45, h * 0.18, 0.06),
          new THREE.MeshStandardMaterial({ color: 0x00ab39, roughness: 0.65, metalness: 0.05, emissive: 0x00160b })
        );
        mark.position.set(0, h * 0.66, d / 2 + 0.05);
        g.add(mark);

        const beacon = new THREE.PointLight(0x00ab39, 1.4, 14);
        beacon.position.set(0, h + 1.6, 0.2);
        g.add(beacon);
      }

      buildingGroup.add(g);
    };

    makeHouse(-4.8, -1.6, 2.2, 1.4, 1.2, -0.35);
    makeHouse(-2.4, -0.6, 2.0, 1.4, 1.1, -0.35);
    makeHouse(0.0, 0.4, 2.1, 1.5, 1.1, -0.35);
    makeHouse(2.6, 1.2, 2.0, 1.3, 1.05, -0.35);
    makeHouse(5.3, 2.0, 2.3, 1.5, 1.15, -0.35);

    makeHouse(-2.0, 3.2, 2.2, 1.6, 1.2, 0.92);
    makeHouse(-0.4, 4.2, 1.8, 1.4, 1.05, 0.92);
    makeHouse(1.1, 5.2, 2.0, 1.5, 1.12, 0.92);

    makeHouse(3.0, -2.2, 3.4, 2.1, 1.35, -0.35, true);

    for (let i = 0; i < 4; i++) {
      const pool = new THREE.Mesh(new THREE.BoxGeometry(0.7, 0.06, 0.45), new THREE.MeshStandardMaterial({ color: 0x2aa7c9, roughness: 0.35, metalness: 0.05 }));
      pool.position.set(-4.2 + i * 2.3, 0.08, 1.6 + (i % 2) * 1.7);
      pool.rotation.y = -0.35;
      pool.receiveShadow = true;
      buildingGroup.add(pool);
    }

    scene.add(buildingGroup);
    townObjects.push({ mesh: buildingGroup, name: town.name, km: town.km });
  } else {
    // Secondary town — small box cluster
    const group = new THREE.Group();
    group.position.set(town.x, y, town.z);

    for (let i = 0; i < 3; i++) {
      const bGeo = new THREE.BoxGeometry(0.8 + Math.random() * 0.6, 0.7 + Math.random() * 0.5, 0.8);
      const bMat = new THREE.MeshStandardMaterial({ color: 0xc4a882, roughness: 0.9 });
      const b = new THREE.Mesh(bGeo, bMat);
      b.position.set((i - 1) * 1.1, (0.7 + Math.random() * 0.5) / 2, 0);
      b.castShadow = true;
      group.add(b);
    }

    scene.add(group);
    townObjects.push({ mesh: group, name: town.name, km: town.km });
  }
}

// Trees (scattered pines)
const treeMat = new THREE.MeshStandardMaterial({ color: 0x3a6b35, roughness: 0.9 });
const trunkMat = new THREE.MeshStandardMaterial({ color: 0x6b4226, roughness: 1 });
const treesGroup = new THREE.Group();

for (let i = 0; i < 60; i++) {
  const x = (Math.random() - 0.5) * 100;
  const z = (Math.random() - 0.5) * 100;
  // Skip near route
  if (Math.abs(x + 2) < 4 && Math.abs(z) < 55) continue;
  const y = terrainY(x, z);

  const h = 0.8 + Math.random() * 1.4;
  const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.08, h, 5), trunkMat);
  trunk.position.set(x, y + h / 2, z);
  trunk.castShadow = true;
  treesGroup.add(trunk);

  const crown = new THREE.Mesh(new THREE.ConeGeometry(0.5 + Math.random() * 0.3, h * 1.2, 6), treeMat);
  crown.position.set(x, y + h + 0.3, z);
  crown.castShadow = true;
  treesGroup.add(crown);
}
scene.add(treesGroup);

// Km markers along route
for (let i = 0; i <= 4; i++) {
  const t = i / 4;
  const pt = routeCurve.getPoint(t);
  const markerGeo = new THREE.CylinderGeometry(0.1, 0.1, 0.8, 6);
  const markerMat = new THREE.MeshStandardMaterial({ color: 0xffffff, emissive: 0xdddddd, emissiveIntensity: 0.3 });
  const marker = new THREE.Mesh(markerGeo, markerMat);
  marker.position.copy(pt);
  marker.position.y += 0.4;
  scene.add(marker);
}

// Label element
const labelEl = document.getElementById('map3d-town-label');

// Raycaster for hover
const raycaster = new THREE.Raycaster();
const mouse = new THREE.Vector2(-9, -9);

canvas.addEventListener('mousemove', (e) => {
  const rect = canvas.getBoundingClientRect();
  mouse.x = ((e.clientX - rect.left) / W) * 2 - 1;
  mouse.y = -((e.clientY - rect.top) / H) * 2 + 1;
  if (reducedMotion) renderFrame();
});

canvas.addEventListener('mouseleave', () => {
  mouse.set(-9, -9);
  if (labelEl) labelEl.textContent = '';
  if (reducedMotion) renderFrame();
});

// Auto-rotation state
let autoTheta = 0;
let isDragging = false, prevX = 0;
const RADIUS = 60, BASE_Y = 45;

canvas.addEventListener('mousedown', (e) => { isDragging = true; prevX = e.clientX; });
window.addEventListener('mouseup', () => { isDragging = false; });
window.addEventListener('mousemove', (e) => {
  if (!isDragging) return;
  autoTheta -= (e.clientX - prevX) * 0.005;
  prevX = e.clientX;
  if (reducedMotion) renderFrame();
});

// Touch support
canvas.addEventListener('touchstart', (e) => { isDragging = true; prevX = e.touches[0].clientX; }, { passive: true });
window.addEventListener('touchend', () => { isDragging = false; });
window.addEventListener('touchmove', (e) => {
  if (!isDragging) return;
  autoTheta -= (e.touches[0].clientX - prevX) * 0.005;
  prevX = e.touches[0].clientX;
  if (reducedMotion) renderFrame();
}, { passive: true });

// Animation
let frame = 0;
const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches ?? false;
let running = false;
let raf = 0;

function renderFrame() {
  frame++;

  if (!isDragging) autoTheta += 0.003;

  if (pilgrims.length) {
    for (const p of pilgrims) {
      const off = Number(p.userData.offset ?? 0);
      const t = ((frame * 0.0009) + off) % 1;
      const pt = routeCurve.getPointAt(t);
      const next = routeCurve.getPointAt((t + 0.01) % 1);
      p.position.copy(pt);
      p.position.y += 0.15;
      p.lookAt(next.x, pt.y + 0.15, next.z);
      p.rotateY(Math.PI);
    }
  }

  camera.position.x = RADIUS * Math.sin(autoTheta);
  camera.position.z = RADIUS * Math.cos(autoTheta);
  camera.position.y = BASE_Y + Math.sin(autoTheta * 0.3) * 5;
  camera.lookAt(0, 2, 0);

  // Beacon pulse
  for (const t of townObjects) {
    if (t.name.includes('Carrascalejo')) {
      const beacon = t.mesh.children.find((c) => c instanceof THREE.PointLight);
      if (beacon) beacon.intensity = 1.2 + Math.sin(frame * 0.06) * 0.8;
    }
  }

  // Hover detection
  raycaster.setFromCamera(mouse, camera);
  const meshes = townObjects.map((t) => t.mesh);
  const hits = raycaster.intersectObjects(meshes, true);
  if (hits.length > 0) {
    // Walk up to find group
    let obj = hits[0].object;
    while (obj.parent && !townObjects.find((t) => t.mesh === obj)) obj = obj.parent;
    const found = townObjects.find((t) => t.mesh === obj);
    if (found && labelEl) labelEl.textContent = found.km ? `${found.name}  (km ${found.km})` : found.name;
    canvasEl.style.cursor = 'pointer';
  } else {
    if (labelEl) labelEl.textContent = '';
    canvasEl.style.cursor = 'grab';
  }

  renderer.render(scene, camera);
}

function tick() {
  if (!running) return;
  raf = requestAnimationFrame(tick);
  renderFrame();
}

function start() {
  if (reducedMotion) {
    renderFrame();
    return;
  }
  if (running) return;
  running = true;
  tick();
}

function stop() {
  running = false;
  if (raf) cancelAnimationFrame(raf);
  raf = 0;
  renderer.dispose();
}

// Auto-start/stop is still driven via data-active.
const activeRoot = (root.closest('.ip-section') as HTMLElement | null) ?? root;
attachSectionActive(activeRoot, {
  auto: autoActive,
  onChange(active) {
    if (active) start();
    else stop();
  },
});

// First paint so it never shows a blank canvas.
renderFrame();

// Resize
const ro = new ResizeObserver(() => {
  W = wrap.clientWidth;
  H = wrap.clientHeight;
  renderer.setSize(W, H);
  camera.aspect = W / H;
  camera.updateProjectionMatrix();
  if (reducedMotion) renderFrame();
});
ro.observe(wrap);
</script>

<style>
  .map3d-town-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 12px;
    overflow: hidden;
  }
  .map3d-town-wrap canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
    cursor: grab;
    border-radius: 12px;
  }
  .map3d-legend {
    position: absolute;
    bottom: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(6px);
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 0.7rem;
    color: #333;
    gap: 10px;
    pointer-events: none;
  }
  .legend-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .legend-dot--route { background: #e8903a; }
  .legend-dot--albergue { background: #f5a623; }
  .legend-dot--town { background: #c4a882; }
  .map3d-label {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.72);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 20px;
    pointer-events: none;
    white-space: nowrap;
    min-height: 24px;
    transition: opacity 0.2s;
  }
</style>
