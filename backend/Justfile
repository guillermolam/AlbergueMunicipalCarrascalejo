# Justfile for the backend Rust workspace
#
# Usage examples:
#   just clippy
#   just fmt
#   just test
#   just build
#   just build-wasm
#
# Notes:
# - `clippy` runs with `-D warnings` to enforce zero warnings in CI-style runs.
# - Some crates in this workspace target WASM; use `build-wasm` if you want to
#   explicitly compile with the wasm32-wasi target.
# - Spin SDK components link against WASI imports, so native tests only run
#   against the `shared` crate. External integration tests for Spin components
#   require the Spin test runtime (spin test).

set shell := ["sh", "-eu", "-c"]

# Default recipe
default: fmt clippy test

fmt:
	cargo fmt --all -- --check

fmt-fix:
	cargo fmt --all

# Lint production code (lib targets only — external test files may reference
# pre-migration APIs and are validated separately via `spin test`).
clippy:
	cargo clippy --workspace --lib -- -D warnings

# Run tests for crates that can execute natively (shared library).
# Spin component tests require the Spin test runtime.
test:
	cargo test -p shared

build:
	cargo build --workspace --all-features

build-release:
	cargo build --workspace --all-features --release

# WASM builds (Spin/WASI)
build-wasm:
	cargo build --workspace --release --target wasm32-wasip2

# Update dependencies
update-deps:
	@echo "Checking for cargo-edit..."
	@command -v cargo-upgrade >/dev/null 2>&1 || cargo install cargo-edit
	@echo "Updating dependencies..."
	cargo upgrade --workspace --incompatible
	@echo "Dependencies updated. Run 'just build' to rebuild."

# Convenience cleanup
clean:
	cargo clean
