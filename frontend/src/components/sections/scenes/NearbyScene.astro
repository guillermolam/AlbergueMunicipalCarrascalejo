---
// NearbyScene.astro — Minimal signposts + route scene (hover shows label).
---

<div id="scene-nearby" class="section-scene" data-active="false">
  <canvas id="scene-nearby-canvas" aria-hidden="true"></canvas>
  <div id="scene-nearby-label" class="scene-label" aria-live="polite"></div>
</div>

<script type="module">
  import { attachSectionActive, createRafLoop } from '../../../lib/three/sectionActive';
  import { cssVarColorInt } from '../../../lib/three/cssColor';

  const root = document.getElementById('scene-nearby');
  const canvas = document.getElementById('scene-nearby-canvas');
  const labelEl = document.getElementById('scene-nearby-label');
  if (!root || !canvas) throw new Error('[NearbyScene] root/canvas missing');

  const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches ?? false;
  let runtime = null;
  let runtimePromise = null;

  async function init() {
    const THREE = await import('three');

    const cWhite = cssVarColorInt('--white', 0xffffff);
    const cBlack = cssVarColorInt('--black', 0x1a1a1a);
    const cGreen = cssVarColorInt('--green', 0x00ab39);
    const cBlue = cssVarColorInt('--blue', 0x0071bc);
    const cGold = cssVarColorInt('--gold', 0xeac102);

    let W = root.clientWidth;
    let H = root.clientHeight;

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(W, H);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(52, W / H, 0.1, 80);
    camera.position.set(0, 5.0, 12.0);
    camera.lookAt(0, 1.2, 0);

    scene.add(new THREE.AmbientLight(cWhite, 0.9));
    const sun = new THREE.DirectionalLight(cWhite, 0.9);
    sun.position.set(8, 10, 4);
    scene.add(sun);

    // Ground.
    const ground = new THREE.Mesh(
      new THREE.PlaneGeometry(22, 12, 1, 1),
      new THREE.MeshStandardMaterial({ color: cGreen, roughness: 0.98, transparent: true, opacity: 0.14 })
    );
    ground.rotation.x = -Math.PI / 2;
    ground.position.y = 0;
    scene.add(ground);

    // Route line.
    const route = new THREE.Line(
      new THREE.BufferGeometry().setFromPoints([
        new THREE.Vector3(-7, 0.05, 3.0),
        new THREE.Vector3(-3, 0.05, 1.2),
        new THREE.Vector3(0, 0.05, 0.2),
        new THREE.Vector3(3.2, 0.05, -1.0),
        new THREE.Vector3(7.5, 0.05, -2.8),
      ]),
      new THREE.LineBasicMaterial({ color: cBlack, transparent: true, opacity: 0.22 })
    );
    scene.add(route);

    // Signposts.
    const signs = [];
    const defs = [
      { name: 'Roman Aqueduct', color: cGold, x: -4.8, z: 1.5, dir: 1 },
      { name: 'Mérida', color: cBlue, x: 0.3, z: 0.0, dir: -1 },
      { name: 'Dehesa Lookout', color: cWhite, x: 4.8, z: -1.4, dir: 1 },
    ];

    for (const d of defs) {
      const g = new THREE.Group();
      g.position.set(d.x, 0, d.z);
      g.userData.name = d.name;

      const pole = new THREE.Mesh(
        new THREE.CylinderGeometry(0.08, 0.09, 2.2, 8),
        new THREE.MeshStandardMaterial({ color: cBlack, roughness: 0.9, transparent: true, opacity: 0.35 })
      );
      pole.position.y = 1.1;
      g.add(pole);

      const board = new THREE.Mesh(
        new THREE.BoxGeometry(2.6, 0.55, 0.18),
        new THREE.MeshStandardMaterial({ color: d.color, roughness: 0.65, transparent: true, opacity: 0.9 })
      );
      board.position.set(d.dir * 1.2, 1.75, 0);
      board.rotation.y = d.dir * 0.35;
      g.add(board);

      const outline = new THREE.Mesh(
        new THREE.BoxGeometry(2.65, 0.6, 0.18),
        new THREE.MeshBasicMaterial({ color: cBlack, transparent: true, opacity: 0.10, wireframe: true })
      );
      outline.position.copy(board.position);
      outline.rotation.copy(board.rotation);
      g.add(outline);

      scene.add(g);
      signs.push(g);
    }

    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2(-9, -9);
    let hovered = '';

    const onMove = (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / Math.max(1, rect.width)) * 2 - 1;
      mouse.y = -(((e.clientY - rect.top) / Math.max(1, rect.height)) * 2 - 1);
      if (reducedMotion) renderFrame(0);
    };
    canvas.addEventListener('mousemove', onMove);
    canvas.addEventListener('mouseleave', () => {
      mouse.set(-9, -9);
      hovered = '';
      if (labelEl) labelEl.textContent = '';
      canvas.style.cursor = 'default';
      if (reducedMotion) renderFrame(0);
    });

    const clock = new THREE.Clock();
    function renderFrame(dt) {
      const t = clock.getElapsedTime();

      // Very light bob to feel alive.
      for (let i = 0; i < signs.length; i++) {
        signs[i].rotation.y = Math.sin(t * 0.35 + i) * 0.05;
      }

      raycaster.setFromCamera(mouse, camera);
      const hits = raycaster.intersectObjects(signs, true);
      const hit = hits.length ? hits[0].object.parent : null;
      const name = hit?.userData?.name ?? '';
      if (name !== hovered) {
        hovered = name;
        if (labelEl) labelEl.textContent = hovered;
      }
      canvas.style.cursor = hovered ? 'pointer' : 'grab';

      // Route shimmer.
      route.material.opacity = 0.18 + Math.sin(t * 1.3) * 0.06;

      renderer.render(scene, camera);
    }

    const loop = createRafLoop((dt) => renderFrame(dt));
    const ro = new ResizeObserver(() => {
      W = root.clientWidth;
      H = root.clientHeight;
      renderer.setSize(W, H);
      camera.aspect = Math.max(1e-6, W / Math.max(1, H));
      camera.updateProjectionMatrix();
      if (reducedMotion) renderFrame(0);
    });
    ro.observe(root);

    renderFrame(0);

    return {
      start() {
        if (reducedMotion) return;
        loop.start();
      },
      stop() {
        loop.stop();
      },
      destroy() {
        loop.stop();
        ro.disconnect();
        canvas.removeEventListener('mousemove', onMove);
        renderer.dispose();
      },
    };
  }

  async function ensureRuntime() {
    if (runtime) return runtime;
    runtimePromise ??= init();
    runtime = await runtimePromise;
    return runtime;
  }

  attachSectionActive(root, {
    auto: true,
    onChange(active) {
      if (active) ensureRuntime().then((r) => r.start());
      else runtime?.stop();
    },
  });
</script>

<style>
  .section-scene {
    position: relative;
    width: 100%;
    height: 16rem;
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(232, 245, 233, 0.9), rgba(255, 255, 255, 0.55));
  }
  .section-scene canvas {
    width: 100% !important;
    height: 100% !important;
  }
  .scene-label {
    position: absolute;
    left: 12px;
    bottom: 12px;
    background: rgba(26, 26, 26, 0.72);
    color: #fff;
    font-size: 0.75rem;
    padding: 6px 10px;
    border-radius: 10px;
    pointer-events: none;
    min-height: 1.2rem;
  }
  @media (min-width: 768px) {
    .section-scene { height: 20rem; }
  }
</style>

