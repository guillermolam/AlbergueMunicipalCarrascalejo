---
// FloorplanScene.astro — Reuses Map3DAlbergue (owns its own canvas + start/stop via data-active).
import Map3DAlbergue from '../../info/Map3DAlbergue.astro';
---

<div class="section-scene section-scene--map">
  <Map3DAlbergue />
</div>

<style>
  .section-scene--map {
    width: 100%;
    height: 22rem;
    border-radius: 12px;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .section-scene--map { height: 26rem; }
  }
</style>

