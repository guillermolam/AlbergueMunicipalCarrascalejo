    // ── Night Tabs ──
    // Shows stay dates. When some nights are unassigned (partial bed), tabs become interactive
    // so user can select which night to assign a different bed to.
    function renderNightTabs() {
      const wrap = document.getElementById('night-tabs-wrap')!;
      const tabs = document.getElementById('night-tabs')!;
      if (!state.nights || state.nights < 1) { wrap.style.display = 'none'; return; }
      wrap.style.display = '';
      tabs.innerHTML = '';
      const ciDate = state.checkin ? new Date(state.checkin + 'T12:00:00') : new Date();
      const allAssigned = bedSchedule.every(b => b !== null && b !== undefined);
      const hasUnassigned = bedSchedule.some(b => b === null || b === undefined);
      // Update label based on state
      const label = wrap.querySelector('.night-tabs-label') as HTMLElement;
      if (label) {
        label.textContent = allAssigned ? 'Your stay:' : hasUnassigned ? 'Select bed for highlighted night:' : 'Your stay:';
      }
      for (let i = 0; i < state.nights; i++) {
        const d = new Date(ciDate); d.setDate(d.getDate() + i);
        const dateLabel = d.toLocaleDateString('en-US',{month:'short',day:'numeric'});
        const isAssigned = bedSchedule[i] !== null && bedSchedule[i] !== undefined;
        const isActive = i === activeNight && hasUnassigned;
        const tab = document.createElement(hasUnassigned ? 'button' : 'span');
        if (hasUnassigned) (tab as HTMLButtonElement).type = 'button';
        tab.className = `night-tab${isActive ? ' active' : ''}${isAssigned ? ' assigned' : ''}`;
        const dotColor = isAssigned ? '#0071BC' : '#bbb';
        tab.innerHTML = `N${i+1} <span style="font-size:0.7rem;opacity:0.7">${dateLabel}</span>${isAssigned ? `<span class="night-tab-dot" style="background:${isActive?'white':dotColor}"></span>` : ''}`;
        if (hasUnassigned) {
          tab.addEventListener('click', () => { activeNight = i; renderBedGrid(); renderNightTabs(); renderSchedule(); });
        }
        tabs.appendChild(tab);
      }
    }

    // ── Schedule Summary ──
    function renderSchedule() {
      const wrap = document.getElementById('bed-schedule')!;
      const rows = document.getElementById('bed-schedule-rows')!;
      const anyAssigned = bedSchedule.some(b => b !== null && b !== undefined);
      wrap.style.display = anyAssigned ? '' : 'none';
      if (!anyAssigned) return;
      rows.innerHTML = '';

      const unique = [...new Set(bedSchedule.filter(b => b !== null && b !== undefined))];
      const allAssigned = bedSchedule.every(b => b !== null && b !== undefined);
      const ciDate = state.checkin ? new Date(state.checkin + 'T12:00:00') : new Date();

      if (allAssigned && unique.length === 1) {
        // Single bed for all nights — show compact summary
        const bed = unique[0]!;
        const isTop = bed % 2 !== 0;
        const bunk = Math.ceil(bed / 2);
        const row = document.createElement('div');
        row.className = 'sched-row';
        row.innerHTML = `<span class="sched-night">All ${state.nights} nights</span>
          <span class="sched-bed">Bed ${bed} · ${isTop?'Top':'Bottom'} · Bunk ${bunk}</span>
          <button class="sched-remove" data-night="all" aria-label="Remove">×</button>`;
        rows.appendChild(row);
      } else {
        // Per-night breakdown (partial/multi-bed scenario)
        for (let i = 0; i < state.nights; i++) {
          const d = new Date(ciDate); d.setDate(d.getDate() + i);
          const label = d.toLocaleDateString('en-US',{month:'short',day:'numeric'});
          const bed = bedSchedule[i];
          const row = document.createElement('div');
          row.className = 'sched-row';
          if (bed !== null && bed !== undefined) {
            const isTop = bed % 2 !== 0;
            const bunk = Math.ceil(bed / 2);
            row.innerHTML = `<span class="sched-night">N${i+1} ${label}</span>
              <span class="sched-bed">Bed ${bed} · ${isTop?'Top':'Bottom'} · Bunk ${bunk}</span>
              <button class="sched-remove" data-night="${i}" aria-label="Remove">×</button>`;
          } else {
            row.innerHTML = `<span class="sched-night unassigned">N${i+1} ${label}</span>
              <span class="sched-empty">Tap a bed to assign</span>`;
          }
          rows.appendChild(row);
        }
      }
      // Wire remove buttons
      rows.querySelectorAll('.sched-remove').forEach(btn => {
        btn.addEventListener('click', () => {
          const nightVal = (btn as HTMLElement).dataset.night!;
          if (nightVal === 'all') {
            // Clear entire selection
            for (let i = 0; i < bedSchedule.length; i++) bedSchedule[i] = null;
            activeNight = 0;
          } else {
            const ni = parseInt(nightVal);
            bedSchedule[ni] = null;
            activeNight = ni;
          }
          renderBedGrid(); renderNightTabs(); renderSchedule(); updateBedState();
        });
      });
    }

    // ── Tooltip ──
    function showTooltip(bed: number, e: MouseEvent) {
      const avail = availMap[bed] || [];
      const isTop = bed % 2 !== 0;
      const bunk = Math.ceil(bed / 2);
      const overall = bedOverallStatus(bed);

      ttTitle.textContent = `Bed ${bed} — ${isTop ? 'Top' : 'Bottom'} Bunk #${bunk}`;

      const statusColors: Record<string,string> = { available:'#A5D6A7', partial:'#FFD54F', occupied:'#EF9A9A', selected:'#90CAF9' };
      const statusLabels: Record<string,string> = { available:'Fully Available', partial:'Partially Available', occupied:'Fully Occupied', selected:'Selected' };
      ttStatus.innerHTML = `<span class="tt-dot" style="background:${statusColors[overall]}"></span>${statusLabels[overall]}`;

      const ciDate = state.checkin ? new Date(state.checkin + 'T12:00:00') : new Date();
      let nightsHtml = '';
      for (let i = 0; i < avail.length; i++) {
        const d = new Date(ciDate); d.setDate(d.getDate() + i);
        const label = d.toLocaleDateString('en-US',{month:'short',day:'numeric'});
        const isAvail = avail[i];
        const isSelected = bedSchedule[i] === bed;
        const cls = isSelected ? 'selected' : isAvail ? 'avail' : 'unavail';
        const val = isSelected ? '✓ Assigned' : isAvail ? 'Available' : 'Occupied';
        nightsHtml += `<div class="tt-night-row">
          <span class="tt-night-label">N${i+1} ${label}</span>
          <span class="tt-night-val ${cls}">${val}</span>
        </div>`;
      }
      ttNights.innerHTML = nightsHtml;

      tooltipEl.style.display = '';
      const rect = (e.target as Element).closest('.bunk-zone')?.getBoundingClientRect();
      if (rect) {
        const x = rect.left + rect.width / 2;
        const y = rect.top - 10;
        tooltipEl.style.left = Math.max(10, Math.min(x - 90, window.innerWidth - 200)) + 'px';
        tooltipEl.style.top = (y - tooltipEl.offsetHeight) + 'px';
      }
    }

    function hideTooltip() { tooltipEl.style.display = 'none'; }

    // ── Render Grid ──
    function renderBedGrid() {
      // availMap is set before renderBedGrid() is called (by initBedSelection / loadBedAvailability)
      const grid1 = document.getElementById('dorm1-grid')!;
      const grid2 = document.getElementById('dorm2-grid')!;
      grid1.innerHTML = '';
      grid2.innerHTML = '';

      for (let bunk = 1; bunk <= 12; bunk++) {
        const topBed = (bunk - 1) * 2 + 1;
        const bottomBed = (bunk - 1) * 2 + 2;
        const topSt = bedOverallStatus(topBed);
        const botSt = bedOverallStatus(bottomBed);

        const cell = document.createElement('div');
        cell.className = 'bunk-cell';
        cell.innerHTML = createBunkSVG(bunk, topBed, bottomBed, topSt, botSt)
                       + `<div class="bunk-label">Bunk ${bunk}</div>`;

        if (bunk <= 6) grid1.appendChild(cell);
        else grid2.appendChild(cell);
      }

      // Wire click + hover on bunk zones
      // 1 person per reservation:
      // - Fully available bed → autofill ALL nights
      // - Partially available bed → autofill available nights, leave unavailable nights for per-night selection
      // - Occupied bed → not clickable
      document.querySelectorAll('.bunk-zone').forEach(zone => {
        const bedNum = parseInt((zone as SVGElement).dataset.bed!);
        const avail = availMap[bedNum] || [];
        const isOccupiedAll = avail.every(a => !a);
        const isSelected = bedSchedule.some(b => b === bedNum);
        const hasAnyAvail = avail.some(Boolean);

        if (hasAnyAvail || isSelected) {
          (zone as SVGElement).style.cursor = 'pointer';
          zone.addEventListener('click', (e) => {
            e.stopPropagation();
            if (isSelected) {
              // Deselect: clear nights assigned to this bed
              for (let i = 0; i < bedSchedule.length; i++) {
                if (bedSchedule[i] === bedNum) bedSchedule[i] = null;
              }
              // Set active night to the first now-unassigned night
              const firstEmpty = bedSchedule.findIndex(b => b === null || b === undefined);
              if (firstEmpty >= 0) activeNight = firstEmpty;
            } else {
              // Assign this bed to all available nights it covers
              // First, clear any previous full selection (so user can switch beds)
              const prevBed = bedSchedule[0];
              const allSameBed = bedSchedule.every(b => b === prevBed);
              if (allSameBed && prevBed !== null) {
                // User is switching beds — clear all first
                for (let i = 0; i < bedSchedule.length; i++) bedSchedule[i] = null;
              }
              // Autofill this bed for all its available nights
              for (let i = 0; i < bedSchedule.length; i++) {
                if (avail[i] && (bedSchedule[i] === null || bedSchedule[i] === undefined)) {
                  bedSchedule[i] = bedNum;
                }
              }
              // Set active night to first remaining unassigned night (if any)
              const firstEmpty = bedSchedule.findIndex(b => b === null || b === undefined);
              if (firstEmpty >= 0) activeNight = firstEmpty;
            }
            renderBedGrid(); renderNightTabs(); renderSchedule(); updateBedState();
          });
        } else if (isOccupiedAll) {
          (zone as SVGElement).style.cursor = 'not-allowed';
        }

        // Tooltip hover
        zone.addEventListener('mouseenter', (e) => showTooltip(bedNum, e as MouseEvent));
        zone.addEventListener('mousemove', (e) => showTooltip(bedNum, e as MouseEvent));
        zone.addEventListener('mouseleave', hideTooltip);
      });
    }

    function updateBedState() {
      const allAssigned = bedSchedule.length > 0 && bedSchedule.every(b => b !== null && b !== undefined);
      const unique = [...new Set(bedSchedule.filter(b => b !== null && b !== undefined))];
      // Set state.bed for the booking
      if (allAssigned) {
        state.bed = unique.length === 1 ? String(unique[0]) : bedSchedule.map((b,i) => `N${i+1}:${b}`).join(',');
      } else {
        state.bed = null;
      }
      enableNext(allAssigned);

      // Update info card & ready
      const infoCard = document.getElementById('bed-info-card')!;
      const bedReady = document.getElementById('bed-ready')!;
      const hint = document.getElementById('bed-hint')!;
      const assigned = bedSchedule.filter(b => b !== null && b !== undefined).length;

      if (allAssigned && unique.length === 1) {
        // Single bed for all nights
        const bed = unique[0]!;
        const isTop = bed % 2 !== 0;
        const bunk = Math.ceil(bed / 2);
        (document.getElementById('bed-info-num') as HTMLElement).textContent = `Bed #${bed}`;
        (document.getElementById('bed-info-pos') as HTMLElement).textContent = isTop ? 'Top Bunk' : 'Bottom Bunk';
        (document.getElementById('bed-info-bunk') as HTMLElement).textContent = `Bunk #${bunk}`;
        (document.getElementById('bed-info-dorm') as HTMLElement).textContent = `🏠 Dormitory ${bed <= 12 ? 1 : 2}`;
        infoCard.style.display = '';
        bedReady.style.display = '';
        hint.textContent = `✨ Bed ${bed} assigned for all ${state.nights} nights!`;
        hint.style.color = '#00AB39';
      } else if (allAssigned) {
        // Multiple beds across nights
        (document.getElementById('bed-info-num') as HTMLElement).textContent = `${unique.length} beds`;
        (document.getElementById('bed-info-pos') as HTMLElement).textContent = 'Split across nights';
        (document.getElementById('bed-info-bunk') as HTMLElement).textContent = `${state.nights} nights covered`;
        (document.getElementById('bed-info-dorm') as HTMLElement).textContent = '📋 See schedule above';
        infoCard.style.display = '';
        bedReady.style.display = '';
        hint.textContent = `✨ All ${state.nights} nights assigned!`;
        hint.style.color = '#00AB39';
      } else if (assigned > 0) {
        const remaining = state.nights - assigned;
        hint.textContent = `${assigned}/${state.nights} nights assigned — select a bed for ${remaining} remaining night${remaining > 1 ? 's' : ''}`;
        hint.style.color = '#D4A017';
        bedReady.style.display = 'none';
        infoCard.style.display = 'none';
      } else {
        hint.textContent = 'Select a bed for your stay';
        hint.style.color = '#D4A017';
        bedReady.style.display = 'none';
        infoCard.style.display = 'none';
      }
    }

    // Initialize bed system when entering step 4
    function initBedSelection() {
      const n = state.nights || 1;
      bedSchedule = new Array(n).fill(null);
      activeNight = 0;
      availMap = getAvailabilityMapFallback(); // render immediately with fallback
      renderNightTabs();
      renderBedGrid();
      renderSchedule();
      updateBedState();
      loadBedAvailability(); // async: refines with real data when ready
    }

    initBedSelection();

    // ── CARD NUMBER FORMATTER ──
    document.getElementById('f-card')?.addEventListener('input', function() {
      const el = this as HTMLInputElement;
      let v = el.value.replace(/\D/g,'');
      el.value = v.replace(/(.{4})/g,'$1 ').trim().substring(0,19);
    });
    document.getElementById('f-expiry')?.addEventListener('input', function() {
      const el = this as HTMLInputElement;
      let v = el.value.replace(/\D/g,'');
      if (v.length >= 3) el.value = v.substring(0,2) + '/' + v.substring(2,4);
      else el.value = v;
    });

    // ── STEP 3 VALIDATION ──
    function validateStep3(): boolean {
      const required = ['f-first','f-last','f-email','f-zip','f-city'];
      let ok = true;
      required.forEach(id => {
        const el = document.getElementById(id) as HTMLInputElement;
        if (!el) return;
        const fg = el.closest('.fg')!;
        if (!el.value.trim()) {
          fg.classList.add('has-error'); el.classList.add('invalid'); ok = false;
          el.addEventListener('input', () => { fg.classList.remove('has-error'); el.classList.remove('invalid'); }, {once:true});
        }
      });
      const email = document.getElementById('f-email') as HTMLInputElement;
      if (email?.value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
        const fg = email.closest('.fg')!;
        fg.classList.add('has-error'); email.classList.add('invalid'); ok = false;
      }
      return ok;
    }

    // ── SUMMARY POPULATE ──
    function populateSummary() {
      const fmt = (d: string) => new Date(d+'T12:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
      const ciStr = state.checkin  ? fmt(state.checkin)  : '—';
      const coStr = state.checkout ? fmt(state.checkout) : '—';
      (document.getElementById('sum-dates') as HTMLElement).textContent = `${ciStr} → ${coStr}`;
      (document.getElementById('sum-nights') as HTMLElement).textContent = String(state.nights);
      (document.getElementById('sum-bed') as HTMLElement).textContent = state.bed ?? '—';
      const firstName = (document.getElementById('f-first') as HTMLInputElement)?.value || '—';
      const lastName  = (document.getElementById('f-last')  as HTMLInputElement)?.value || '';
      (document.getElementById('sum-pilgrim') as HTMLElement).textContent = `${firstName} ${lastName}`.trim();
      (document.getElementById('sum-doc') as HTMLElement).textContent = state.docType === 'dni' ? 'DNI / ID Card' : state.docType === 'passport' ? 'Passport' : '—';
      const total = state.totalPrice > 0 ? state.totalPrice : state.nights * state.pricePerNight;
      (document.getElementById('sum-total') as HTMLElement).textContent = `EUR ${total}`;
      (document.getElementById('pay-total') as HTMLElement).textContent = `EUR ${total}`;
    }

    // ── NAVIGATION ──
    btnNext.addEventListener('click', function() {
      if (state.step === 3 && !validateStep3()) return;
      if (state.step === 6) { submitBooking(); return; }
      rippleEffect(this as HTMLElement);
      if (state.step === 5) populateSummary();
      goToStep(state.step + 1, 'forward');
    });

    btnBack.addEventListener('click', function() {
      rippleEffect(this as HTMLElement);
      goToStep(state.step - 1, 'back');
    });

    function rippleEffect(el: HTMLElement) {
      const rect = el.getBoundingClientRect();
      const r = document.createElement('span');
      r.className = 'ripple-wave';
      const size = Math.max(rect.width, rect.height);
      r.style.cssText = `width:${size}px;height:${size}px;left:${rect.width/2 - size/2}px;top:${rect.height/2 - size/2}px`;
      el.appendChild(r);
      setTimeout(() => r.remove(), 650);
    }

    // ── SUBMIT ──
    async function submitBooking() {
      populateSummary();
      btnNext.disabled = true;
      const originalLabel = btnNext.textContent;
      btnNext.textContent = 'Confirmando…';

      const firstName = (document.getElementById('f-first') as HTMLInputElement)?.value.trim() ?? '';
      const lastName  = (document.getElementById('f-last')  as HTMLInputElement)?.value.trim() ?? '';
      const email     = (document.getElementById('f-email') as HTMLInputElement)?.value.trim() ?? '';
      const total     = state.totalPrice > 0 ? state.totalPrice : state.nights * state.pricePerNight;

      function buildRedirectParams(confCode: string, bookingRef: string) {
        return new URLSearchParams({
          conf:     confCode,
          ref:      bookingRef,
          name:     `${firstName} ${lastName}`.trim() || 'Peregrino',
          checkin:  state.checkin  ?? '',
          checkout: state.checkout ?? '',
          nights:   String(state.nights),
          total:    String(total),
          bed:      state.bed ?? '',
          persons:  '1',
          email,
        });
      }

      try {
        const result = await actions.booking.create({
          checkIn:  state.checkin!,
          checkOut: state.checkout!,
          persons: 1,
          notes: [
            state.bed  ? `Cama: ${state.bed}`  : '',
            state.docType ? `Doc: ${state.docType.toUpperCase()}` : '',
            firstName   ? `Peregrino: ${firstName} ${lastName}` : '',
          ].filter(Boolean).join('. '),
        });

        const data = (result as any)?.data ?? result;
        const confCode   = (data as any).confirmationCode
          ?? 'CONF-' + Math.random().toString(36).substring(2, 8).toUpperCase();
        const rawBooking = (data as any).booking;
        const bookingRef = rawBooking?.id
          ? 'BK-' + String(rawBooking.id).substring(0, 6).toUpperCase()
          : 'BK-' + Date.now().toString(36).toUpperCase().slice(-6);

        window.location.href = `/booking-confirmed?${buildRedirectParams(confCode, bookingRef)}`;

      } catch (err) {
        console.warn('[booking] API call failed, using offline confirmation', err);
        // Graceful degradation — pilgrim still gets a local confirmation
        const confCode   = 'CONF-' + Math.random().toString(36).substring(2, 8).toUpperCase();
        const bookingRef = 'BK-' + Date.now().toString(36).toUpperCase().slice(-6);
        const params = buildRedirectParams(confCode, bookingRef);
        params.set('offline', '1');
        window.location.href = `/booking-confirmed?${params}`;
      } finally {
        btnNext.disabled = false;
        btnNext.textContent = originalLabel;
      }
    }

    // ── CONFETTI ──
    function launchConfetti() {
      const c = document.getElementById('confetti-book')!;
      c.style.display = 'block';
      const colors = ['#00AB39','#EAC102','#006b24','#ffffff','#ED1C24'];
      for (let i = 0; i < 80; i++) {
        const dot = document.createElement('div');
        const size = 5 + Math.random() * 9;
        const angle = Math.random() * Math.PI * 2;
        const dist = 100 + Math.random() * 200;
        dot.style.cssText = `
          position:absolute;
          width:${size}px;height:${size}px;
          border-radius:${Math.random()>.5?'50%':'2px'};
          background:${colors[Math.floor(Math.random()*colors.length)]};
          left:${40+Math.random()*20}vw;top:40vh;
          animation:conf-fly ${1.5+Math.random()*2}s ease ${Math.random()*0.5}s forwards;
          --dx:${Math.cos(angle)*dist}px;--dy:${Math.sin(angle)*dist-200}px;
        `;
        c.appendChild(dot);
      }
      const style = document.createElement('style');
      style.textContent = '@keyframes conf-fly{to{transform:translate(var(--dx),var(--dy)) rotate(720deg);opacity:0}}';
      document.head.appendChild(style);
      setTimeout(() => { c.style.display='none'; c.innerHTML=''; style.remove(); }, 4000);
    }

