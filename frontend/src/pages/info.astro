      margin: 0 0 0.5rem;
    }
    .cta-sub {
      font-family: var(--font-hand);
      font-size: 1rem;
      color: #555;
      margin: 0 0 2rem;
    }
    @keyframes cta-rock-info {
      0%,
      100% {
        transform: rotate(0deg) translateY(0);
      }
      20% {
        transform: rotate(-2.5deg) translateY(-2px);
      }
      40% {
        transform: rotate(2.5deg) translateY(-3px);
      }
      60% {
        transform: rotate(-1.5deg) translateY(-1px);
      }
      80% {
        transform: rotate(1deg);
      }
    }
    .btn-sketchy-cta {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 1rem 2.5rem;
      text-decoration: none;
      transition: transform 200ms ease;
      animation: cta-rock-info 3.5s ease-in-out infinite;
    }
    .btn-sketchy-cta:hover {
      animation: none;
      transform: translateY(-3px);
    }
    .btn-sketchy-cta:active {
      animation: none;
      transform: scale(0.98);
    }
    .cta-btn-label {
      position: relative;
      z-index: 2;
      font-family: var(--font-sketch);
      font-weight: 700;
      font-size: 1.1rem;
      color: white;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    /* Scroll reveal */
    .reveal-section {
      opacity: 0;
      transform: translateY(28px);
      transition:
        opacity 600ms ease calc(var(--delay, 0s)),
        transform 600ms ease calc(var(--delay, 0s));
    }
    .reveal-section.revealed {
      opacity: 1;
      transform: translateY(0);
    }

    /* Reviews */
    .reviews-overall {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 2.5rem;
      align-items: start;
    }
    .reviews-score-big {
      display: flex;
      flex-direction: column;
      align-items: center;
      background: var(--green);
      color: white;
      border-radius: 16px;
      padding: 1.5rem 2rem;
      min-width: 140px;
    }
    .reviews-score-num {
      font-family: var(--font-display);
      font-size: 3.5rem;
      line-height: 1;
    }
    .reviews-score-label {
      font-family: var(--font-hand);
      font-size: 1rem;
      margin-top: 0.25rem;
    }
    .reviews-score-count {
      font-size: 0.7rem;
      opacity: 0.8;
      margin-top: 0.35rem;
      text-align: center;
    }
    .reviews-subscores {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .subscore-row {
      display: grid;
      grid-template-columns: 180px 1fr 40px;
      align-items: center;
      gap: 0.75rem;
    }
    .subscore-lbl {
      font-size: 0.85rem;
      color: #444;
    }
    .subscore-bar-wrap {
      background: #e8e8e8;
      border-radius: 6px;
      height: 8px;
      overflow: hidden;
    }
    .subscore-bar {
      background: var(--green);
      height: 100%;
      border-radius: 6px;
      transition: width 1s ease;
    }
    .subscore-val {
      font-weight: 700;
      font-size: 0.9rem;
      color: var(--green);
    }

    /* Nearby */
    .nearby-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .nearby-card {
      position: relative;
      border-radius: 14px;
      padding: 1.25rem 1.25rem 1.25rem 1rem;
      display: flex;
      gap: 1rem;
      align-items: flex-start;
    }
    .nearby-icon {
      font-size: 2rem;
      flex-shrink: 0;
    }
    .nearby-info {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }
    .nearby-name {
      font-size: 0.95rem;
      color: #222;
    }
    .nearby-dist {
