---
// SSR — data fetched from D1 at request time via internal API routes
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import MapLibre from '../components/MapLibre.astro';
import {
  getD1,
  db,
  hostelConfig,
  hostelServices,
  hostelRules,
  nearbyAttractions,
  reviewScores,
} from '../db/helpers';
import { eq, asc } from 'drizzle-orm';

// ── Defaults (mirror migration seed / fallback when D1 not available) ─────────
const DEFAULT_CONFIG = {
  name: 'Albergue Municipal de El Carrascalejo',
  tagline: 'Acogida en el Camino de Santiago — Vía de la Plata',
  addressStreet: 'Paraje la cuesta, s/n',
  addressPostcode: '06894',
  addressTown: 'El Carrascalejo',
  addressProvince: 'Badajoz',
  addressCountry: 'España',
  phone: '+34 695 90 43 44',
  email: 'elcarrascalejoalbergue@gmail.com',
  latitude: 39.0237972,
  longitude: -6.3373782,
  checkInOpen: '10:00',
  checkInClose: '21:00',
  checkOutOpen: '09:00',
  checkOutClose: '11:00',
  maxNights: 2,
  totalBeds: 24,
  tourismLicense: 'AL-BA-0034',
  languages: ['es', 'en'] as string[],
  accessibility: { wheelchair: true, ground_floor: true, adapted_bathroom: true, grab_rails: true },
  caminoKm: '482',
  caminoRoute: 'Via de la Plata',
};

const DEFAULT_RULES = [
  'Horario de silencio: 22:00 — 07:00',
  'Zona de fumadores habilitada en el exterior',
  'No se permiten fiestas ni eventos',
  'No se admiten ninos (albergue para adultos peregrinos)',
  'Mascotas permitidas — consultar sin cargo adicional',
  'Documento de identidad obligatorio al llegar',
  'Respeta a los demas peregrinos',
  'Cancelacion gratuita 24h antes',
  'Pago en efectivo en el albergue',
  'Llegadas tardias: avisar previamente al hospitalero',
];

const DEFAULT_ATTRACTIONS = [
  {
    name: 'Acueducto Romano de Los Milagros',
    distanceKm: 13,
    icon: '🏛️',
    description:
      'Impresionante acueducto romano del siglo I d.C., Patrimonio de la Humanidad UNESCO.',
  },
  {
    name: 'Basilica de Santa Eulalia',
    distanceKm: 14,
    icon: '⛪',
    description: 'Imponente basilica gotica del siglo XIV dedicada a la martir patrona de Merida.',
  },
  {
    name: 'Teatro Romano y Anfiteatro',
    distanceKm: 15,
    icon: '🎭',
    description: 'Teatro del siglo I a.C. perfectamente conservado y anfiteatro de gladiadores.',
  },
  {
    name: 'Aeropuerto de Badajoz',
    distanceKm: 57,
    icon: '✈️',
    description: 'Aeropuerto internacional con conexiones a Madrid, Barcelona y Canarias.',
  },
];

const DEFAULT_REVIEW_SCORES = {
  source: 'booking',
  overall: 9.1,
  staff: 9.6,
  cleanliness: 9.4,
  comfort: 9.3,
  valueForMoney: 9.6,
  facilities: 9.0,
  location: 9.0,
  totalCount: 71,
  label: 'Sobresaliente',
};

// ── Load from D1 ──────────────────────────────────────────────────────────────
let hostelData = DEFAULT_CONFIG;
let rules: string[] = DEFAULT_RULES;
let attractions = DEFAULT_ATTRACTIONS;
let reviewData = DEFAULT_REVIEW_SCORES;
let servicePriceCents: Record<string, number> = {};

try {
  const d1 = await getD1();
  if (d1) {
    const drizzle = db(d1);

    // Config row
    const [cfgRow] = await drizzle
      .select()
      .from(hostelConfig)
      .where(eq(hostelConfig.id, 1))
      .limit(1);
    const extRow = await d1
      .prepare(
        'SELECT check_in_open, check_in_close, check_out_open, check_out_close, max_nights, total_beds, languages, accessibility, camino_km, camino_route FROM hostel_config WHERE id = 1'
      )
      .first<{
        check_in_open: string;
        check_in_close: string;
        check_out_open: string;
        check_out_close: string;
        max_nights: number;
        total_beds: number;
        languages: string;
        accessibility: string;
        camino_km: string;
        camino_route: string;
      }>();

    if (cfgRow) {
      hostelData = {
        name: cfgRow.name,
        tagline: cfgRow.tagline ?? DEFAULT_CONFIG.tagline,
        addressStreet: cfgRow.addressStreet ?? DEFAULT_CONFIG.addressStreet,
        addressPostcode: cfgRow.addressPostcode ?? DEFAULT_CONFIG.addressPostcode,
        addressTown: cfgRow.addressTown ?? DEFAULT_CONFIG.addressTown,
        addressProvince: cfgRow.addressProvince ?? DEFAULT_CONFIG.addressProvince,
        addressCountry: cfgRow.addressCountry ?? DEFAULT_CONFIG.addressCountry,
        phone: cfgRow.phone ?? DEFAULT_CONFIG.phone,
        email: cfgRow.email ?? DEFAULT_CONFIG.email,
        latitude: cfgRow.latitude ?? DEFAULT_CONFIG.latitude,
        longitude: cfgRow.longitude ?? DEFAULT_CONFIG.longitude,
        checkInOpen: extRow?.check_in_open ?? DEFAULT_CONFIG.checkInOpen,
        checkInClose: extRow?.check_in_close ?? DEFAULT_CONFIG.checkInClose,
        checkOutOpen: extRow?.check_out_open ?? DEFAULT_CONFIG.checkOutOpen,
        checkOutClose: extRow?.check_out_close ?? DEFAULT_CONFIG.checkOutClose,
        maxNights: extRow?.max_nights ?? DEFAULT_CONFIG.maxNights,
        totalBeds: extRow?.total_beds ?? DEFAULT_CONFIG.totalBeds,
        tourismLicense: cfgRow.tourismLicense ?? DEFAULT_CONFIG.tourismLicense,
        languages: extRow?.languages ? JSON.parse(extRow.languages) : DEFAULT_CONFIG.languages,
        accessibility: extRow?.accessibility
          ? JSON.parse(extRow.accessibility)
          : DEFAULT_CONFIG.accessibility,
        caminoKm: extRow?.camino_km ?? DEFAULT_CONFIG.caminoKm,
        caminoRoute: extRow?.camino_route ?? DEFAULT_CONFIG.caminoRoute,
      };
    }

    // House rules
    const rulesRows = await drizzle
      .select()
      .from(hostelRules)
      .where(eq(hostelRules.active, 1))
      .orderBy(asc(hostelRules.sortOrder));
    if (rulesRows.length > 0) rules = rulesRows.map((r) => r.rule);

    // Nearby attractions
    const attrRows = await drizzle
      .select()
      .from(nearbyAttractions)
      .where(eq(nearbyAttractions.active, 1))
      .orderBy(asc(nearbyAttractions.sortOrder));
    if (attrRows.length > 0) attractions = attrRows.map((r) => ({ ...r, description: r.description ?? '' }));

    // Review scores
    const [scoreRow] = await drizzle
      .select()
      .from(reviewScores)
      .where(eq(reviewScores.source, 'all'))
      .limit(1);
    if (scoreRow?.overall) {
      reviewData = {
        source: scoreRow.source,
        overall: scoreRow.overall ?? DEFAULT_REVIEW_SCORES.overall,
        staff: scoreRow.staff ?? DEFAULT_REVIEW_SCORES.staff,
        cleanliness: scoreRow.cleanliness ?? DEFAULT_REVIEW_SCORES.cleanliness,
        comfort: scoreRow.comfort ?? DEFAULT_REVIEW_SCORES.comfort,
        valueForMoney: scoreRow.valueForMoney ?? DEFAULT_REVIEW_SCORES.valueForMoney,
        facilities: scoreRow.facilities ?? DEFAULT_REVIEW_SCORES.facilities,
        location: scoreRow.location ?? DEFAULT_REVIEW_SCORES.location,
        totalCount: scoreRow.totalCount,
        label: scoreRow.label ?? DEFAULT_REVIEW_SCORES.label,
      };
    }

    // Service prices (for display in facilities cards)
    const svcRows = await drizzle
      .select()
      .from(hostelServices)
      .where(eq(hostelServices.available, 1));
    for (const s of svcRows) servicePriceCents[s.name] = s.priceCents;
  }
} catch (e) {
  console.warn('[info.astro] D1 load failed, using defaults:', e);
}

// ── Derived display values ─────────────────────────────────────────────────────
const INFO_LAT = hostelData.latitude;
const INFO_LNG = hostelData.longitude;
const addressDisplay = `${hostelData.addressStreet} · ${hostelData.addressTown}, ${hostelData.addressPostcode}`;
const addressMapMarker = `${hostelData.addressStreet} · ${hostelData.addressPostcode} ${hostelData.addressTown}`;

// ── Static page data (presentation-only, not in DB) ───────────────────────────

// Booking.com real photos (hotel ID 12983893)
const PHOTOS = [
