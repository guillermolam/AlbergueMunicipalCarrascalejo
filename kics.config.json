{
  "excludeFiles": [
    "**/node_modules/**",
    "**/target/**",
    "**/dist/**",
    "**/.astro/**",
    "**/.cache/**",
    "**/.terraform/**",
    "**/tfplan",
    "**/*.tfstate",
    "**/*.tfstate.*",
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/*.crt",
    "**/*.wasm",
    "**/*.wat",
    "**/*.bin",
    "**/tests/**",
    "**/__tests__/**",
    "**/test/**",
    "**/scripts/**",
    "**/.github/**",
    "**/.trunk/**",
    "**/.qlty/**",
    "**/docs/**",
    "**/.vscode/**",
    "**/.idea/**",
    "**/.DS_Store"
  ],
  "excludeQueries": [],
  "includeQueries": [],
  "categories": [
    "BACKUP",
    "BEST_PRACTICES",
    "SECRETS",
    "SECURITY",
    "SUPPLY_CHAIN"
  ],
  "severityThreshold": "MEDIUM",
  "scanPath": "infra",
  "outputPath": "kics-results",
  "outputFormats": [
    "json",
    "sarif",
    "html"
  ],
  "queryExecTimeout": 60,
  "filesPerQuery": 20,
  "pathSeparator": "/",
  "optimizeQueries": true,
  "previewLines": 3,
  "secretsToken": "",
  "secretsRegexes": [
    "(?i)api_key.*['\"]\\w+['\"]",
    "(?i)aws_access_key.*['\"]\\w+['\"]",
    "(?i)password.*['\"]\\w+['\"]",
    "BEGIN (?:RSA |EC |OPENSSH |PGP )?PRIVATE KEY"
  ],
  "excludeResults": [],
  "disableSecrets": false,
  "showProgressBar": true,
  "typeMapping": {},
  "executionMode": "serial",
  "platformType": "Terraform"
}
