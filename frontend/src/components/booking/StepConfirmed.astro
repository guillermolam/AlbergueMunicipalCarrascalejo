---
// StepConfirmed.astro — Step 7: booking confirmation animation + action buttons
---

<div class="step-panel hidden" id="step-7" data-step="7">
  <div class="confirmed-wrap">
    <div class="confirmed-circle" id="conf-circle">
      <svg viewBox="0 0 52 52" fill="none">
        <circle class="conf-ring" cx="26" cy="26" r="24" stroke="#00AB39" stroke-width="3"></circle>
        <path
          class="conf-check"
          d="M14 26 L22 34 L38 18"
          stroke="#00AB39"
          stroke-width="3.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </div>
    <h1 class="confirmed-title">¡Reserva Confirmada!</h1>
    <p class="confirmed-sub">Recibirás una confirmación por email. ¡Buen Camino! 🥾</p>
    <div class="confirmed-ref">
      <span class="ref-label">Reference</span>
      <span class="ref-val" id="booking-ref">ALB-2026-XXXX</span>
    </div>
    <div class="confirmed-btns">
      <a href="/booking-confirmed" class="btn-conf-primary">
        <svg style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none" aria-hidden="true">
          <rect x="0" y="0" width="100%" height="100%" rx="12" fill="#00AB39" stroke="#1A1A1A" stroke-width="2.5" filter="url(#sketchy-filter-book)"></rect>
        </svg>
        <span class="conf-btn-label">Ver Confirmación</span>
      </a>
      <a href="/dashboard" class="btn-conf-secondary">
        <svg style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none" aria-hidden="true">
          <rect x="0" y="0" width="100%" height="100%" rx="12" fill="white" stroke="#00AB39" stroke-width="2.5" filter="url(#sketchy-filter-book)"></rect>
        </svg>
        <span class="conf-btn-label sec">Mi Dashboard</span>
      </a>
    </div>
  </div>
</div>
