        const bin = sh(
          new THREE.Mesh(
            new THREE.BoxGeometry(0.58, 0.98, 0.68),
            new THREE.MeshLambertMaterial({ color: c })
          )
        );
        bin.position.set(bvx, 0.49, bvz);
        scene.add(bin);
        // Lid
        const lid = new THREE.Mesh(
          new THREE.BoxGeometry(0.6, 0.07, 0.7),
          new THREE.MeshLambertMaterial({ color: 0x222222 })
        );
        lid.position.set(bvx, 0.99, bvz);
        scene.add(lid);
      }

      // ── EAST-SIDE DIRT ACCESS TRACK ───────────────────────────────────────────────
      // Oct 2019 photos show a sandy track behind/east of the compound
      const eastTrack = sh(
        new THREE.Mesh(
          new THREE.PlaneGeometry(9, 120),
          new THREE.MeshLambertMaterial({ color: 0xb89e70 })
        ),
        false,
        true
      );
      eastTrack.rotation.x = -Math.PI / 2;
      eastTrack.position.set(-55, 0.005, -10);
      scene.add(eastTrack);

      // ── PARKED CARS on east dirt track (Oct 2019 photos show white Fiat Panda + silver car)
      function simpleCar(x: number, z: number, ry: number, bodyColor: number) {
        const cg = new THREE.Group();
        const bm = new THREE.MeshLambertMaterial({ color: bodyColor });
        // Lower body
        const bd = sh(new THREE.Mesh(new THREE.BoxGeometry(1.7, 0.72, 3.8), bm));
        bd.position.set(0, 0.36, 0);
        cg.add(bd);
        // Cabin/roof
        const cb = sh(new THREE.Mesh(new THREE.BoxGeometry(1.5, 0.6, 2.0), bm));
        cb.position.set(0, 0.98, -0.1);
        cg.add(cb);
        // Windows
        const wm = new THREE.MeshLambertMaterial({
          color: 0x88aacc,
          transparent: true,
          opacity: 0.55,
        });
        const win = new THREE.Mesh(new THREE.BoxGeometry(1.38, 0.48, 1.88), wm);
        win.position.set(0, 0.98, -0.1);
        cg.add(win);
        // Wheels (4)
        for (const [wx, wz] of [
          [-0.82, -1.2],
          [-0.82, 1.2],
          [0.82, -1.2],
          [0.82, 1.2],
        ]) {
          const wh = new THREE.Mesh(new THREE.CylinderGeometry(0.27, 0.27, 0.2, 10), M.iron);
          wh.rotation.z = Math.PI / 2;
          wh.position.set(wx, 0.27, wz);
          cg.add(wh);
        }
        cg.position.set(x, 0, z);
        cg.rotation.y = ry;
        scene.add(cg);
      }
      // White Fiat Panda (car 1 - east side)
      simpleCar(-85, 26, Math.PI * 0.5, 0xf0ede8);
      // Silver/grey car (car 2 - east side)
      simpleCar(-70, 30, Math.PI * 0.5, 0x9aa0a8);
      // White van parked on east side
      simpleCar(-60, 22, Math.PI * 0.5, 0xe8e8e0);

      // ── BAR / CAFETERIA STOREFRONT (between wings, dark glass with signs) ──────────
      // Viewer at x≈-93,z≈+22 looking north sees the bar at z≈15 area
      {
        const bfM = new THREE.MeshLambertMaterial({
          color: 0x080810,
          transparent: true,
          opacity: 0.9,
        });
        const bSignM = new THREE.MeshLambertMaterial({ color: 0x080808 });
        // Glass front panel (facing south = +z direction, so thin in Z)
        const bf = sh(new THREE.Mesh(new THREE.BoxGeometry(7, 3.0, 0.09), bfM));
        bf.position.set(-91, 1.55, 14.8);
        scene.add(bf);
        // Black sign board above glass
        const bs = new THREE.Mesh(new THREE.BoxGeometry(7, 0.75, 0.1), bSignM);
        bs.position.set(-91, 3.45, 14.8);
        scene.add(bs);
        // Dado base strip matching facade
        const bd = sh(new THREE.Mesh(new THREE.BoxGeometry(7.2, 1.0, 0.09), M.dado));
        bd.position.set(-91, 0.5, 14.8);
        scene.add(bd);
        // Door frame (centre opening)
        scene.add(bx(0.08, 3.0, 0.1, M.iron, -87.5, 1.5, 14.8));
        scene.add(bx(0.08, 3.0, 0.1, M.iron, -94.5, 1.5, 14.8));
      }

      // ── INTERIOR COURTYARD PAVING (concrete slabs between wings) ──────────────────
      {
        const pvM = new THREE.MeshLambertMaterial({ color: 0xc4bea8 });
        const cp = sh(new THREE.Mesh(new THREE.PlaneGeometry(32, 24), pvM), false, true);
        cp.rotation.x = -Math.PI / 2;
        cp.position.set(-90, 0.015, 17);
        scene.add(cp);
        // Paver joint lines (2 directions)
        for (let li = -14; li <= 14; li += 2.8) {
          const hl = new THREE.Mesh(
            new THREE.PlaneGeometry(32, 0.04),
            new THREE.MeshLambertMaterial({ color: 0xa89e8a })
          );
          hl.rotation.x = -Math.PI / 2;
          hl.position.set(-90, 0.02, 17 + li);
          scene.add(hl);
        }
      }

      // ── COLORFUL BUNTING across courtyard ─────────────────────────────────────────
      {
        const bunC = [0xee2222, 0x22aa22, 0x2288ee, 0xffcc00, 0xee22aa, 0xff7700];
        for (const bz of [16.5, 20]) {
          // two strings
          scene.add(bx(14, 0.04, 0.04, M.iron, -89, 4.2, bz)); // string wire
          for (let i = 0; i < 8; i++) {
            const c = bunC[i % bunC.length];
            const bg = new THREE.BufferGeometry();
            const px = -83 - i * 1.7,
              hlo = 3.7,
              hhi = 4.2;
            const v = new Float32Array([px, hlo, bz, px - 0.7, hhi, bz, px - 1.4, hlo, bz]);
            bg.setAttribute('position', new THREE.Float32BufferAttribute(v, 3));
            bg.computeVertexNormals();
            scene.add(
              new THREE.Mesh(
                bg,
                new THREE.MeshLambertMaterial({ color: c, side: THREE.DoubleSide })
              )
            );
          }
        }
      }

      // ── OUTDOOR FURNITURE in courtyard ────────────────────────────────────────────
      // Stacked black chairs
      const chairM = new THREE.MeshLambertMaterial({ color: 0x202028 });
      for (const [fx, fz] of [
        [-93, 16],
        [-93, 17.5],
        [-91.5, 16],
        [-91, 18.5],
        [-89.5, 15.8],
      ]) {
        const ch = sh(new THREE.Mesh(new THREE.BoxGeometry(0.65, 1.55, 0.52), chairM));
        ch.position.set(fx, 0.78, fz);
        scene.add(ch);
      }
      // Round tables
      const tabTop = new THREE.MeshLambertMaterial({ color: 0xb8b0a0 });
      for (const [tx, tz] of [
        [-95.5, 17],
        [-94, 19.5],
        [-90.5, 17],
      ]) {
        const t = new THREE.Mesh(new THREE.CylinderGeometry(0.5, 0.5, 0.07, 10), tabTop);
        t.position.set(tx, 0.82, tz);
        scene.add(t);
        scene.add(bx(0.055, 0.82, 0.055, M.iron, tx, 0.41, tz));
      }
      // Wine barrels (wooden)
      for (const [bvx, bvz] of [
        [-91.5, 15],
        [-90.8, 15],
      ]) {
        const b = sh(new THREE.Mesh(new THREE.CylinderGeometry(0.36, 0.32, 0.86, 10), M.wood));
        b.position.set(bvx, 0.43, bvz);
        scene.add(b);
      }

      // ── SOLAR PANELS on Wing A east slope ─────────────────────────────────────────
      // East slope: from ridge (x=-103) down to east edge (x≈-96.5); angle≈17°
      {
        const spM = new THREE.MeshLambertMaterial({ color: 0x1a2848 });
        const ang = Math.atan2(2.2, 7.05);
        for (const sz of [17, 23]) {
          const sp = sh(new THREE.Mesh(new THREE.BoxGeometry(0.07, 1.3, 2.1), spM));
          sp.rotation.z = -ang;
          sp.position.set(-99.2, 5.55, sz);
          scene.add(sp);
          // Silver frame around panel
          const fr = new THREE.Mesh(
            new THREE.BoxGeometry(0.08, 1.38, 2.18),
            new THREE.MeshLambertMaterial({ color: 0xaaaaaa })
          );
          fr.rotation.z = -ang;
          fr.position.set(-99.2, 5.55, sz);
          scene.add(fr);
        }
        // Solar thermal collector (white cylindrical tank on roof)
        const stc = new THREE.Mesh(
          new THREE.CylinderGeometry(0.28, 0.28, 1.6, 8),
          new THREE.MeshLambertMaterial({ color: 0xd4d0c4 })
        );
        stc.rotation.z = Math.PI / 2;
        stc.position.set(-101, 6.15, 25);
        scene.add(stc);
      }

      // ── SATELLITE DISH on Wing A ──────────────────────────────────────────────────
      {
        const dM = new THREE.MeshLambertMaterial({ color: 0xcccccc });
        const dish = new THREE.Mesh(
          new THREE.SphereGeometry(0.34, 8, 5, 0, Math.PI * 2, 0, Math.PI * 0.5),
          dM
        );
        dish.rotation.x = Math.PI * 0.55;
        dish.position.set(-101, 6.4, 20);
        scene.add(dish);
        addAt(
          new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 0.55, 6), M.iron),
          -101,
          6.1,
          20
        );
      }

      // ── PALM TREES along nave south (interior) face ───────────────────────────────
      // Oct 2019 photo 2 and Feb 2025 photo 4 show 3 fan palms along nave south wall
      // Nave south face: z = 12 + 10 = 22
      palm(-52, 23, 4.8);
      palm(-44, 23, 5.5);
      palm(-36, 23, 4.8);
      cypress(-48, 23, 7); // cypress between palms

      // ── CAMINO WAYMARKER post (yellow shell sign) ─────────────────────────────────
      scene.add(bx(0.12, 2, 0.12, M.wood, -121, 1, 8));
      scene.add(
        bx(0.8, 0.42, 0.07, new THREE.MeshLambertMaterial({ color: 0xf5e040 }), -120.6, 2.12, 8)
      );

      const grid = new THREE.GridHelper(220, 44, 0x2b2b2b, 0x2b2b2b);
      grid.position.y = 0.03;
      grid.visible = false;
      scene.add(grid);
      const axes = new THREE.AxesHelper(18);
      axes.visible = false;
      scene.add(axes);
      window.addEventListener('keydown', (e) => {
        if (e.key.toLowerCase() !== 'm') return;
        grid.visible = !grid.visible;
        axes.visible = grid.visible;
      });

      {
        const pts = PARCEL.map((pair: number[]) => {
          const v = sv(pair[0], pair[1]);
          return new THREE.Vector3(v.x, 0.08, -v.y);
        });
        const g = new THREE.BufferGeometry().setFromPoints(pts.concat([pts[0]]));
        const m = new THREE.LineBasicMaterial({ color: 0x00ab39 });
        const ln = new THREE.Line(g, m);
        scene.add(ln);
      }

      const pilgrimCurve = new THREE.CatmullRomCurve3(
        [
          new THREE.Vector3(-140, 0, 40),
          new THREE.Vector3(-132, 0, 18),
          new THREE.Vector3(-126, 0, 8),
          new THREE.Vector3(-114, 0, 12),
          new THREE.Vector3(-111, 0, 20),
          new THREE.Vector3(-103, 0, 20),
          new THREE.Vector3(-88, 0, 20),
          new THREE.Vector3(-78, 0, 18),
          new THREE.Vector3(-58, 0, 18),
          new THREE.Vector3(-40, 0, 18),
          new THREE.Vector3(-30, 0, 26),
          new THREE.Vector3(-52, 0, 34),
          new THREE.Vector3(-96, 0, 34),
        ],
        true,
        'catmullrom',
        0.22
      );

      const pilgrims: any[] = [];
      const makePilgrim = (seed: number) => {
        const g = new THREE.Group();
        const body = new THREE.Mesh(
          new THREE.CapsuleGeometry(0.18, 0.55, 6, 10),
          new THREE.MeshLambertMaterial({ color: 0x3c3c3c })
        );
        body.position.y = 0.65;
        const head = new THREE.Mesh(
          new THREE.SphereGeometry(0.16, 12, 12),
          new THREE.MeshLambertMaterial({ color: 0xf0d2b0 })
        );
        head.position.y = 1.22;
        const pack = new THREE.Mesh(
          new THREE.BoxGeometry(0.22, 0.28, 0.18),
          new THREE.MeshLambertMaterial({ color: 0x2a3a50 })
        );
        pack.position.set(0, 0.85, -0.22);
        g.add(body, head, pack);
        g.userData.t = seed;
        g.userData.speed = 0.015 + (seed % 5) * 0.003;
        scene.add(g);
        return g;
      };
      for (let i = 0; i < 7; i++) {
        const p = makePilgrim(i / 7);
        pilgrims.push(p);
      }

      // ── Remove loader ─────────────────────────────────────────────────────────────
      const ldEl = document.getElementById('ld');
      if (ldEl) ldEl.style.opacity = '0';
      if (ldEl) setTimeout(() => ldEl.remove(), 700);

      // ── Resize ─────────────────────────────────────────────────────────────────
      window.addEventListener('resize', () => {
        const w = innerWidth,
          h = innerHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      });

      // ── Render loop ───────────────────────────────────────────────────────────
      const clock = new THREE.Clock();
      let paused = false;
      window.addEventListener('message', (e) => {
        const d = e?.data;
        if (d?.type !== 'hostel3d:pause') return;
        paused = !!d.paused;
      });
      (function loop() {
        requestAnimationFrame(loop);
        const dt = Math.min(0.05, clock.getDelta());
        const t = clock.getElapsedTime();

        if (paused) return;

        for (const g of windy) {
          const w = g.userData.wind;
          const a = Math.sin(t * 0.55 + w.phase) * 0.06 * w.s;
          g.rotation.y = a;
          g.rotation.z = Math.sin(t * 0.7 + w.phase * 0.9) * 0.02 * w.s;
        }

        for (const g of pilgrims) {
          g.userData.t = (g.userData.t + dt * g.userData.speed) % 1;
          const p = pilgrimCurve.getPointAt(g.userData.t);
          const p2 = pilgrimCurve.getPointAt((g.userData.t + 0.006) % 1);
          g.position.copy(p);
          g.lookAt(p2.x, p2.y + 0.6, p2.z);
        }

        for (const c of cars) {
          c.position.z += c.userData.dir * c.userData.speed * dt;
          if (c.position.z > 260) c.position.z = -260;
          if (c.position.z < -260) c.position.z = 260;
        }

        for (const b of storks) {
          b.userData.t = (b.userData.t + dt * 0.02) % 1;
          const a = b.userData.t * Math.PI * 2;
          b.position.set(-85 + Math.cos(a) * 120, 52 + Math.sin(a * 0.7) * 6, 18 + Math.sin(a) * 110);
          b.rotation.y = -a + Math.PI / 2;
          const flap = Math.sin(t * 4.8 + b.userData.phase) * 0.55;
          b.userData.w1.rotation.x = flap;
          b.userData.w2.rotation.x = -flap;
        }

        for (const f of bunting) {
          const ph = f.userData.phase;
          f.rotation.z = Math.sin(t * 2.6 + ph) * 0.24;
          f.rotation.x = Math.cos(t * 2.1 + ph * 0.8) * 0.18;
        }

        controls.update();
        renderer.render(scene, camera);
      })();
    </script>
  </body>
</html>
