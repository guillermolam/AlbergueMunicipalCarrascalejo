---
import Layout from '../layouts/Layout.astro';

const clerkUser  = await Astro.locals.currentUser();
const firstName  = clerkUser?.firstName  ?? '';
const lastName   = clerkUser?.lastName   ?? '';
const fullName   = [firstName, lastName].filter(Boolean).join(' ') || 'Peregrino';
const email      = clerkUser?.emailAddresses?.[0]?.emailAddress ?? '';
const avatarUrl  = clerkUser?.imageUrl ?? '';
const createdAt  = clerkUser?.createdAt ? new Date(clerkUser.createdAt) : null;
const memberYear = createdAt?.getFullYear()?.toString() ?? '';
const memberSince = createdAt
  ? createdAt.toLocaleDateString('es-ES', { month: 'long', year: 'numeric' })
  : '';
const socialAccounts: { provider: string; label: string; icon: string }[] =
  (clerkUser?.externalAccounts ?? []).map((ea: any) => {
    const p = String(ea.provider ?? '').toLowerCase();
    const labels: Record<string, { label: string; icon: string }> = {
      google:   { label: 'Google',   icon: 'G' },
      github:   { label: 'GitHub',   icon: '⌥' },
      apple:    { label: 'Apple',    icon: '' },
      facebook: { label: 'Facebook', icon: 'f' },
      twitter:  { label: 'Twitter',  icon: '𝕏' },
      microsoft:{ label: 'Microsoft',icon: 'M' },
    };
    return { provider: p, ...(labels[p] ?? { label: p, icon: '●' }) };
  });

const meta: Record<string, any> = (clerkUser?.unsafeMetadata?.pilgrimProfile as any) ?? {};
const initStages: string[] = meta.camino?.stages ?? [];
const STAGE_KM_LIST: Record<string, number> = {
  s01:20,s02:25,s03:22,s04:18,s05:26,s06:19,s07:22,s08:16,
  s09:23,s10:24,s11:12,s12:22,s13:21,s14:8, s15:33,s16:14,
  s17:26,s18:24,s19:20,s20:18,s21:22,s22:26,s23:30,s24:27,
  s25:22,s26:22,s27:25,s28:29,s29:30,s30:21,s31:32,s32:24,
  s33:29,s34:21,s35:18,s36:22,s37:25,s38:29,s39:19,s40:20,
};
const initKm  = initStages.reduce((a, id) => a + (STAGE_KM_LIST[id] ?? 0), 0);
const initPct = Math.min(100, Math.round((initStages.length / 40) * 100));

const STAGES = [
  { id:'s01', from:'Sevilla',                      to:'Guillena',                       km:20 },
  { id:'s02', from:'Guillena',                     to:'Castilblanco de los Arroyos',    km:25 },
  { id:'s03', from:'Castilblanco',                 to:'Almadén de la Plata',            km:22 },
  { id:'s04', from:'Almadén de la Plata',          to:'El Real de la Jara',             km:18 },
  { id:'s05', from:'El Real de la Jara',           to:'Monesterio',                     km:26 },
  { id:'s06', from:'Monesterio',                   to:'Fuente de Cantos',               km:19 },
  { id:'s07', from:'Fuente de Cantos',             to:'Zafra',                          km:22 },
  { id:'s08', from:'Zafra',                        to:'Los Santos de Maimona',          km:16 },
  { id:'s09', from:'Los Santos de Maimona',        to:'Villafranca de los Barros',      km:23 },
  { id:'s10', from:'Villafranca de los Barros',    to:'Torremejía',                     km:24 },
  { id:'s11', from:'Torremejía',                   to:'Mérida',                         km:12 },
  { id:'s12', from:'Mérida',                       to:'Aljucén',                        km:22 },
  { id:'s13', from:'Aljucén',                      to:'El Carrascalejo',                km:21, highlight:true },
  { id:'s14', from:'El Carrascalejo',              to:'Alcuéscar',                      km:8,  highlight:true },
  { id:'s15', from:'Alcuéscar',                    to:'Cáceres',                        km:33 },
  { id:'s16', from:'Cáceres',                      to:'Casar de Cáceres',               km:14 },
  { id:'s17', from:'Casar de Cáceres',             to:'Grimaldo',                       km:26 },
  { id:'s18', from:'Grimaldo',                     to:'Carcaboso / Caparra',            km:24 },
  { id:'s19', from:'Carcaboso',                    to:'Aldeanueva del Camino',          km:20 },
  { id:'s20', from:'Aldeanueva del Camino',        to:'Baños de Montemayor',            km:18 },
  { id:'s21', from:'Baños de Montemayor',          to:'Calzada de Béjar',               km:22 },
  { id:'s22', from:'Calzada de Béjar',             to:'Salamanca',                      km:26 },
  { id:'s23', from:'Salamanca',                    to:'El Cubo de la Tierra del Vino',  km:30 },
  { id:'s24', from:'El Cubo de la Tierra del Vino', to:'Zamora',                        km:27 },
  { id:'s25', from:'Zamora',                       to:'Montamarta',                     km:22 },
  { id:'s26', from:'Montamarta',                   to:'Granja de Moreruela',            km:22 },
  { id:'s27', from:'Granja de Moreruela',          to:'Benavente',                      km:25 },
  { id:'s28', from:'Benavente',                    to:'La Bañeza',                      km:29 },
  { id:'s29', from:'La Bañeza',                    to:'Astorga',                        km:30 },
  { id:'s30', from:'Astorga',                      to:'Rabanal del Camino',             km:21 },
  { id:'s31', from:'Rabanal del Camino',           to:'Ponferrada',                     km:32 },
  { id:'s32', from:'Ponferrada',                   to:'Villafranca del Bierzo',         km:24 },
  { id:'s33', from:'Villafranca del Bierzo',       to:'O Cebreiro',                     km:29 },
  { id:'s34', from:'O Cebreiro',                   to:'Triacastela',                    km:21 },
  { id:'s35', from:'Triacastela',                  to:'Sarria',                         km:18 },
  { id:'s36', from:'Sarria',                       to:'Portomarín',                     km:22 },
  { id:'s37', from:'Portomarín',                   to:'Palas de Rei',                   km:25 },
  { id:'s38', from:'Palas de Rei',                 to:'Arzúa',                          km:29 },
  { id:'s39', from:'Arzúa',                        to:'O Pedrouzo',                     km:19 },
  { id:'s40', from:'O Pedrouzo',                   to:'Santiago de Compostela',         km:20 },
];

const BADGES = [
  { id:'b_first',        glyph:'I',   name:'Primera Etapa',       desc:'Completa tu primera etapa',              auto:true,  level:'Bronce' },
  { id:'b_5stages',      glyph:'V',   name:'5 Etapas',            desc:'Completa 5 etapas del camino',           auto:true,  level:'Plata'  },
  { id:'b_10stages',     glyph:'X',   name:'10 Etapas',           desc:'Completa 10 etapas del camino',          auto:true,  level:'Plata'  },
  { id:'b_halfway',      glyph:'½',   name:'Mitad del Camino',    desc:'Supera la etapa 20',                     auto:true,  level:'Oro'    },
  { id:'b_carrascalejo', glyph:'C',   name:'El Carrascalejo',     desc:'Pasa por el Albergue Municipal',         auto:true,  level:'Oro'    },
  { id:'b_100km',        glyph:'C',   name:'100 km',              desc:'Camina más de 100 km en total',          auto:false, level:'Bronce' },
  { id:'b_rain',         glyph:'~',   name:'Peregrino Mojado',    desc:'Sal a andar bajo la lluvia',             auto:false, level:'Bronce' },
  { id:'b_stamps5',      glyph:'5S',  name:'5 Sellos',            desc:'Colecciona 5 sellos en tu credencial',   auto:false, level:'Plata'  },
  { id:'b_stamps10',     glyph:'10S', name:'10 Sellos',           desc:'Colecciona 10 sellos',                   auto:false, level:'Oro'    },
  { id:'b_social',       glyph:'∞',   name:'Espíritu Peregrino',  desc:'Comparte mesa con otros peregrinos',     auto:false, level:'Plata'  },
  { id:'b_dawn',         glyph:'↑',   name:'Madrugador',          desc:'Sal antes de las 6:00 h',                auto:false, level:'Bronce' },
  { id:'b_complete',     glyph:'★',   name:'Buen Camino',         desc:'Llega a Santiago de Compostela',         auto:true,  level:'Legendario' },
];
---

<Layout title="Mi Perfil — Albergue Municipal de El Carrascalejo">

  <!-- Shared sketchy filter -->
  <svg style="position:absolute;width:0;height:0" aria-hidden="true">
    <defs>
      <filter id="sk">
        <feTurbulence type="fractalNoise" baseFrequency="0.025" numOctaves="3" result="n"/>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="2.5"/>
      </filter>
    </defs>
  </svg>

  <!-- Back -->
  <div class="topbar">
    <a href="/dashboard" class="back-link">← Panel</a>
    <input type="file" id="avatarInput" accept="image/*" style="display:none" />
  </div>

  <div class="page-wrap">

    <!-- ══════════════════════════════════════════════════════════════════════
         LEFT — THE POKÉMON-STYLE PROFILE CARD
    ═══════════════════════════════════════════════════════════════════════ -->
    <div class="card-col">

      <!-- Profile trading card -->
      <div class="poke-card" id="pokeCard">
        <!-- Card chrome border -->
        <div class="card-inner">

          <!-- Header strip -->
          <div class="card-header">
            <span class="card-type-badge">PEREGRINO</span>
            <span class="card-hp">
              <span class="card-hp-label">KM</span>
              <span class="card-hp-val" id="cardKmVal">{initKm}</span>
            </span>
          </div>

          <!-- Avatar art frame -->
          <div class="card-art" id="cardArtZone" role="button" tabindex="0" aria-label="Cambiar foto de perfil">
            <div class="card-art-frame">
              <div class="card-art-inner">
                {avatarUrl
                  ? <img src={avatarUrl} alt="Foto de perfil" class="card-avatar-img" id="cardAvatar" />
                  : <span class="card-avatar-initials" id="cardInitials">
                      {(firstName[0] ?? 'P').toUpperCase()}{(lastName[0] ?? '').toUpperCase()}
                    </span>
                }
              </div>
              <div class="card-art-overlay" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4-4.64 4.36A9 9 0 0 1 3.51 15"/></svg>
                Cambiar
              </div>
            </div>
          </div>

          <!-- Card name (read-only from Clerk) -->
          <div class="card-name-row">
            <div class="card-name" id="cardName">{fullName}</div>
          </div>

          <!-- Route label -->
          <div class="card-route" id="cardRoute">
            <span class="route-dot"></span>
            <span id="cardRouteName">{meta.camino?.route === 'frances' ? 'Camino Francés' : 'Vía de la Plata'}</span>
          </div>

          <!-- Stat bars — Pokémon style -->
          <div class="card-stats">
            <div class="stat-row">
              <span class="stat-label">Etapas</span>
              <div class="stat-track">
                <div class="stat-fill" id="statFillStages" style={`width:${initPct}%`}></div>
              </div>
              <span class="stat-num" id="statNumStages">{initStages.length}<small>/40</small></span>
            </div>
            <div class="stat-row">
              <span class="stat-label">Km</span>
              <div class="stat-track">
                <div class="stat-fill" id="statFillKm" style={`width:${Math.min(100, Math.round((initKm/910)*100))}%`}></div>
              </div>
              <span class="stat-num" id="statNumKm">{initKm}<small>/910</small></span>
            </div>
            <div class="stat-row">
              <span class="stat-label">Logros</span>
              <div class="stat-track">
                <div class="stat-fill" id="statFillBadges" style="width:0%"></div>
              </div>
              <span class="stat-num" id="statNumBadges">0<small>/12</small></span>
            </div>
          </div>

          <!-- Card footer -->
          <div class="card-footer">
            <span class="card-footer-text">{email}</span>
            {memberYear && <span class="card-footer-year">{memberYear}</span>}
          </div>
        </div><!-- /.card-inner -->
      </div><!-- /.poke-card -->

      <!-- Coat-of-arms badge collection (under poke-card) -->
      <div class="coa-badges-section">
        <div class="panel-head" style="margin-bottom:0.6rem;margin-top:0.85rem">
          <span class="panel-title">Logros</span>
          <span class="badge-count-pill" id="badgeCountPill">0/16</span>
        </div>
        <div class="coa-badges-wrap" id="coaBadgesWrap">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- Social logins + member since -->
      <div class="social-logins-row">
        {memberSince && (
          <span class="social-chip">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Miembro desde {memberSince}
          </span>
        )}
        {socialAccounts.map(sa => (
          <span class="social-chip social-chip--connected" title={`Conectado con ${sa.label}`}>
            <span class="social-chip-icon">{sa.icon}</span>
            {sa.label}
          </span>
        ))}
      </div>

    </div><!-- /card-col -->

    <!-- ══════════════════════════════════════════════════════════════════════
         RIGHT — INFO PANELS + CAMINO + BADGES
    ═══════════════════════════════════════════════════════════════════════ -->
    <div class="right-col">

      <!-- ─── INFO PANELS (above camino) ─── -->

      <!-- Personal Profile Panel -->
      <div class="info-panel ip-glass">
        <div class="panel-head">
          <div class="panel-head-left">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--g)" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span class="panel-title">Perfil personal</span>
          </div>
          <button class="panel-toggle" data-target="panelPersonalForm" aria-expanded="false">Editar</button>
        </div>
        <div class="panel-display" id="panelPersonalDisplay">
          <div class="disp-pills" id="dispPersonal">
            <span class="disp-empty">Sin información personal</span>
          </div>
        </div>
        <div class="panel-form" id="panelPersonalForm" hidden>
          <div class="form-grid">
            <div class="field field-full">
              <label>Teléfono</label>
              <div class="phone-outer-p">
                <div class="phone-wrap-p">
                  <button type="button" class="phone-prefix-p" id="p-phone-prefix" aria-haspopup="listbox" aria-expanded="false">
                    <span id="p-phone-flag">🇪🇸</span>
                    <span class="p-prefix-code" id="p-phone-dial">+34</span>
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                  </button>
                  <input type="tel" id="fPhone" placeholder="612 345 678" class="phone-input-p" inputmode="numeric" />
                  <input type="hidden" id="fPhoneCC" value="ES" />
                </div>
                <div id="p-phone-drop" class="phone-drop-p" role="listbox">
                  <input type="text" class="phone-drop-search-p" placeholder="País o +código…" autocomplete="off" />
                  <ul class="phone-drop-list-p"></ul>
                </div>
              </div>
            </div>
            <div class="field field-full">
              <label>Dirección de casa</label>
              <div class="addr-outer">
                <input type="text" id="fAddress" placeholder="Calle, ciudad, país…" autocomplete="off" aria-autocomplete="list" aria-haspopup="listbox" />
                <ul id="addrDrop" class="addr-drop" role="listbox" hidden></ul>
              </div>
            </div>
            <div class="field field-full"><label>Sobre mí</label><textarea id="fBio" rows="2" placeholder="Cuéntanos algo…"></textarea></div>
          </div>
          <div class="form-actions">
            <button class="sketchy-btn" data-save="personal">Guardar</button>
            <button class="sketchy-btn-ghost" data-cancel="personal">Cancelar</button>
          </div>
        </div>
      </div>

      <!-- Emergency Contact Panel -->
      <div class="info-panel ip-glass">
        <div class="panel-head">
          <div class="panel-head-left">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--g)" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.62 3.32 2 2 0 0 1 3.62 1.13h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.73a16 16 0 0 0 6 6l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16z"/></svg>
            <span class="panel-title">Contacto de emergencia</span>
          </div>
          <button class="panel-toggle" data-target="panelEmForm" aria-expanded="false">Editar</button>
        </div>
        <div class="panel-display" id="panelEmDisplay">
          <div class="disp-pills" id="dispEmergency">
            <span class="disp-empty">Sin contacto de emergencia</span>
          </div>
        </div>
        <div class="panel-form" id="panelEmForm" hidden>
          <div id="emValidationMsg" class="validation-msg" hidden></div>
          <div class="form-grid">
            <div class="field"><label>Nombre *</label><input type="text" id="emName" placeholder="Nombre completo" required /></div>
            <div class="field"><label>Relación *</label>
              <select id="emRelation">
                <option value="">— elige —</option>
                <option value="pareja">Pareja</option><option value="padre_madre">Padre/Madre</option>
                <option value="hijo_a">Hijo/a</option><option value="hermano_a">Hermano/a</option>
                <option value="amigo_a">Amigo/a</option><option value="otro">Otro</option>
              </select>
            </div>
            <div class="field field-full">
              <label>Teléfono contacto *</label>
              <div class="phone-outer-p">
                <div class="phone-wrap-p">
                  <button type="button" class="phone-prefix-p" id="em-phone-prefix" aria-haspopup="listbox" aria-expanded="false">
                    <span id="em-phone-flag">🇪🇸</span>
                    <span class="p-prefix-code" id="em-phone-dial">+34</span>
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                  </button>
                  <input type="tel" id="emPhoneNum" placeholder="612 345 678" class="phone-input-p" inputmode="numeric" />
                  <input type="hidden" id="emPhoneCC" value="ES" />
                </div>
                <div id="em-phone-drop" class="phone-drop-p" role="listbox">
                  <input type="text" class="phone-drop-search-p" placeholder="País o +código…" autocomplete="off" />
                  <ul class="phone-drop-list-p"></ul>
                </div>
              </div>
            </div>
            <div class="field field-full"><label>Email contacto *</label><input type="email" id="emEmail" placeholder="email@ejemplo.com" required /></div>
          </div>
          <div class="form-actions">
            <button class="sketchy-btn" data-save="emergency">Guardar</button>
            <button class="sketchy-btn-ghost" data-cancel="emergency">Cancelar</button>
          </div>
        </div>
      </div>

      <!-- Vehicles Panel -->
      <div class="info-panel ip-glass">
        <div class="panel-head">
          <div class="panel-head-left">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--g)" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h3l3 3v5h-6V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <span class="panel-title">Vehículos</span>
          </div>
          <button class="panel-toggle" data-target="panelVehicleForm" aria-expanded="false">+ Añadir</button>
        </div>
        <div class="gear-chips-wrap" id="vehicleDisplay">
          <span class="disp-empty">Sin vehículos registrados</span>
        </div>
        <div class="panel-form" id="panelVehicleForm" hidden>
          <div id="vehicleValidationMsg" class="validation-msg" hidden></div>
          <div class="form-grid">
            <div class="field"><label>Tipo *</label>
              <select id="vType"><option value="">— elige —</option><option value="coche">Coche</option><option value="bicicleta">Bicicleta</option><option value="moto">Moto</option><option value="furgoneta">Furgoneta</option></select>
            </div>
            <div class="field"><label>Matrícula *</label><input type="text" id="vPlate" placeholder="1234 ABC" required /></div>
            <div class="field"><label>Modelo</label><input type="text" id="vModel" placeholder="Seat Ibiza" /></div>
            <div class="field"><label>Color</label><input type="text" id="vColor" placeholder="Rojo" /></div>
          </div>
          <div class="form-actions">
            <button class="sketchy-btn" id="addVehicleBtn">Añadir vehículo</button>
            <button class="sketchy-btn-ghost" data-cancel="gear">Cancelar</button>
          </div>
        </div>
      </div>

      <!-- Belongings Panel -->
      <div class="info-panel ip-glass">
        <div class="panel-head">
          <div class="panel-head-left">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--g)" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            <span class="panel-title">Equipaje &amp; Taquilla</span>
          </div>
          <button class="panel-toggle" data-target="panelBelongingsForm" aria-expanded="false">+ Añadir</button>
        </div>
        <div class="gear-chips-wrap" id="belongingsDisplay">
          <span class="disp-empty">Sin artículos registrados</span>
        </div>
        <div class="panel-form" id="panelBelongingsForm" hidden>
          <div class="gear-sub-tabs" style="margin-bottom:0.75rem">
            <button class="gear-sub-tab active" data-sub="gItem">Artículo</button>
            <button class="gear-sub-tab" data-sub="gLocker">Taquilla</button>
          </div>
          <div id="gItem">
            <div id="itemValidationMsg" class="validation-msg" hidden></div>
            <div class="form-grid">
              <div class="field"><label>Categoría *</label>
                <select id="bCategory"><option value="">— elige —</option><option value="mochila">Mochila</option><option value="medicamentos">Medicamentos</option><option value="electronica">Electrónica</option><option value="documentacion">Documentación</option><option value="ropa">Ropa</option><option value="valor">Objetos de valor</option><option value="llaves">Llaves</option><option value="otro">Otro</option></select>
              </div>
              <div class="field"><label>Cantidad</label><input type="number" id="bCount" min="1" max="100" value="1" style="max-width:80px" /></div>
              <div class="field field-full"><label>Artículo *</label><input type="text" id="bName" placeholder="Pasaporte" required /></div>
              <div class="field field-full"><label>Notas</label><input type="text" id="bNotes" placeholder="Descripción…" /></div>
            </div>
            <div class="form-actions"><button class="sketchy-btn" id="addItemBtn">Añadir artículo</button></div>
          </div>
          <div id="gLocker" hidden>
            <div class="field" style="max-width:180px"><label>Número de taquilla</label><input type="text" id="lockerNum" placeholder="12" /></div>
            <div class="form-actions"><button class="sketchy-btn" data-save="locker">Guardar</button></div>
          </div>
        </div>
      </div>

      <!-- Pets Panel -->
      <div class="info-panel ip-glass">
        <div class="panel-head">
          <div class="panel-head-left">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--g)" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M10 5.172C10 3.782 8.423 2.679 6.5 3c-2.823.47-4.113 6.006-4 7 .08.703 1.725 1.722 3.656 1 1.261-.472 1.96-1.45 2.344-2.5"/><path d="M14.267 5.172c0-1.39 1.577-2.493 3.5-2.172 2.823.47 4.113 6.006 4 7-.08.703-1.725 1.722-3.656 1-1.261-.472-1.96-1.45-2.344-2.5"/><path d="M8 14v.5"/><path d="M16 14v.5"/><path d="M11.25 16.25h1.5L12 17l-.75-.75z"/><path d="M4.42 11.247A13.152 13.152 0 0 0 4 14.556C4 18.728 7.582 21 12 21s8-2.272 8-6.444c0-1.061-.162-2.2-.493-3.309m-9.243-6.082A8.801 8.801 0 0 1 12 5c.78 0 1.5.108 2.161.306"/></svg>
            <span class="panel-title">Mascotas</span>
          </div>
          <button class="panel-toggle" data-target="panelPetsForm" aria-expanded="false">+ Añadir</button>
        </div>
        <div class="gear-chips-wrap" id="petsDisplay">
          <span class="disp-empty">Sin mascotas registradas</span>
        </div>
        <div class="panel-form" id="panelPetsForm" hidden>
          <div id="petValidationMsg" class="validation-msg" hidden></div>
          <div class="form-grid">
            <div class="field"><label>Nombre *</label><input type="text" id="petName" placeholder="Luna" required /></div>
            <div class="field"><label>Especie *</label>
              <select id="petSpecies"><option value="">— elige —</option><option value="perro">Perro</option><option value="gato">Gato</option><option value="ave">Ave</option><option value="otro">Otro</option></select>
            </div>
            <div class="field"><label>Raza</label><input type="text" id="petBreed" placeholder="Labrador" /></div>
            <div class="field"><label>Chip / ID</label><input type="text" id="petChip" placeholder="Nº chip" /></div>
          </div>
          <div class="form-actions">
            <button class="sketchy-btn" id="addPetBtn">Añadir mascota</button>
            <button class="sketchy-btn-ghost" data-cancel="pet">Cancelar</button>
          </div>
        </div>
      </div>

      <!-- Camino stages panel -->
      <div class="camino-panel">
        <div class="panel-head">
          <span class="panel-title">El Camino — Etapas</span>
          <span class="stage-count-pill" id="stageCountPill">{initStages.length}/40</span>
        </div>
        <div class="camino-route-row">
          <select id="cRoute" class="route-select">
            <option value="vdlp">Vía de la Plata</option>
            <option value="frances">Camino Francés</option>
            <option value="norte">Camino del Norte</option>
            <option value="portugues">Camino Portugués</option>
            <option value="sana">Vía de la Plata + Sanabrés</option>
            <option value="otro">Otro</option>
          </select>
          <input type="date" id="cStart" class="date-input" title="Fecha de inicio" />
        </div>
        <div class="stage-list" id="stageList">
          {STAGES.map((s) => (
            <label class:list={['stage-row', s.highlight ? 'stage-hl' : '']} data-id={s.id}>
              <input type="checkbox" class="stage-cb" value={s.id} checked={initStages.includes(s.id)} />
              <span class="stage-mark"></span>
              <span class="stage-name">{s.from} → {s.to}</span>
              <span class="stage-km-tag">{s.km} km</span>
            </label>
          ))}
        </div>
        <div class="camino-actions">
          <button class="sketchy-btn" id="saveCaminoBtn">Guardar progreso</button>
        </div>
      </div>

      <!-- Badge count pill for stats -->
      <span class="badge-count-pill" id="badgeCountPillRight" style="display:none">0/16</span>

    </div><!-- /right-col -->
  </div><!-- /page-wrap -->

  <!-- Stage detail modal -->
  <div id="stageModal" class="stage-modal-overlay" hidden aria-modal="true" role="dialog">
    <div class="stage-modal" id="stageModalCard">
      <div class="stage-modal-head">
        <span class="stage-modal-title" id="stageModalTitle">Etapa</span>
        <button class="stage-modal-close" id="stageModalClose" aria-label="Cerrar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="stage-modal-body">
        <div class="sm-field-row">
          <div class="sm-field">
            <label class="sm-label">Fecha inicio</label>
            <input type="date" id="smStartDate" class="sm-input" />
          </div>
          <div class="sm-field">
            <label class="sm-label">Hora inicio</label>
            <input type="time" id="smStartTime" class="sm-input" value="06:00" />
          </div>
        </div>
        <div class="sm-field-row">
          <div class="sm-field">
            <label class="sm-label">Fecha llegada</label>
            <input type="date" id="smEndDate" class="sm-input" />
          </div>
          <div class="sm-field">
            <label class="sm-label">Hora llegada</label>
            <input type="time" id="smEndTime" class="sm-input" value="14:00" />
          </div>
        </div>
        <div class="sm-field">
          <label class="sm-label">Transporte</label>
          <select id="smTransport" class="sm-input">
            <option value="walking">🚶 A pie</option>
            <option value="bike">🚲 Bicicleta</option>
            <option value="horse">🐴 Caballo</option>
            <option value="bus">🚌 Autobús</option>
            <option value="car">🚗 Coche</option>
            <option value="taxi">🚕 Taxi</option>
            <option value="other">✦ Otro</option>
          </select>
        </div>
        <div class="sm-field">
          <label class="sm-label">Notas</label>
          <textarea id="smNotes" class="sm-input" rows="2" placeholder="Comentarios de la etapa…"></textarea>
        </div>
      </div>
      <div class="stage-modal-foot">
        <button class="sketchy-btn" id="stageModalSave">Guardar etapa</button>
        <button class="sketchy-btn-ghost" id="stageModalCancel">Cancelar</button>
      </div>
    </div>
  </div>

  <div id="profileData" data-user-email={email} hidden></div>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

</Layout>

<style>
  /* ── Tokens ── */
  :root {
    --g:   #00AB39;
    --gd:  #1a3a2e;
    --gm:  #2d5a3d;
    --gl:  #e8f5e9;
    --parchment: #faf7f0;
    --ink: #1a2a1a;
    --font-hand: 'Patrick Hand', cursive;
    --font-sketch: 'Cabin Sketch', cursive;
  }

  /* ── Page ── */
  .topbar {
    background: var(--gd);
    padding: 0.75rem 1.25rem;
  }
  .back-link {
    font-family: var(--font-hand);
    font-size: 0.9rem;
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: #fff; }

  .page-wrap {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 1.25rem;
    max-width: 1080px;
    margin: 1.25rem auto 4rem;
    padding: 0 1rem;
    align-items: start;
  }

  /* ══════════════════════════════════════════════════════
     POKÉMON-STYLE PROFILE CARD
  ═══════════════════════════════════════════════════════ */
  .poke-card {
    background: var(--parchment);
    border: 4px solid var(--gd);
    border-radius: 18px;
    padding: 6px;
    box-shadow:
      0 2px 0 0 rgba(0,0,0,0.18),
      4px 6px 24px rgba(0,0,0,0.14),
      inset 0 1px 0 rgba(255,255,255,0.7);
    filter: url(#sk);
    position: relative;
  }
  .card-inner {
    border: 2px solid rgba(0,171,57,0.35);
    border-radius: 13px;
    overflow: hidden;
    background: var(--parchment);
    filter: none; /* reset nested filter */
  }

  /* Card header strip */
  .card-header {
    background: linear-gradient(135deg, var(--gd) 0%, var(--gm) 100%);
    padding: 0.5rem 0.85rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .card-type-badge {
    font-family: var(--font-sketch);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: rgba(255,255,255,0.9);
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 4px;
    padding: 0.1rem 0.5rem;
  }
  .card-hp {
    font-family: var(--font-hand);
    font-size: 0.85rem;
    color: rgba(255,255,255,0.85);
    display: flex;
    align-items: baseline;
    gap: 0.2rem;
  }
  .card-hp-label { font-size: 0.62rem; opacity: 0.7; text-transform: uppercase; letter-spacing: 0.1em; }
  .card-hp-val { font-family: var(--font-sketch); font-size: 1.1rem; color: #fff; }

  /* Art frame */
  .card-art {
    padding: 0.75rem 0.85rem 0.5rem;
    cursor: pointer;
  }
  .card-art-frame {
    position: relative;
    border: 2px solid var(--gd);
    border-radius: 10px;
    overflow: hidden;
    background: linear-gradient(160deg, #d4edd9 0%, #b8dfc0 50%, #c5e8ca 100%);
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-art-inner {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-avatar-initials {
    font-family: var(--font-sketch);
    font-size: 4rem;
    color: var(--gd);
    opacity: 0.6;
    user-select: none;
  }
  .card-art-overlay {
    position: absolute;
    inset: 0;
    background: rgba(26,58,46,0.55);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    color: #fff;
    font-family: var(--font-hand);
    font-size: 0.85rem;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .card-art:hover .card-art-overlay { opacity: 1; }

  /* Name row */
  .card-name-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.85rem 0.1rem;
    gap: 0.5rem;
  }
  .card-name {
    font-family: var(--font-sketch);
    font-size: 1.25rem;
    color: var(--ink);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  /* Route label */
  .card-route {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.85rem 0.5rem;
    font-family: var(--font-hand);
    font-size: 0.82rem;
    color: var(--gm);
  }
  .route-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--g);
    flex-shrink: 0;
  }

  /* Stat bars */
  .card-stats {
    padding: 0.5rem 0.85rem 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px dashed rgba(0,171,57,0.25);
  }
  .stat-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .stat-label {
    font-family: var(--font-hand);
    font-size: 0.72rem;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    width: 46px;
    flex-shrink: 0;
  }
  .stat-track {
    flex: 1;
    height: 7px;
    background: rgba(0,0,0,0.07);
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(0,171,57,0.15);
  }
  .stat-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--g), #52c778);
    border-radius: 6px;
    transition: width 0.7s cubic-bezier(.4,0,.2,1);
    min-width: 0;
  }
  .stat-num {
    font-family: var(--font-hand);
    font-size: 0.82rem;
    color: var(--gd);
    font-weight: 700;
    min-width: 52px;
    text-align: right;
  }
  .stat-num small { font-size: 0.62rem; color: #aaa; font-weight: 400; }

  /* Card footer */
  .card-footer {
    background: rgba(0,171,57,0.06);
    border-top: 1px dashed rgba(0,171,57,0.25);
    padding: 0.4rem 0.85rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .card-footer-text { font-family: var(--font-hand); font-size: 0.72rem; color: #999; }
  .card-footer-year { font-family: var(--font-sketch); font-size: 0.72rem; color: rgba(0,171,57,0.6); }

  /* ══════════════════════════════════════════════════════
     INFO PANELS (below card)
  ═══════════════════════════════════════════════════════ */
  .info-panels { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; }

  .info-panel {
    background: #fff;
    border: 2px solid rgba(0,171,57,0.18);
    border-radius: 12px;
    overflow: hidden;
    filter: url(#sk);
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.85rem;
    background: var(--gl);
    border-bottom: 1px solid rgba(0,171,57,0.15);
  }
  .panel-title {
    font-family: var(--font-hand);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--gd);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .panel-toggle {
    font-family: var(--font-hand);
    font-size: 0.75rem;
    color: var(--g);
    background: none;
    border: 1px solid rgba(0,171,57,0.35);
    border-radius: 12px;
    padding: 0.15rem 0.65rem;
    cursor: pointer;
    transition: background 0.15s;
  }
  .panel-toggle:hover, .panel-toggle[aria-expanded="true"] {
    background: var(--g);
    color: #fff;
    border-color: var(--g);
  }

  .panel-display { padding: 0.65rem 0.85rem; }
  .panel-form { padding: 0.75rem 0.85rem; border-top: 1px solid rgba(0,171,57,0.1); }

  .disp-pills {
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
    padding: 0.1rem 0;
  }
  .disp-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(0,171,57,0.22);
    border: 1px solid rgba(0,171,57,0.35);
    border-radius: 20px;
    padding: 0.3rem 0.85rem 0.3rem 0.6rem;
    font-family: var(--font-hand);
    font-size: 0.84rem;
    color: var(--gd);
    font-weight: 600;
    line-height: 1.3;
    align-self: flex-start;
    max-width: 100%;
    word-break: break-word;
  }
  .disp-pill[style*="cursor"] { cursor: pointer; }
  .disp-pill[style*="cursor"]:hover { background: rgba(0,171,57,0.32); }
  .disp-pill svg { opacity: 0.65; flex-shrink: 0; color: var(--gm); }
  .disp-pill a { color: var(--gd); text-decoration: none; font-weight: 600; }
  .disp-pill a:hover { text-decoration: underline; }
  .disp-empty { font-family: var(--font-hand); font-size: 0.82rem; color: #bbb; font-style: italic; }

  /* Social logins row */
  .social-logins-row {
    display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0.5rem 0 0.25rem;
  }
  .social-chip {
    display: inline-flex; align-items: center; gap: 0.35rem;
    background: rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.1);
    border-radius: 20px; padding: 0.22rem 0.65rem;
    font-family: var(--font-hand); font-size: 0.75rem; color: #666;
  }
  .social-chip--connected {
    background: rgba(0,171,57,0.08); border-color: rgba(0,171,57,0.25); color: var(--gd);
  }
  .social-chip-icon { font-size: 0.85rem; line-height: 1; }

  .gear-chips-wrap {
    padding: 0.55rem 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    min-height: 40px;
  }
  .gear-chip {
    font-family: var(--font-hand);
    font-size: 0.78rem;
    background: var(--gl);
    border: 1px solid rgba(0,171,57,0.3);
    border-radius: 14px;
    padding: 0.18rem 0.55rem;
    color: var(--gd);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .chip-remove { background: none; border: none; color: #aaa; cursor: pointer; font-size: 0.7rem; padding: 0; }
  .chip-remove:hover { color: #c00; }

  /* Forms */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
  }
  .field { display: flex; flex-direction: column; gap: 0.2rem; }
  .field-full { grid-column: span 2; }
  .field label {
    font-family: var(--font-hand);
    font-size: 0.72rem;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .field input, .field select, .field textarea {
    border: 1.5px solid rgba(0,171,57,0.25);
    border-radius: 8px;
    padding: 0.45rem 0.65rem;
    font-family: var(--font-hand);
    font-size: 0.88rem;
    color: var(--ink);
    background: #fafafa;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.18s;
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none;
    border-color: var(--g);
    box-shadow: 0 0 0 2px rgba(0,171,57,0.1);
    background: #fff;
  }
  .field textarea { resize: vertical; min-height: 52px; }
  .form-actions { display: flex; gap: 0.45rem; margin-top: 0.65rem; }

  /* Buttons */
  .sketchy-btn {
    font-family: var(--font-hand);
    font-size: 0.88rem;
    font-weight: 700;
    background: var(--g);
    color: #fff;
    border: 2px solid var(--gd);
    border-radius: 8px;
    padding: 0.42rem 1rem;
    cursor: pointer;
    position: relative;
    transition: background 0.18s, transform 0.12s;
    box-shadow: 2px 2px 0 var(--gd);
  }
  .sketchy-btn:hover { background: var(--gm); transform: translate(-1px, -1px); box-shadow: 3px 3px 0 var(--gd); }
  .sketchy-btn:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 var(--gd); }

  .sketchy-btn-ghost {
    font-family: var(--font-hand);
    font-size: 0.88rem;
    background: transparent;
    color: #666;
    border: 1.5px solid #ccc;
    border-radius: 8px;
    padding: 0.42rem 0.85rem;
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .sketchy-btn-ghost:hover { border-color: #999; color: #333; }

  .sketchy-btn-sm {
    font-size: 0.85rem;
    padding: 0.22rem 0.55rem;
    border-radius: 6px;
  }

  /* Gear sub-tabs */
  .gear-sub-tabs { display: flex; gap: 0.3rem; margin-bottom: 0.65rem; }
  .gear-sub-tab {
    font-family: var(--font-hand);
    font-size: 0.78rem;
    padding: 0.22rem 0.65rem;
    border-radius: 10px;
    border: 1px solid rgba(0,171,57,0.3);
    background: none;
    color: #666;
    cursor: pointer;
    transition: all 0.15s;
  }
  .gear-sub-tab.active { background: var(--g); color: #fff; border-color: var(--g); }

  /* ══════════════════════════════════════════════════════
     RIGHT COLUMN
  ═══════════════════════════════════════════════════════ */
  .right-col { display: flex; flex-direction: column; gap: 1.25rem; }

  /* Camino panel */
  .camino-panel {
    background: #fff;
    border: 2px solid rgba(0,171,57,0.2);
    border-radius: 14px;
    overflow: hidden;
    filter: url(#sk);
  }
  .camino-panel .panel-head { padding: 0.65rem 1rem; background: var(--gl); border-bottom: 1px solid rgba(0,171,57,0.15); }

  .stage-count-pill {
    font-family: var(--font-sketch);
    font-size: 0.82rem;
    background: var(--gd);
    color: #fff;
    padding: 0.15rem 0.65rem;
    border-radius: 14px;
  }

  .camino-route-row {
    display: flex;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid rgba(0,171,57,0.1);
  }
  .route-select, .date-input {
    border: 1.5px solid rgba(0,171,57,0.25);
    border-radius: 8px;
    padding: 0.35rem 0.6rem;
    font-family: var(--font-hand);
    font-size: 0.85rem;
    background: #fafafa;
    color: var(--ink);
    flex: 1;
  }
  .route-select:focus, .date-input:focus { outline: none; border-color: var(--g); }

  .stage-list {
    max-height: 360px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--g) transparent;
  }
  .stage-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.38rem 1rem;
    cursor: pointer;
    border-bottom: 1px dotted rgba(0,171,57,0.1);
    transition: background 0.12s;
    font-family: var(--font-hand);
  }
  .stage-row:hover { background: #f5fdf5; }
  .stage-row input[type="checkbox"] { display: none; }
  .stage-mark {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid #ccc;
    flex-shrink: 0;
    transition: background 0.15s, border-color 0.15s;
  }
  .stage-row:has(input:checked) .stage-mark { background: var(--g); border-color: var(--g); }
