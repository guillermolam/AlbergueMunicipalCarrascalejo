        frontFile: null,
        backFile: null,
        frontValid: null,
        backValid: null,
        validationError: null,
        avatarDataUrl: null,
      }));
      // Seed in-memory cache from persistent stores; clear stale slots
      resetPilgrims(p);
      personFormData = Array.from({ length: p }, (_, i) => {
        const stored = pilgrimStores[i].get();
        // Convert to generic Record<string,string>
        return Object.fromEntries(STEP3_FIELD_KEYS.map((k) => [k, stored[k] ?? '']));
