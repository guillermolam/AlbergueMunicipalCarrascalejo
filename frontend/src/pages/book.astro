    // ── COUNTRY PICKER (Nationality + Address Country) ───────────────────────
    function initCountryPicker(opts: {
      inputId: string; dropId: string; flagId: string; hiddenId: string;
      onSelect?: (c: { c:string; n:string; f:string; d:string }) => void;
    }) {
      const input  = document.getElementById(opts.inputId)  as HTMLInputElement | null;
      const drop   = document.getElementById(opts.dropId)   as HTMLUListElement  | null;
      const flagEl = document.getElementById(opts.flagId)   as HTMLElement | null;
      const hidden = document.getElementById(opts.hiddenId) as HTMLInputElement | null;
      if (!input || !drop) return;

      let activeIdx = -1;
      let filtered: typeof COUNTRIES = [];

      function renderList(q: string) {
        const lq = q.toLowerCase();
        filtered = q.length < 1
          ? COUNTRIES.slice(0, 60)
          : COUNTRIES.filter(c => c.n.toLowerCase().includes(lq) || c.c.toLowerCase().includes(lq));
        drop.innerHTML = '';
        activeIdx = -1;
        filtered.forEach((c, i) => {
          const li = document.createElement('li');
          li.setAttribute('role', 'option');
          li.setAttribute('id', `${opts.dropId}-opt-${i}`);
          li.innerHTML = `<span>${c.f}</span><span>${c.n}</span><span class="cdl-code">${c.c}</span>`;
          li.addEventListener('mousedown', e => { e.preventDefault(); choose(c); });
          li.addEventListener('mouseenter', () => setActive(i));
          drop.appendChild(li);
        });
        drop.style.display = filtered.length ? 'block' : 'none';
        input.setAttribute('aria-expanded', filtered.length ? 'true' : 'false');
      }

      function setActive(idx: number) {
        drop.querySelectorAll('li').forEach((li, i) => {
          li.classList.toggle('active', i === idx);
        });
        activeIdx = idx;
        if (idx >= 0) input.setAttribute('aria-activedescendant', `${opts.dropId}-opt-${idx}`);
      }

      function choose(c: typeof COUNTRIES[0]) {
        input.value = c.n;
        if (flagEl) flagEl.textContent = c.f;
        if (hidden) hidden.value = c.c;
        drop.style.display = 'none';
        input.setAttribute('aria-expanded', 'false');
        activeIdx = -1;
        opts.onSelect?.(c);
      }

      // Pre-select Spain as default
      const spain = COUNTRIES.find(c => c.c === 'ES');
      if (spain) choose(spain);

      input.addEventListener('focus', () => renderList(input.value));
      input.addEventListener('input', () => renderList(input.value.trim()));
      input.addEventListener('blur',  () => setTimeout(() => { drop.style.display = 'none'; input.setAttribute('aria-expanded','false'); }, 160));
      input.addEventListener('keydown', (e: KeyboardEvent) => {
        const items = drop.querySelectorAll('li');
        if (!items.length) return;
        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(Math.min(activeIdx + 1, items.length - 1)); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(Math.max(activeIdx - 1, 0)); }
        else if (e.key === 'Enter' && activeIdx >= 0) { e.preventDefault(); choose(filtered[activeIdx]); }
        else if (e.key === 'Escape') { drop.style.display = 'none'; input.setAttribute('aria-expanded','false'); }
      });
    }

    // Nationality picker
    initCountryPicker({ inputId:'f-nat', dropId:'nat-drop', flagId:'f-nat-flag', hiddenId:'f-nat-code' });
    // Address country picker
    initCountryPicker({ inputId:'f-country', dropId:'country-drop', flagId:'f-country-flag', hiddenId:'f-country-code' });

    // ── PHONE PREFIX PICKER ──────────────────────────────────────────────────
    function initPhonePicker(opts: {
      btnId: string; dropId: string; flagId: string; dialId: string; hiddenId: string;
    }) {
      const btn    = document.getElementById(opts.btnId)    as HTMLButtonElement | null;
      const drop   = document.getElementById(opts.dropId)   as HTMLElement | null;
      const flagEl = document.getElementById(opts.flagId)   as HTMLElement | null;
      const dialEl = document.getElementById(opts.dialId)   as HTMLElement | null;
      const hidden = document.getElementById(opts.hiddenId) as HTMLInputElement | null;
      if (!btn || !drop) return;

      const searchInput = drop.querySelector<HTMLInputElement>('.phone-drop-search');
      const list        = drop.querySelector<HTMLUListElement>('.phone-drop-list');
      if (!list) return;

      let activeIdx = -1;
      let filtered: typeof COUNTRIES = [];

      function renderList(q: string) {
        const lq = q.toLowerCase().replace(/^\+/, '');
        filtered = q.length < 1
          ? COUNTRIES.slice(0, 80)
          : COUNTRIES.filter(c =>
              c.n.toLowerCase().includes(lq) ||
              c.d.replace('+','').startsWith(lq) ||
              c.c.toLowerCase().startsWith(lq));
        list.innerHTML = '';
        activeIdx = -1;
        filtered.forEach((c, i) => {
          const li = document.createElement('li');
          li.setAttribute('role', 'option');
          li.innerHTML = `<span>${c.f}</span><span>${c.n}</span><span class="pdl-dial">${c.d}</span>`;
          li.addEventListener('mousedown', e => { e.preventDefault(); choose(c); });
          li.addEventListener('mouseenter', () => {
            list.querySelectorAll('li').forEach((l, j) => l.classList.toggle('active', j === i));
            activeIdx = i;
          });
          list.appendChild(li);
        });
      }

      function choose(c: typeof COUNTRIES[0]) {
        if (flagEl) flagEl.textContent = c.f;
        if (dialEl) dialEl.textContent = c.d;
        if (hidden) hidden.value = c.c;
        btn.setAttribute('aria-expanded', 'false');
        drop.classList.remove('open');
        if (searchInput) searchInput.value = '';
        renderList('');
      }

      function open() {
        renderList('');
        drop.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        setTimeout(() => searchInput?.focus(), 30);
      }

      function close() {
        drop.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }

      btn.addEventListener('click', e => {
        e.stopPropagation();
        drop.classList.contains('open') ? close() : open();
      });

      searchInput?.addEventListener('input', () => renderList(searchInput.value.trim()));
      searchInput?.addEventListener('keydown', (e: KeyboardEvent) => {
        const items = list.querySelectorAll<HTMLElement>('li');
        if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, items.length - 1); items.forEach((li, i) => li.classList.toggle('active', i === activeIdx)); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); items.forEach((li, i) => li.classList.toggle('active', i === activeIdx)); }
        else if (e.key === 'Enter' && activeIdx >= 0) { e.preventDefault(); choose(filtered[activeIdx]); }
        else if (e.key === 'Escape') close();
      });

      document.addEventListener('click', e => {
        if (!drop.contains(e.target as Node) && e.target !== btn) close();
      });

      // Initial render
      renderList('');
    }

    initPhonePicker({ btnId:'phone-prefix', dropId:'phone-drop', flagId:'phone-flag', dialId:'phone-dial', hiddenId:'f-phone-cc' });
    initPhonePicker({ btnId:'ec-phone-prefix', dropId:'ec-phone-drop', flagId:'ec-phone-flag', dialId:'ec-phone-dial', hiddenId:'f-ec-phone-cc' });

    // ── ADDRESS AUTOCOMPLETE (Geoapify via /api/autocomplete SSR proxy) ───────
    // The API key is kept server-side in the SSR Worker — never in the browser.
    ;(function initAddressAutocomplete() {
      const addrInput   = document.getElementById('f-addr')         as HTMLInputElement | null;
      const suggestList = document.getElementById('addr-suggestions') as HTMLUListElement | null;
      const cityInput   = document.getElementById('f-city')          as HTMLInputElement | null;
      const zipInput    = document.getElementById('f-zip')           as HTMLInputElement | null;
      if (!addrInput || !suggestList) return;

      let debounceTimer: ReturnType<typeof setTimeout> | null = null;
      let activeIdx = -1;

      interface Suggestion {
        label: string; street: string; city: string; postcode: string; countryCode: string;
      }

      function showSuggestions(items: Suggestion[]) {
        suggestList.innerHTML = '';
        activeIdx = -1;
        if (!items.length) { hideSuggestions(); return; }

        items.forEach((s, i) => {
          const li = document.createElement('li');
          li.setAttribute('role', 'option');
          li.setAttribute('id', `addr-opt-${i}`);
          li.style.cssText = 'padding:0.6rem 0.9rem;cursor:pointer;font-family:\'Patrick Hand\',cursive;font-size:0.9rem;color:#3D2B1F;border-bottom:1px solid #F3EAE0;list-style:none';
          li.textContent = s.label;
          li.addEventListener('mousedown', e => {
            e.preventDefault();
            selectSuggestion(s);
          });
          li.addEventListener('mouseenter', () => {
            setActive(i);
          });
          suggestList.appendChild(li);
        });

        suggestList.style.display = 'block';
        addrInput.setAttribute('aria-expanded', 'true');
      }

      function hideSuggestions() {
        suggestList.style.display = 'none';
        addrInput.setAttribute('aria-expanded', 'false');
        activeIdx = -1;
      }

      function setActive(idx: number) {
        const items = suggestList.querySelectorAll('li');
        items.forEach((li, i) => {
          (li as HTMLElement).style.background = i === idx ? '#F0FFF4' : '';
          li.setAttribute('aria-selected', String(i === idx));
        });
        activeIdx = idx;
        addrInput.setAttribute('aria-activedescendant', idx >= 0 ? `addr-opt-${idx}` : '');
      }

      function selectSuggestion(s: Suggestion) {
        addrInput.value = s.street || s.label;
        if (cityInput && s.city)     cityInput.value = s.city;
        if (zipInput  && s.postcode) zipInput.value  = s.postcode;
        // Auto-fill country from Geoapify result
        if (s.countryCode) {
          const cc = s.countryCode.toUpperCase();
          const countryInput  = document.getElementById('f-country')      as HTMLInputElement | null;
          const countryFlag   = document.getElementById('f-country-flag') as HTMLElement | null;
          const countryHidden = document.getElementById('f-country-code') as HTMLInputElement | null;
          const match = COUNTRIES.find(c => c.c === cc);
          if (match && countryInput) {
            countryInput.value = match.n;
            if (countryFlag)   countryFlag.textContent  = match.f;
            if (countryHidden) countryHidden.value = match.c;
          }
        }
        hideSuggestions();
        addrInput.dispatchEvent(new Event('input', { bubbles: true }));
      }

      async function fetchSuggestions(text: string) {
        if (text.length < 2) { hideSuggestions(); return; }
        try {
          const res  = await fetch(`/api/autocomplete?text=${encodeURIComponent(text)}&lang=es&limit=6`);
          const data = await res.json() as { suggestions?: Suggestion[] };
          showSuggestions(data.suggestions ?? []);
        } catch {
          hideSuggestions();
        }
      }

      addrInput.addEventListener('input', () => {
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => fetchSuggestions(addrInput.value.trim()), 300);
      });

      addrInput.addEventListener('keydown', (e: KeyboardEvent) => {
        const items = suggestList.querySelectorAll('li');
        if (!items.length) return;
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          setActive(Math.min(activeIdx + 1, items.length - 1));
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          setActive(Math.max(activeIdx - 1, 0));
        } else if (e.key === 'Enter' && activeIdx >= 0) {
          e.preventDefault();
          (items[activeIdx] as HTMLElement).dispatchEvent(new MouseEvent('mousedown'));
        } else if (e.key === 'Escape') {
          hideSuggestions();
        }
      });

      addrInput.addEventListener('blur', () => {
        // Delay so mousedown on a suggestion fires first
        setTimeout(hideSuggestions, 150);
      });
    })();
    // ─────────────────────────────────────────────────────────────────────────
  </script>
