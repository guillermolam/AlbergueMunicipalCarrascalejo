  <style is:global>
    /*
     * /info page global overrides — make body transparent so the fixed
     * Hostel3DBackground canvas (z=0) is visible behind all sections.
     */
    body:has(#hostel-bg-canvas) {
      background: transparent !important;
    }
  </style>

  <style>
    /* ── Variables ── */
    :root {
      --ip-green: var(--green, #3a7a3a);
      --ip-green-light: var(--green-light, #e8f5e9);
      --ip-black: var(--black, #111);
      --ip-font-display: var(--font-display, 'Cabin Sketch', serif);
      --ip-font-body: var(--font-hand, sans-serif);
    }

    /* ── Parallax scroll sections ── */
    .ps-section {
      opacity: 0;
      transform: translateY(32px);
      transition: opacity 0.65s ease, transform 0.65s ease;
    }
    .ps-section.ps-visible {
      opacity: 1;
      transform: translateY(0);
    }
    .ps-reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.5s ease var(--ps-delay, 0s), transform 0.5s ease var(--ps-delay, 0s);
    }
    .ps-section.ps-visible .ps-reveal {
      opacity: 1;
      transform: translateY(0);
    }

    /* ── HERO — glass card over 3D background ── */
    .ip-hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      /* No background — the fixed Hostel3DBackground canvas is visible */
      background: transparent;
      z-index: 1;
    }
    .ip-hero-content {
      position: relative;
      z-index: 2;
      /* Glass overlay so text is readable above the 3D canvas */
      background: rgba(5, 20, 10, 0.55);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 20px;
      padding: 2.5rem 3rem;
      text-align: center;
      color: #fff;
      padding: 2rem 1.5rem;
    }
    .ip-hero-badge {
      display: inline-block;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: 99px;
      padding: 5px 16px;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      margin-bottom: 1rem;
      backdrop-filter: blur(6px);
    }
    .ip-hero-title {
      font-family: var(--ip-font-display);
      font-size: clamp(3rem, 8vw, 5.5rem);
      color: #fff;
      margin: 0 0 0.5rem;
      text-shadow: 0 2px 20px rgba(0,0,0,0.4);
    }
    .ip-hero-sub {
      font-size: 1.05rem;
      color: rgba(255,255,255,0.75);
      margin: 0 0 2rem;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
    }
    .ip-hero-stats {
      display: flex;
      gap: 1.5rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .ip-hero-stat {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 10px;
      padding: 10px 20px;
      backdrop-filter: blur(8px);
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .ip-hero-stat span { font-size: 1.4rem; font-weight: 700; color: #fff; }
    .ip-hero-stat small { font-size: 0.7rem; color: rgba(255,255,255,0.65); }

    /* ── Sections — glass panels over the fixed 3D background ── */
    .ip-section {
      position: relative;
      z-index: 1;
      padding: 5rem 1.5rem;
      /* Frosted glass — 3D scene visible through blur */
      background: rgba(245, 248, 244, 0.72);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
      border-bottom: 1px solid rgba(255,255,255,0.2);
      border-top: 1px solid rgba(255,255,255,0.1);
    }
    .ip-section--dark {
      background: rgba(6, 16, 6, 0.68);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      color: #fff;
      border-bottom-color: rgba(255,255,255,0.07);
      border-top-color: rgba(255,255,255,0.05);
    }
    .ip-section--tinted {
      background: rgba(218, 240, 216, 0.72);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }
    .ip-section-inner {
      max-width: 1080px;
      margin: 0 auto;
    }
    .ip-label {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--ip-green);
      margin-bottom: 0.35rem;
    }
    .ip-section--dark .ip-label { color: #7dc87d; }
    .ip-heading {
      font-family: var(--ip-font-display);
      font-size: clamp(1.7rem, 4vw, 2.8rem);
      color: var(--ip-black);
      margin: 0 0 1.25rem;
      line-height: 1.15;
    }
    .ip-section--dark .ip-heading { color: #fff; }
    .ip-body {
      font-size: 0.95rem;
      color: #555;
      line-height: 1.7;
      margin: 0 0 1.25rem;
      max-width: 440px;
    }
    .ip-section--dark .ip-body { color: rgba(255,255,255,0.7); }

    /* ── Split layout ── */
    .ip-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
      align-items: center;
    }
    .ip-split--reverse { direction: rtl; }
    .ip-split--reverse > * { direction: ltr; }
    .ip-3d-tall {
      height: 420px;
      border-radius: 14px;
      overflow: hidden;
    }

    /* ── Info pills ── */
    .ip-info-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-bottom: 1.25rem;
    }
    .ip-pill {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 99px;
      padding: 4px 12px;
      font-size: 0.75rem;
      color: rgba(255,255,255,0.85);
    }

    /* ── Mini map ── */
    .ip-mini-map {
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 0.5rem;
    }
    .ip-osm-link {
      font-size: 0.78rem;
      color: #7dc87d;
      text-decoration: none;
    }
    .ip-osm-link:hover { text-decoration: underline; }

    /* ── Gallery ── */
    .ip-gallery-track-outer {
      position: relative;
      border-radius: 14px;
      overflow: hidden;
      aspect-ratio: 16/8;
      max-height: 440px;
    }
    .ip-gallery-track {
      display: flex;
      height: 100%;
      transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
      will-change: transform;
    }
    .ip-gallery-slide {
      flex: 0 0 100%;
      min-width: 100%;
      height: 100%;
      margin: 0;
      position: relative;
    }
    .ip-gallery-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .ip-gallery-cap {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 0.5rem 1rem;
      background: linear-gradient(transparent, rgba(0,0,0,0.6));
      color: #fff;
      font-size: 0.82rem;
    }
    .ip-gallery-btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(0,0,0,0.45);
      color: #fff;
      border: none;
      width: 2.4rem;
      height: 2.4rem;
      border-radius: 50%;
      font-size: 1.4rem;
      line-height: 1;
      cursor: pointer;
      backdrop-filter: blur(4px);
      z-index: 3;
      transition: background 0.15s;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .ip-gallery-btn:hover { background: rgba(0,0,0,0.72); }
    .ip-gallery-prev { left: 0.75rem; }
    .ip-gallery-next { right: 0.75rem; }
    .ip-gallery-dots {
      position: absolute;
      bottom: 0.75rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 5px;
      z-index: 3;
    }
    .ip-gallery-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: rgba(255,255,255,0.5);
      border: none;
      cursor: pointer;
      padding: 0;
      transition: background 0.2s, transform 0.2s;
    }
    .ip-gallery-dot.active {
      background: #fff;
      transform: scale(1.25);
    }

    /* ── Facilities ── */
    .ip-two-col {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 2.5rem;
      align-items: start;
    }
    .ip-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-bottom: 1.25rem;
    }
    .ip-chip {
      background: var(--ip-green-light);
      border: 1px solid rgba(58,122,58,0.25);
      border-radius: 99px;
      padding: 5px 12px;
      font-size: 0.78rem;
      color: #2a5a2a;
      font-weight: 500;
    }
    .ip-popover-wrap {
      margin-top: 1.25rem;
    }
    .ip-about-photo {
      position: relative;
    }
    .ip-about-img {
      width: 100%;
      border-radius: 12px;
      aspect-ratio: 4/3;
      object-fit: cover;
      display: block;
    }
    .ip-about-badge {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(0,0,0,0.72);
      color: #fff;
      font-size: 0.7rem;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 99px;
      backdrop-filter: blur(4px);
    }
    .ip-price-tag {
      margin-top: 10px;
      text-align: center;
    }
    .ip-price-num {
      display: block;
      font-family: var(--ip-font-display);
      font-size: 2rem;
      color: var(--ip-green);
    }
    .ip-price-sub {
      font-size: 0.75rem;
      color: #888;
    }

    /* ── Room legend ── */
    .ip-room-legend {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px 16px;
      margin-top: 1rem;
    }
    .ip-room-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.8rem;
      color: rgba(255,255,255,0.8);
    }
    .ip-room-dot {
      width: 12px;
      height: 12px;
      border-radius: 3px;
      flex-shrink: 0;
    }

    /* ── Practical info ── */
    .ip-practical-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 12px;
      margin-bottom: 2rem;
    }
    .ip-practical-card {
      background: var(--ip-green-light);
      border: 1px solid rgba(58,122,58,0.18);
      border-radius: 12px;
      padding: 16px;
      text-align: center;
    }
    .ip-pc-icon { font-size: 1.5rem; margin-bottom: 4px; }
    .ip-pc-label { font-size: 0.7rem; color: #888; text-transform: uppercase; letter-spacing: 0.05em; }
    .ip-pc-val { font-size: 0.95rem; font-weight: 700; color: #222; margin-top: 2px; }

    /* ── Rules ── */
    .ip-rules { max-width: 680px; }
    .ip-rules-heading {
      font-family: var(--ip-font-display);
      font-size: 1.1rem;
      color: var(--ip-black);
      margin: 0 0 0.75rem;
    }
    .ip-rules-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px 16px;
    }
    .ip-rule {
      display: flex;
      align-items: flex-start;
      gap: 7px;
      font-size: 0.85rem;
      color: #444;
      line-height: 1.4;
    }
    .ip-rule svg { flex-shrink: 0; margin-top: 2px; }

    /* ── Accordion ── */
    .ip-accordion { max-width: 720px; }
    .ip-acc-item {
      border-bottom: 1px solid rgba(0,0,0,0.1);
    }
    .ip-acc-trigger {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 0;
      background: none;
      border: none;
      text-align: left;
      cursor: pointer;
      font-size: 0.92rem;
      font-weight: 600;
      color: #222;
      gap: 1rem;
    }
    .ip-acc-arrow {
      flex-shrink: 0;
      transition: transform 0.25s;
    }
    .ip-acc-item.open .ip-acc-arrow {
      transform: rotate(180deg);
    }
    .ip-acc-body {
      display: none;
      padding: 0 0 1rem;
      font-size: 0.88rem;
      color: #555;
      line-height: 1.7;
    }
    .ip-acc-item.open .ip-acc-body { display: block; }
    .ip-acc-body p { margin: 0; }

    /* ── Reviews ── */
    .ip-reviews-wrap {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 2rem;
      align-items: start;
      max-width: 680px;
    }
    .ip-review-score {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
    .ip-score-big {
      font-family: var(--ip-font-display);
      font-size: 4rem;
      color: var(--ip-green);
      line-height: 1;
    }
    .ip-score-meta {
      display: flex;
      flex-direction: column;
      align-items: center;
      font-size: 0.78rem;
      color: #888;
      text-align: center;
    }
    .ip-score-meta strong { color: #222; font-size: 0.88rem; }
    .ip-subscore-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 8px;
    }
    .ip-subscore-lbl { font-size: 0.8rem; color: #555; min-width: 130px; }
    .ip-subscore-track {
      flex: 1;
      height: 6px;
      background: #eee;
      border-radius: 3px;
      overflow: hidden;
    }
    .ip-subscore-bar {
      height: 100%;
      background: var(--ip-green);
      border-radius: 3px;
      transition: width 0.8s ease;
    }
    .ip-subscore-val { font-size: 0.78rem; font-weight: 700; color: #333; min-width: 26px; text-align: right; }

    /* ── Nearby ── */
    .ip-nearby-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 14px;
      margin-bottom: 1rem;
    }
    .ip-nearby-card {
      background: #fff;
      border: 1px solid rgba(0,0,0,0.08);
      border-radius: 12px;
      padding: 14px;
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }
    .ip-nearby-icon { font-size: 1.7rem; flex-shrink: 0; }
    .ip-nearby-name { display: block; font-size: 0.88rem; font-weight: 700; color: #222; }
    .ip-nearby-dist { display: inline-block; font-size: 0.72rem; color: var(--ip-green); font-weight: 600; margin-bottom: 3px; }
    .ip-nearby-desc { font-size: 0.78rem; color: #666; margin: 0; line-height: 1.4; }
    .ip-license-note { font-size: 0.78rem; color: #888; margin-top: 1rem; }

    /* ── CTA section ── */
    .ip-cta-section {
      background: linear-gradient(135deg, #1a3a1a 0%, #0f2010 100%);
      color: #fff;
    }
    .ip-cta-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      flex-wrap: wrap;
    }
    .ip-cta-heading {
      font-family: var(--ip-font-display);
      font-size: clamp(1.5rem, 3.5vw, 2.2rem);
      color: #fff;
      margin: 0 0 0.5rem;
    }
    .ip-cta-sub { font-size: 0.9rem; color: rgba(255,255,255,0.7); margin: 0 0 1rem; }
    .ip-contact-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .ip-contact-pill {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 99px;
      padding: 5px 14px;
      font-size: 0.78rem;
      color: rgba(255,255,255,0.85);
      text-decoration: none;
      transition: background 0.15s;
    }
    .ip-contact-pill:hover { background: rgba(255,255,255,0.2); }
    .ip-cta-btn {
      display: inline-block;
      padding: 16px 36px;
      background: var(--ip-green);
      color: #fff;
      text-decoration: none;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 700;
      white-space: nowrap;
      transition: background 0.18s, transform 0.1s;
      box-shadow: 0 4px 16px rgba(0,0,0,0.3);
    }
    .ip-cta-btn:hover { background: #2d612d; transform: translateY(-1px); }
    .ip-cta-btn:active { transform: scale(0.97); }

    /* ── Responsive ── */
    @media (max-width: 840px) {
      .ip-split, .ip-two-col {
        grid-template-columns: 1fr;
      }
      .ip-split--reverse { direction: ltr; }
      .ip-3d-tall { height: 300px; }
      .ip-room-legend { grid-template-columns: 1fr; }
      .ip-reviews-wrap { grid-template-columns: 1fr; }
      .ip-rules-list { grid-template-columns: 1fr; }
      .ip-cta-inner { flex-direction: column; align-items: flex-start; }
    }
    @media (max-width: 560px) {
      .ip-hero-stats { gap: 0.75rem; }
      .ip-practical-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>

  <script type="module">
    // ── HERO PARTICLE CANVAS ──────────────────────────────────────────
    (() => {
      const canvas = document.getElementById('hero-particles');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let W, H;
      const PARTICLES = [];

      function resize() {
        W = canvas.width = canvas.offsetWidth;
        H = canvas.height = canvas.offsetHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      for (let i = 0; i < 90; i++) {
        PARTICLES.push({
          x: Math.random() * W,
          y: Math.random() * H,
          r: 1 + Math.random() * 2.5,
          dx: (Math.random() - 0.5) * 0.4,
          dy: (Math.random() - 0.5) * 0.3,
          a: 0.3 + Math.random() * 0.5,
        });
      }

      function drawStar(ctx, x, y, r, a) {
        ctx.save();
        ctx.globalAlpha = a;
        ctx.fillStyle = '#7dc87d';
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      function tick() {
        if (!ctx) return;
        ctx.clearRect(0, 0, W, H);
        for (const p of PARTICLES) {
          p.x += p.dx;
          p.y += p.dy;
          if (p.x < 0) p.x = W;
          if (p.x > W) p.x = 0;
          if (p.y < 0) p.y = H;
          if (p.y > H) p.y = 0;
          drawStar(ctx, p.x, p.y, p.r, p.a);
        }
        // Draw Camino shell constellation hints
        ctx.save();
        ctx.strokeStyle = 'rgba(125,200,125,0.05)';
        ctx.lineWidth = 1;
        for (let i = 0; i < PARTICLES.length - 1; i++) {
          const a = PARTICLES[i], b = PARTICLES[(i + 7) % PARTICLES.length];
          const dist = Math.hypot(a.x - b.x, a.y - b.y);
          if (dist < 120) {
            ctx.globalAlpha = (1 - dist / 120) * 0.3;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
        ctx.restore();
        requestAnimationFrame(tick);
      }
      tick();
    })();

    // ── SCROLL PARALLAX REVEAL ────────────────────────────────────────
    (() => {
      const sections = document.querySelectorAll('.ps-section');
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('ps-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.08 }
      );
      for (const s of sections) io.observe(s);
    })();

    // ── GALLERY ──────────────────────────────────────────────────────
    (() => {
      const track = document.getElementById('gallery-track');
      const dots = document.querySelectorAll('.ip-gallery-dot');
      if (!track) return;
      let current = 0;
      const slides = track.querySelectorAll('.ip-gallery-slide');
      const total = slides.length;

      function goTo(idx) {
        current = (idx + total) % total;
        track.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((d, i) => {
          d.classList.toggle('active', i === current);
          d.setAttribute('aria-selected', String(i === current));
        });
      }

      document.getElementById('gallery-prev')?.addEventListener('click', () => goTo(current - 1));
      document.getElementById('gallery-next')?.addEventListener('click', () => goTo(current + 1));
      dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));

      // Auto-advance
      let timer = setInterval(() => goTo(current + 1), 5000);
      track.parentElement?.addEventListener('mouseenter', () => clearInterval(timer));
      track.parentElement?.addEventListener('mouseleave', () => { timer = setInterval(() => goTo(current + 1), 5000); });

      // Touch swipe
      let startX = 0;
      track.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, { passive: true });
      track.addEventListener('touchend', e => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 50) goTo(current + (dx < 0 ? 1 : -1));
      });
    })();

    // ── ACCORDION ────────────────────────────────────────────────────
    (() => {
      document.querySelectorAll('.ip-acc-trigger').forEach(btn => {
        btn.addEventListener('click', () => {
          const item = btn.closest('.ip-acc-item');
          const isOpen = item?.classList.contains('open');
          document.querySelectorAll('.ip-acc-item.open').forEach(i => i.classList.remove('open'));
          if (!isOpen) item?.classList.add('open');
          btn.setAttribute('aria-expanded', String(!isOpen));
        });
      });
    })();

    // ── DYNAMIC PRICE ────────────────────────────────────────────────
    (() => {
      try {
        const price = 15;
        const label = price.toFixed(0) + ' EUR';
        const statEl = document.getElementById('info-price-stat');
        if (statEl) statEl.textContent = label;
        const locRow = document.getElementById('info-price-locrow');
        if (locRow) locRow.textContent = label + ' / noche por persona';
      } catch {
        /* keep default */
      }
    })();
  </script>
</Layout>
)}
