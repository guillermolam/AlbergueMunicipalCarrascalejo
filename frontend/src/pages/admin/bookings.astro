    row.appendChild(label);
    row.appendChild(barWrap);
    row.appendChild(pctEl);
    container.appendChild(row);
  });
}

function renderTrendsTable() {
  var tbody = document.getElementById('trends-tbody');
  if (!tbody) return;
  var days = [
    { rank: 1, day: 'Monday',    avg: 4.2, pct: 92 },
    { rank: 2, day: 'Friday',    avg: 3.8, pct: 84 },
    { rank: 3, day: 'Saturday',  avg: 3.5, pct: 78 },
    { rank: 4, day: 'Sunday',    avg: 3.1, pct: 69 },
    { rank: 5, day: 'Wednesday', avg: 2.7, pct: 60 },
  ];
  days.forEach(function(d) {
    var tr = document.createElement('tr');

    var tdRank = document.createElement('td');
    var rankBadge = document.createElement('span');
    rankBadge.className = 'badge ' + (d.rank === 1 ? 'badge-warning' : d.rank === 2 ? 'badge-ghost' : 'badge-ghost') + ' badge-sm';
    rankBadge.textContent = '#' + d.rank;
    tdRank.appendChild(rankBadge);

    var tdDay = document.createElement('td');
    tdDay.className = 'font-medium';
    tdDay.textContent = d.day;

    var tdAvg = document.createElement('td');
    tdAvg.textContent = d.avg.toFixed(1) + '/day';

    var tdBar = document.createElement('td');
    var barWrap = document.createElement('div');
    barWrap.className = 'w-24 bg-base-300 rounded-full h-3 overflow-hidden';
    var bar = document.createElement('div');
    bar.className = 'h-full bg-success rounded-full';
    bar.style.width = d.pct + '%';
    barWrap.appendChild(bar);
    tdBar.appendChild(barWrap);

    tr.appendChild(tdRank);
    tr.appendChild(tdDay);
    tr.appendChild(tdAvg);
    tr.appendChild(tdBar);
    tbody.appendChild(tr);
  });
}

