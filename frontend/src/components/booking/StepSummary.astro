---
// StepSummary.astro — Step 6: booking review summary + confirm CTA
---

<div class="step-panel hidden" id="step-6" data-step="6">
  <div class="step-header center">
    <div class="step-header-icon large">
      <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#00AB39" stroke-width="2" stroke-linecap="round">
        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
        <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
        <path d="M10 9H8m8 4H8m8 4H8"></path>
      </svg>
    </div>
    <h1 class="step-title">Review Your Booking</h1>
    <p class="step-desc">Check all details before confirming</p>
  </div>

  <div class="summary-card">
    <svg class="info-card-border" preserveAspectRatio="none" aria-hidden="true">
      <rect x="4" y="6" width="calc(100% - 8px)" height="calc(100% - 10px)" rx="14" fill="rgba(0,0,0,0.05)" filter="blur(5px)"></rect>
      <rect x="0" y="0" width="100%" height="100%" rx="16" fill="white" stroke="#D4A574" stroke-width="2.5"></rect>
    </svg>
    <div class="summary-inner">
      <div class="summary-row">
        <span class="sum-label">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          Dates
        </span>
        <span class="sum-val" id="sum-dates">—</span>
      </div>
      <div class="summary-row">
        <span class="sum-label">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          Nights
        </span>
        <span class="sum-val" id="sum-nights">—</span>
      </div>
      <div class="summary-row">
        <span class="sum-label">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          Pilgrims
        </span>
        <span class="sum-val" id="sum-persons">1</span>
      </div>
      <div class="summary-row">
        <span class="sum-label">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M2 4v16"></path>
            <path d="M2 8h18a2 2 0 0 1 2 2v10"></path>
            <path d="M2 17h20"></path>
            <path d="M6 8v9"></path>
          </svg>
          Bed
        </span>
        <span class="sum-val" id="sum-bed">—</span>
      </div>
      <div class="summary-row">
        <span class="sum-label">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="7" r="4"></circle>
            <path d="M4 21v-2a8 8 0 0 1 16 0v2"></path>
          </svg>
          Pilgrim
        </span>
        <span class="sum-val" id="sum-pilgrim">—</span>
      </div>
      <div class="summary-row">
        <span class="sum-label">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <rect x="2" y="5" width="20" height="14" rx="2"></rect>
            <path d="M2 10h20"></path>
          </svg>
          Document
        </span>
        <span class="sum-val" id="sum-doc">—</span>
      </div>
      <div class="summary-divider"></div>
      <div class="summary-row total-row">
        <span class="sum-label total-label">Total</span>
        <span class="sum-val total-val" id="sum-total">EUR 0</span>
      </div>
    </div>
  </div>

  <!-- Big confirm CTA -->
  <button class="btn-confirm" id="btn-confirm">
    <svg style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none" aria-hidden="true">
      <rect x="4" y="6" width="calc(100% - 8px)" height="calc(100% - 8px)" rx="14" fill="black" filter="blur(5px)" opacity="0.2"></rect>
      <rect x="0" y="0" width="100%" height="100%" rx="14" fill="#00AB39" stroke="#1A1A1A" stroke-width="2.5" filter="url(#sketchy-filter-book)"></rect>
    </svg>
    <span class="confirm-label">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      Confirm Booking
    </span>
  </button>
</div>
