---
// Map3DAlbergue.astro — ThreeJS 3D bird's-eye floor plan of the albergue
// Rooms: Reception, Dorm 1 (12 beds), Dorm 2 (12 beds), Kitchen, Bathroom×2, Patio
---

<div class="map3d-albergue-wrap" data-active="false">
  <canvas id="map3d-albergue" aria-label="Plano 3D del Albergue Municipal"></canvas>
  <div class="albergue-room-label" id="albergue-room-label" aria-live="polite">
    <strong id="albergue-room-name"></strong>
    <span id="albergue-room-desc"></span>
  </div>
  <div class="albergue-hint" aria-hidden="true">↕ Pasa el ratón sobre las habitaciones</div>
</div>

<script type="module">
import * as THREE from 'three';
import { attachSectionActive } from '../../lib/three/sectionActive';

const canvas = document.getElementById('map3d-albergue');
if (!canvas) throw new Error('map3d-albergue canvas missing');

const root = canvas.closest('.map3d-albergue-wrap');
if (!root) throw new Error('map3d-albergue root missing');

const wrap = canvas.parentElement;
let W = wrap.clientWidth, H = wrap.clientHeight;

const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(W, H);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;

const scene = new THREE.Scene();
scene.background = new THREE.Color(0xf0ece0);

const camera = new THREE.PerspectiveCamera(40, W / H, 0.1, 100);
camera.position.set(12, 22, 18);
camera.lookAt(0, 0, 0);

// Lights
const ambient = new THREE.AmbientLight(0xfff8f0, 0.8);
scene.add(ambient);
const sun = new THREE.DirectionalLight(0xfffae0, 1.5);
sun.position.set(15, 30, 15);
sun.castShadow = true;
sun.shadow.mapSize.set(1024, 1024);
sun.shadow.camera.near = 1;
sun.shadow.camera.far = 80;
sun.shadow.camera.left = -20;
sun.shadow.camera.right = 20;
sun.shadow.camera.top = 20;
sun.shadow.camera.bottom = -20;
scene.add(sun);
const fill = new THREE.DirectionalLight(0xd0e8ff, 0.4);
fill.position.set(-10, 15, -5);
scene.add(fill);

// Ground
const groundGeo = new THREE.PlaneGeometry(26, 22);
groundGeo.rotateX(-Math.PI / 2);
const groundMat = new THREE.MeshStandardMaterial({ color: 0xe8e0c8, roughness: 1 });
const ground = new THREE.Mesh(groundGeo, groundMat);
ground.receiveShadow = true;
scene.add(ground);

const gridHelper = new THREE.GridHelper(26, 13, 0xc8c0aa, 0xd8d0b8);
gridHelper.position.y = 0.01;
scene.add(gridHelper);

// Room definitions
const ROOMS = [
  {
    label: 'Recepción',
    desc: 'Registro, información y venta de sellos de la Credencial',
    color: 0x8bc34a,
    x: -6, z: -4.5, w: 4, d: 3, h: 2.6,
    accent: 0x558b2f,
  },
  {
    label: 'Dormitorio 1',
    desc: '12 literas — sábanas y manta incluidas',
    color: 0x64b5f6,
    x: -1.5, z: -5, w: 7, d: 4, h: 2.8,
    accent: 0x1565c0,
  },
  {
    label: 'Dormitorio 2',
    desc: '12 literas — taquillas individuales',
    color: 0x4fc3f7,
    x: -1.5, z: -0.5, w: 7, d: 4, h: 2.8,
    accent: 0x0277bd,
  },
  {
    label: 'Cocina',
    desc: 'Microondas, nevera, fogones y utensilios',
    color: 0xffa726,
    x: 4.5, z: -4.5, w: 3, d: 3, h: 2.4,
    accent: 0xe65100,
  },
  {
    label: 'Baño Mujeres',
    desc: 'Duchas calientes 24h · Accesible',
    color: 0xf48fb1,
    x: 4.5, z: -1, w: 3, d: 2.5, h: 2.4,
    accent: 0xad1457,
  },
  {
    label: 'Baño Hombres',
    desc: 'Duchas calientes 24h · Accesible',
    color: 0x80cbc4,
    x: 4.5, z: 1.8, w: 3, d: 2.5, h: 2.4,
    accent: 0x00695c,
  },
  {
    label: 'Cafetería / Comedor',
    desc: 'Desayunos, menú del peregrino y bebidas',
    color: 0xffcc80,
    x: -6, z: -0.5, w: 4, d: 5, h: 2.2,
    accent: 0xf57c00,
  },
  {
    label: 'Patio y Jardín',
    desc: 'Espacio exterior, tendedero y parking bicicletas',
    color: 0xa5d6a7,
    x: -1.5, z: 4.5, w: 7, d: 3.5, h: 0.3,
    accent: 0x2e7d32,
    isOutdoor: true,
  },
];

const wallThick = 0.12;
const roomMeshes = [];

for (const room of ROOMS) {
  const group = new THREE.Group();
  group.position.set(room.x, 0, room.z);

  if (room.isOutdoor) {
    const pGeo = new THREE.BoxGeometry(room.w, room.h, room.d);
    const pMat = new THREE.MeshStandardMaterial({ color: room.color, roughness: 0.95 });
    const pMesh = new THREE.Mesh(pGeo, pMat);
    pMesh.position.y = room.h / 2;
    pMesh.receiveShadow = true;
    group.add(pMesh);

    for (let i = 0; i < 3; i++) {
      const treeH = 1.2 + Math.random() * 0.8;
      const trunk = new THREE.Mesh(
        new THREE.CylinderGeometry(0.06, 0.08, treeH, 5),
        new THREE.MeshStandardMaterial({ color: 0x795548 })
      );
      trunk.position.set((i - 1) * 2, treeH / 2 + room.h, Math.random() * 0.5);
      trunk.castShadow = true;
      group.add(trunk);

      const crown = new THREE.Mesh(
        new THREE.SphereGeometry(0.45 + Math.random() * 0.2, 7, 7),
        new THREE.MeshStandardMaterial({ color: 0x388e3c, roughness: 0.9 })
      );
      crown.position.set((i - 1) * 2, treeH + room.h + 0.35, Math.random() * 0.5);
      crown.castShadow = true;
      group.add(crown);
    }
  } else {
    // Floor
    const floorGeo = new THREE.BoxGeometry(room.w, 0.08, room.d);
    const floorMat = new THREE.MeshStandardMaterial({ color: room.color, roughness: 0.85 });
    const floor = new THREE.Mesh(floorGeo, floorMat);
    floor.position.y = 0.04;
    floor.receiveShadow = true;
    group.add(floor);

    const wallColor = new THREE.Color(room.color).lerp(new THREE.Color(0xffffff), 0.55);
    const wMat = new THREE.MeshStandardMaterial({ color: wallColor, roughness: 0.7 });

    const makeWall = (wx, wh, wd, px, py, pz) => {
      const g = new THREE.BoxGeometry(wx, wh, wd);
      const m = new THREE.Mesh(g, wMat);
      m.position.set(px, py, pz);
      m.castShadow = true;
      m.receiveShadow = true;
      return m;
    };

    group.add(makeWall(room.w * 0.4, room.h, wallThick, -room.w * 0.25, room.h / 2, room.d / 2));
    group.add(makeWall(room.w * 0.4, room.h, wallThick,  room.w * 0.25, room.h / 2, room.d / 2));
    group.add(makeWall(room.w, room.h, wallThick, 0, room.h / 2, -room.d / 2));
    group.add(makeWall(wallThick, room.h, room.d, -room.w / 2, room.h / 2, 0));
    group.add(makeWall(wallThick, room.h, room.d,  room.w / 2, room.h / 2, 0));

    const accentGeo = new THREE.BoxGeometry(room.w, 0.15, wallThick * 2);
    const accentMat = new THREE.MeshStandardMaterial({ color: room.accent, roughness: 0.6 });
    const accent = new THREE.Mesh(accentGeo, accentMat);
    accent.position.set(0, room.h + 0.075, room.d / 2);
    group.add(accent);

    if (room.label.includes('Dormitorio')) {
      const bedMat = new THREE.MeshStandardMaterial({ color: 0xf5f5f5, roughness: 0.9 });
      for (let r = 0; r < 3; r++) {
        for (let c = 0; c < 2; c++) {
          const bunk = new THREE.Mesh(new THREE.BoxGeometry(0.85, 0.12, 1.8), bedMat);
          bunk.position.set(
            -room.w / 2 + 0.8 + c * (room.w / 2) * 0.8,
            0.45,
            -room.d / 2 + 0.9 + r * (room.d / 3) * 0.75
          );
          group.add(bunk);
          const upper = bunk.clone();
          upper.position.y = 1.3;
          group.add(upper);
        }
      }
    }

    if (room.label.includes('Cocina')) {
      const counter = new THREE.Mesh(
        new THREE.BoxGeometry(room.w - 0.4, 0.8, 0.5),
        new THREE.MeshStandardMaterial({ color: 0xbdbdbd, roughness: 0.4, metalness: 0.3 })
      );
      counter.position.set(0, 0.4, -room.d / 2 + 0.3);
      group.add(counter);
    }
  }

  scene.add(group);

  // Invisible hit mesh
  const hitGeo = new THREE.BoxGeometry(room.w, Math.max(room.h, 0.5), room.d);
  const hitMat = new THREE.MeshBasicMaterial({ visible: false });
  const hitMesh = new THREE.Mesh(hitGeo, hitMat);
  hitMesh.position.set(room.x, Math.max(room.h, 0.5) / 2, room.z);
  hitMesh.userData.label = room.label;
  hitMesh.userData.desc = room.desc;
  scene.add(hitMesh);
  roomMeshes.push(hitMesh);
}

const labelEl = document.getElementById('albergue-room-label');
const nameEl = document.getElementById('albergue-room-name');
const descEl = document.getElementById('albergue-room-desc');
const raycaster = new THREE.Raycaster();
const mouse = new THREE.Vector2(-9, -9);

canvas.addEventListener('mousemove', (e) => {
  const rect = canvas.getBoundingClientRect();
  mouse.x = ((e.clientX - rect.left) / W) * 2 - 1;
  mouse.y = -((e.clientY - rect.top) / H) * 2 + 1;
  if (reducedMotion) renderFrame();
});

canvas.addEventListener('mouseleave', () => {
  mouse.set(-9, -9);
  if (labelEl) labelEl.classList.remove('visible');
  canvas.style.cursor = 'default';
  if (reducedMotion) renderFrame();
});

let autoTheta = Math.PI * 0.18;
let isDragging = false, prevX = 0;
const RADIUS = Math.sqrt(12 ** 2 + 18 ** 2);

canvas.addEventListener('mousedown', (e) => { isDragging = true; prevX = e.clientX; });
window.addEventListener('mouseup', () => { isDragging = false; });
window.addEventListener('mousemove', (e) => {
  if (!isDragging) return;
  autoTheta += (e.clientX - prevX) * 0.008;
  prevX = e.clientX;
  if (reducedMotion) renderFrame();
});

canvas.addEventListener('touchstart', (e) => { isDragging = true; prevX = e.touches[0].clientX; }, { passive: true });
window.addEventListener('touchend', () => { isDragging = false; });
window.addEventListener('touchmove', (e) => {
  if (!isDragging) return;
  autoTheta += (e.touches[0].clientX - prevX) * 0.008;
  prevX = e.touches[0].clientX;
  if (reducedMotion) renderFrame();
}, { passive: true });

let highlighted = null;

const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches ?? false;
let running = false;
let raf = 0;

function renderFrame() {
  if (!isDragging) autoTheta += 0.004;
  camera.position.x = RADIUS * Math.sin(autoTheta);
  camera.position.z = RADIUS * Math.cos(autoTheta);
  camera.position.y = 22;
  camera.lookAt(0, 0, 0);

  raycaster.setFromCamera(mouse, camera);
  const hits = raycaster.intersectObjects(roomMeshes, false);

  if (hits.length > 0) {
    const hit = hits[0].object;
    if (hit !== highlighted) {
      highlighted = hit;
      if (nameEl) nameEl.textContent = hit.userData.label;
      if (descEl) descEl.textContent = hit.userData.desc;
      if (labelEl) labelEl.classList.add('visible');
    }
    canvas.style.cursor = 'pointer';
  } else {
    if (highlighted) {
      highlighted = null;
      if (labelEl) labelEl.classList.remove('visible');
    }
    canvas.style.cursor = 'grab';
  }

  renderer.render(scene, camera);
}

function tick() {
  if (!running) return;
  raf = requestAnimationFrame(tick);
  renderFrame();
}

function start() {
  if (reducedMotion) {
    renderFrame();
    return;
  }
  if (running) return;
  running = true;
  tick();
}

function stop() {
  running = false;
  if (raf) cancelAnimationFrame(raf);
  raf = 0;
}

attachSectionActive(root, {
  auto: true,
  onChange(active) {
    if (active) start();
    else stop();
  },
});

// First paint so it never shows a blank canvas.
renderFrame();

const ro = new ResizeObserver(() => {
  W = wrap.clientWidth;
  H = wrap.clientHeight;
  renderer.setSize(W, H);
  camera.aspect = W / H;
  camera.updateProjectionMatrix();
  if (reducedMotion) renderFrame();
});
ro.observe(wrap);
</script>

<style>
  .map3d-albergue-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 12px;
    overflow: hidden;
  }
  .map3d-albergue-wrap canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
    cursor: grab;
    border-radius: 12px;
  }
  .albergue-room-label {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(20, 20, 20, 0.82);
    color: #fff;
    font-size: 0.78rem;
    line-height: 1.6;
    padding: 7px 16px;
    border-radius: 10px;
    pointer-events: none;
    text-align: center;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.2s;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .albergue-room-label.visible {
    opacity: 1;
  }
  .albergue-room-label strong {
    font-weight: 700;
    font-size: 0.82rem;
  }
  .albergue-hint {
    position: absolute;
    top: 10px;
    right: 12px;
    font-size: 0.68rem;
    color: rgba(50,50,50,0.55);
    pointer-events: none;
    font-style: italic;
  }
</style>
