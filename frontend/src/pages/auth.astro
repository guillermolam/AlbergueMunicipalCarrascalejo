---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const locals = Astro.locals as any;
const auth = locals.auth?.();
const role = locals.role ?? 'guest';

if (auth?.isAuthenticated) {
  return Astro.redirect(role === 'admin' ? '/admin' : '/camino');
}

if (auth?.redirectToSignIn) {
  return auth.redirectToSignIn();
}
---

<Layout title="Acceso · Albergue Carrascalejo" description="Inicio de sesión">
  <main class="mx-auto max-w-xl px-4 py-20">
    <section class="card-brut p-6" data-rough-frame>
      <h1 class="text-3xl font-900">Acceso</h1>
      <p class="mt-2 text-sm opacity-75">Autenticación gestionada por Clerk.</p>

      <div class="mt-5 flex flex-col gap-3">
        <a
          href="/sign-in"
          class="inline-flex justify-center border-2 border-black rounded-lg px-4 py-2 bg-[#00ab39] text-white font-800 no-underline"
        >
          Ir a iniciar sesión
        </a>
        <a
          href="/sign-up"
          class="inline-flex justify-center border-2 border-black rounded-lg px-4 py-2 bg-white text-black font-800 no-underline hover:bg-[#e8f5e9]"
        >
          Crear cuenta
        </a>
      </div>
    </section>
  </main>
</Layout>
