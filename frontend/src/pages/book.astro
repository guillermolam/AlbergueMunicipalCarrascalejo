  <style is:global>
    /* ─── BASE ─── */
    .wiz-wrap {
      min-height: 100vh;
      background: #FFF9F0;
      display: flex;
      overflow-x: hidden;
    }

    /* ─── SIDEBAR ─── */
    .wiz-sidebar {
      display: none;
      width: 320px;
      flex-shrink: 0;
      background: rgba(255,255,255,0.85);
      backdrop-filter: blur(8px);
      border-right: 3px solid rgba(212,165,116,0.25);
      padding: 2rem;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
    }
    @media (min-width: 1024px) { .wiz-sidebar { display: flex; flex-direction: column; } }

    .sidebar-logo { text-align: center; margin-bottom: 2.5rem; }
    .s-logo {
      width: 64px; height: 64px; margin: 0 auto 0.75rem;
      animation: logo-wobble-s 4s ease-in-out infinite;
    }
    @keyframes logo-wobble-s {
      0%,100% { transform: rotate(0deg) translateY(0); }
      25% { transform: rotate(-4deg) translateY(-2px); }
      75% { transform: rotate(4deg) translateY(-1px); }
    }
    .s-title { font-family: 'Cabin Sketch',cursive; font-size: 1.3rem; color: #00AB39; margin: 0; }
    .s-sub { font-family: 'Patrick Hand',cursive; font-size: 0.85rem; color: #888; margin: 0.25rem 0 0; }

    .step-track { position: relative; display: flex; flex-direction: column; gap: 1.25rem; }
    .track-line { position: absolute; left: 29px; top: 40px; width: 2px; height: calc(100% - 40px); pointer-events: none; }

    .step-btn {
      display: flex; align-items: center; gap: 1rem;
      background: none; border: none; cursor: default;
      padding: 0; text-align: left;
      transition: opacity 200ms;
    }
    .step-btn.active { cursor: default; }

    .step-circle { position: relative; width: 60px; height: 60px; flex-shrink: 0; }
    .step-circle svg { position: absolute; inset: 0; }
    .step-icon {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.3rem; color: white;
    }
    .step-icon.inactive { color: #5D4E37; }

    .step-info { flex: 1; min-width: 0; }
    .step-num { font-family: 'Cabin Sketch',cursive; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #888; }
    .step-num.inactive { color: #aaa; }
    .step-label { font-family: 'Shadows Into Light',cursive; font-size: 1.1rem; color: #999; margin: 0; transition: color 300ms; }
    .step-label.active { color: #5D4E37; }
    .step-sub { font-family: 'Patrick Hand',cursive; font-size: 0.8rem; color: #bbb; margin: 0; }
    .step-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .step-dot.active { background: #00AB39; animation: dot-pulse 2s ease-in-out infinite; }
    @keyframes dot-pulse { 0%,100%{ transform:scale(1); } 50%{ transform:scale(1.4); } }

    /* Sidebar active state updates via JS */
    .step-circle.done svg circle:first-child { fill: #E8F5E9 !important; }
    .step-circle.done svg circle:first-child { stroke: #00AB39 !important; }

    /* ─── MAIN ─── */
    .wiz-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Mobile bar */
    .mobile-bar {
      display: flex; align-items: center; gap: 0.75rem;
      position: sticky; top: 0; z-index: 50;
      background: rgba(255,249,240,0.95); backdrop-filter: blur(8px);
      border-bottom: 2px solid rgba(0,171,57,0.15);
      padding: 0.75rem 1rem;
    }
    @media (min-width: 1024px) { .mobile-bar { display: none; } }
    .mb-logo { width: 44px; height: 44px; animation: logo-wobble-s 4s ease-in-out infinite; }
    .mb-title { font-family: 'Cabin Sketch',cursive; font-size: 1.1rem; color: #00AB39; margin: 0; }
    .mb-step { font-family: 'Patrick Hand',cursive; font-size: 0.8rem; color: #888; margin: 0; }

    /* Progress bar */
    .prog-wrap { padding: 1rem 1.5rem 0; }
    .prog-bar {
      width: 100%; height: 8px;
      background: #E5E7EB;
      border-radius: 99px;
      overflow: hidden;
      margin-bottom: 0.4rem;
    }
    .prog-fill {
      height: 100%;
      background: linear-gradient(90deg, #006b24, #00AB39);
      border-radius: 99px;
      transition: width 500ms cubic-bezier(0.34,1.56,0.64,1);
    }
    .prog-labels { display: flex; justify-content: space-between; }
    .prog-text { font-family: 'Patrick Hand',cursive; font-size: 0.8rem; color: #888; }
    .prog-pct { font-family: 'Cabin Sketch',cursive; font-size: 0.85rem; color: #00AB39; font-weight: 700; }

    /* Step panels */
    .step-panel {
      flex: 1; padding: 1.5rem 1.5rem 2rem;
      animation: step-enter 400ms cubic-bezier(0.34,1.56,0.64,1) forwards;
    }
    .step-panel.hidden { display: none !important; }
    @keyframes step-enter {
      from { opacity: 0; transform: translateX(30px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    .step-panel.exiting {
      animation: step-exit 300ms ease forwards;
    }
    @keyframes step-exit {
      from { opacity: 1; transform: translateX(0); }
      to   { opacity: 0; transform: translateX(-30px); }
    }

    /* ─── STEP HEADER ─── */
    .step-header {
      display: flex; align-items: flex-start; gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .step-header.center {
      flex-direction: column; align-items: center; text-align: center; gap: 0.5rem;
    }
    .step-header-icon { flex-shrink: 0; }
    .step-header-icon.large { margin-bottom: 0.25rem; }
    .step-title {
      font-family: 'Cabin Sketch',cursive;
      font-size: clamp(1.8rem, 5vw, 3rem);
      color: #5D4E37;
      margin: 0 0 0.25rem;
      line-height: 1.1;
    }
    .step-desc {
      font-family: 'Patrick Hand',cursive;
      font-size: 1.1rem; color: #888; margin: 0;
    }
    .step-hint {
      font-family: 'Shadows Into Light',cursive;
      font-size: 1.4rem; color: #00AB39;
      white-space: nowrap;
      margin-left: auto;
    }
    @media (max-width: 600px) { .step-hint { display: none; } }

    /* ─── DATE SUMMARY BAR ─── */
    .date-summary {
      display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem;
      background: white; border: 2px solid #D4A574;
      border-radius: 14px; padding: 0.9rem 1.25rem;
      margin-bottom: 1.5rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
      transition: box-shadow 200ms;
    }
    .date-chip {
      display: flex; flex-direction: column;
      padding: 0.4rem 0.8rem;
      background: #F5F5F5; border-radius: 8px;
      transition: background 200ms, transform 200ms;
    }
    .date-chip.filled { background: #E8F5E9; transform: translateY(-1px); }
    .chip-label { font-family: 'Cabin Sketch',cursive; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #888; }
    .chip-val { font-family: 'Shadows Into Light',cursive; font-size: 1.1rem; color: #00AB39; }
    .nights-chip {
      display: flex; align-items: center; gap: 0.4rem;
      background: #00AB39; color: white;
      border-radius: 10px; padding: 0.5rem 1rem;
      font-family: 'Cabin Sketch',cursive; font-size: 1rem;
      animation: bounce-in-chip 400ms cubic-bezier(0.34,1.56,0.64,1);
    }
    @keyframes bounce-in-chip { from{transform:scale(0);opacity:0} to{transform:scale(1);opacity:1} }
    .date-actions { display: flex; align-items: center; gap: 0.75rem; margin-left: auto; }
    .time-hint { font-family: 'Patrick Hand',cursive; font-size: 0.82rem; color: #888; }
    .clear-btn {
      font-family: 'Patrick Hand',cursive; font-size: 0.85rem; color: #00AB39;
      background: none; border: none; cursor: pointer; text-decoration: underline;
      transition: color 150ms;
    }
    .clear-btn:hover { color: #006b24; }

    /* ─── PRICE CHIP & BREAKDOWN ─── */
    .price-chip {
      display: flex; flex-direction: column; align-items: center;
      background: linear-gradient(135deg, #006b24, #00AB39);
      color: white; border-radius: 10px; padding: 0.4rem 1rem;
      animation: bounce-in-chip 400ms cubic-bezier(0.34,1.56,0.64,1);
    }
    .price-chip-label {
      font-family: 'Cabin Sketch',cursive; font-size: 0.62rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.85;
    }
    .price-chip-val {
      font-family: 'Shadows Into Light',cursive; font-size: 1.2rem; font-weight: 700;
    }
    .price-breakdown {
      width: 100%; margin-top: 0.5rem; padding-top: 0.5rem;
      border-top: 1.5px dashed #D4A574;
      animation: fade-in-up-uc 300ms ease;
    }
    .price-breakdown-rows { display: flex; flex-direction: column; gap: 0.2rem; }
    .price-row {
      display: flex; justify-content: space-between; align-items: center;
      font-family: 'Patrick Hand',cursive; font-size: 0.82rem; color: #5D4E37;
      padding: 0.15rem 0.25rem; border-radius: 6px;
      transition: background 150ms;
    }
    .price-row:hover { background: rgba(0,171,57,0.06); }
    .price-row-night { opacity: 0.7; }
    .price-row-amt { font-weight: 700; color: #00AB39; }
    .price-breakdown-total {
      display: flex; justify-content: space-between; align-items: center;
      margin-top: 0.35rem; padding-top: 0.35rem;
      border-top: 2px solid #D4A574;
      font-family: 'Cabin Sketch',cursive; font-size: 1rem; color: #5D4E37;
    }
    .price-total-label { font-weight: 700; }
    .price-total-amt { font-weight: 700; color: #00AB39; font-size: 1.15rem; }

    /* ─── CALENDAR ─── */
    .cal-wrap {
      position: relative; border-radius: 20px;
      padding: 1rem 1.5rem 1.5rem;
      min-height: 400px;
    }
    .cal-border {
      position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none;
      filter: drop-shadow(3px 4px 6px rgba(0,0,0,0.08));
    }
    .cal-inner { position: relative; z-index: 2; }
    .cal-nav {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 1.25rem; padding: 0 0.5rem;
    }
    .cal-month-title {
      font-family: 'Cabin Sketch',cursive; font-size: 1.8rem; color: #00AB39; margin: 0;
      transition: opacity 200ms, transform 200ms;
    }
    .cal-nav-btn {
      position: relative; width: 44px; height: 44px;
      display: flex; align-items: center; justify-content: center;
      background: white; border: 3px solid #00AB39;
      color: #00AB39; cursor: pointer;
      transition: background 150ms, transform 150ms;
      border-radius: 50% 45% 48% 52% / 52% 48% 50% 50%;
    }
    .cal-nav-btn:hover { background: #E8F5E9; transform: scale(1.1); }
    .cal-nav-btn:active { transform: scale(0.92); }
    .nav-circle { position: absolute; inset: 0; pointer-events: none; }
    .cal-today-btn {
      font-family: 'Patrick Hand',cursive; font-size: 0.82rem;
      color: #00AB39; background: #E8F5E9; border: 2px solid #00AB39;
      border-radius: 8px; padding: 0.3rem 0.75rem; cursor: pointer;
      transition: all 150ms; white-space: nowrap;
    }
    .cal-today-btn:hover { background: #00AB39; color: white; transform: scale(1.05); }
    .cal-today-btn:active { transform: scale(0.95); }
    .cal-dow-row {
      display: grid; grid-template-columns: repeat(7, 1fr);
      gap: 0.25rem; margin-bottom: 0.6rem;
      opacity: 0.9;
    }
    .cal-dow-row span {
      text-align: center; font-family: 'Cabin Sketch',cursive;
      font-size: clamp(0.75rem, 1.5vw, 1rem); color: #5D4E37;
      padding: 0.25rem 0;
    }
    .cal-grid {
      display: grid; grid-template-columns: repeat(7, 1fr);
      gap: clamp(3px, 0.6vw, 8px);
    }
    .cal-day {
      position: relative;
      aspect-ratio: 1;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      cursor: pointer; transition: transform 150ms, box-shadow 150ms;
      border: none; background: none; padding: 0;
      gap: 0;
    }
    .cal-day:not(.disabled):hover { transform: scale(1.08); box-shadow: 0 3px 12px rgba(0,171,57,0.15); z-index: 5; }
    .cal-day:not(.disabled):active { transform: scale(0.94); }
    .cal-day.disabled { cursor: not-allowed; opacity: 0.5; }
    .cal-day-bg {
      position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none;
    }
    .cal-day-num {
      position: relative; z-index: 2;
      font-family: 'Patrick Hand',cursive; font-size: clamp(0.78rem, 1.8vw, 1rem);
      color: #5D4E37; line-height: 1.1;
    }
    .cal-day-beds {
      position: relative; z-index: 2;
      font-family: 'Cabin Sketch',cursive; font-size: clamp(0.6rem, 1.4vw, 0.75rem);
      color: #00AB39; line-height: 1; opacity: 0.9;
      white-space: nowrap;
    }
    .cal-day-beds.low { color: #ED1C24; font-weight: 700; }
    .cal-day-beds.none { color: #999; }
    .cal-day-price {
      position: relative; z-index: 2;
      font-family: 'Patrick Hand',cursive; font-size: clamp(0.58rem, 1.2vw, 0.72rem);
      color: #5D4E37; opacity: 0.7; line-height: 1;
    }
    .cal-day.today .cal-day-num { color: white; font-family: 'Cabin Sketch',cursive; }
    .cal-day.today .cal-day-beds { color: white; opacity: 0.9; }
    .cal-day.today .cal-day-price { color: white; opacity: 0.7; }
    .cal-day.disabled .cal-day-num { color: #ccc; }
    .cal-day.disabled .cal-day-beds,
    .cal-day.disabled .cal-day-price { display: none; }
    .cal-day.in-range { background: rgba(0,171,57,0.1); border-radius: 4px; }
    .cal-day.selected .cal-day-num,
    .cal-day.checkin .cal-day-num,
    .cal-day.checkout .cal-day-num { color: white; font-family: 'Cabin Sketch',cursive; }
    .cal-day.checkin .cal-day-beds,
    .cal-day.checkout .cal-day-beds { color: white; opacity: 0.9; }
    .cal-day.checkin .cal-day-price,
    .cal-day.checkout .cal-day-price { color: white; opacity: 0.7; }
    .cal-day.in-range .cal-day-beds { color: #006b24; }
    .cal-day.in-range .cal-day-price { color: #006b24; opacity: 0.7; }
    .today-dot {
      position: absolute; bottom: 4%; left: 50%; transform: translateX(-50%);
      width: 4px; height: 4px; border-radius: 50%; background: white; z-index: 3;
    }

    /* ─── DOC CARDS ─── */
    .doc-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.5rem; }
    @media (max-width: 560px) { .doc-cards { grid-template-columns: 1fr; } }
    .doc-card {
      position: relative; border-radius: 20px;
      background: white; border: 2.5px solid #D4A574;
      cursor: pointer; padding: 1.5rem;
      transition: transform 200ms, box-shadow 200ms, border-color 200ms;
      overflow: hidden;
    }
    .doc-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(212,165,116,0.25); }
    .doc-card.selected { border-color: #00AB39; box-shadow: 0 0 0 3px rgba(0,171,57,0.2); }
    .doc-card.selected .doc-selected-ring {
      display: block; animation: ring-grow 300ms cubic-bezier(0.34,1.56,0.64,1);
    }
    .doc-selected-ring {
      display: none; position: absolute; top: 10px; right: 10px;
      width: 24px; height: 24px; border-radius: 50%;
      background: #00AB39;
      background-image: url("data:image/svg+xml,%3Csvg width='14' height='10' viewBox='0 0 14 10' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 5L5 9L13 1' stroke='white' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E");
      background-repeat: no-repeat; background-position: center;
    }
    @keyframes ring-grow { from{transform:scale(0)} to{transform:scale(1)} }
    .doc-card-inner { position: relative; z-index: 2; }
    .doc-illustration { margin-bottom: 1rem; }
    .doc-illustration svg { width: 100%; height: auto; max-height: 140px; }
    .doc-name { font-family: 'Cabin Sketch',cursive; font-size: 1.2rem; color: #5D4E37; margin: 0 0 0.25rem; }
    .doc-desc { font-family: 'Patrick Hand',cursive; font-size: 0.9rem; color: #888; margin: 0 0 0.5rem; }
    .doc-req { font-family: 'Patrick Hand',cursive; font-size: 0.82rem; color: #555; margin: 0; display: flex; align-items: center; gap: 0.4rem; }
    .req-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .req-dot.green { background: #00AB39; }
    .req-dot.blue { background: #3B82F6; }

    /* ─── UPLOAD ZONE ─── */
    .upload-zone { margin-top: 1rem; }
    .upload-zone-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @media (max-width: 560px) { .upload-zone-inner { grid-template-columns: 1fr; } }
    .upload-face {
      position: relative; border-radius: 16px; min-height: 140px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: transform 200ms;
    }
    .upload-face:hover { transform: scale(1.02); }
    .upload-border { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
    .upload-content { position: relative; z-index: 2; text-align: center; padding: 1.5rem; }
    .upload-icon { font-size: 2rem; margin-bottom: 0.5rem; }
    .upload-label { font-family: 'Cabin Sketch',cursive; font-size: 1rem; color: #5D4E37; margin: 0 0 0.25rem; }
    .upload-hint { font-family: 'Patrick Hand',cursive; font-size: 0.82rem; color: #aaa; margin: 0; }
    .upload-input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }

    /* ─── INFO CARD (Step 3) ─── */
    .info-card { position: relative; border-radius: 16px; margin-bottom: 1rem; }
    .info-card-border { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
    .info-card-inner { position: relative; z-index: 2; padding: 1.75rem; display: flex; flex-direction: column; gap: 0; }
    .info-section { padding: 1.25rem 0; }
    .info-section:first-child { padding-top: 0; }
    .info-section-title {
      font-family: 'Cabin Sketch',cursive; font-size: 1.1rem; color: #5D4E37;
      font-weight: 700; margin: 0 0 1rem;
      display: flex; align-items: center; gap: 0.5rem;
    }
    .section-divider { height: 1px; background: rgba(212,165,116,0.4); border: none; margin: 0; border-top: 1.5px dashed rgba(212,165,116,0.5); }

    /* Form fields */
    .fg { display: flex; flex-direction: column; gap: 0.3rem; }
    .fl { font-family: 'Cabin Sketch',cursive; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #5D4E37; }
    .req { color: #ED1C24; }
    .fi {
      width: 100%; padding: 0.7rem 0.9rem;
      font-family: 'Patrick Hand',cursive; font-size: 1rem; color: #5D4E37;
      background: #FFF9F0; border: 1.5px solid #E8E0D5;
      border-radius: 10px; outline: none;
      transition: border-color 200ms, box-shadow 200ms, transform 150ms;
    }
    .fi:focus {
      border-color: #00AB39;
      box-shadow: 0 0 0 3px rgba(0,171,57,0.12), 0 2px 6px rgba(0,171,57,0.08);
      transform: translateY(-1px);
    }
    .fi.invalid { border-color: #ED1C24; animation: shake-field 0.4s ease; }
    @keyframes shake-field {
      0%,100% { transform: translateX(0); }
      20% { transform: translateX(-5px); }
      40% { transform: translateX(5px); }
      60% { transform: translateX(-3px); }
      80% { transform: translateX(3px); }
    }
    .ferr { font-family: 'Patrick Hand',cursive; font-size: 0.76rem; color: #ED1C24; display: none; }
    .fg.has-error .ferr { display: block; animation: fade-in-err 200ms ease; }
    @keyframes fade-in-err { from{opacity:0;transform:translateY(-4px)} to{opacity:1;transform:none} }
    .fg.has-error .fi { border-color: #ED1C24; }

    .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 0.75rem; }
    .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; }
    @media (max-width: 660px) {
      .form-row-2 { grid-template-columns: 1fr; }
      .form-row-3 { grid-template-columns: 1fr; }
    }

    /* Phone input */
    .phone-wrap { display: flex; border: 1.5px solid #E8E0D5; border-radius: 10px; overflow: hidden; background: #FFF9F0; transition: border-color 200ms, box-shadow 200ms; }
    .phone-wrap:focus-within { border-color: #00AB39; box-shadow: 0 0 0 3px rgba(0,171,57,0.12); }
    .phone-prefix {
      display: flex; align-items: center; gap: 0.35rem;
      padding: 0.7rem 0.75rem; border-right: 1.5px solid #E8E0D5;
      background: #F5EFE8; cursor: pointer; flex-shrink: 0;
      transition: background 150ms;
    }
    .phone-prefix:hover { background: #EDE4D8; }
    .flag { font-size: 1.2rem; }
    .prefix-code { font-family: 'Patrick Hand',cursive; font-size: 0.9rem; color: #5D4E37; }
    .phone-input { border: none !important; box-shadow: none !important; background: transparent !important; flex: 1; transform: none !important; }

    /* Phone prefix searchable dropdown */
    .phone-outer { position: relative; }
    .phone-prefix-drop {
      display: none; position: absolute; top: calc(100% + 2px); left: 0; z-index: 300;
      width: 280px; background: #fff; border: 1.5px solid #D4A574; border-radius: 10px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.14); overflow: hidden;
    }
    .phone-prefix-drop.open { display: block; }
    .phone-drop-search {
      width: 100%; box-sizing: border-box; padding: 0.6rem 0.75rem;
      border: none; border-bottom: 1.5px solid #E8E0D5;
      font-family: 'Patrick Hand',cursive; font-size: 0.9rem; color: #3D2B1F;
      background: #FFF9F0; outline: none;
    }
    .phone-drop-search::placeholder { color: #b8a89a; }
    .phone-drop-list { max-height: 220px; overflow-y: auto; list-style: none; margin: 0; padding: 0; }
    .phone-drop-list li {
      display: flex; align-items: center; gap: 0.6rem;
      padding: 0.5rem 0.75rem; cursor: pointer;
      font-family: 'Patrick Hand',cursive; font-size: 0.88rem; color: #3D2B1F;
      border-bottom: 1px solid #F3EAE0;
    }
    .phone-drop-list li:last-child { border-bottom: none; }
    .phone-drop-list li:hover, .phone-drop-list li.active { background: #F0FFF4; }
    .phone-drop-list .pdl-dial { margin-left: auto; color: #888; font-size: 0.82rem; }

    /* Country picker (nationality + address country) */
    .country-pick-wrap { display: flex; align-items: center; border: 1.5px solid #E8E0D5; border-radius: 10px; background: #FFF9F0; padding-left: 0.7rem; transition: border-color 200ms, box-shadow 200ms; gap: 0.4rem; }
    .country-pick-wrap:focus-within { border-color: #00AB39; box-shadow: 0 0 0 3px rgba(0,171,57,0.12); }
    .country-pick-flag { font-size: 1.2rem; flex-shrink: 0; }
    .country-pick-input { border: none !important; box-shadow: none !important; background: transparent !important; transform: none !important; padding-left: 0 !important; flex: 1; }
    .country-drop {
      position: absolute; top: 100%; left: 0; right: 0; z-index: 200;
      margin: 2px 0 0; padding: 0; list-style: none;
      background: #fff; border: 1.5px solid #D4A574; border-radius: 8px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.12); max-height: 220px; overflow-y: auto;
      display: none;
    }
    .country-drop li {
      display: flex; align-items: center; gap: 0.5rem;
      padding: 0.55rem 0.9rem; cursor: pointer;
      font-family: 'Patrick Hand',cursive; font-size: 0.9rem; color: #3D2B1F;
      border-bottom: 1px solid #F3EAE0; list-style: none;
    }
    .country-drop li:last-child { border-bottom: none; }
    .country-drop li:hover, .country-drop li.active { background: #F0FFF4; }
    .country-drop .cdl-code { margin-left: auto; color: #aaa; font-size: 0.78rem; }

    /* Address */
    .addr-wrap { display: flex; align-items: center; border: 1.5px solid #E8E0D5; border-radius: 10px; background: #FFF9F0; padding-left: 0.7rem; transition: border-color 200ms, box-shadow 200ms; }
    .addr-wrap:focus-within { border-color: #00AB39; box-shadow: 0 0 0 3px rgba(0,171,57,0.12); }
    .addr-input { border: none !important; box-shadow: none !important; background: transparent !important; transform: none !important; padding-left: 0.4rem !important; }

    /* ─── BED SELECTION ─── */
    .bed-legend { display: flex; gap: 1.5rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
    .legend-item { display: flex; align-items: center; gap: 0.4rem; font-family: 'Patrick Hand',cursive; font-size: 0.9rem; color: #5D4E37; }
    .legend-dot { width: 14px; height: 14px; border-radius: 4px; }
    .legend-dot.available { background: #FFF9F0; border: 2px solid #D4A574; }
    .legend-dot.occupied  { background: #F5F5F5; border: 2px solid #E0E0E0; }
    .legend-dot.selected  { background: #00AB39; border: 2px solid #006b24; }

    .dorm-wrap { position: relative; border-radius: 20px; margin-bottom: 1rem; }
    .dorm-border { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; filter: drop-shadow(2px 3px 8px rgba(0,0,0,0.07)); }
    .dorm-inner { position: relative; z-index: 2; padding: 1.5rem; }
    .bunk-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    @media (max-width: 560px) { .bunk-grid { grid-template-columns: repeat(2, 1fr); } }

    .bunk { display: flex; flex-direction: column; gap: 0.5rem; }
    .bunk-label { font-family: 'Cabin Sketch',cursive; font-size: 0.85rem; color: #5D4E37; font-weight: 700; text-align: center; }

    .bed-btn {
      position: relative; width: 100%; aspect-ratio: 5/3;
      display: flex; align-items: center; justify-content: center;
      border: none; cursor: pointer; padding: 0;
      transition: transform 200ms, filter 200ms;
    }
    .bed-btn:not([data-state="occupied"]):hover { transform: scale(1.06); filter: brightness(1.03); }
    .bed-btn:not([data-state="occupied"]):active { transform: scale(0.94); }
    .bed-btn[data-state="occupied"] { cursor: not-allowed; opacity: 0.7; }
    .bed-btn[data-state="selected"] .bed-bg rect { fill: #E8F5E9 !important; stroke: #00AB39 !important; stroke-width: 3 !important; }
    .bed-bg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
    .bed-pos {
      position: relative; z-index: 2;
      font-family: 'Patrick Hand',cursive; font-size: 0.85rem; color: #5D4E37;
    }
    .occupied-text { color: #aaa; text-decoration: line-through; }
    .bed-selection-hint { text-align: center; font-family: 'Patrick Hand',cursive; font-size: 0.9rem; color: #aaa; }

    /* ─── UPLOAD PHASE (Step 2 transition) ─── */
    .squiggle-line { width: 140px; height: 12px; margin: 0.5rem auto 0; display: block; }
    .doc-card-bg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
    .upload-formats { font-family: 'Patrick Hand',cursive; font-size: 0.72rem; color: #bbb; margin: 0.4rem 0 0; }
    .upload-cam-icon { margin-bottom: 0.5rem; }

    .doc-cards.phase-out {
      animation: cards-slide-up 400ms cubic-bezier(0.4,0,0.2,1) forwards;
    }
    @keyframes cards-slide-up {
      0%   { opacity: 1; transform: translateY(0) scale(1); }
      100% { opacity: 0; transform: translateY(-30px) scale(0.95); }
    }

    .upload-phase {
      animation: upload-slide-in 450ms cubic-bezier(0.34,1.56,0.64,1) forwards;
    }
    @keyframes upload-slide-in {
      0%   { opacity: 0; transform: translateY(20px) scale(0.96); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    .upload-phase.phase-out {
      animation: upload-slide-out 350ms ease forwards;
    }
    @keyframes upload-slide-out {
      0%   { opacity: 1; transform: translateY(0) scale(1); }
      100% { opacity: 0; transform: translateY(20px) scale(0.96); }
    }
    .doc-cards.phase-in {
      animation: cards-slide-down 400ms cubic-bezier(0.34,1.56,0.64,1) forwards;
    }
    @keyframes cards-slide-down {
      0%   { opacity: 0; transform: translateY(-20px) scale(0.95); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    .selected-doc-bar {
      display: flex; align-items: center; justify-content: space-between;
      background: #E8F5E9; border: 2px solid #00AB39;
      border-radius: 14px; padding: 0.75rem 1.25rem;
      margin-bottom: 1.25rem;
      animation: bar-pop 350ms cubic-bezier(0.34,1.56,0.64,1);
    }
    @keyframes bar-pop { from{transform:scale(0.9);opacity:0} to{transform:scale(1);opacity:1} }
    .selected-doc-info { display: flex; align-items: center; gap: 0.6rem; }
    .selected-doc-icon { font-size: 1.5rem; }
    .selected-doc-label {
      font-family: 'Cabin Sketch',cursive; font-size: 1.05rem; color: #006b24; font-weight: 700;
    }
    .change-doc-btn {
      font-family: 'Patrick Hand',cursive; font-size: 0.9rem; color: #00AB39;
      background: white; border: 1.5px solid #00AB39; border-radius: 10px;
      padding: 0.4rem 0.9rem; cursor: pointer;
      transition: background 150ms, transform 150ms;
    }
    .change-doc-btn:hover { background: #E8F5E9; transform: scale(1.05); }

    .upload-complete {
      margin-top: 1rem;
      animation: fade-in-up-uc 300ms ease;
    }
    @keyframes fade-in-up-uc { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:none} }
    .uploaded-file-row {
      display: flex; align-items: center; gap: 0.75rem;
      background: #E8F5E9; border: 1.5px solid #A5D6A7;
      border-radius: 12px; padding: 0.75rem 1rem;
    }
    .uploaded-file-check {
      width: 28px; height: 28px; flex-shrink: 0;
      background: #00AB39; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
    }
    .uploaded-file-check svg { display: block; }
    .check-draw {
      stroke-dasharray: 30; stroke-dashoffset: 30;
      animation: draw-check 500ms ease 150ms forwards;
    }
    @keyframes draw-check { to { stroke-dashoffset: 0; } }
    .uploaded-file-name {
      flex: 1; font-family: 'Patrick Hand',cursive; font-size: 0.95rem; color: #006b24;
    }
    .uploaded-file-remove {
      background: none; border: none; cursor: pointer;
      font-size: 1.3rem; color: #888; line-height: 1;
      transition: color 150ms, transform 150ms;
    }
    .uploaded-file-remove:hover { color: #ED1C24; transform: scale(1.2); }

    .ocr-result {
      margin-top: 1rem; background: #FAFAFA;
      border: 1.5px solid #E0E0E0; border-radius: 12px;
      padding: 1rem 1.25rem;
      animation: fade-in-up-uc 400ms ease;
    }
    .ocr-header {
      display: flex; align-items: center; gap: 0.5rem;
      font-family: 'Cabin Sketch',cursive; font-size: 0.9rem; color: #00AB39; font-weight: 700;
      margin-bottom: 0.75rem;
    }
    .ocr-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 1.5rem; }
    @media (max-width: 500px) { .ocr-fields { grid-template-columns: 1fr; } }
    .ocr-field { display: flex; flex-direction: column; gap: 0.15rem; }
    .ocr-label { font-family: 'Cabin Sketch',cursive; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em; color: #888; }
    .ocr-value { font-family: 'Patrick Hand',cursive; font-size: 0.95rem; color: #5D4E37; }

    /* ─── ISO BED GRID (Step 4) ─── */
    .legend-swatch {
      width: 18px; height: 18px; border-radius: 5px;
      border: 2px solid; display: inline-block;
    }
    .dorm-title {
      font-family: 'Cabin Sketch',cursive; font-size: 1.15rem; color: #5D4E37;
      font-weight: 700; margin: 0 0 1rem;
      display: flex; align-items: center; gap: 0.4rem;
    }
    .dorm-range {
      font-family: 'Patrick Hand',cursive; font-size: 0.9rem; color: #888; font-weight: 400;
    }
    .iso-bed-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem 0.6rem;
    }
    @media (max-width: 400px) { .iso-bed-grid { grid-template-columns: repeat(2, 1fr); } }

    .bunk-cell {
      position: relative; width: 100%;
      transition: transform 200ms;
    }
    .bunk-cell:hover { transform: translateY(-3px); }
    .bunk-cell svg { width: 100%; height: auto; display: block; }
    .bunk-cell .bunk-label {
      text-align: center; font-family: 'Cabin Sketch',cursive; font-size: 0.72rem;
      color: #5D4E37; margin-top: 0.15rem; font-weight: 700;
    }
    /* Clickable zones within each bunk SVG */
    .bunk-zone {
      cursor: pointer; transition: opacity 150ms, transform 150ms;
    }
    .bunk-zone:hover:not(.occupied) { opacity: 0.8; transform: scale(1.03); }
    .bunk-zone.occupied { cursor: not-allowed; }
    .bunk-zone.occupied:hover { opacity: 1; }
    .bunk-zone.selected { filter: brightness(1.05); }

    /* Bed info card */
    .bed-info-card {
      margin-top: 1.25rem;
      background: white; border: 2.5px solid #0071BC;
      border-radius: 16px; padding: 1rem 1.25rem;
      animation: bed-card-pop 400ms cubic-bezier(0.34,1.56,0.64,1);
    }
    @keyframes bed-card-pop { from{transform:scale(0.85);opacity:0} to{transform:scale(1);opacity:1} }
    .bed-info-inner { display: flex; flex-direction: column; gap: 0.6rem; }
    .bed-info-badge {
      width: 28px; height: 28px; border-radius: 50%;
      background: #0071BC; color: white;
      font-size: 0.9rem; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      align-self: flex-end;
    }
    .bed-info-header { display: flex; align-items: center; gap: 0.6rem; }
    .bed-info-num { font-family: 'Cabin Sketch',cursive; font-size: 1.2rem; color: #0071BC; font-weight: 700; }
    .bed-info-detail {
      display: flex; align-items: center; gap: 1rem;
    }
    .bed-info-position { font-family: 'Patrick Hand',cursive; font-size: 0.95rem; color: #5D4E37; margin: 0; }
    .bed-info-bunk { font-family: 'Patrick Hand',cursive; font-size: 0.85rem; color: #888; margin: 0.1rem 0 0; }
    .bed-info-divider { height: 1.5px; background: rgba(0,113,188,0.2); border-top: 1px dashed rgba(0,113,188,0.3); }
    .bed-info-dorm { font-family: 'Patrick Hand',cursive; font-size: 0.9rem; color: #5D4E37; margin: 0; }

    .bed-ready {
      text-align: center; margin-top: 1rem;
      animation: fade-in-up-uc 400ms ease;
    }
    .bed-ready-title { font-family: 'Shadows Into Light',cursive; font-size: 1.4rem; color: #00AB39; margin: 0; }
    .bed-ready-sub { font-family: 'Patrick Hand',cursive; font-size: 0.9rem; color: #888; margin: 0.2rem 0 0; }

    /* Bunk illustration in info card */
    .bunk-illus {
      width: 48px; height: 48px; flex-shrink: 0;
    }
    .bunk-illus svg { width: 100%; height: 100%; }

    /* ─── NIGHT TABS ─── */
    .night-tabs-wrap {
      margin-bottom: 1rem; padding: 0.75rem 1rem;
      background: white; border: 2px solid #D4A574; border-radius: 14px;
    }
    .night-tabs-label {
      font-family: 'Cabin Sketch',cursive; font-size: 0.78rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.06em; color: #5D4E37; margin-bottom: 0.5rem;
    }
    .night-tabs {
      display: flex; gap: 0.35rem; flex-wrap: wrap;
    }
    .night-tab {
      position: relative; padding: 0.35rem 0.7rem;
      font-family: 'Patrick Hand',cursive; font-size: 0.85rem;
      border: 2px solid #D4A574; border-radius: 10px; background: #FFF9F0;
      color: #5D4E37; cursor: pointer;
      transition: all 200ms;
    }
    .night-tab:hover { border-color: #00AB39; background: #E8F5E9; }
    .night-tab.active {
      border-color: #00AB39; background: #00AB39; color: white;
      font-weight: 700; box-shadow: 0 2px 8px rgba(0,171,57,0.2);
    }
    .night-tab.assigned {
      border-color: #0071BC; background: #E3F2FD;
    }
    .night-tab.assigned.active {
      background: #0071BC; color: white; border-color: #0071BC;
    }
    .night-tab-dot {
      display: inline-block; width: 6px; height: 6px; border-radius: 50%;
      margin-left: 0.3rem; vertical-align: middle;
    }

    /* ─── BED SCHEDULE ─── */
    .bed-schedule {
      margin-top: 1rem; background: white; border: 2px solid #D4A574;
      border-radius: 14px; padding: 0.75rem 1rem;
      animation: fade-in-up-uc 350ms ease;
    }
    .bed-schedule-header {
      display: flex; align-items: center; gap: 0.4rem;
      font-family: 'Cabin Sketch',cursive; font-size: 0.85rem; font-weight: 700;
      color: #00AB39; margin-bottom: 0.5rem;
    }
    .bed-schedule-rows { display: flex; flex-direction: column; gap: 0.3rem; }
    .sched-row {
      display: flex; align-items: center; gap: 0.5rem;
      padding: 0.3rem 0.6rem; border-radius: 8px;
      font-family: 'Patrick Hand',cursive; font-size: 0.85rem; color: #5D4E37;
      background: #F9F9F6; border: 1px solid #E8E0D5;
    }
    .sched-night {
      font-family: 'Cabin Sketch',cursive; font-size: 0.72rem; font-weight: 700;
      color: white; background: #00AB39; border-radius: 6px;
      padding: 0.15rem 0.4rem; min-width: 52px; text-align: center;
    }
    .sched-bed { flex: 1; }
    .sched-remove {
      background: none; border: none; cursor: pointer; color: #aaa;
      font-size: 1rem; transition: color 150ms;
    }
    .sched-remove:hover { color: #ED1C24; }
    .sched-empty {
      font-family: 'Patrick Hand',cursive; font-size: 0.82rem; color: #bbb;
      font-style: italic; padding: 0.2rem 0;
    }

    /* ─── BED TOOLTIP (Chart.js style) ─── */
    .bed-tooltip {
      position: fixed; z-index: 999; pointer-events: none;
      background: rgba(30,30,30,0.92); backdrop-filter: blur(6px);
      border-radius: 10px; padding: 0.65rem 0.85rem;
      min-width: 180px; max-width: 260px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.25);
      transition: opacity 150ms, transform 100ms;
    }
    .bed-tooltip-arrow {
      position: absolute; bottom: -6px; left: 50%; transform: translateX(-50%);
      width: 0; height: 0;
      border-left: 7px solid transparent; border-right: 7px solid transparent;
      border-top: 7px solid rgba(30,30,30,0.92);
    }
    .bed-tooltip-title {
      font-family: 'Cabin Sketch',cursive; font-size: 0.9rem; font-weight: 700;
      color: white; margin-bottom: 0.35rem;
    }
    .bed-tooltip-status {
      display: flex; align-items: center; gap: 0.4rem;
      font-family: 'Patrick Hand',cursive; font-size: 0.82rem; color: #ccc;
      margin-bottom: 0.3rem;
    }
    .tt-dot {
      width: 8px; height: 8px; border-radius: 3px; flex-shrink: 0;
    }
    .bed-tooltip-nights {
      display: flex; flex-direction: column; gap: 0.2rem;
    }
    .tt-night-row {
      display: flex; align-items: center; gap: 0.4rem;
      font-family: 'Patrick Hand',cursive; font-size: 0.78rem;
    }
    .tt-night-label { color: #aaa; min-width: 48px; }
    .tt-night-val { color: white; }
    .tt-night-val.avail { color: #A5D6A7; }
    .tt-night-val.unavail { color: #EF9A9A; }
    .tt-night-val.selected { color: #90CAF9; }

    /* ─── BUNK ANIMATIONS ─── */
    .bunk-cell {
      animation: bunk-float 4s ease-in-out infinite;
    }
    .bunk-cell:nth-child(2) { animation-delay: -0.7s; }
    .bunk-cell:nth-child(3) { animation-delay: -1.4s; }
    .bunk-cell:nth-child(4) { animation-delay: -2.1s; }
    .bunk-cell:nth-child(5) { animation-delay: -2.8s; }
    .bunk-cell:nth-child(6) { animation-delay: -3.5s; }
    @keyframes bunk-float {
      0%,100% { transform: translateY(0); }
      50% { transform: translateY(-3px); }
    }
    .bunk-cell:hover { animation: none; transform: translateY(-4px) scale(1.03); }

    /* ─── PAYMENT ─── */
    .payment-card { position: relative; border-radius: 16px; margin-bottom: 1rem; }
    .payment-inner { position: relative; z-index: 2; padding: 1.75rem; display: flex; flex-direction: column; gap: 1rem; }
    .price-summary-bar {
      display: flex; justify-content: space-between; align-items: center;
      background: #E8F5E9; border-radius: 12px; padding: 0.9rem 1.25rem;
      margin-bottom: 0.5rem;
    }
    .psb-label { font-family: 'Cabin Sketch',cursive; font-size: 0.9rem; color: #006b24; font-weight: 700; text-transform: uppercase; }
    .psb-val { font-family: 'Shadows Into Light',cursive; font-size: 2rem; color: #00AB39; }
    .card-input-wrap { position: relative; }
    .card-number { padding-right: 3.5rem !important; letter-spacing: 0.1em; }
    .card-icons { position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); pointer-events: none; }
    .cvv-wrap { position: relative; display: flex; align-items: center; }
    .cvv-help {
      position: absolute; right: 0.75rem; background: none; border: none;
      cursor: pointer; color: #888; display: flex; transition: color 150ms;
    }
    .cvv-help:hover { color: #00AB39; }
    .security-note {
      display: flex; align-items: center; gap: 0.5rem;
      font-family: 'Patrick Hand',cursive; font-size: 0.82rem; color: #888;
      background: #F0FFF4; border-radius: 8px; padding: 0.6rem 0.9rem;
    }

    /* ─── SUMMARY ─── */
    .summary-card { position: relative; border-radius: 16px; margin-bottom: 1.5rem; }
    .summary-inner { position: relative; z-index: 2; padding: 1.75rem; }
    .summary-row { display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 0; border-bottom: 1px dashed rgba(212,165,116,0.3); }
    .summary-row:last-child { border-bottom: none; }
    .sum-label { font-family: 'Patrick Hand',cursive; font-size: 0.95rem; color: #888; }
    .sum-val { font-family: 'Cabin Sketch',cursive; font-size: 1rem; color: #5D4E37; text-align: right; }
    .summary-divider { height: 2px; background: rgba(212,165,116,0.4); margin: 0.5rem 0; }
    .total-row { padding-top: 1rem; }
    .total-label { font-family: 'Cabin Sketch',cursive; font-size: 1.1rem; color: #1A1A1A; font-weight: 700; }
    .total-val { font-family: 'Shadows Into Light',cursive; font-size: 2.2rem; color: #00AB39; }

    .btn-confirm {
      position: relative; width: 100%; padding: 1rem 2rem;
      display: flex; align-items: center; justify-content: center;
      border: none; cursor: pointer; border-radius: 14px;
      transition: transform 200ms; overflow: hidden;
      animation: cta-rock 3.5s ease-in-out infinite;
    }
    .btn-confirm:hover { animation: none; transform: scale(1.06) rotateZ(-3deg) translateY(-3px); }
    .btn-confirm:active { transform: scale(0.95); animation: none; }
    @keyframes cta-rock {
      0%,100% { transform: rotate(0deg) translateY(0); }
      25% { transform: rotate(-2deg) translateY(-2px); }
      75% { transform: rotate(2deg) translateY(-1px); }
    }
    .confirm-label {
      position: relative; z-index: 2;
      font-family: 'Cabin Sketch',cursive; font-size: 1.1rem; font-weight: 700;
      color: white; text-transform: uppercase; letter-spacing: 0.05em;
      display: flex; align-items: center; gap: 0.6rem;
    }

    /* Wave underline */
    .wave-line { width: 120px; height: 12px; }
    .wave-line svg { width: 100%; height: 100%; }

    /* ─── CONFIRMED ─── */
    .confirmed-wrap { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 2rem 1rem; gap: 1rem; }
    .confirmed-circle { width: 90px; height: 90px; }
    .confirmed-circle svg { width: 100%; height: 100%; }
    .conf-ring { stroke-dasharray: 151; stroke-dashoffset: 151; transition: stroke-dashoffset 700ms ease 200ms; }
    .conf-check { stroke-dasharray: 50; stroke-dashoffset: 50; transition: stroke-dashoffset 600ms ease 900ms; }
    .confirmed-wrap.show .conf-ring { stroke-dashoffset: 0; }
    .confirmed-wrap.show .conf-check { stroke-dashoffset: 0; }
    .confirmed-title { font-family: 'Shadows Into Light',cursive; font-size: 2.5rem; color: #00AB39; margin: 0; animation: bounce-in 500ms cubic-bezier(0.34,1.56,0.64,1) 1.2s both; }
    .confirmed-sub { font-family: 'Patrick Hand',cursive; font-size: 1.1rem; color: #555; margin: 0; animation: fade-in-up-c 400ms ease 1.4s both; }
    @keyframes bounce-in { from{transform:scale(0.5);opacity:0} to{transform:scale(1);opacity:1} }
    @keyframes fade-in-up-c { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:none} }
    .confirmed-ref {
      display: flex; flex-direction: column; align-items: center; gap: 0.2rem;
      padding: 0.75rem 1.5rem; background: #E8F5E9;
      border-radius: 12px; animation: fade-in-up-c 400ms ease 1.6s both;
    }
    .ref-label { font-family: 'Cabin Sketch',cursive; font-size: 0.75rem; color: #006b24; text-transform: uppercase; letter-spacing: 0.08em; }
    .ref-val { font-family: 'Shadows Into Light',cursive; font-size: 1.5rem; color: #00AB39; }
    .confirmed-btns { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 1rem; animation: fade-in-up-c 400ms ease 1.8s both; }
    .btn-conf-primary, .btn-conf-secondary {
      position: relative; padding: 0.8rem 1.5rem;
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 160px; border-radius: 12px; text-decoration: none;
      cursor: pointer; transition: transform 200ms;
    }
    .btn-conf-primary:hover, .btn-conf-secondary:hover { transform: translateY(-3px) scale(1.04); }
    .conf-btn-label { position: relative; z-index: 2; font-family: 'Cabin Sketch',cursive; font-size: 0.95rem; font-weight: 700; color: white; text-transform: uppercase; letter-spacing: 0.04em; }
    .conf-btn-label.sec { color: #00AB39; }

    /* ─── BOTTOM NAV ─── */
    .wiz-nav {
      position: fixed; bottom: 0; left: 0; right: 0; z-index: 40;
      display: flex; justify-content: space-between; align-items: center;
      padding: 1rem 1.5rem;
      background: rgba(255,249,240,0.95); backdrop-filter: blur(8px);
      border-top: 2px solid rgba(212,165,116,0.2);
    }
    /* On desktop, sidebar is 320px wide — offset fixed nav accordingly */
    @media (min-width: 1024px) { .wiz-nav { left: 320px; } }
    /* Add bottom padding so content isn't hidden behind the fixed nav (~88px tall) */
    .wiz-main { padding-bottom: 100px; }
    .btn-back, .btn-next {
      position: relative;
      padding: 0.9rem 2rem;
      border: none; cursor: pointer; border-radius: 12px;
      transition: transform 200ms, opacity 200ms;
      min-width: 140px;
    }
    .btn-back:hover { transform: translateX(-3px) scale(1.04); }
    .btn-next:hover:not(:disabled) { transform: translateX(3px) scale(1.04); }
    .btn-back:active, .btn-next:active { transform: scale(0.95); }
    .btn-next:disabled { opacity: 0.55; cursor: not-allowed; }
    .nav-btn-label {
      position: relative; z-index: 2;
      font-family: 'Cabin Sketch',cursive; font-size: 1rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.04em; color: white;
    }
    .back-label { color: #00AB39; }

    /* Ripple */
    .ripple-wave {
      position: absolute; border-radius: 50%;
      background: rgba(255,255,255,0.35);
      transform: scale(0); pointer-events: none;
      animation: ripple-go 600ms linear;
    }
    @keyframes ripple-go { to { transform: scale(4); opacity: 0; } }

    @media (max-width: 480px) {
      .btn-back, .btn-next { min-width: 110px; padding: 0.8rem 1.25rem; }
      .step-panel { padding: 1rem; }
    }
  </style>

  <script>
    import { actions } from 'astro:actions';
    import { createOCREngine, supportsFastBuild } from 'tesseract-wasm';

    // ── STATE ──
    const state = {
      step: 1,
      checkin: null as string | null,
      checkout: null as string | null,
      nights: 0,
      docType: null as string | null,
      bed: null as string | null,
      pricePerNight: 15 as number,   // updated from API once dates are selected
      totalPrice: 0 as number,
    };

    let calYear = new Date().getFullYear();
    let calMonth = new Date().getMonth();

    // ── STEP CONFIG ──
    const STEPS = [
      { pct: 14,  label: 'Continue to ID Upload →',  back: null },
      { pct: 29,  label: 'Continue to Your Info →',  back: '← Back to Dates' },
      { pct: 43,  label: 'Continue to Bed Selection →', back: '← Back to ID Upload' },
      { pct: 57,  label: 'Continue to Payment →',    back: '← Back to Your Info' },
      { pct: 72,  label: 'Continue to Summary →',    back: '← Back to Bed Selection' },
      { pct: 86,  label: 'Confirm Booking',           back: '← Back to Payment' },
      { pct: 100, label: '',                           back: null },
    ];

    // ── ELEMENTS ──
    const progFill = document.getElementById('prog-fill')!;
    const progText = document.getElementById('prog-text')!;
    const progPct  = document.getElementById('prog-pct')!;
    const mobileStepLabel = document.getElementById('mobile-step-label')!;
    const btnBack = document.getElementById('btn-back') as HTMLButtonElement;
    const btnNext = document.getElementById('btn-next') as HTMLButtonElement;
    const wizNav  = document.getElementById('wiz-nav')!;

    // ── RENDER STEP ──
    function goToStep(next: number, dir: 'forward' | 'back' = 'forward') {
      const currentPanel = document.getElementById(`step-${state.step}`)!;
      const nextPanel    = document.getElementById(`step-${next}`)!;

      currentPanel.style.animation = dir === 'forward'
        ? 'step-exit 280ms ease forwards'
        : 'step-exit-back 280ms ease forwards';

      setTimeout(() => {
        currentPanel.classList.add('hidden');
        currentPanel.style.animation = '';
        state.step = next;
        nextPanel.classList.remove('hidden');
        nextPanel.style.animation = dir === 'forward'
          ? 'step-enter 380ms cubic-bezier(0.34,1.56,0.64,1) forwards'
          : 'step-enter-back 380ms cubic-bezier(0.34,1.56,0.64,1) forwards';
        // Re-init bed selection when entering step 4 (needs current nights count)
        if (next === 4) initBedSelection();
        updateUI();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }, 260);
    }

    function updateUI() {
      const cfg = STEPS[state.step - 1];
      // Progress
      progFill.style.width = cfg.pct + '%';
      progText.textContent = `Step ${state.step} of 7`;
      progPct.textContent  = `${cfg.pct}% Complete`;
      mobileStepLabel.textContent = `Step ${state.step} of 7`;

      // Nav buttons
      if (state.step === 7) {
        wizNav.style.display = 'none';
        return;
      } else {
        wizNav.style.display = '';
      }
      if (cfg.back) {
        btnBack.style.display = '';
        (btnBack.querySelector('.nav-btn-label') as HTMLElement).textContent = cfg.back;
      } else {
        btnBack.style.display = 'none';
      }
      (btnNext.querySelector('.nav-btn-label') as HTMLElement).textContent = cfg.label;

      // Sidebar
      document.querySelectorAll('.step-btn').forEach((btn, i) => {
        const s = i + 1;
        const circle = btn.querySelector('.step-circle')!;
        const num    = btn.querySelector('.step-num')!;
        const lbl    = btn.querySelector('.step-label')!;
        const dot    = btn.querySelector('.step-dot');
        if (s < state.step) {
          circle.classList.add('done');
          lbl.textContent = '✓ ' + lbl.textContent?.replace('✓ ','');
          lbl.classList.add('active');
          num.classList.remove('inactive');
          if (dot) dot.classList.remove('active');
        } else if (s === state.step) {
          lbl.classList.add('active');
          num.classList.remove('inactive');
          if (dot) { dot.classList.add('active'); (dot as HTMLElement).style.display = ''; }
        } else {
          lbl.classList.remove('active');
          num.classList.add('inactive');
          if (dot) dot.classList.remove('active');
        }
      });

      // Per-step enable/disable
      enableNext(canProceed());
    }

    function canProceed(): boolean {
      switch (state.step) {
        case 1: return !!(state.checkin && state.checkout);
        case 2: return !!state.docType;
        case 3: return true; // validated on click
        case 4: return !!state.bed;
        case 5: return true;
        case 6: return true;
        default: return false;
      }
    }

    function enableNext(yes: boolean) {
      btnNext.disabled = !yes;
    }

    // ── CALENDAR ──
    // Per-month availability cache populated from /api/availability
    const dayInfoCache: Record<string, { beds: number; price: number }> = {};
    let calFetchController: AbortController | null = null;

    // Local formula used as instant fallback while API response is in-flight
    function getDayInfoLocal(dateStr: string): { beds: number; price: number } {
      const parts = dateStr.split('-').map(Number);
      const hash = (parts[2] * 7 + parts[1] * 13 + parts[0]) % 29;
      const d = new Date(dateStr + 'T12:00:00');
      const isWeekend = d.getDay() === 5 || d.getDay() === 6;
      const isSummer  = d.getMonth() >= 5 && d.getMonth() <= 8;
      const price = 8 + (isWeekend ? 4 : 0) + (isSummer ? 3 : 0) + (hash % 3);
      const beds  = Math.max(0, 24 - Math.min(23, Math.floor(hash * 0.9)));
      return { beds, price };
    }

    function getDayInfo(dateStr: string): { beds: number; price: number } {
      return dayInfoCache[dateStr] ?? getDayInfoLocal(dateStr);
    }

    // Fetch a full month from the API and repaint the calendar when done
    async function fetchMonthAvailability(year: number, month: number) {
      const mm = String(month + 1).padStart(2, '0');
      const lastDay = new Date(year, month + 1, 0).getDate();
      const from = `${year}-${mm}-01`;
      const to   = `${year}-${mm}-${String(lastDay).padStart(2, '0')}`;
      calFetchController?.abort();
      calFetchController = new AbortController();
      try {
        const res = await fetch(`/api/availability?from=${from}&to=${to}`, {
          signal: calFetchController.signal,
        });
        if (res.ok) {
          const data = await res.json() as { days: Record<string, { beds: number; price: number }> };
          Object.assign(dayInfoCache, data.days);
          renderCalendar(); // repaint with real data
        }
      } catch (e) {
        if ((e as Error).name !== 'AbortError') console.warn('[availability] fetch failed', e);
      }
    }

    // After dates are selected, fetch real per-night price from the action
    async function fetchPriceForSelection() {
      if (!state.checkin || !state.checkout) return;
      try {
        const result = await actions.booking.checkAvailability({
          checkIn: state.checkin,
          checkOut: state.checkout,
          persons: 1,
        });
        if (result.data) {
          state.pricePerNight = result.data.pricePerNight ?? state.pricePerNight;
          state.totalPrice    = result.data.totalPrice    ?? (state.nights * state.pricePerNight);
          // Update the price summary chips with real values
          updateDateSummary();
        }
      } catch {
        // keep default price — no UI disruption
      }
    }

    function renderCalendar() {
      const grid = document.getElementById('cal-grid')!;
      const titleEl = document.getElementById('cal-month-title')!;
      const today = new Date(); today.setHours(0,0,0,0);

      titleEl.textContent = new Date(calYear, calMonth, 1)
        .toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

      // Show/hide today button depending on whether we're viewing the current month
      const todayBtn = document.getElementById('today-btn')!;
      const isCurrentMonth = calYear === today.getFullYear() && calMonth === today.getMonth();
      todayBtn.style.display = isCurrentMonth ? 'none' : '';

      grid.innerHTML = '';

      const firstDay = new Date(calYear, calMonth, 1).getDay();
      const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();

      const checkinDate  = state.checkin  ? new Date(state.checkin  + 'T00:00:00') : null;
      const checkoutDate = state.checkout ? new Date(state.checkout + 'T00:00:00') : null;

      // Empty cells
      for (let i = 0; i < firstDay; i++) {
        grid.insertAdjacentHTML('beforeend', '<div></div>');
      }

      for (let d = 1; d <= daysInMonth; d++) {
        const date = new Date(calYear, calMonth, d);
        const isPast = date < today;
        const isToday = date.getTime() === today.getTime();
        const dateStr = `${calYear}-${String(calMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
        const isCheckin  = state.checkin  === dateStr;
        const isCheckout = state.checkout === dateStr;
        const inRange = checkinDate && checkoutDate && date > checkinDate && date < checkoutDate;

        // Get availability and price info
        const info = getDayInfo(dateStr);
        const isSoldOut = info.beds === 0;

        let fillColor = '#FFF9F0';
        let strokeColor = '#D4A574';
        let strokeWidth = '2.5';

        if (isPast && !isToday) { fillColor = '#f5f5f5'; strokeColor = '#e0e0e0'; }
        if (isToday) { fillColor = '#EAC102'; strokeColor = '#D4A574'; }
        if (isSoldOut && !isPast && !isToday) { fillColor = '#FFF0F0'; strokeColor = '#EF9A9A'; }
        if (isCheckin || isCheckout) { fillColor = '#00AB39'; strokeColor = '#005a1e'; strokeWidth = '3'; }
        if (inRange) { fillColor = '#C8E6C9'; strokeColor = '#81C784'; }

        const classes = ['cal-day',
          isPast && !isToday ? 'disabled' : '',
          isSoldOut && !isPast && !isToday ? 'disabled' : '',
          isToday ? 'today' : '',
          isCheckin ? 'checkin' : '',
          isCheckout ? 'checkout' : '',
          inRange ? 'in-range' : ''
        ].filter(Boolean).join(' ');

        const isDisabled = (isPast && !isToday) || (isSoldOut && !isPast && !isToday);

        // Beds label
        const bedsClass = info.beds === 0 ? 'none' : info.beds <= 3 ? 'low' : '';
        const bedsLabel = info.beds === 0 ? 'Full' : `${info.beds} left`;

        grid.insertAdjacentHTML('beforeend', `
          <button class="${classes}" data-date="${dateStr}" data-price="${info.price}" data-beds="${info.beds}" ${isDisabled ? 'disabled' : ''} aria-label="${dateStr} - €${info.price}/night - ${info.beds} beds left">
            <svg class="cal-day-bg" viewBox="0 0 100 100">
              <rect x="5" y="5" width="90" height="90" rx="15"
                fill="${fillColor}" stroke="${strokeColor}" stroke-width="${strokeWidth}"/>
            </svg>
            <span class="cal-day-num">${d}</span>
            <span class="cal-day-beds ${bedsClass}">${bedsLabel}</span>
            <span class="cal-day-price">€${info.price}</span>
            ${isToday ? '<div class="today-dot"></div>' : ''}
          </button>`);
      }

      // Click handler
      grid.querySelectorAll('.cal-day:not(.disabled)').forEach(btn => {
        btn.addEventListener('click', function() {
          const d = (this as HTMLElement).dataset.date!;
          if (!state.checkin || (state.checkin && state.checkout)) {
            state.checkin = d; state.checkout = null;
          } else {
            if (d <= state.checkin) { state.checkin = d; }
            else {
              state.checkout = d;
              const ms = new Date(d + 'T00:00:00').getTime() - new Date(state.checkin + 'T00:00:00').getTime();
              state.nights = Math.round(ms / 86400000);
              fetchPriceForSelection(); // async — updates state.pricePerNight when API responds
            }
          }
          updateDateSummary();
          renderCalendar();
          enableNext(canProceed());
        });
      });
    }

    function updateDateSummary() {
      const ci = document.getElementById('checkin-display')!;
      const co = document.getElementById('checkout-display')!;
      const cichip = document.getElementById('checkin-chip')!;
      const cochip = document.getElementById('checkout-chip')!;
      const nchip = document.getElementById('nights-chip')!;
      const nval  = document.getElementById('nights-val')!;
      const acts  = document.getElementById('date-actions')!;
      const priceChip = document.getElementById('price-chip')!;
      const priceTotal = document.getElementById('price-total')!;
      const priceBreakdown = document.getElementById('price-breakdown')!;
      const priceRows = document.getElementById('price-rows')!;
      const priceTotalRow = document.getElementById('price-total-row')!;

      if (state.checkin) {
        ci.textContent = new Date(state.checkin + 'T12:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric'});
        cichip.classList.add('filled');
      } else {
        ci.textContent = '—'; cichip.classList.remove('filled');
      }
      if (state.checkout) {
        co.textContent = new Date(state.checkout + 'T12:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric'});
        cochip.classList.add('filled');
        nchip.style.display = '';
        nval.textContent = String(state.nights);
        acts.style.display = '';

        // Calculate price breakdown
        const ciDate = new Date(state.checkin + 'T12:00:00');
        let total = 0;
        let rowsHtml = '';
        for (let i = 0; i < state.nights; i++) {
          const d = new Date(ciDate); d.setDate(d.getDate() + i);
          const ds = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
          const info = getDayInfo(ds);
          total += info.price;
          const label = d.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'});
          rowsHtml += `<div class="price-row">
            <span class="price-row-night">Night ${i+1} · ${label}</span>
            <span class="price-row-amt">€${info.price}</span>
          </div>`;
        }
        priceChip.style.display = '';
        priceTotal.textContent = `€${total}`;
        priceBreakdown.style.display = '';
        priceRows.innerHTML = rowsHtml;
        priceTotalRow.innerHTML = `<span class="price-total-label">Total (${state.nights} night${state.nights > 1 ? 's' : ''})</span><span class="price-total-amt">€${total}</span>`;
      } else {
        co.textContent = '—'; cochip.classList.remove('filled');
        nchip.style.display = 'none'; acts.style.display = 'none';
        priceChip.style.display = 'none';
        priceBreakdown.style.display = 'none';
      }
    }

    document.getElementById('prev-month')!.addEventListener('click', () => {
      calMonth--; if (calMonth < 0) { calMonth = 11; calYear--; }
      animateMonthTitle('back'); renderCalendar(); fetchMonthAvailability(calYear, calMonth);
    });
    document.getElementById('next-month')!.addEventListener('click', () => {
      calMonth++; if (calMonth > 11) { calMonth = 0; calYear++; }
      animateMonthTitle('forward'); renderCalendar(); fetchMonthAvailability(calYear, calMonth);
    });
    document.getElementById('today-btn')!.addEventListener('click', () => {
      const now = new Date();
      const dir = (calYear > now.getFullYear() || (calYear === now.getFullYear() && calMonth > now.getMonth())) ? 'back' : 'forward';
      calYear = now.getFullYear(); calMonth = now.getMonth();
      animateMonthTitle(dir); renderCalendar(); fetchMonthAvailability(calYear, calMonth);
    });

    function animateMonthTitle(dir: 'forward' | 'back') {
      const t = document.getElementById('cal-month-title')!;
      t.style.opacity = '0';
      t.style.transform = `translateX(${dir === 'forward' ? '-20px' : '20px'})`;
      setTimeout(() => {
        t.style.transition = 'opacity 250ms ease, transform 250ms ease';
        t.style.opacity = '1'; t.style.transform = '';
      }, 50);
      setTimeout(() => { t.style.transition = ''; }, 350);
    }

    document.getElementById('clear-dates')!.addEventListener('click', () => {
      state.checkin = null; state.checkout = null; state.nights = 0;
      updateDateSummary(); renderCalendar(); enableNext(false);
    });

    // ── DOC TYPE (Phase transition: cards → upload) ──
    const docCardsPhase = document.getElementById('doc-cards-phase')!;
    const uploadPhase = document.getElementById('upload-phase')!;
    const changeDocBtn = document.getElementById('change-doc-btn')!;
    const uploadFrontInput = document.getElementById('upload-front-input') as HTMLInputElement;
    const uploadBackInput = document.getElementById('upload-back-input') as HTMLInputElement;
    const uploadComplete = document.getElementById('upload-complete')!;
    const uploadedFileName = document.getElementById('uploaded-file-name')!;
    const uploadedFileRemove = document.getElementById('uploaded-file-remove')!;
    const ocrResult = document.getElementById('ocr-result')!;
    const uploadBack = document.getElementById('upload-back')!;
    let uploadedFiles = { front: false, back: false };

    function showUploadPhase(docType: string) {
      state.docType = docType;
      const icon = document.getElementById('selected-doc-icon')!;
      const label = document.getElementById('selected-doc-label')!;
      if (docType === 'dni') {
        icon.textContent = '🪪'; label.textContent = 'DNI / ID Card';
        uploadBack.style.display = '';
      } else {
        icon.textContent = '📘'; label.textContent = 'Passport';
        uploadBack.style.display = 'none';
      }
      // Animate doc cards out
      docCardsPhase.classList.add('phase-out');
      setTimeout(() => {
        docCardsPhase.style.display = 'none';
        docCardsPhase.classList.remove('phase-out');
        // Show upload phase
        uploadPhase.style.display = '';
        uploadPhase.classList.remove('phase-out');
      }, 380);
      enableNext(true);
    }

    document.querySelectorAll('.doc-card').forEach(card => {
      card.addEventListener('click', function() {
        const dt = (this as HTMLElement).dataset.doc!;
        showUploadPhase(dt);
      });
      card.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') (card as HTMLElement).click();
      });
    });

    // Change doc button — reverse transition
    changeDocBtn.addEventListener('click', () => {
      uploadPhase.classList.add('phase-out');
      setTimeout(() => {
        uploadPhase.style.display = 'none';
        uploadPhase.classList.remove('phase-out');
        // Reset upload state
        uploadComplete.style.display = 'none';
        ocrResult.style.display = 'none';
        document.getElementById('upload-front-content')!.style.display = '';
        document.getElementById('upload-back-content')!.style.display = '';
        uploadedFiles = { front: false, back: false };
        state.docType = null;
        enableNext(canProceed());
        // Show doc cards
        docCardsPhase.style.display = '';
        docCardsPhase.classList.add('phase-in');
        setTimeout(() => docCardsPhase.classList.remove('phase-in'), 420);
      }, 330);
    });

    // ── Browser-side OCR helpers (tesseract-wasm) ─────────────────────────────
    // Engine is reused for the whole page session — loading WASM + traineddata
    // once (~6 MB total) and caching avoids re-fetching on subsequent uploads.
    type OCREngineType = Awaited<ReturnType<typeof createOCREngine>>;
    let _ocrEngine: OCREngineType | null = null;
    let _loadedLang = '';

    /** Decode a File into ImageData, scaling to ≤2400px and boosting contrast. */
    async function fileToImageData(file: File): Promise<ImageData> {
      const bitmap = await createImageBitmap(file);
      const maxDim = 2400;
      const scale  = Math.min(1, maxDim / Math.max(bitmap.width, bitmap.height));
      const w = Math.round(bitmap.width  * scale);
      const h = Math.round(bitmap.height * scale);
      const canvas = Object.assign(document.createElement('canvas'), { width: w, height: h });
      const ctx    = canvas.getContext('2d')!;
      ctx.filter = 'grayscale(1) contrast(1.6)';
      ctx.drawImage(bitmap, 0, 0, w, h);
      bitmap.close();
      return ctx.getImageData(0, 0, w, h);
    }

    interface ExtractedFields {
      firstName: string; lastName: string;
      documentNumber: string; birthDate: string; nationality: string;
    }

    /** Parse DNI / NIE text extracted by Tesseract. */
    function parseDni(text: string): ExtractedFields {
      const lines = text.split(/\r?\n/).map(l => l.trim()).filter(Boolean);

      // Document number: 8 digits + letter (DNI) or X/Y/Z + 7 digits + letter (NIE)
      let documentNumber = '';
      const dniMatch = text.match(/\b(\d{8}[A-Z])\b/);
      if (dniMatch) documentNumber = dniMatch[1];
      if (!documentNumber) {
        const nieMatch = text.match(/\b([XYZ]\d{7}[A-Z])\b/);
        if (nieMatch) documentNumber = nieMatch[1];
      }

      // Birth date — DD/MM/YYYY, DD-MM-YYYY, DD.MM.YYYY or space-separated
      let birthDate = '';
      const dm = text.match(/(\d{1,2})\s*[\/\-\.\s]\s*(\d{1,2})\s*[\/\-\.\s]\s*(\d{4})/);
      if (dm) birthDate = `${dm[3]}-${dm[2].padStart(2,'0')}-${dm[1].padStart(2,'0')}`;

      // Nationality — 3-letter ISO code present on the card
      let nationality = '';
      const natRe = /\b(ESP|FRA|DEU|ITA|POR|GBR|USA|MEX|ARG|COL|BRA|MAR|ROU|CHN|JPN|NLD|BEL|POL|SVK|CZE|HUN|SWE|NOR|DNK|FIN|AUT|CHE)\b/;
      const natM = text.match(natRe);
      if (natM) nationality = natM[1];
      if (!nationality) nationality = 'ESP'; // default for Spanish ID

      // Names — look for APELLIDOS / NOMBRE label lines first
      let lastName = '', firstName = '';
      for (let i = 0; i < lines.length - 1; i++) {
        if (/APELLIDOS?/i.test(lines[i]) && !lastName)
          lastName  = lines[i + 1].replace(/[^A-ZÁÉÍÓÚÜÑA-Z\s]/gi, '').trim();
        if (/^NOMBRE\s*$/i.test(lines[i]) && !firstName)
          firstName = lines[i + 1].replace(/[^A-ZÁÉÍÓÚÜÑA-Z\s]/gi, '').trim();
      }
      // Fallback: consecutive ALL-CAPS lines that look like names
      if (!lastName || !firstName) {
        const nameLines = lines.filter(l =>
          /^[A-ZÁÉÍÓÚÜÑ\s]{3,}$/.test(l) && !/\d/.test(l) &&
          !/(DNI|NIE|ESP|ESPAÑA|SPAIN|FECHA|NACIM|VALID|DOCUM|NÚMER|NOMBR|APELL|SEXO|NACION|REPÚBL)/i.test(l)
        );
        if (!lastName  && nameLines[0]) lastName  = nameLines[0];
        if (!firstName && nameLines[1]) firstName = nameLines[1];
      }

      return { firstName, lastName, documentNumber, birthDate, nationality };
    }

    /** Parse Passport MRZ lines extracted by Tesseract. */
    function parsePassport(text: string): ExtractedFields {
      let firstName = '', lastName = '', documentNumber = '', birthDate = '', nationality = 'ESP';

      // MRZ line 1: P<ESPapellido<<NOMBRE<...
      const m1 = text.match(/P[<A-Z][A-Z]{3}([A-Z<]{39})/);
      if (m1) {
        const sep = m1[1].indexOf('<<');
        if (sep !== -1) {
          lastName  = m1[1].slice(0, sep).replace(/</g, ' ').trim();
          firstName = m1[1].slice(sep + 2).replace(/</g, ' ').trim();
        }
      }
      // MRZ line 2: docNumber0NAT6digitsDOB0sex6digitsExpiry0...
      const m2 = text.match(/([A-Z0-9<]{9})\d[A-Z]{3}(\d{6})\d[MF<](\d{6})/);
      if (m2) {
        documentNumber = m2[1].replace(/</g, '');
        const dob = m2[2];
        const yy  = parseInt(dob.slice(0, 2));
        birthDate = `${yy > 30 ? 1900 + yy : 2000 + yy}-${dob.slice(2,4)}-${dob.slice(4,6)}`;
      }
      return { firstName, lastName, documentNumber, birthDate, nationality };
    }

    /** Return (or lazily initialise) the OCR engine for the given language. */
    async function getOCREngine(lang: string): Promise<OCREngineType> {
      if (_ocrEngine && _loadedLang === lang) return _ocrEngine;
      if (_ocrEngine) { _ocrEngine.destroy(); _ocrEngine = null; }

      const wasmPath = supportsFastBuild()
        ? '/tesseract/tesseract-core.wasm'
        : '/tesseract/tesseract-core-fallback.wasm';
      const wasmBinary = await fetch(wasmPath).then(r => r.arrayBuffer());
      _ocrEngine = await createOCREngine({ wasmBinary });

      const model = await fetch(`/tesseract/${lang}.traineddata`).then(r => r.arrayBuffer());
      _ocrEngine.loadModel(model);
      _loadedLang = lang;
      return _ocrEngine;
    }
    // ──────────────────────────────────────────────────────────────────────────

    // Upload file handlers
    async function handleUpload(side: 'front' | 'back', file: File) {
      uploadedFiles[side] = true;
      const content = document.getElementById(`upload-${side}-content`)!;
      content.innerHTML = `<div style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00AB39" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
        <span style="font-family:'Patrick Hand',cursive;color:#006b24;font-size:0.9rem">${file.name}</span>
      </div>`;

      // Check if all required uploads done
      const needBack = state.docType === 'dni';
      if (uploadedFiles.front && (!needBack || uploadedFiles.back)) {
        // Show upload complete bar + OCR scanning indicator
        uploadedFileName.textContent = needBack ? 'Front + Back uploaded' : file.name;
        uploadComplete.style.display = '';
        ocrResult.style.display = '';
        const ocrFieldsEl = ocrResult.querySelector('.ocr-fields') as HTMLElement | null;
        if (ocrFieldsEl) ocrFieldsEl.innerHTML = '<div style="text-align:center;padding:0.5rem 0;font-family:\'Patrick Hand\',cursive;color:#5D4E37">Escaneando documento…</div>';

        // ── Browser-side OCR via tesseract-wasm ───────────────────────────────
        // Runs entirely in the browser: no HTTP request to any server.
        // The WASM binary (~1.8 MB) + traineddata (~2–4 MB) are fetched from
        // /tesseract/ on the first scan and cached for subsequent uploads.
        const lang = (state.docType === 'passport') ? 'eng' : 'spa';
        try {
          const engine = await getOCREngine(lang);

          let rawText = '';
          if (uploadFrontInput.files?.[0]) {
            engine.loadImage(await fileToImageData(uploadFrontInput.files[0]));
            rawText += engine.getText() + '\n';
          }
          if (uploadBackInput.files?.[0]) {
            engine.loadImage(await fileToImageData(uploadBackInput.files[0]));
            rawText += engine.getText() + '\n';
          }

          const ext = (state.docType === 'passport') ? parsePassport(rawText) : parseDni(rawText);
          const hasData = !!(ext.firstName || ext.lastName || ext.documentNumber || ext.birthDate);

          if (!hasData) {
            if (ocrFieldsEl) ocrFieldsEl.innerHTML = `<div style="color:#EF5350;font-family:'Patrick Hand',cursive;font-size:0.9rem;padding:0.5rem 0">OCR no pudo extraer datos — por favor rellene los campos manualmente</div>`;
            return;
          }

          // Pre-fill Step 3 form fields with extracted values
          const fFirst = document.getElementById('f-first') as HTMLInputElement;
          const fLast  = document.getElementById('f-last')  as HTMLInputElement;
          const fDob   = document.getElementById('f-dob')   as HTMLInputElement;
          const fNat   = document.getElementById('f-nat')   as HTMLInputElement;
          if (fFirst && ext.firstName)   fFirst.value = ext.firstName;
          if (fLast  && ext.lastName)    fLast.value  = ext.lastName;
          if (fDob   && ext.birthDate)   fDob.value   = ext.birthDate;
          if (fNat   && ext.nationality) fNat.value   = ext.nationality;

          // Update OCR display panel
          if (ocrFieldsEl) {
            const name   = [ext.firstName, ext.lastName].filter(Boolean).join(' ').toUpperCase() || '—';
            const docNum = ext.documentNumber || '—';
            ocrFieldsEl.innerHTML = `
              <div class="ocr-field"><span class="ocr-label">Nombre</span><span class="ocr-value">${name}</span></div>
              <div class="ocr-field"><span class="ocr-label">Documento #</span><span class="ocr-value">${docNum}</span></div>
              <div class="ocr-field"><span class="ocr-label">Fecha nacimiento</span><span class="ocr-value">${ext.birthDate || '—'}</span></div>
              <div class="ocr-field"><span class="ocr-label">Nacionalidad</span><span class="ocr-value">${(ext.nationality || '—').toUpperCase()}</span></div>
            `;
          }
        } catch (err) {
          console.error('[tesseract-wasm] OCR error:', err);
          if (ocrFieldsEl) ocrFieldsEl.innerHTML = `<div style="color:#EF5350;font-family:'Patrick Hand',cursive;font-size:0.9rem">Error al escanear — por favor rellene manualmente.</div>`;
        }
      }
    }

    [uploadFrontInput, uploadBackInput].forEach(input => {
      if (!input) return;
      const side = input.id.includes('front') ? 'front' : 'back';
      input.addEventListener('change', () => {
        if (input.files && input.files[0]) handleUpload(side as 'front' | 'back', input.files[0]);
      });
      // Click the upload face to trigger file input
      const face = input.closest('.upload-face');
      if (face) {
        face.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).tagName !== 'INPUT') input.click();
        });
        face.addEventListener('keydown', (e) => {
          if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') input.click();
        });
      }
    });

    // Remove uploaded file
    uploadedFileRemove.addEventListener('click', () => {
      uploadComplete.style.display = 'none';
      ocrResult.style.display = 'none';
      uploadedFiles = { front: false, back: false };
      document.getElementById('upload-front-content')!.innerHTML = `
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#00AB39" stroke-width="1.5" stroke-linecap="round" class="upload-cam-icon"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="12" cy="12" r="3.5"/><path d="M3 5l2-2h4l2 2"/></svg>
        <p class="upload-label">Front of <span id="upload-face-label">ID</span></p>
        <p class="upload-hint">Click or drag image to upload</p>
        <p class="upload-formats">JPG, PNG or PDF (max 10MB)</p>`;
      const backContent = document.getElementById('upload-back-content');
      if (backContent) {
        backContent.innerHTML = `
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#D4A574" stroke-width="1.5" stroke-linecap="round" class="upload-cam-icon"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="12" cy="12" r="3.5"/><path d="M3 5l2-2h4l2 2"/></svg>
          <p class="upload-label">Back of ID</p>
          <p class="upload-hint">Click or drag image to upload</p>
