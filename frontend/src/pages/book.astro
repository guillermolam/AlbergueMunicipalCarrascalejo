    // ── Browser-side OCR helpers (tesseract-wasm) ─────────────────────────────
    // Engine is reused for the whole page session — loading WASM + traineddata
    // once (~6 MB total) and caching avoids re-fetching on subsequent uploads.
    // tesseract-wasm is loaded lazily so a Vite 504 cache miss never blocks the page.
    type TesseractModule = typeof import('tesseract-wasm');
    type OCREngineType = Awaited<ReturnType<TesseractModule['createOCREngine']>>;
    let _ocrEngine: OCREngineType | null = null;
    let _loadedLang = '';

    /** Decode a File into ImageData, scaling to ≤2400px and boosting contrast. */
    async function fileToImageData(file: File): Promise<ImageData> {
      const bitmap = await createImageBitmap(file);
      const maxDim = 2400;
      const scale = Math.min(1, maxDim / Math.max(bitmap.width, bitmap.height));
      const w = Math.round(bitmap.width * scale);
      const h = Math.round(bitmap.height * scale);
      const canvas = Object.assign(document.createElement('canvas'), { width: w, height: h });
      const ctx = canvas.getContext('2d')!;
      ctx.filter = 'grayscale(1) contrast(1.6)';
      ctx.drawImage(bitmap, 0, 0, w, h);
      bitmap.close();
      return ctx.getImageData(0, 0, w, h);
    }

    interface ExtractedFields {
      firstName: string;
      lastName: string;
      documentNumber: string;
      birthDate: string;
      nationality: string;
    }

    /**
     * Parse TD1 (3-line × 30 char) MRZ found on the back of Spanish DNI cards.
     * Line 1: type(2) + country(3) + doc_num(9) + check(1) + optional(15)
     * Line 2: dob(6) + check(1) + sex(1) + expiry(6) + check(1) + nat(3) + optional(11) + check(1)
     * Line 3: primary_id << secondary_id (last << first name)
     */
    function parseMrzTD1(text: string): Partial<ExtractedFields> | null {
      // Strip spaces inside potential MRZ lines, find lines ≥ 20 all-uppercase+< chars
      const mrzLines = text
        .split(/\r?\n/)
        .map((l) => l.trim().replace(/\s+/g, ''))
        .filter((l) => l.length >= 20 && /^[A-Z0-9<]{20,}$/.test(l));

      // Need at least 2 lines
      if (mrzLines.length < 2) return null;

      // Name line: contains << (primary/secondary separator), all CAPS + <
      const nameLine = mrzLines.find((l) => l.includes('<<') && /^[A-Z<]{15,}$/.test(l));
      // DOB line: starts with 6 digits + check digit + M/F/X/<
      const dobLine = mrzLines.find((l) => /^\d{6}\d[MFX<]/i.test(l));
      // Doc line: starts with I or C + 1 char + 3-letter country
      const docLine = mrzLines.find((l) => /^[IC][A-Z<][A-Z]{3}[A-Z0-9<]{5}/i.test(l));

      if (!nameLine && !dobLine) return null;

      let firstName = '',
        lastName = '',
        documentNumber = '',
        birthDate = '',
        nationality = 'ESP';

      if (nameLine) {
        const sep = nameLine.indexOf('<<');
        // Primary id = last names (single < between surname1 and surname2)
        // Secondary id = first names
        lastName = nameLine.slice(0, sep).replace(/</g, ' ').trim();
        firstName = nameLine
          .slice(sep + 2)
          .replace(/</g, ' ')
          .trim();
      }

      if (dobLine) {
        const dobRaw = dobLine.slice(0, 6);
        const yy = parseInt(dobRaw.slice(0, 2));
        // Heuristic: year 30+ → 1900s (e.g. 50 → 1950), else 2000s
        birthDate = `${yy >= 30 ? 1900 + yy : 2000 + yy}-${dobRaw.slice(2, 4)}-${dobRaw.slice(4, 6)}`;
        const nat = dobLine.slice(15, 18).replace(/</g, '');
        if (/^[A-Z]{3}$/.test(nat)) nationality = nat;
      }

      if (docLine) {
        // Doc number = chars 5–13 (0-indexed), common OCR: O→0
        documentNumber = docLine.slice(5, 14).replace(/O/g, '0').replace(/</g, '');
      }

      return { firstName, lastName, documentNumber, birthDate, nationality };
    }

    /** Parse DNI / NIE / Permiso de Residencia text extracted by Tesseract. */
    function parseDni(text: string): ExtractedFields {
      // ── 1. Try TD1 MRZ first (DNI back has 3-line MRZ — most reliable) ────────
      const mrz = parseMrzTD1(text);
      if (mrz?.firstName || mrz?.lastName) {
        // Merge MRZ with any extra fields from label scan below
        const labelResult = parseDniLabels(text);
        return {
          firstName: mrz.firstName || labelResult.firstName,
          lastName: mrz.lastName || labelResult.lastName,
          documentNumber: mrz.documentNumber || labelResult.documentNumber,
          birthDate: mrz.birthDate || labelResult.birthDate,
          nationality: mrz.nationality || labelResult.nationality,
        };
      }

      // ── 2. Fall back to label / visual field parsing ────────────────────────
      return parseDniLabels(text);
    }

    /** Label-based parser for DNI front, NIE front, and Permiso de Residencia. */
    function parseDniLabels(text: string): ExtractedFields {
      const lines = text
        .split(/\r?\n/)
        .map((l) => l.trim())
        .filter(Boolean);
      const upper = text.toUpperCase();

      // ── Document number ──────────────────────────────────────────────────────
      let documentNumber = '';
      // "NIE: Y63872519B" or "NIE Y63872519B" label
      const nieLabelM = text.match(/NIE[:\s]+([XYZ]\d{7}[A-Z])\b/i);
      if (nieLabelM) {
        documentNumber = nieLabelM[1];
      }
      // Bare NIE (X/Y/Z + 7 digits + letter)
      if (!documentNumber) {
        const nieM = text.match(/\b([XYZ]\d{7}[A-Z])\b/);
        if (nieM) documentNumber = nieM[1];
      }
      // DNI (8 digits + letter)
      if (!documentNumber) {
        const dniM = text.match(/\b(\d{8}[A-Z])\b/);
        if (dniM) documentNumber = dniM[1];
      }

      // ── Birth date ───────────────────────────────────────────────────────────
      let birthDate = '';
      // Matches: "18 04 1995", "10/01/1950", "10-01-1950", "10.01.1950"
      const dm =
        text.match(/\b(\d{1,2})\s+(\d{2})\s+(\d{4})\b/) ||
        text.match(/(\d{1,2})[\/\-\.](\d{1,2})[\/\-\.](\d{4})/);
      if (dm) birthDate = `${dm[3]}-${dm[2].padStart(2, '0')}-${dm[1].padStart(2, '0')}`;

      // ── Nationality ──────────────────────────────────────────────────────────
      const NAT_RE =
        /\b(ESP|FRA|DEU|ITA|POR|GBR|USA|MEX|ARG|COL|BRA|MAR|ROU|CHN|JPN|NLD|BEL|POL|SVK|CZE|HUN|SWE|NOR|DNK|FIN|AUT|CHE|IRL|LUX|GRC|HRV|BGR|SRB|ALB|TUR|UKR|RUS)\b/;
      const natM = upper.match(NAT_RE);
      let nationality = natM ? natM[1] : 'ESP';

      // ── Names ────────────────────────────────────────────────────────────────
      let firstName = '',
        lastName = '',
        lastName2 = '';

      for (let i = 0; i < lines.length - 1; i++) {
        const lbl = lines[i].toUpperCase();
        const next = lines[i + 1].replace(/[^A-ZÁÉÍÓÚÜÑ\s\-]/gi, '').trim();

        // "PRIMER APELLIDO" → next line is first surname
        if (/PRIMER\s+APELLIDO/i.test(lbl) && !lastName) {
          lastName = next;
          continue;
        }
        // "SEGUNDO APELLIDO" → next line is second surname
        if (/SEGUNDO\s+APELLIDO/i.test(lbl) && !lastName2) {
          lastName2 = next;
          continue;
        }
        // Generic "APELLIDOS" label (older DNI) → next line
        if (/^APELLIDOS?\s*$/i.test(lbl) && !lastName) {
          lastName = next;
          continue;
        }
        // "NOMBRE" alone → next line is first name
        if (/^NOMBRE\s*$/i.test(lbl) && !firstName) {
          firstName = next;
          continue;
        }
        // NIE / Permiso format: "APELLIDOS Nombres / SURNAMES Forenames" → name on next line
        // Name line format: "LASTNAME Firstname"  (ALL-CAPS last, mixed first)
        if (/APELLIDOS\s+NOMBRES|SURNAMES\s+FORENAMES/i.test(lbl)) {
          const parts = lines[i + 1].trim().split(/\s+/);
          if (parts.length >= 2) {
            // Convention: last word(s) in Title case = first name(s)
            const firstIdx = parts.findIndex(
              (p) =>
                p === p.charAt(0).toUpperCase() + p.slice(1).toLowerCase() && p !== p.toUpperCase()
            );
            if (firstIdx > 0) {
              lastName = parts.slice(0, firstIdx).join(' ');
              firstName = parts.slice(firstIdx).join(' ');
            } else {
              // All caps — last word is given name
              firstName = parts[parts.length - 1];
              lastName = parts.slice(0, -1).join(' ');
            }
          }
          continue;
        }
      }

      // Combine double surnames (PRIMER + SEGUNDO APELLIDO)
      if (lastName2 && !lastName.toUpperCase().includes(lastName2.toUpperCase())) {
        lastName = `${lastName} ${lastName2}`.trim();
      }

      // ── Fallback: all-caps lines that look like names ────────────────────────
      const NOISE =
        /(DNI|NIE|ESP|ESPAÑA|SPAIN|FECHA|NACIM|VALID|DOCUM|NÚMERO|NOMBR|APELL|SEXO|NACION|REPÚBL|MADRID|DOMICIL|PROVINCIA|LUGAR|HIJO|PERSONAL|PERMISO|RESIDENCIA|ESTANCIA|TRABAJAR|AUTORIZA|OBSERV|PRORROGA|INVESTIGA)/i;
      if (!lastName || !firstName) {
        const nameLines = lines.filter(
          (l) => /^[A-ZÁÉÍÓÚÜÑ\s\-]{3,}$/.test(l) && !/\d/.test(l) && !NOISE.test(l)
        );
        if (!lastName && nameLines[0]) lastName = nameLines[0];
        if (!firstName && nameLines[1]) firstName = nameLines[1];
      }

      return { firstName, lastName, documentNumber, birthDate, nationality };
    }

    /** Parse Passport (TD3, 2×44) MRZ extracted by Tesseract. */
    function parsePassport(text: string): ExtractedFields {
      let firstName = '',
        lastName = '',
        documentNumber = '',
        birthDate = '',
        nationality = 'ESP';

      // TD3 MRZ line 1 — P<ESPapellido<<NOMBRE<<<... (44 chars)
      const m1 = text.match(/P[<A-Z][A-Z]{3}([A-Z<]{39})/);
      if (m1) {
        const sep = m1[1].indexOf('<<');
        if (sep !== -1) {
          lastName = m1[1].slice(0, sep).replace(/</g, ' ').trim();
          firstName = m1[1]
            .slice(sep + 2)
            .replace(/</g, ' ')
            .trim();
        }
      }

      // TD3 MRZ line 2 — docNum(9)check nat(3) dob(6)check sex expiry(6)check...
      const m2 = text.match(/([A-Z0-9<]{9})\d([A-Z]{3})(\d{6})\d[MF<](\d{6})/);
      if (m2) {
        documentNumber = m2[1].replace(/</g, '');
        const nat = m2[2];
        if (/^[A-Z]{3}$/.test(nat)) nationality = nat;
        const dob = m2[3];
        const yy = parseInt(dob.slice(0, 2));
        birthDate = `${yy >= 30 ? 1900 + yy : 2000 + yy}-${dob.slice(2, 4)}-${dob.slice(4, 6)}`;
      }

      // Fallback to label parsing if MRZ didn't yield names
      if (!firstName && !lastName) {
        const lines = text
          .split(/\r?\n/)
          .map((l) => l.trim())
          .filter(Boolean);
        for (let i = 0; i < lines.length - 1; i++) {
          if (/APELLIDOS?/i.test(lines[i]) && !lastName)
            lastName = lines[i + 1].replace(/[^A-ZÁÉÍÓÚÜÑ\s\-]/gi, '').trim();
          if (/^NOMBRE\s*$/i.test(lines[i]) && !firstName)
            firstName = lines[i + 1].replace(/[^A-ZÁÉÍÓÚÜÑ\s\-]/gi, '').trim();
        }
      }

      return { firstName, lastName, documentNumber, birthDate, nationality };
    }

    /** Return (or lazily initialise) the OCR engine for the given language. */
    async function getOCREngine(lang: string): Promise<OCREngineType> {
      if (_ocrEngine && _loadedLang === lang) return _ocrEngine;
      if (_ocrEngine) {
        _ocrEngine.destroy();
        _ocrEngine = null;
      }

      // Dynamic import so a stale Vite dep cache (504) never blocks page load
      const { createOCREngine, supportsFastBuild } = await import('tesseract-wasm');

      const wasmPath = supportsFastBuild()
        ? '/tesseract/tesseract-core.wasm'
        : '/tesseract/tesseract-core-fallback.wasm';
      const wasmBinary = await fetch(wasmPath).then((r) => r.arrayBuffer());
      _ocrEngine = await createOCREngine({ wasmBinary });

      const model = await fetch(`/tesseract/${lang}.traineddata`).then((r) => r.arrayBuffer());
      _ocrEngine.loadModel(model);
      _loadedLang = lang;
      return _ocrEngine;
    }
