---
export interface Props {
  title: string;
  subtitle?: string;
  stats?: Array<{ label: string; value: string }>;
}

const { title, subtitle, stats = [] } = Astro.props;

const iconFor = (label: string) => {
  const l = label.toLowerCase();
  if (l.includes('cama')) return 'beds';
  if (l.includes('booking') || l.includes('rese')) return 'reviews';
  if (l.includes('máx') || l.includes('max') || l.includes('noche')) return 'nights';
  if (l.includes('desde') || l.includes('€') || l.includes('precio')) return 'price';
  return 'info';
};
---

<div class="info-scene info-scene-hero">
  <iframe
    id="info-scene-hero-iframe"
    class="info-hero-iframe"
    src="/hostel-3d?embed=1"
    title="Albergue 3D"
    loading="eager"
    referrerpolicy="no-referrer"
  />
  <div class="info-overlay">
    <img
      class="info-logo"
      src="/logos/logoalbergue-removebg-preview.png"
      width="184"
      height="68"
      alt="Albergue Municipal"
      loading="eager"
      decoding="async"
    />
    <h1 class="info-title">{title}</h1>
    {subtitle ? <p class="info-subtitle">{subtitle}</p> : null}
    {stats.length ? (
      <div class="info-stats">
        {stats.map((s) => (
          <div class="info-stat">
            <div class="info-stat-icon" aria-hidden="true" data-icon={iconFor(s.label)}>
              {iconFor(s.label) === 'beds' ? (
                <svg
                  viewBox="0 0 24 24"
                  width="24"
                  height="24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3 7h6a4 4 0 0 1 4 4v0" />
                  <path d="M3 11h18v6H3z" />
                  <path d="M3 17v3" />
                  <path d="M21 17v3" />
                  <path d="M13 10h8" />
                </svg>
              ) : iconFor(s.label) === 'reviews' ? (
                <svg
                  viewBox="0 0 24 24"
                  width="24"
                  height="24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 2l2.9 6 6.6.6-5 4.2 1.6 6.5L12 16.9 5.9 19.3 7.5 12.8 2.5 8.6 9.1 8z" />
                </svg>
              ) : iconFor(s.label) === 'nights' ? (
                <svg
                  viewBox="0 0 24 24"
                  width="24"
                  height="24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 13.2A7.8 7.8 0 0 1 10.8 3 6.6 6.6 0 1 0 21 13.2z" />
                  <path d="M6 20l2-2 2 2 2-2 2 2" />
                </svg>
              ) : iconFor(s.label) === 'price' ? (
                <svg
                  viewBox="0 0 24 24"
                  width="24"
                  height="24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M7 7h10l-1 9H8L7 7z" />
                  <path d="M9 7a3 3 0 0 1 6 0" />
                  <path d="M12 10v4" />
                  <path d="M10.8 12h2.4" />
                </svg>
              ) : (
                <svg
                  viewBox="0 0 24 24"
                  width="24"
                  height="24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 18h.01" />
                  <path d="M10 10a2 2 0 1 1 3.5 1.3c-.8.8-1.5 1.2-1.5 2.7" />
                  <path d="M12 22a10 10 0 1 0-10-10 10 10 0 0 0 10 10z" />
                </svg>
              )}
            </div>
            <div class="info-stat-value">{s.value}</div>
            <div class="info-stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    ) : null}
  </div>
</div>

<script>
  import { attachSectionActive, createRafLoop } from '../../../lib/three/sectionActive';

  const iframe = document.getElementById('info-scene-hero-iframe');
  if (!(iframe instanceof HTMLIFrameElement)) throw new Error('[SceneHero] iframe missing');
  const section = iframe.closest('.ip-section');
  if (!(section instanceof HTMLElement)) throw new Error('[SceneHero] section missing');
  const iframeEl = iframe;
  const sectionEl = section;

  const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches ?? false;
  let active = false;

  const target = { x: 0, y: 0 };
  const current = { x: 0, y: 0 };

  const onMove = (e: PointerEvent) => {
    if (!active) return;
    if (reducedMotion) return;
    const r = sectionEl.getBoundingClientRect();
    const nx = (e.clientX - r.left) / Math.max(1, r.width) - 0.5;
    const ny = (e.clientY - r.top) / Math.max(1, r.height) - 0.5;
    target.x = nx;
    target.y = ny;
  };

  window.addEventListener('pointermove', onMove, { passive: true });

  const loop = createRafLoop(() => {
    if (!active) return;
    current.x += (target.x - current.x) * 0.08;
    current.y += (target.y - current.y) * 0.08;
    const tx = current.x * 22;
    const ty = current.y * 14;
    iframeEl.style.transform = `scale(1.06) translate3d(${tx}px, ${ty}px, 0)`;
  });

  const postPause = (paused: boolean) => {
    try {
      iframeEl.contentWindow?.postMessage({ type: 'hostel3d:pause', paused }, '*');
    } catch {}
  };

  attachSectionActive(sectionEl, {
    auto: false,
    onChange(isActive) {
      active = isActive;
      if (active) {
        postPause(false);
        if (!reducedMotion) loop.start();
      } else {
        postPause(true);
        loop.stop();
      }
    },
  });
</script>

<style>
  .info-scene {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: radial-gradient(120% 80% at 30% 20%, rgba(0, 171, 57, 0.16), rgba(0, 0, 0, 0));
  }
  .info-canvas {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none;
  }
  .info-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(20px, 6vw, 64px);
    z-index: 5;
    color: rgba(255, 255, 255, 0.92);
    pointer-events: none;
  }
  .info-logo {
    width: min(220px, 62vw);
    height: auto;
    margin-bottom: 10px;
    filter: drop-shadow(0 10px 32px rgba(0, 0, 0, 0.45));
    opacity: 0.98;
  }
  .info-hero-iframe {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    border: 0;
    pointer-events: none;
    transform: scale(1.06) translate3d(0, 0, 0);
    transform-origin: center;
    filter: saturate(1.05) contrast(1.02);
  }
  .info-title {
    font-size: clamp(44px, 7vw, 92px);
    line-height: 0.95;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.55);
  }
  .info-subtitle {
    margin-top: 14px;
    font-size: clamp(14px, 1.7vw, 20px);
    opacity: 0.9;
    max-width: 64ch;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.45);
  }
  .info-stats {
    margin-top: 26px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 14px;
    max-width: 760px;
  }
  .info-stat {
    position: relative;
    padding: 12px 14px;
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(20, 24, 32, 0.72), rgba(6, 8, 12, 0.62));
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);
    box-shadow:
      0 22px 70px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      inset 0 -16px 30px rgba(0, 0, 0, 0.42);
    overflow: hidden;
    transform: translateZ(0);
  }
  .info-stat::before {
    content: '';
    position: absolute;
    inset: 10px;
    border-radius: 14px;
    box-shadow:
      inset 0 0 0 2px rgba(255, 255, 255, 0.06),
      inset 0 18px 30px rgba(255, 255, 255, 0.03),
      inset 0 -18px 30px rgba(0, 0, 0, 0.55);
    pointer-events: none;
  }
  .info-stat::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 20px;
    background: radial-gradient(800px 240px at 30% 15%, rgba(0, 171, 57, 0.22), transparent 55%);
    opacity: 0.35;
    pointer-events: none;
  }
  .info-stat-icon {
    width: 42px;
    height: 42px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.92);
    background: linear-gradient(180deg, rgba(0, 171, 57, 0.58), rgba(0, 171, 57, 0.26));
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      0 18px 40px rgba(0, 171, 57, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.22);
    margin-bottom: 10px;
    transform-origin: center;
  }
  .info-stat:nth-child(1) .info-stat-icon { animation: ipIconPulse 2.2s ease-in-out infinite; }
  .info-stat:nth-child(2) .info-stat-icon { animation: ipIconTilt 2.8s ease-in-out infinite; }
  .info-stat:nth-child(3) .info-stat-icon { animation: ipIconFloat 2.4s ease-in-out infinite; }
  .info-stat:nth-child(4) .info-stat-icon { animation: ipIconWink 3.1s ease-in-out infinite; }

  @keyframes ipIconPulse {
    0%, 100% { transform: scale(1); filter: drop-shadow(0 0 0 rgba(0,171,57,0)); }
    45% { transform: scale(1.06); filter: drop-shadow(0 10px 18px rgba(0,171,57,0.22)); }
  }
  @keyframes ipIconTilt {
    0%, 100% { transform: rotate(-2deg) translateY(0); }
    50% { transform: rotate(5deg) translateY(-1px); }
  }
  @keyframes ipIconFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }
  @keyframes ipIconWink {
    0%, 100% { transform: scale(1); }
    42% { transform: scale(1.04); }
    46% { transform: scale(0.96); }
    50% { transform: scale(1.04); }
  }
  .info-stat-value {
    font-weight: 800;
    font-size: 22px;
  }
  .info-stat-label {
    font-size: 12px;
    opacity: 0.85;
    margin-top: 2px;
  }
</style>
