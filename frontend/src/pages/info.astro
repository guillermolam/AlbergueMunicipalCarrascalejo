---
export const prerender = true;

import { DoodleCard, SketchyButton } from '../components';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Información - Albergue Municipal Carrascalejo">
  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <h1 class="text-3xl font-900 text-center mb-8 text-stone-800">Información del Albergue</h1>

    <!-- How to Arrive -->
    <section class="mb-12">
      <DoodleCard variant="elevated" padding="lg">
        <h2 class="text-2xl font-900 mb-6 text-stone-800 flex items-center gap-3">
          <span class="text-2xl">🚶</span>
          Cómo llegar
        </h2>
        <div class="space-y-4 text-stone-700">
          <p><strong>Desde Santiago:</strong> Autobús línea 5 hasta Carrascalejo, 45 minutos.</p>
          <p><strong>Desde el Camino:</strong> A 2 km del desvío en Negreira, señalizado.</p>
          <p><strong>En coche:</strong> A-8 salida 123, seguir señales a Carrascalejo.</p>
          <p><strong>Coordenadas:</strong> 42.1234, -8.5678</p>
        </div>
      </DoodleCard>
    </section>

    <!-- Services Accordion -->
    <section class="mb-12">
      <DoodleCard variant="elevated" padding="lg">
        <h2 class="text-2xl font-900 mb-6 text-stone-800 flex items-center gap-3">
          <span class="text-2xl">🏠</span>
          Servicios
        </h2>

        <div class="space-y-3">
          {
            [
              {
                title: 'Alojamiento',
                content:
                  '24 camas en dormitorios mixtos con taquillas individuales. Ropa de cama incluida.',
              },
              {
                title: 'Cocina',
                content:
                  'Cocina equipada con nevera, microondas, utensilios y especias básicas. Zona de comedor.',
              },
              {
                title: 'Baños',
                content: 'Duchas calientes 24h, secadores de pelo, jabón y champú ecológicos.',
              },
              {
                title: 'Lavandería',
                content: 'Lavadora y secadora (€3 ciclo), tendedero exterior. Detergente incluido.',
              },
              {
                title: 'WiFi y carga',
                content:
                  'WiFi gratuito en todas las instalaciones. Puntos de carga USB y enchufes.',
              },
              {
                title: 'Bicicletas',
                content:
                  'Alquiler de bicicletas €10/día. Incluye casco y candado. Reserva anticipada.',
              },
            ].map((item, index) => (
              <div x-data="{ open: false }" class="border border-stone-200 rounded-lg">
                <button
                  x-on:click="open = !open"
                  class="w-full px-4 py-3 text-left flex justify-between items-center hover:bg-stone-50 transition-colors"
                >
                  <span class="font-600 text-stone-800">{item.title}</span>
                  <span
                    x-bind:class="{ 'rotate-180': open }"
                    class="transform transition-transform"
                  >
                    ▼
                  </span>
                </button>
                <div x-show="open" x-transition class="px-4 pb-3 text-stone-700">
                  {item.content}
                </div>
              </div>
            ))
          }
        </div>
      </DoodleCard>
    </section>

    <!-- Rules -->
    <section class="mb-12">
      <DoodleCard variant="elevated" padding="lg">
        <h2 class="text-2xl font-900 mb-6 text-stone-800 flex items-center gap-3">
          <span class="text-2xl">📋</span>
          Normas del albergue
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h3 class="font-900 text-stone-800 mb-3">Horarios</h3>
            <ul class="space-y-2 text-stone-700 text-sm">
              <li>• Entrada: 15:00 - 22:00</li>
              <li>• Salida: antes 11:00</li>
              <li>• Silencio: 22:00 - 07:00</li>
              <li>• Cocina cierra: 21:30</li>
            </ul>
          </div>
          <div>
            <h3 class="font-900 text-stone-800 mb-3">Convivencia</h3>
            <ul class="space-y-2 text-stone-700 text-sm">
              <li>• Zonas comunes limpias</li>
              <li>• Respetar el descanso</li>
              <li>• No fumar en interiores</li>
              <li>• Mascotas no permitidas</li>
            </ul>
          </div>
          <div>
            <h3 class="font-900 text-stone-800 mb-3">Seguridad</h3>
            <ul class="space-y-2 text-stone-700 text-sm">
              <li>• Taquillas con candado</li>
              <li>• No dejar objetos de valor</li>
              <li>• Extintores señalizados</li>
              <li>• Teléfono emergencia: 112</li>
            </ul>
          </div>
          <div>
            <h3 class="font-900 text-stone-800 mb-3">Servicios</h3>
            <ul class="space-y-2 text-stone-700 text-sm">
              <li>• WiFi gratuito</li>
              <li>• Ropa de cama incluida</li>
              <li>• Uso de cocina</li>
              <li>• Consigna equipaje</li>
            </ul>
          </div>
        </div>
      </DoodleCard>
    </section>

    <!-- Contact -->
    <section class="text-center">
      <DoodleCard variant="elevated" padding="lg">
        <h2 class="text-2xl font-900 mb-6 text-stone-800 flex items-center gap-3">
          <span class="text-2xl">📞</span>
          Contacto
        </h2>
        <div class="space-y-4 text-stone-700">
          <p><strong>Teléfono:</strong> +34 123 456 789</p>
          <p><strong>Email:</strong> info@alberguecarrascalejo.com</p>
          <p><strong>Dirección:</strong> Rúa do Camiño 123, 15890 Carrascalejo, A Coruña</p>
          <div class="flex gap-4 justify-center mt-6">
            <SketchyButton href="/book" text="Reservar Ahora" variant="primary" />
            <SketchyButton href="/" text="Volver al Inicio" variant="outline" />
          </div>
        </div>
      </DoodleCard>
    </section>
  </main>
</Layout>
