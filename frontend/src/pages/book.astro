    function getCountryFlag(code: string): string {
      if (!code || code.length !== 2) return '🌍';
      const pts = [...code.toUpperCase()].map((c) => 0x1f1e6 + c.charCodeAt(0) - 65);
      return String.fromCodePoint(...pts);
    }

