        <circle cx="1100" cy="80" r="30" fill="none" stroke="#00AB39" stroke-width="2" opacity="0.1" style="animation: bg-drift 20s ease-in-out infinite; animation-delay: -8s;" />
        <circle cx="1300" cy="250" r="45" fill="none" stroke="#00AB39" stroke-width="2" opacity="0.1" style="animation: bg-drift 30s ease-in-out infinite; animation-delay: -4s;" />
        <circle cx="200" cy="400" r="55" fill="none" stroke="#1A1A1A" stroke-width="2" opacity="0.1" style="animation: bg-drift 25s ease-in-out infinite; animation-delay: -7s;" />
        <circle cx="500" cy="350" r="25" fill="none" stroke="#00AB39" stroke-width="2" opacity="0.1" style="animation: bg-drift 21s ease-in-out infinite; animation-delay: -1s;" />
        <circle cx="750" cy="450" r="65" fill="none" stroke="#1A1A1A" stroke-width="2" opacity="0.1" style="animation: bg-drift 27s ease-in-out infinite; animation-delay: -5s;" />
        <circle cx="1000" cy="400" r="38" fill="none" stroke="#00AB39" stroke-width="2" opacity="0.1" style="animation: bg-drift 23s ease-in-out infinite; animation-delay: -9s;" />
        <circle cx="100" cy="650" r="42" fill="none" stroke="#00AB39" stroke-width="2" opacity="0.1" style="animation: bg-drift 29s ease-in-out infinite; animation-delay: -3s;" />
        <circle cx="400" cy="700" r="33" fill="none" stroke="#1A1A1A" stroke-width="2" opacity="0.1" style="animation: bg-drift 22s ease-in-out infinite; animation-delay: -6s;" />
        <circle cx="700" cy="650" r="48" fill="none" stroke="#00AB39" stroke-width="2" opacity="0.1" style="animation: bg-drift 26s ease-in-out infinite; animation-delay: -2s;" />
        <circle cx="1050" cy="700" r="28" fill="none" stroke="#1A1A1A" stroke-width="2" opacity="0.1" style="animation: bg-drift 24s ease-in-out infinite; animation-delay: -8s;" />
        <circle cx="1350" cy="600" r="52" fill="none" stroke="#00AB39" stroke-width="2" opacity="0.1" style="animation: bg-drift 28s ease-in-out infinite; animation-delay: -4s;" />
